#!/usr/bin/env bash
# Tests scripts/fresh-reader with a stand-in for claude.
set -euo pipefail
cd "$(dirname "$0")/.."
script=$(pwd)/scripts/fresh-reader

case_count=0
failed_cases=0

# git looks for no repository above the temporary folder, which holds the project.
base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT
export GIT_CEILING_DIRECTORIES=$base
mkdir -p "$base/bin" "$base/project/docs"
# The folder that the stand-in writes what it got to
records=$base/records

# A stand-in for claude, first on the PATH. Each run adds a line with its arguments, each in brackets, to the file
# calls in TEST_RECORDS. It writes the folder it runs in to the file folder, the names of that folder's files to the
# file files, and its input to the file input. Its first TEST_FAILURES runs fail with an error that names the run.
# It prints the error on its output, as claude does for an API error, or on its error output when
# TEST_ERROR_ON_STDERR isn't empty. The other runs print an answer that names the run.
cat >"$base/bin/claude" <<'STAND_IN'
#!/usr/bin/env bash
records=$TEST_RECORDS
printf '[%s]' "$@" >>"$records/calls"
echo >>"$records/calls"
run=$(($(wc -l <"$records/calls")))
pwd -P >"$records/folder"
ls -A >"$records/files"
cat >"$records/input"
if ((run > TEST_FAILURES)); then
  echo "The reader's answer from run $run"
  exit 0
fi
if [[ -n $TEST_ERROR_ON_STDERR ]]; then
  echo "Error: the error of run $run" >&2
else
  echo "API Error: the error of run $run"
fi
exit 1
STAND_IN
chmod +x "$base/bin/claude"

# The page holds characters that a shell or printf would change: a backquote, a dollar sign, a percent sign and a
# backslash.
page_text=$(
  cat <<'PAGE'
# Record what you spend

Run `expenses add 12.50 lunch` to add an expense.
The app saves 100% of your expenses to $HOME/expenses.csv, and writes \n for a new line in a description.
PAGE
)
printf '%s\n' "$page_text" >"$base/project/docs/expenses.md"

# Commits every file in the folder project: commit_all <message>
commit_all() {
  git -C "$base/project" add --all
  git -C "$base/project" -c user.name=test -c user.email=test@example.com commit --quiet -m "$1"
}

# The project's origin/main has the page, and a branch starts from it.
git -C "$base/project" init --quiet --initial-branch=main
commit_all "docs: add the expenses page"
git -C "$base/project" update-ref refs/remotes/origin/main HEAD
git -C "$base/project" switch --quiet --create 12-change

reader="a developer who wants to record what they spend"
claude_arguments="[-p][--safe-mode][--tools][]"
prompt="You are a developer who wants to record what they spend. Read this page once, the way that reader would. Quote each sentence you had to read twice, and say what made you stop. Then quote each sentence you didn't need, and say why. Then quote each sentence that says again what another sentence on the page already says, with the sentence it repeats. Leave out sentences that you'd only word differently."
prompt_with_new_lines="$prompt After the page come the lines that a change added or rewrote. Check those lines most closely for a sentence that repeats another."

# The record of the pages read, and the folder of the readers' answers, in the project's git folder
pages_read=$base/project/.git/pages-read
answers=$base/project/.git/fresh-reader-answers

# Starts a case in which claude fails its first <failures> runs, and the script runs in the folder project, with no
# record of the pages read and no answers: new_case <failures>
new_case() {
  failures=$1
  error_on_stderr=""
  run_folder=$base/project
  rm -rf "$records" "$pages_read" "$answers"
  mkdir -p "$records"
  : >"$records/calls"
}

# Runs scripts/fresh-reader in the folder run_folder with the arguments, and sets status and output:
# run_fresh_reader [<argument>...]
run_fresh_reader() {
  status=0
  output=$(cd "$run_folder" && TEST_RECORDS=$records TEST_FAILURES=$failures \
    TEST_ERROR_ON_STDERR=$error_on_stderr PATH=$base/bin:$PATH "$script" "$@" 2>&1) || status=$?
}

# Reports a failed case: fail_case <message>
fail_case() {
  echo "error: $1" >&2
  failed_cases=$((failed_cases + 1))
}

# Checks how the script ended, and what it printed: expect_result <description> <succeeds or fails> <output>
# The script fails when it exits with a code other than 0.
expect_result() {
  local description=$1 expected_end=$2 expected_output=$3 end=succeeds expected_code="code 0"
  if ((status != 0)); then
    end=fails
  fi
  if [[ $expected_end == fails ]]; then
    expected_code="a code other than 0"
  fi
  case_count=$((case_count + 1))
  if [[ $end != "$expected_end" || $output != "$expected_output" ]]; then
    fail_case "$description, scripts/fresh-reader must exit with $expected_code and print \"$expected_output\", but it exited with code $status and printed \"$output\"."
  fi
}

# Checks the arguments of each run of claude, one run to a line: expect_calls <description> <calls>
expect_calls() {
  local description=$1 expected_calls=$2 calls
  calls=$(<"$records/calls")
  case_count=$((case_count + 1))
  if [[ $calls != "$expected_calls" ]]; then
    fail_case "$description, claude must get the arguments \"$expected_calls\", but it got \"$calls\"."
  fi
}

# Checks what the last run of claude got on its input: expect_input <description> <input>
expect_input() {
  local description=$1 expected_input=$2 input=""
  case_count=$((case_count + 1))
  if [[ -f $records/input ]]; then
    input=$(<"$records/input")
  fi
  if [[ $input != "$expected_input" ]]; then
    fail_case "$description, claude must get \"$expected_input\" on its input, but it got \"$input\"."
  fi
}

# Checks that the last run of claude ran in an empty folder, and that the folder is gone once the script ends:
# expect_empty_temporary_folder <description>
expect_empty_temporary_folder() {
  local description=$1 folder files
  case_count=$((case_count + 1))
  if [[ ! -f $records/folder ]]; then
    fail_case "$description, scripts/fresh-reader must run claude, but it didn't."
    return 0
  fi
  folder=$(<"$records/folder")
  files=$(<"$records/files")
  if [[ -n $files ]]; then
    fail_case "$description, claude must run in an empty folder, but its folder held \"$files\"."
  elif [[ -e $folder ]]; then
    fail_case "$description, scripts/fresh-reader must remove the folder that claude ran in, but $folder is still there."
  fi
}

# Checks the record of the pages read, with no hash for no record: expect_record <description> [<hash>...]
expect_record() {
  local description=$1 expected="" recorded=""
  shift
  if (($# > 0)); then
    expected=$(printf '%s\n' "$@")
  fi
  case_count=$((case_count + 1))
  if [[ -f $pages_read ]]; then
    recorded=$(<"$pages_read")
  fi
  if [[ $recorded != "$expected" ]]; then
    fail_case "$description, the record of the pages read must hold \"$expected\", but it holds \"$recorded\"."
  fi
}

new_case 0
run_fresh_reader "$reader" docs/expenses.md
expect_result "When claude answers" succeeds "The reader's answer from run 1"
expect_calls "When claude answers" "$claude_arguments"
expect_input "When claude answers" "$prompt"$'\n\n'"$page_text"
expect_empty_temporary_folder "When claude answers"
# The hash that the page has in the commit with its content
page_hash=$(git -C "$base/project" rev-parse HEAD:docs/expenses.md)
expect_record "When claude answers" "$page_hash"

new_case 1
run_fresh_reader "$reader" docs/expenses.md
expect_result "When claude fails once" succeeds "The reader's answer from run 2"
expect_calls "When claude fails once" "$claude_arguments"$'\n'"$claude_arguments"
expect_input "When claude fails once" "$prompt"$'\n\n'"$page_text"
expect_empty_temporary_folder "When claude fails once"
expect_record "When claude fails once" "$page_hash"

new_case 2
run_fresh_reader "$reader" docs/expenses.md
expect_result "When claude fails twice" fails \
  "error: can't get the reader's answer, because claude failed twice. The second time, it exited with code 1 and printed: API Error: the error of run 2"
expect_calls "When claude fails twice" "$claude_arguments"$'\n'"$claude_arguments"
expect_record "When claude fails twice"

# A folder where the record belongs makes the record impossible to write. Between the answer and the script's error,
# bash prints its own error, which names the script's line.
new_case 0
mkdir "$pages_read"
run_fresh_reader "$reader" docs/expenses.md
case_count=$((case_count + 1))
record_error="error: the reader answered, but scripts/fresh-reader can't record in $pages_read that the reader read docs/expenses.md, and the hooks block a pull request that adds or rewrites text in the page, and an issue or pull request with the page as its body, without that record. Fix the error above, and run scripts/fresh-reader again."
if ((status == 0)) || [[ $output != "The reader's answer from run 1"$'\n'*$'\n'"$record_error" ]]; then
  fail_case "When the record can't be written, scripts/fresh-reader must exit with a code other than 0, and print the reader's answer first and \"$record_error\" last, but it exited with code $status and printed \"$output\"."
fi

new_case 2
error_on_stderr=yes
run_fresh_reader "$reader" docs/expenses.md
expect_result "When claude fails twice with an error on its error output" fails \
  "error: can't get the reader's answer, because claude failed twice. The second time, it exited with code 1 and printed: Error: the error of run 2"

saved_answer="A reader already read this page as it is now, and answered:"$'\n'"The reader's answer from run 1"
new_case 0
run_fresh_reader "$reader" docs/expenses.md
run_fresh_reader "$reader" docs/expenses.md
expect_result "When the same reader reads the page again" succeeds "$saved_answer"
expect_calls "When the same reader reads the page again" "$claude_arguments"
rm "$pages_read"
run_fresh_reader "$reader" docs/expenses.md
expect_result "When the same reader reads the page again after the record is gone" succeeds "$saved_answer"
expect_record "When the same reader reads the page again after the record is gone" "$page_hash"

new_case 0
run_fresh_reader "$reader" docs/expenses.md
run_fresh_reader "a developer who wants to export what they spend" docs/expenses.md
expect_result "When another reader reads the page" succeeds "The reader's answer from run 2"

new_case 0
run_fresh_reader "$reader" docs/expenses.md
printf '%s\n' "Run \`expenses list\` to see them." >>"$base/project/docs/expenses.md"
run_fresh_reader "$reader" docs/expenses.md
expect_result "When the page changed since the reader read it" succeeds "The reader's answer from run 2"
git -C "$base/project" checkout --quiet -- docs/expenses.md

new_case 2
run_fresh_reader "$reader" docs/expenses.md
run_fresh_reader "$reader" docs/expenses.md
expect_result "When claude failed twice on the page before" succeeds "The reader's answer from run 3"

# A file where the folder of the answers belongs makes the answer impossible to save.
new_case 0
printf '%s\n' "not a folder" >"$answers"
run_fresh_reader "$reader" docs/expenses.md
case_count=$((case_count + 1))
save_error="error: the reader answered, but scripts/fresh-reader can't save the answer in $answers, so the next run on the page as it is now would ask a new reader. Fix the error above."
if ((status == 0)) || [[ $output != "The reader's answer from run 1"$'\n'*$'\n'"$save_error" ]]; then
  fail_case "When the answer can't be saved, scripts/fresh-reader must exit with a code other than 0, and print the reader's answer first and \"$save_error\" last, but it exited with code $status and printed \"$output\"."
fi
expect_record "When the answer can't be saved" "$page_hash"

new_case 0
run_fresh_reader
expect_result "When it gets no argument" fails \
  "error: scripts/fresh-reader takes two arguments, the page's reader and the page's path, as in scripts/fresh-reader \"a developer who wants to use this project\" README.md, and a third one, the path of the posted version, when the page replaces one. It got 0."
expect_calls "When it gets no argument" ""

new_case 0
run_fresh_reader docs/expenses.md
expect_result "When it gets only the page" fails \
  "error: scripts/fresh-reader takes two arguments, the page's reader and the page's path, as in scripts/fresh-reader \"a developer who wants to use this project\" README.md, and a third one, the path of the posted version, when the page replaces one. It got 1."
expect_calls "When it gets only the page" ""

new_case 0
run_fresh_reader "$reader" docs/expenses.md docs/expenses.md "a fourth argument"
expect_result "When it gets four arguments" fails \
  "error: scripts/fresh-reader takes two arguments, the page's reader and the page's path, as in scripts/fresh-reader \"a developer who wants to use this project\" README.md, and a third one, the path of the posted version, when the page replaces one. It got 4."
expect_calls "When it gets four arguments" ""

new_case 0
run_fresh_reader "$reader" docs/expenses.md posted.md
expect_result "When the posted version doesn't exist" fails \
  "error: posted.md isn't a file. Give the path of a file with the posted version, such as the one that gh pr view <number> --json body --jq .body writes."
expect_calls "When the posted version doesn't exist" ""
expect_record "When the posted version doesn't exist"

new_case 0
run_fresh_reader "$reader" docs/missing.md
expect_result "When the page doesn't exist" fails \
  "error: docs/missing.md isn't a file. Give the page's path, such as README.md."
expect_calls "When the page doesn't exist" ""
expect_record "When the page doesn't exist"

new_case 0
printf '%s\n' "Each expense that you add goes to the file \$HOME/expenses.csv." >>"$base/project/docs/expenses.md"
run_fresh_reader "$reader" docs/expenses.md
expect_result "When the page has a new sentence that repeats an older one" succeeds "The reader's answer from run 1"
expect_input "When the page has a new sentence that repeats an older one" \
  "$prompt_with_new_lines"$'\n\n'"$page_text"$'\n'"Each expense that you add goes to the file \$HOME/expenses.csv."$'\n\n'"The lines that the change added or rewrote:"$'\n\n'"Each expense that you add goes to the file \$HOME/expenses.csv."
expect_record "When the page has a change that isn't committed" "$(git -C "$base/project" hash-object docs/expenses.md)"
# A second page adds a line to the record.
printf '%s\n' "# Import a bank file" >"$base/project/docs/import.md"
run_fresh_reader "$reader" docs/import.md
expect_record "When the reader reads a second page" "$(git -C "$base/project" hash-object docs/expenses.md docs/import.md)"
rm "$base/project/docs/import.md"
git -C "$base/project" checkout --quiet -- docs/expenses.md

# A page that doesn't end in one line break adds a second line: the hash of its text with one line break at the end,
# which a body with that text gets.
new_case 0
printf '%s' "$page_text" >"$base/project/body.md"
printf '%s\n' "$page_text" >"$base/one-line-break.md"
run_fresh_reader "$reader" body.md
expect_record "When the page ends in no line break" "$(git -C "$base/project" hash-object body.md)" \
  "$(git hash-object "$base/one-line-break.md")"
rm "$base/project/body.md" "$base/one-line-break.md"

# The branch rewrites the page's heading and commits it. Then main rewrites the last line, which the branch still has
# as it was, so that line isn't new.
new_case 0
sed 's/^# Record what you spend$/# Record your expenses/' "$base/project/docs/expenses.md" >"$base/edited.md"
mv "$base/edited.md" "$base/project/docs/expenses.md"
commit_all "docs: rename the expenses page"
branch_text=$(<"$base/project/docs/expenses.md")
git -C "$base/project" switch --quiet main
printf '%s\n' "# Record what you spend" "" "Run \`expenses add 12.50 lunch\` to add an expense." >"$base/project/docs/expenses.md"
commit_all "docs: shorten the expenses page"
git -C "$base/project" update-ref refs/remotes/origin/main HEAD
git -C "$base/project" switch --quiet 12-change
run_fresh_reader "$reader" docs/expenses.md
expect_input "When the branch rewrote a line and main changed another one since" \
  "$prompt_with_new_lines"$'\n\n'"$branch_text"$'\n\n'"The lines that the change added or rewrote:"$'\n\n'"# Record your expenses"

new_case 0
printf '%s\n' "# Import a bank file" >"$base/project/docs/import.md"
run_fresh_reader "$reader" docs/import.md
expect_input "When main doesn't have the page and git doesn't track it" "$prompt"$'\n\n'"# Import a bank file"

new_case 0
commit_all "docs: add the import page"
run_fresh_reader "$reader" docs/import.md
expect_input "When main doesn't have the page and the branch added it" "$prompt"$'\n\n'"# Import a bank file"

# The branch renames the page with git mv, and adds a line that it doesn't commit.
new_case 0
git -C "$base/project" mv docs/expenses.md docs/spending.md
printf '%s\n' "Run \`expenses list\` to see them." >>"$base/project/docs/spending.md"
renamed_text=$(<"$base/project/docs/spending.md")
renamed_input="$prompt_with_new_lines"$'\n\n'"$renamed_text"$'\n\n'"The lines that the change added or rewrote:"$'\n\n'"# Record your expenses"$'\n'"Run \`expenses list\` to see them."
run_fresh_reader "$reader" docs/spending.md
expect_input "When the branch renamed the page and didn't commit it" "$renamed_input"

new_case 0
commit_all "docs: rename the expenses page to spending"
run_fresh_reader "$reader" docs/spending.md
expect_input "When the branch renamed the page and committed it" "$renamed_input"

# The branch and another branch each add a line at the end of the page, and the branch merges the other one, which
# stops with a conflict in the page. git lists such a page once for each stage of the conflict, up
# to three times, until it's staged.
new_case 0
before_conflict=$(git -C "$base/project" rev-parse HEAD)
git -C "$base/project" switch --quiet --create 13-export
printf '%s\n' "Run \`expenses export\` to save them as CSV." >>"$base/project/docs/spending.md"
commit_all "docs: say how to export expenses"
git -C "$base/project" switch --quiet 12-change
printf '%s\n' "Run \`expenses total\` to see what you spent." >>"$base/project/docs/spending.md"
commit_all "docs: say how to total expenses"
if git -C "$base/project" -c user.name=test -c user.email=test@example.com merge --quiet 13-export >/dev/null; then
  fail_case "When the branch merges 13-export, git must stop with a conflict in docs/spending.md, but it merged."
fi
printf '%s\n' "$renamed_text" "Run \`expenses total\` to see what you spent." "Run \`expenses export\` to save them as CSV." \
  >"$base/project/docs/spending.md"
resolved_input="$prompt_with_new_lines"$'\n\n'"$(<"$base/project/docs/spending.md")"$'\n\n'"The lines that the change added or rewrote:"$'\n\n'"# Record your expenses"$'\n'"Run \`expenses list\` to see them."$'\n'"Run \`expenses total\` to see what you spent."$'\n'"Run \`expenses export\` to save them as CSV."
run_fresh_reader "$reader" docs/spending.md
expect_result "When the page has a merge conflict that isn't staged" succeeds "The reader's answer from run 1"
expect_input "When the page has a merge conflict that isn't staged" "$resolved_input"
new_case 0
git -C "$base/project" add docs/spending.md
run_fresh_reader "$reader" docs/spending.md
expect_input "When the resolution of the page's merge conflict is staged" "$resolved_input"
git -C "$base/project" merge --abort
git -C "$base/project" reset --quiet --hard "$before_conflict"

new_case 0
printf '%s\n' "# Notes" >"$base/notes.md"
run_fresh_reader "$reader" "$base/notes.md"
expect_result "When the page is outside the repository" succeeds "The reader's answer from run 1"
expect_input "When the page is outside the repository" "$prompt"$'\n\n'"# Notes"

new_case 0
run_folder=$base
run_fresh_reader "$reader" notes.md
expect_result "When the folder isn't in a git repository" succeeds "The reader's answer from run 1"
expect_input "When the folder isn't in a git repository" "$prompt"$'\n\n'"# Notes"
run_fresh_reader "$reader" notes.md
expect_result "When the same reader reads the page again outside a git repository" succeeds \
  "The reader's answer from run 2"

# A new description of a pull request rewrites the first line of the posted one, keeps the second and adds a third. The
# reader gets the lines that it adds or rewrites compared with the posted one, outside a repository and in one whose
# branch doesn't change the description.
posted_description=$(printf '%s\n' "Skips the expenses that an import already added." "It compares the date and the amount.")
description=$(printf '%s\n' "Skips the expenses that an earlier import added." "It compares the date and the amount." \
  "It leaves an expense in a foreign currency out of the total.")
description_input="$prompt_with_new_lines"$'\n\n'"$description"$'\n\n'"The lines that the change added or rewrote:"$'\n\n'"Skips the expenses that an earlier import added."$'\n'"It leaves an expense in a foreign currency out of the total."
printf '%s\n' "$posted_description" >"$base/posted.md"
printf '%s\n' "$description" >"$base/description.md"
new_case 0
run_folder=$base
run_fresh_reader "$reader" description.md posted.md
expect_result "When a new description outside a repository replaces a posted one" succeeds "The reader's answer from run 1"
expect_input "When a new description outside a repository replaces a posted one" "$description_input"
new_case 0
run_fresh_reader "$reader" "$base/description.md" "$base/posted.md"
expect_input "When a new description in a repository replaces a posted one" "$description_input"
expect_record "When a new description in a repository replaces a posted one" "$(git hash-object "$base/description.md")"
new_case 0
run_fresh_reader "$reader" "$base/posted.md" "$base/posted.md"
expect_input "When the new description is the posted one" "$prompt"$'\n\n'"$posted_description"
# A page that the branch changed gets the lines that it adds compared with the posted version, not with main.
new_case 0
run_fresh_reader "$reader" docs/spending.md "$base/description.md"
expect_input "When the branch changed the page and a posted version is given" \
  "$prompt_with_new_lines"$'\n\n'"$renamed_text"$'\n\n'"The lines that the change added or rewrote:"$'\n\n'"$renamed_text"

new_case 0
git -C "$base/project" update-ref -d refs/remotes/origin/main
run_fresh_reader "$reader" docs/spending.md
expect_result "When the repository has no origin/main" succeeds "The reader's answer from run 1"
expect_input "When the repository has no origin/main" "$prompt"$'\n\n'"$renamed_text"

if ((failed_cases > 0)); then
  echo "error: $failed_cases of the $case_count cases in scripts/fresh-reader.test failed. The errors above say which." >&2
  exit 1
fi
echo "scripts/fresh-reader.test passed. Cases: $case_count."
