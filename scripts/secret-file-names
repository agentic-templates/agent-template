# shellcheck shell=bash
# The function has_secret_name, which scripts/clear-worktrees and scripts/loop/run-builder use to keep a file that may
# hold a secret out of a commit.

# Succeeds if a file's name suggests that the file holds a secret: has_secret_name <path>
has_secret_name() {
  local name=${1##*/} result=1
  shopt -s nocasematch
  case $name in
    .env.example) ;;
    .env | .env.* | *.pem | *.key | *.p12 | *.pfx | *.jks | *.keystore | id_rsa | id_dsa | id_ecdsa | id_ed25519 | \
      .netrc | .npmrc | .pypirc | *credential* | *secret* | *password*)
      result=0
      ;;
  esac
  shopt -u nocasematch
  return "$result"
}
