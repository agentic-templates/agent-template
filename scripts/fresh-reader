#!/usr/bin/env bash
# Gives a page to a reader who has seen nothing else, and prints the reader's answer: scripts/fresh-reader <reader> <page>
# <reader> is the page's reader and what they want to do, such as "a developer who wants to use this project", and
# <page> is the page's path. The reader quotes each sentence they had to read twice, each sentence they didn't need,
# and each sentence that repeats another, with the reason. When the page was on origin/main where the branch started,
# under this name or another, the reader also gets the lines that the branch and its uncommitted edits added or rewrote.
# It runs claude -p in an empty temporary folder, with --safe-mode, which keeps the login but turns off CLAUDE.md,
# skills, plugins, hooks and MCP servers, and with no tools. If claude fails, the script runs it once more. If that run
# fails too, it prints claude's error and exits with code 1. Once the reader answers, the script adds git's hash of the
# page to the record of the pages read, in the git folder of the current folder's worktree, as
# scripts/hooks/pages-read.bash describes. Outside a git repository, it records nothing. "Review a changed page with a
# fresh reader" in docs/pages.md runs it, and a hook blocks gh pr create until the record has each page that the pull
# request adds or rewrites text in, as the pull request has it.
set -euo pipefail
# shellcheck source=scripts/hooks/pages-read.bash
source "$(dirname "$0")/hooks/pages-read.bash"

# Prints an error and stops: stop <message>
stop() {
  echo "error: $1" >&2
  exit 1
}

if (($# != 2)); then
  stop "scripts/fresh-reader takes two arguments, the page's reader and the page's path, as in scripts/fresh-reader \"a developer who wants to use this project\" README.md, and it got $#."
fi
reader=$1
page=$2
if [[ ! -f $page ]]; then
  stop "$page isn't a file. Give the page's path, such as README.md."
fi

# Outside a clone with origin/main, or for a page that git doesn't track, the reader gets the whole page and no lines.
# Until the resolution of a merge conflict in the page is staged, git lists the page once for each side of the conflict,
# and --deduplicate lists it once.
new_lines=""
if branch_start=$(git merge-base HEAD origin/main 2>/dev/null) &&
  path=$(git --literal-pathspecs ls-files --full-name --deduplicate -- "$page" 2>/dev/null) && [[ -n $path ]]; then
  # git diff gets no pathspec, because with only the page's new name it can't see a rename, and the renamed page
  # would look new. --diff-filter=MR leaves out a page that the branch's start doesn't have, because all of it is new.
  if ! diff=$(git -c core.quotePath=false diff --no-ext-diff --no-color --no-relative --find-renames --unified=0 --diff-filter=MR \
    "$branch_start" 2>&1); then
    stop "can't compare $page with the branch's start, because git diff failed: $diff"
  fi
  new_lines=$(awk -v page_header="+++ b/$path" '
    /^diff --git / { in_header = 1; is_page = 0; next }
    in_header && $0 == page_header { is_page = 1 }
    in_header && /^@@/ { in_header = 0 }
    !in_header && is_page && /^\+/ { print substr($0, 2) }
  ' <<<"$diff")
fi

prompt="You are $reader. Read this page once, the way that reader would. Quote each sentence you had to read twice, and say what made you stop. Then quote each sentence you didn't need, and say why. Then quote each sentence that says again what another sentence on the page already says, with the sentence it repeats. Leave out sentences that you'd only word differently."
if [[ -z $new_lines ]]; then
  input="$prompt"$'\n\n'"$(<"$page")"
else
  prompt+=" After the page come the lines that a change added or rewrote. Check those lines most closely for a sentence that repeats another."
  input="$prompt"$'\n\n'"$(<"$page")"$'\n\n'"The lines that the change added or rewrote:"$'\n\n'"$new_lines"
fi

# Outside a git repository, git has no folder for the record, and prints an error that the reader of the answer
# doesn't need.
record=""
if record=$(pages_read_path 2>/dev/null); then
  page_hash=$(git hash-object -- "$page")
fi

folder=$(mktemp -d)
trap 'rm -rf "$folder"' EXIT
cd "$folder"

# Runs claude once, and prints what it prints on its output and its error output. claude gets the prompt on its input,
# because --tools takes each argument after it as the name of a tool.
ask_reader() {
  claude -p --safe-mode --tools "" <<<"$input" 2>&1
}

# claude fails with an API error now and then, and a second run usually works.
status=0
answer=$(ask_reader) || answer=$(ask_reader) || status=$?
if ((status != 0)); then
  stop "can't get the reader's answer, because claude failed twice. The second time, it exited with code $status and printed: $answer"
fi
printf '%s\n' "$answer"
if [[ -n $record ]] && ! printf '%s\n' "$page_hash" >>"$record"; then
  stop "the reader answered, but scripts/fresh-reader can't record in $record that the reader read $page, and a hook blocks opening a pull request that adds or rewrites text in the page without that record. Fix the error above, and run scripts/fresh-reader again."
fi
