#!/usr/bin/env bash
# Gives a page to a reader who has seen nothing else, and prints the reader's answer: scripts/fresh-reader <reader> <page>
# <reader> is the page's reader and what they want to do, such as "a developer who wants to use this project", and
# <page> is the page's path. The reader quotes each sentence they had to read twice, each sentence they didn't need,
# and each sentence that repeats another, with the reason. When main has the page, the reader also gets the lines that
# the branch and its uncommitted edits added or rewrote since the branch left origin/main.
# It runs claude -p in an empty temporary folder, with --safe-mode, which keeps the login but turns off CLAUDE.md,
# skills, plugins, hooks and MCP servers, and with no tools. If claude fails, the script runs it once more. If that run
# fails too, it prints claude's error and exits with code 1. "Review a changed page with a fresh reader" in
# docs/pages.md runs it.
set -euo pipefail

# Prints an error and stops: stop <message>
stop() {
  echo "error: $1" >&2
  exit 1
}

if (($# != 2)); then
  stop "scripts/fresh-reader takes two arguments, the page's reader and the page's path, as in scripts/fresh-reader \"a developer who wants to use this project\" README.md, and it got $#."
fi
reader=$1
page=$2
if [[ ! -f $page ]]; then
  stop "$page isn't a file. Give the page's path, such as README.md."
fi

if ! branch_start=$(git merge-base HEAD origin/main 2>&1); then
  stop "can't tell which lines of $page are new, because git can't find where HEAD leaves origin/main. Run scripts/fresh-reader in a clone of the project, after git fetch origin main. git printed: $branch_start"
fi
# A page that main doesn't have is new as a whole, so --diff-filter=M leaves it out, as git diff does for a page that
# git doesn't track. The text before the first @@ names the files, and the lines after it that start with + are new.
if ! diff=$(git diff --no-ext-diff --no-color --unified=0 --diff-filter=M "$branch_start" -- "$page" 2>&1); then
  stop "can't compare $page with main, because git diff failed: $diff"
fi
new_lines=$(awk '/^@@/ { in_hunk = 1; next } in_hunk && /^\+/ { print substr($0, 2) }' <<<"$diff")

prompt="You are $reader. Read this page once, the way that reader would. Quote each sentence you had to read twice, and say what made you stop. Then quote each sentence you didn't need, and say why. Then quote each sentence that says again what another sentence on the page already says, with the sentence it repeats. Leave out sentences that you'd only word differently."
if [[ -z $new_lines ]]; then
  input="$prompt"$'\n\n'"$(<"$page")"
else
  prompt+=" After the page come the lines that a change added or rewrote. Check those lines most closely for a sentence that repeats another."
  input="$prompt"$'\n\n'"$(<"$page")"$'\n\n'"The lines that the change added or rewrote:"$'\n\n'"$new_lines"
fi

folder=$(mktemp -d)
trap 'rm -rf "$folder"' EXIT
cd "$folder"

# Runs claude once, and prints what it prints on its output and its error output. claude gets the prompt on its input,
# because --tools takes each argument after it as the name of a tool.
ask_reader() {
  claude -p --safe-mode --tools "" <<<"$input" 2>&1
}

# claude fails with an API error now and then, and a second run usually works.
status=0
answer=$(ask_reader) || answer=$(ask_reader) || status=$?
if ((status != 0)); then
  stop "can't get the reader's answer, because claude failed twice. The second time, it exited with code $status and printed: $answer"
fi
printf '%s\n' "$answer"
