  "error: .cursorrules makes a tool skip AGENTS.md." \
  "error: AGENTS.override.md makes a tool skip AGENTS.md."
run_case root_only_name_in_a_folder pass

# Cases for the check that finds notes about unfinished work.
# The two words are split here, so that the check doesn't match this file.
todo="TO""DO"
fixme="FIX""ME"

todo_in_a_shell_script() {
  printf '%s\n' '#!/usr/bin/env bash' 'echo "start"' "# $todo: print the total" > "$copy/scripts/unfinished"
  chmod +x "$copy/scripts/unfinished"
}

fixme_in_a_text_file() {
  echo "$fixme the rounding" > "$copy/notes.txt"
}

other_words_and_markdown() {
  echo "todo, ${todo}S and MY_$todo are other words" > "$copy/notes.txt"
  echo "$todo: write this page" > "$copy/docs/page.md"
}

run_case todo_in_a_shell_script fail \
  "scripts/unfinished:3:# $todo: print the total" \
  "error: the lines above hold $todo or $fixme."
run_case fixme_in_a_text_file fail "notes.txt:1:$fixme the rounding"
run_case other_words_and_markdown pass

# Cases for the check that finds paths into a person's home folder.

# Prints each argument on a line of its own, with a person's name in place of <name>.
# The check doesn't take <name> for a name, so this file holds no path into a home folder.
fill_in_name() {
  printf '%s\n' "${@//<name>/ana}"
}

paths_into_home_folders() {
  fill_in_name '/home/<name>/notes' '/Users/<name>/notes' 'C:\Users\<name>\notes' '{"notes": "C:\\Users\\<name>\\notes"}' \
    'c:/users/<name>/notes or /home/<name>/notes' > "$copy/notes.txt"
}

paths_into_no_persons_home_folder() {
  cat > "$copy/notes.txt" <<'EOF'
/home-for-tests/someone
/home/<name>/notes, /home/$USER/notes, /Users/{name}/notes and C:\Users\%USERNAME%\notes
/home/runner/work, /Users/runner/work, C:\Users\runneradmin\work, /home/node/app and /home/linuxbrew/.linuxbrew
/home/vscode/app, /Users/Shared/notes and C:\Users\Public\notes
https://example.com/home/docs/, /users/ana/repos in GitHub's API and src/home/ana/notes
EOF
}

paths_into_home_folders_in_generated_and_vendored_files() {
  local file
  printf '%s\n' 'dist/** linguist-generated' 'api.json linguist-generated=true' 'vendor/** linguist-vendored' \
    'third_party/** linguist-vendored=true' >> "$copy/.gitattributes"
  mkdir -p "$copy/dist" "$copy/vendor" "$copy/third_party"
  for file in dist/app.js api.json vendor/lib.js third_party/lib.js; do
    fill_in_name '/home/<name>/notes' > "$copy/$file"
  done
}

run_case paths_into_home_folders fail \
  "$(fill_in_name 'error: notes.txt:1 holds a path into a home folder, /home/<name>/.') Use a path relative to the repository, or ~ or \$HOME." \
  "$(fill_in_name 'error: notes.txt:2 holds a path into a home folder, /Users/<name>/.')" \
  "$(fill_in_name 'error: notes.txt:3 holds a path into a home folder, C:\Users\<name>\.')" \
  "$(fill_in_name 'error: notes.txt:4 holds a path into a home folder, C:\\Users\\<name>\\.')" \
  "$(fill_in_name 'error: notes.txt:5 holds a path into a home folder, c:/users/<name>/.')" \
  "$(fill_in_name 'error: notes.txt:5 holds a path into a home folder, /home/<name>/.')"
run_case paths_into_no_persons_home_folder pass
run_case paths_into_home_folders_in_generated_and_vendored_files pass

# Cases for the check that limits the size of the AGENTS.md files.

# Writes a file: write_lines <file> <lines> <bytes in each line, with its line ending>
write_lines() {
  local file=$1 lines=$2 bytes=$3 line
  line=$(printf '%*s' $((bytes - 1)) '' | tr ' ' x)
  mkdir -p "$(dirname "$file")"
  for ((written = 0; written < lines; written++)); do
    printf '%s\n' "$line"
  done > "$file"
}

# Adds a line of x's to the end of a file in the copy, so that the file has the given number of bytes:
# pad_to <path in the copy> <bytes>
pad_to() {
  local file=$1 bytes=$2 missing
  missing=$((bytes - $(wc -c < "$copy/$file")))
  if ((missing < 1)); then
    echo "error: $file has $bytes bytes or more, so scripts/test-check can't pad it to $bytes. Raise that size in each case that pads it, and lower the sizes of the other files in the case by as much." >&2
    exit 1
  fi
  printf '%s\n' "$(printf '%*s' $((missing - 1)) '' | tr ' ' x)" >> "$copy/$file"
}

agents_md_of_200_lines() {
  write_lines "$copy/src/AGENTS.md" 200 10
}

agents_md_of_199_lines() {
  write_lines "$copy/src/AGENTS.md" 199 10
}

agents_md_of_25000_bytes() {
  pad_to AGENTS.md 25000
}

agents_md_of_24999_bytes() {
  pad_to AGENTS.md 24999
}

agents_md_files_of_32000_bytes_on_one_path() {
  pad_to AGENTS.md 20000
  write_lines "$copy/src/api/AGENTS.md" 100 120
}

agents_md_files_of_32000_bytes_on_two_paths() {
  pad_to AGENTS.md 20000
  write_lines "$copy/src/AGENTS.md" 100 60
  write_lines "$copy/lib/AGENTS.md" 100 60
}

run_case agents_md_of_200_lines fail \
  "error: src/AGENTS.md has 200 lines, and the limit is 199." \
  "the limit is 199. Move a procedure that only one kind of request needs into a guide of its own."
run_case agents_md_of_199_lines pass
run_case agents_md_of_25000_bytes fail "error: AGENTS.md has 25000 bytes, and the limit is 24999."
run_case agents_md_of_24999_bytes pass
run_case agents_md_files_of_32000_bytes_on_one_path fail "error: the AGENTS.md files from the root down to src/api have 32000 bytes together, and the limit is 31999."
run_case agents_md_files_of_32000_bytes_on_two_paths pass

# Cases for the check that limits the length of every tracked file.

file_of_1001_lines() {
  write_lines "$copy/src/report.py" 1001 10
}

file_of_1000_lines() {
  write_lines "$copy/src/report.py" 1000 10
}

two_long_files() {
  write_lines "$copy/src/report.py" 1001 10
  write_lines "$copy/web/app.js" 1500 10
}

# git counts a file as binary when its first 8,000 bytes hold a zero byte.
long_binary_file() {
  mkdir -p "$copy/assets"
  for ((written = 0; written < 1001; written++)); do
    printf 'x\0\n'
  done > "$copy/assets/logo.png"
}

long_lockfile_in_a_folder() {
  write_lines "$copy/web/package-lock.json" 1001 10
}

long_file_marked_linguist_generated() {
  write_lines "$copy/src/schema.py" 1001 10
  echo "src/schema.py linguist-generated" >> "$copy/.gitattributes"
}

long_file_marked_linguist_vendored() {
  write_lines "$copy/vendor/chart.js" 1001 10
  echo "vendor/** linguist-vendored=true" >> "$copy/.gitattributes"
}

long_file_unmarked_as_generated_and_vendored() {
  write_lines "$copy/src/schema.py" 1001 10
  printf '%s\n' "src/*.py linguist-generated linguist-vendored" "src/schema.py -linguist-generated linguist-vendored=false" >> "$copy/.gitattributes"
}

long_file_listed_with_a_reason() {
  write_lines "$copy/tests/statement.csv" 1001 10
  echo "tests/statement.csv A whole bank statement, to test the import" > "$copy/scripts/long-files"
}

blank_line_in_the_list_of_long_files() {
  write_lines "$copy/tests/statement.csv" 1001 10
  printf '%s\n' "" "tests/statement.csv A whole bank statement, to test the import" "" > "$copy/scripts/long-files"
}

long_file_listed_without_a_reason() {
  write_lines "$copy/tests/statement.csv" 1001 10
  echo "tests/statement.csv" > "$copy/scripts/long-files"
}

listed_file_of_1000_lines() {
  write_lines "$copy/tests/statement.csv" 1000 10
  echo "tests/statement.csv A whole bank statement, to test the import" > "$copy/scripts/long-files"
}

run_case file_of_1001_lines fail "error: src/report.py has 1001 lines, and the limit is 1000. Move a part with its own responsibility into a file of its own."
run_case file_of_1000_lines pass
run_case two_long_files fail \
  "error: src/report.py has 1001 lines, and the limit is 1000." \
  "error: web/app.js has 1500 lines, and the limit is 1000."
run_case long_binary_file pass
run_case long_lockfile_in_a_folder pass
run_case long_file_marked_linguist_generated pass
run_case long_file_marked_linguist_vendored pass
run_case long_file_unmarked_as_generated_and_vendored fail "error: src/schema.py has 1001 lines, and the limit is 1000."
run_case long_file_listed_with_a_reason pass
run_case blank_line_in_the_list_of_long_files pass
run_case long_file_listed_without_a_reason fail "error: scripts/long-files lists tests/statement.csv without a reason. Add a space and the reason after the path."
run_case listed_file_of_1000_lines fail "error: scripts/long-files lists tests/statement.csv, which scripts/check accepts without the list. Remove its line, or fix the path."

# Cases for the checks that scripts are executable and that each check of the hooks has a test.
# The repository as it is has a test without a check, scripts/hooks/session-start.test, and passes.

script_that_isnt_executable() {
  printf '%s\n' '#!/usr/bin/env bash' 'echo "The total is 0."' > "$copy/scripts/total"
}

hook_check_without_a_test() {
  printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$copy/scripts/hooks/example.check"
  chmod +x "$copy/scripts/hooks/example.check"
}

run_case script_that_isnt_executable fail "error: scripts/total starts with #!, and git doesn't record it as executable. Run chmod +x scripts/total as a command of its own, and then commit the change. If git ignores file modes, as it can on Windows, run git update-index --chmod=+x scripts/total instead."
run_case hook_check_without_a_test fail "error: scripts/hooks/example.check has no test. Add scripts/hooks/example.test, which runs the check through scripts/hooks/before-tool, as the other tests in scripts/hooks/ do."

# Cases for the check that finds section names that match no heading.

section_names_in_files_without_those_headings() {
  echo '# Target' > "$copy/docs/target.md"
  cat > "$copy/docs/notes.md" <<'EOF'
See "Target" in docs/target.md, and "No such section" in docs/target.md.
See "No such section" in `docs/target.md`.
See "No such section" in [docs/target.md](target.md).
EOF
}

section_name_with_describes_that_matches_no_heading() {
  printf '%s\n' '# Notes' 'Do it as "No such section" describes.' > "$copy/docs/notes.md"
}

section_name_with_says_that_matches_no_heading_or_field() {
  printf '%s\n' '# Notes' 'Do what "No such section" says.' > "$copy/docs/notes.md"
}

section_name_in_a_file_that_doesnt_exist() {
  echo 'See "Target" in docs/gone.md.' > "$copy/docs/notes.md"
}

form_field_named_with_says() {
  printf '%s\n' 'body:' '  - type: textarea' '    attributes:' '      label: Who needs it' > "$copy/.github/ISSUE_TEMPLATE/idea.yml"
  echo 'Write what "Who needs it" says.' > "$copy/docs/notes.md"
}

section_names_that_match_headings() {
  printf '%s\n' '# Target' '### Section at level 3' > "$copy/docs/target.md"
  cat > "$copy/docs/notes.md" <<'EOF'
# Notes
See "Section at level 3" in docs/target.md, and "Target" in `docs/target.md`.
See "Target" in [docs/target.md](target.md), as "Notes" describes.
Put "read `docs/target.md` first" in each prompt.
EOF
}

run_case section_names_in_files_without_those_headings fail \
  'error: docs/notes.md:1 names "No such section" in docs/target.md, which has no such heading. Fix the name, or the heading.' \
  'error: docs/notes.md:2 names "No such section" in docs/target.md, which has no such heading.' \
  'error: docs/notes.md:3 names "No such section" in docs/target.md, which has no such heading.'
run_case section_name_with_describes_that_matches_no_heading fail 'error: docs/notes.md:2 names "No such section", which matches no heading in docs/notes.md and no field label in .github/ISSUE_TEMPLATE/. Fix the name, or the heading.'
run_case section_name_with_says_that_matches_no_heading_or_field fail 'error: docs/notes.md:2 names "No such section", which matches no heading in docs/notes.md and no field label in .github/ISSUE_TEMPLATE/.'
run_case section_name_in_a_file_that_doesnt_exist fail "error: docs/notes.md:1 names \"Target\" in docs/gone.md, which doesn't exist. Write the path from the repository's root to the file."
run_case form_field_named_with_says pass
run_case section_names_that_match_headings pass

# Cases for the check of the prose in Markdown files.

# The lines that break a rule come after two code blocks, so that a code block that doesn't end would hide them.
prose_that_breaks_each_rule() {
  cat > "$copy/docs/page.md" <<'EOF'
# Page

```bash
total=0; echo "pages 10 - 20"
```

1. Add the expenses:

   ```bash
   total=0; echo "pages 10 - 20"
   ```

The app totals the month; it also exports it.
The app totals the month — it also exports it.
The app totals the month – it also exports it.
pages 10 - 20
[Click here](https://example.com)
Read the guide: [CLICK HERE][guide].

[guide]: https://example.com
EOF
}

markdown_that_follows_the_prose_rules() {
  cat > "$copy/docs/page.md" <<'EOF'
# Page

- A list item that starts with a dash.
  - A list item in a list item.

Run `total=0; echo "$total"` or ``echo "pages 10 - 20 `30`"``, as [the guide](https://example.com/totals?month=1;year=2026 "Totals [2026]; pages 10 - 20") says.
Two&nbsp;words, an <span title="a; b">HTML tag</span> and a comment. <!-- Totals; pages 10 - 20 -->
Don't write "click here" as a link's text.

1. Add the expenses:

   ```bash
   total=0; echo "pages 10 - 20"
   ```

~~~~text
```
total=0; echo "pages 10 - 20"
```
~~~~

[guide]: https://example.com/totals?month=1;year=2026 "Totals; pages 10 - 20"
EOF
}

semicolons_in_generated_and_vendored_files() {
  printf '%s\n' 'CHANGELOG.md linguist-generated' 'vendor/** linguist-vendored' >> "$copy/.gitattributes"
  mkdir -p "$copy/vendor/chart"
  echo "The app totals the month; it also exports it." > "$copy/CHANGELOG.md"
  echo "The app totals the month; it also exports it." > "$copy/vendor/chart/README.md"
}

run_case prose_that_breaks_each_rule fail \
  'error: docs/page.md:13 has a semicolon in prose. Write two sentences, as "Write clear sentences" in docs/writing.md says.' \
  'error: docs/page.md:14 has a dash between words in prose. If it joins two sentences, write two sentences, as "Write clear sentences" in docs/writing.md says. Otherwise, replace it with a word, as in "pages 10 to 20".' \
  'error: docs/page.md:15 has a dash between words in prose.' \
  'error: docs/page.md:16 has a dash between words in prose.' \
  'error: docs/page.md:17 has a link whose text is "click here". Make the link text name the page it opens, as "Organize a page" in docs/pages.md says.' \
  'error: docs/page.md:18 has a link whose text is "click here".'
run_case markdown_that_follows_the_prose_rules pass
run_case semicolons_in_generated_and_vendored_files pass

# Case for the place where setup adds the project's checks, which the copies skip.

# The last line of the comment in scripts/check that marks the place.
project_checks_comment="# Keep this comment after setup, because a case in scripts/test-check finds the place by it."

# Puts a command that fails right after the comment.
project_check_that_fails() {
  local line found_comment=""
  local -a lines=()
  while IFS= read -r line; do
    lines+=("$line")
    if [[ $line == *"$project_checks_comment"* ]]; then
      lines+=(false)
      found_comment=yes
    fi
  done < "$copy/scripts/check"
  if [[ -z "$found_comment" ]]; then
    echo "error: in the case project_check_that_fails, can't find the line \"$project_checks_comment\" in scripts/check. Put the comment that ends with this line back at the top of the block that runs only when CHECK_UNDER_TEST is unset." >&2
    exit 1
  fi
  printf '%s\n' "${lines[@]}" > "$copy/scripts/check"
}

run_case project_check_that_fails pass

# Add a case for each check in scripts/check here.

if ((failed_cases > 0)); then
  echo "error: $failed_cases of the $case_count cases in scripts/test-check failed. The errors above say which." >&2
  exit 1
fi
echo "scripts/test-check passed. Cases: $case_count."
