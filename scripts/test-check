#!/usr/bin/env bash
# Tests scripts/check. Each case runs it on a copy of the repository. scripts/test-scripts runs this script.
set -euo pipefail
cd "$(dirname "$0")/.."

# scripts/test-scripts also runs the real ShellCheck cases, with --shellcheck-only.
shellcheck_only=""
if (($# > 0)); then
  if [[ $# != 1 || $1 != --shellcheck-only ]]; then
    echo "usage: scripts/test-check [--shellcheck-only]" >&2
    exit 2
  fi
  shellcheck_only=yes
fi

copy=""
failed_cases=0
case_count=0
# A case sets this to make the copy's scripts/check skip the tests of the scripts and hooks, with SKIP_SCRIPT_TESTS.
skip_script_tests=""

# Only --shellcheck-only runs real ShellCheck. The other cases test what scripts/check finds by itself.
# Stand-ins for skipped tools come first on each copy's PATH and fail if a copy runs one.
stand_ins=$(mktemp -d)
for tool in shellcheck actionlint zizmor; do
  if [[ $tool == shellcheck && -n $shellcheck_only ]]; then
    continue
  fi
  printf '%s\n' '#!/usr/bin/env bash' "echo \"error: the copy ran $tool, and the copies that scripts/test-check makes must skip it.\" >&2" \
    'exit 1' > "$stand_ins/$tool"
  chmod +x "$stand_ins/$tool"
done

remove_copy() {
  if [[ -n "$copy" ]]; then
    rm -rf "$copy"
  fi
}
trap 'remove_copy; rm -rf "$stand_ins"' EXIT

# Copies the tracked files, as they are on disk, into a new git repository at $copy.
make_copy() {
  remove_copy
  copy=$(mktemp -d)
  # -f skips the submodules and deleted files that git ls-files also lists.
  git ls-files -z | while IFS= read -r -d '' file; do
    if [[ -f $file ]]; then
      mkdir -p "$copy/$(dirname "$file")"
      cp -p "$file" "$copy/$file"
    fi
  done
  git -C "$copy" init --quiet
}

# Checks that scripts/check recorded the tree of the copy's files in .git/check-passed if it passed, and nothing if it failed
# or skipped the tests of the scripts and hooks because of SKIP_SCRIPT_TESTS.
# Every file of the copy is staged, so the tree of the index is the tree of the files on disk.
# Prints an error and fails if the record is wrong: check_record <function> <pass or fail>
check_record() {
  local case_function=$1 result=$2 record=$copy/.git/check-passed tree reason=""
  if [[ $result == fail ]]; then
    reason="failed"
  elif [[ -n $skip_script_tests ]]; then
    reason="skipped the tests of the scripts and hooks"
  fi
  if [[ -n $reason ]]; then
    if [[ -f $record ]]; then
      echo "error: in the case $case_function, scripts/check $reason, so it must not write .git/check-passed, but it did." >&2
      return 1
    fi
    return 0
  fi
  tree=$(git -C "$copy" write-tree)
  if [[ ! -f $record ]]; then
    echo "error: in the case $case_function, scripts/check passed, so it must write the tree of the files it checked, $tree, to .git/check-passed, but it wrote no such file." >&2
    return 1
  fi
  if [[ $(< "$record") != "$tree" ]]; then
    echo "error: in the case $case_function, scripts/check passed, so .git/check-passed must hold the tree of the files it checked, $tree, but it holds: $(< "$record")" >&2
    return 1
  fi
}

# Runs one case: run_case <function> <pass or fail> [<text that the output must hold>...]
# The function gets a fresh copy at $copy, and adds the files that the case needs to it.
run_case() {
  local case_function=$1 expected=$2 text output actual=pass check_under_test=1
  shift 2
  if [[ -n $shellcheck_only ]]; then
    if [[ $case_function != shellcheck_* && $case_function != project_check_that_fails ]]; then
      return
    fi
    check_under_test=shellcheck
  elif [[ $case_function == shellcheck_* ]]; then
    return
  fi
  case_count=$((case_count + 1))
  make_copy
  skip_script_tests=""
  "$case_function"
  git -C "$copy" add --all
  # CHECK_UNDER_TEST stops the copy's scripts/check from running this script again.
  if ! output=$(cd "$copy" && CHECK_UNDER_TEST=$check_under_test SKIP_SCRIPT_TESTS=$skip_script_tests PATH=$stand_ins:$PATH \
    scripts/check 2>&1); then
    actual=fail
  fi

  if [[ $actual != "$expected" ]]; then
    echo "error: in the case $case_function, scripts/check must $expected, but the result was: $actual. Its output:" >&2
    printf '%s\n' "$output" >&2
    failed_cases=$((failed_cases + 1))
    return
  fi
  if ! check_record "$case_function" "$actual"; then
    failed_cases=$((failed_cases + 1))
    return
  fi
  for text in "$@"; do
    if [[ $output != *"$text"* ]]; then
      echo "error: in the case $case_function, the output of scripts/check must hold \"$text\". Its output:" >&2
      printf '%s\n' "$output" >&2
      failed_cases=$((failed_cases + 1))
    fi
  done
}

# Replaces each copy of a text in a file of the copy: replace_text <file> <text> <new text>
# Stops the tests if the file doesn't hold the text, because the case would then test nothing.
replace_text() {
  local file=$1 text=$2 new_text=$3 content replaced=""
  content=$(<"$copy/$file")
  if [[ $content != *"$text"* ]]; then
    echo "error: in the case ${FUNCNAME[1]}, can't find \"$text\" in $file. Change the case to match the file." >&2
    exit 1
  fi
  while [[ $content == *"$text"* ]]; do
    replaced+=${content%%"$text"*}$new_text
    content=${content#*"$text"}
  done
  printf '%s\n' "$replaced$content" > "$copy/$file"
}

# A project may already use a fixture's filename or check name.
unused_workflow_path() {
  local path=.github/workflows/$1.yml number=0
  while [[ -e $path ]]; do
    number=$((number + 1))
    path=.github/workflows/$1-$number.yml
  done
  printf '%s\n' "$path"
}
fixture_workflow=$(unused_workflow_path test-check)

repository_as_it_is() {
  :
}

run_case repository_as_it_is pass

# These cases run only with --shellcheck-only, which scripts/test-scripts uses only where shellcheck is installed,
# so the bash-3-2 job needs no external linters.
shellcheck_fixture=scripts/shellcheck-fixture
while [[ -e $shellcheck_fixture ]]; do
  shellcheck_fixture=$shellcheck_fixture-fixture
done

shellcheck_repository_as_it_is() {
  :
}

shellcheck_unquoted_variable() {
  cat > "$copy/$shellcheck_fixture" <<'SCRIPT'
#!/usr/bin/env bash
value='two words'
printf '%s\n' $value
SCRIPT
  chmod +x "$copy/$shellcheck_fixture"
}

run_case shellcheck_repository_as_it_is pass
run_case shellcheck_unquoted_variable fail \
  "$shellcheck_fixture" \
  "SC2086"

# Case for the record of a pass, which run_case checks in every case.

record_that_cant_be_written() {
  mkdir "$copy/.git/check-passed"
}

run_case record_that_cant_be_written fail "error: the checks passed, but scripts/check can't record the pass in .git/check-passed, and a hook blocks opening a pull request without that record."

# Cases for SKIP_SCRIPT_TESTS, which makes scripts/check skip the tests of the scripts and hooks.
# run_case checks that scripts/check records no pass then.

script_tests_skipped() {
  skip_script_tests=1
}

claude_md_with_the_script_tests_skipped() {
  skip_script_tests=1
  echo "Rules" > "$copy/CLAUDE.md"
}

run_case script_tests_skipped pass "Skipped the tests of the scripts and hooks because SKIP_SCRIPT_TESTS is set."
run_case claude_md_with_the_script_tests_skipped fail "error: CLAUDE.md makes a tool skip AGENTS.md."

# Cases for the check that each action pinned to a commit SHA has a version comment.

checkout_sha=3d3c42e5aac5ba805825da76410c181273ba90b1

# Writes a separate workflow, with a step that checks out the code. The step's uses: line is line 8:
# write_checkout_workflow <uses: line>
write_checkout_workflow() {
  printf '%s\n' "name: Lint" "on: pull_request" "permissions: {}" "jobs:" "  lint:" "    runs-on: ubuntu-latest" "    steps:" \
    "      - $1" "        with:" "          persist-credentials: false" > "$copy/$fixture_workflow"
}

pinned_action_without_a_comment() {
  write_checkout_workflow "uses: actions/checkout@$checkout_sha"
}

pinned_action_with_a_comment_that_isnt_a_version() {
  write_checkout_workflow "uses: actions/checkout@$checkout_sha # pinned"
}

pinned_action_without_a_comment_in_a_composite_action() {
  mkdir -p "$copy/.github/actions/setup"
  printf '%s\n' "name: Setup" "description: Checks out the code." "runs:" "  using: composite" "  steps:" \
    "    - uses: actions/checkout@$checkout_sha" "      with:" "        persist-credentials: false" > "$copy/.github/actions/setup/action.yaml"
}

pinned_action_with_a_version_comment_in_quotes() {
  write_checkout_workflow "uses: \"actions/checkout@$checkout_sha\" # v7.0.1"
}

run_case pinned_action_without_a_comment fail "error: $fixture_workflow:8 pins actions/checkout to a commit SHA without a version comment. Write the version that the SHA pins in a comment after it, as in \"# v5.0.0\"."
run_case pinned_action_with_a_comment_that_isnt_a_version fail "error: $fixture_workflow:8 pins actions/checkout to a commit SHA without a version comment."
run_case pinned_action_without_a_comment_in_a_composite_action fail 'error: .github/actions/setup/action.yaml:6 pins actions/checkout to a commit SHA without a version comment.'
run_case pinned_action_with_a_version_comment_in_quotes pass

