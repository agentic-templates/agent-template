#!/usr/bin/env bash
# Runs the hooks' tests, the .test files in scripts/hooks/, at the same time, because one after another they take
# minutes. It prints each test's output once the test ends, in the order of the tests' names, so that the outputs
# don't mix. It fails if a test fails. scripts/test-scripts runs it.
set -euo pipefail
cd "$(dirname "$0")/.."

outputs=$(mktemp -d)

# Stops each test that still runs, and removes the outputs.
# A test that runs in the background ignores Ctrl-C, so without this it would go on running after the script stops.
stop_tests() {
  local process_id
  for process_id in $(jobs -pr); do
    kill "$process_id" 2>/dev/null || true
  done
  rm -rf "$outputs"
}
trap stop_tests EXIT

hook_tests=(scripts/hooks/*.test)
process_ids=()
for ((index = 0; index < ${#hook_tests[@]}; index++)); do
  "${hook_tests[index]}" >"$outputs/$index.out" 2>"$outputs/$index.err" &
  process_ids+=("$!")
done

found_failed_test=""
for ((index = 0; index < ${#hook_tests[@]}; index++)); do
  if ! wait "${process_ids[index]}"; then
    found_failed_test=yes
  fi
  cat "$outputs/$index.out"
  cat "$outputs/$index.err" >&2
done
if [[ -n "$found_failed_test" ]]; then
  exit 1
fi
