# shellcheck shell=bash
# The main checkout, the loop's folder, which holds the orchestrator's state file and the log of the hooks' blocks,
# state_field, which reads a line of the state file, is_orchestrators_session, which tells whether the file names a
# session, and compaction_record, which names the file that records what started a session's compaction. The hooks in
# scripts/hooks read them from here, and scripts/loop/paths.py finds the same folders for the Python scripts.

# Prints the main checkout, which holds the git folder that its worktrees share. A repository that keeps its git
# folder elsewhere, as a submodule does, has no such checkout, so its main checkout is the checkout itself:
# main_checkout <shared git folder> <checkout>
main_checkout() {
  if [[ $1 == */.git ]]; then
    printf '%s\n' "${1%/.git}"
  else
    printf '%s\n' "$2"
  fi
}

# Prints the loop's folder: the folder that LOOP_DIR names, as in the tests, or else .loop in the main checkout, so
# that every worktree finds the same folder: loop_folder <shared git folder> <checkout>
loop_folder() {
  if [[ -n ${LOOP_DIR:-} ]]; then
    printf '%s\n' "$LOOP_DIR"
  else
    printf '%s/.loop\n' "$(main_checkout "$1" "$2")"
  fi
}

# Prints the first word after "<name>:" on the first line of the state file that starts with it:
# state_field <state file> <name>
state_field() {
  awk -v name="$2:" 'index($0, name) == 1 { $0 = substr($0, length(name) + 1); print $1; exit }' "$1"
}

# Succeeds if the state file in a loop's folder names a session as the orchestrator's, on its session: line:
# is_orchestrators_session <loop folder> <session id>
is_orchestrators_session() {
  [[ -n $2 && -f $1/state.md && $(state_field "$1/state.md" session) == "$2" ]]
}

# Prints the file in which scripts/hooks/before-compact records what started a session's compaction, auto or manual,
# for scripts/hooks/session-start: compaction_record <loop folder> <session id>
# It fails for a session id that isn't a word of letters, digits, - and _, because an id such as ../state.md would
# name another file, which session-start would delete.
compaction_record() {
  if [[ ! $2 =~ ^[A-Za-z0-9_-]+$ ]]; then
    return 1
  fi
  printf '%s/compactions/%s\n' "$1" "$2"
}
