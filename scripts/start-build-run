#!/usr/bin/env bash
# Frees the issues of earlier builders when the orchestrator starts the loop, as step 4 of "Start the loop or
# take it over" in docs/loop.md describes:
# - It removes the current account from each ready issue assigned to it, unless scripts/pull-request-state prints
#   merging or stopped for the issue. It prints each issue it leaves assigned, with that state.
# - Then it runs scripts/clear-worktrees, which frees the branch of each ready issue that a leftover worktree holds.
#   It prints what that script prints, and exits with that script's exit code.
# It stops with an error, and exits with code 1, when gh fails. It asks gh about the repository of this checkout,
# or the one in GH_REPO.
set -euo pipefail
cd "$(dirname "$0")/.."

# Prints an error and stops: stop <message>
stop() {
  echo "error: $1" >&2
  exit 1
}

if ! assigned_issues=$(gh issue list --label ready --assignee @me --limit 200 --json number --jq '.[].number' 2>&1); then
  stop "can't list the ready issues assigned to you, because gh failed: $assigned_issues"
fi
for issue in $assigned_issues; do
  # scripts/pull-request-state prints its own error.
  if ! state=$(scripts/pull-request-state "$issue"); then
    exit 1
  fi
  if [[ $state == merging || $state == stopped ]]; then
    echo "Left issue #$issue assigned to you, because scripts/pull-request-state prints $state for it."
    continue
  fi
  if ! answer=$(gh issue edit "$issue" --remove-assignee @me 2>&1); then
    stop "can't remove your assignment from issue #$issue, because gh failed: $answer"
  fi
done

scripts/clear-worktrees
