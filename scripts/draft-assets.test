#!/usr/bin/env bash
# Runs the test workflow's shell steps with local Git history and a stand-in for GitHub's API.
set -euo pipefail
cd "$(dirname "$0")/.."
base=$(mktemp -d)
trap 'rm -rf "$base"' EXIT
fixture=scripts/fixtures/draft-assets.yml
if command -v actionlint >/dev/null; then
  actionlint "$fixture"
fi
if command -v zizmor >/dev/null; then
  zizmor "$fixture"
fi
# Check the job boundary that the local shell runner cannot enforce.
job() {
  awk -v name="$1" '
    $0 == "  " name ":" { found = 1; next }
    found && /^  [a-z]+:/ { exit }
    found { print }
  ' "$fixture"
}
build_job=$(job build)
upload_job=$(job upload)
if ! grep -Fx '      contents: read' <<< "$build_job" >/dev/null ||
  grep -E 'write|secrets\.|GH_TOKEN' <<< "$build_job" >/dev/null ||
  ! grep -Fx '    needs: build' <<< "$upload_job" >/dev/null ||
  ! grep -Fx '      contents: write' <<< "$upload_job" >/dev/null ||
  ! grep -Fx "      GH_TOKEN: \${{ github.token }}" <<< "$upload_job" >/dev/null; then
  echo 'error: keep the build read-only and give write credentials only to its separate upload job.' >&2
  exit 1
fi
for binding in "  BUILD_SHA: \${{ inputs.build_sha }}" "  DRAFT_TAG: \${{ inputs.draft_tag }}"; do
  grep -Fx "$binding" "$fixture" >/dev/null || exit 1
done

# Like scripts/ci.test, execute the workflow's commands rather than a second implementation.
step() {
  awk -v name="$1" '
    $0 == "      - name: " name { found = 1; next }
    found && /^        run: \|$/ { body = 1; next }
    body && /^          / { sub(/^          /, ""); print; next }
    body { exit }
  ' "$fixture" > "$base/$1"
  if [[ ! -s $base/$1 ]]; then
    echo "error: the draft-assets fixture has no $1 step." >&2
    exit 1
  fi
}
step Build
step Upload
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_CEILING_DIRECTORIES=$base
export GIT_AUTHOR_NAME=Tester GIT_AUTHOR_EMAIL=tester@example.com
export GIT_COMMITTER_NAME=Tester GIT_COMMITTER_EMAIL=tester@example.com
mkdir "$base/source" "$base/bin"
git -C "$base/source" init -q --initial-branch=main
printf 'checked source\n' > "$base/source/asset.txt"
git -C "$base/source" add asset.txt
git -C "$base/source" commit -qm 'feat: add an asset'
checked_sha=$(git -C "$base/source" rev-parse HEAD)
git -C "$base/source" tag v1.0.0
git -C "$base/source" tag -a annotated -m 'Annotated release'
printf 'new source\n' > "$base/source/asset.txt"
git -C "$base/source" commit -qam 'feat: change the asset'
new_sha=$(git -C "$base/source" rev-parse HEAD)
git -C "$base/source" tag wrong-source
export SOURCE_URL=$base/source TEST_STATE=$base/state
cat > "$base/bin/gh" <<'GH'
#!/usr/bin/env bash
set -euo pipefail
case "$*" in
  'release view '* )
    [[ $# == 5 && $3 == "$EXPECTED_DRAFT" && $4 == --json && $5 == isDraft,tagName,targetCommitish ]] || exit 1
    cat "$TEST_STATE/release.json"
    ;;
  'release upload '* )
    [[ $# == 4 && $3 == "$EXPECTED_DRAFT" && $4 == release.tar ]] || exit 1
    cp "$4" "$TEST_STATE/uploaded.tar"
    ;;
  *) echo "Unexpected gh call: $*" >&2; exit 1 ;;
esac
GH
chmod +x "$base/bin/gh"
export PATH="$base/bin:$PATH"
case_count=0
new_case() {
  rm -rf "$base/work" "$TEST_STATE"
  mkdir "$base/work" "$TEST_STATE"
  export BUILD_SHA=$checked_sha DRAFT_TAG=v1.0.0 EXPECTED_DRAFT=v1.0.0
  printf '{"isDraft":true,"tagName":"v1.0.0","targetCommitish":"main"}\n' > "$TEST_STATE/release.json"
}
run_build() {
  (cd "$base/work" && bash -eo pipefail "$base/Build") > "$base/output" 2>&1
}
run_upload() {
  (cd "$base/work" && bash -eo pipefail "$base/Upload") >> "$base/output" 2>&1
}
expect_upload() {
  case_count=$((case_count + 1))
  if ! run_build || ! run_upload; then
    cat "$base/output"
    exit 1
  fi
  [[ $(tar -xOf "$TEST_STATE/uploaded.tar" asset.txt) == 'checked source' ]] || exit 1
}
expect_rejected() {
  case_count=$((case_count + 1))
  if run_build && run_upload; then
    echo "error: $1 unexpectedly succeeded." >&2
    exit 1
  fi
  if [[ -e $TEST_STATE/uploaded.tar ]]; then
    echo "error: $1 uploaded an asset." >&2
    exit 1
  fi
}
new_case
expect_upload
new_case
export DRAFT_TAG=annotated EXPECTED_DRAFT=annotated
printf '{"isDraft":true,"tagName":"annotated","targetCommitish":"main"}\n' > "$TEST_STATE/release.json"
expect_upload
new_case
export DRAFT_TAG=untagged EXPECTED_DRAFT=untagged
printf '{"isDraft":true,"tagName":"untagged","targetCommitish":"%s"}\n' "$checked_sha" > "$TEST_STATE/release.json"
expect_upload
for input in '' main abc 0000000000000000000000000000000000000000 "\$(touch injected)"; do
  new_case
  export BUILD_SHA=$input
  expect_rejected "invalid or missing build SHA"
done
for input in '' '--help' 'bad tag'; do
  new_case
  export DRAFT_TAG=$input
  expect_rejected "invalid or missing draft tag"
done
new_case
rm "$TEST_STATE/release.json"
expect_rejected 'missing draft'
new_case
export DRAFT_TAG=wrong-source EXPECTED_DRAFT=wrong-source
printf '{"isDraft":true,"tagName":"wrong-source","targetCommitish":"%s"}\n' "$checked_sha" > "$TEST_STATE/release.json"
expect_rejected 'existing tag with different source despite matching draft target'
for target in main "$new_sha" ''; do
  new_case
  export DRAFT_TAG=untagged EXPECTED_DRAFT=untagged
  printf '{"isDraft":true,"tagName":"untagged","targetCommitish":"%s"}\n' "$target" > "$TEST_STATE/release.json"
  expect_rejected 'untagged draft without the exact source SHA'
done
new_case
run_build
printf '{"isDraft":false,"tagName":"v1.0.0","targetCommitish":"main"}\n' > "$TEST_STATE/release.json"
case_count=$((case_count + 1))
if run_upload || [[ -e $TEST_STATE/uploaded.tar ]]; then
  echo 'error: a release published after the build received an upload.' >&2
  exit 1
fi
printf 'scripts/draft-assets.test passed. Cases: %s.\n' "$case_count"
