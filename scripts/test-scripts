#!/usr/bin/env bash
# Runs the tests of the scripts and hooks, each test file in a process of its own, all at the same time:
# scripts/test-scripts [--part <part>/<parts> | --branch]
# The test files are each scripts/hooks/*.test, the cases of scripts/test-check and each scripts/*.test. The script
# prints the outputs of the files in that order, so that they don't mix. A failure in any file fails the script.
# With --part, as in --part 2/3, it runs only every third file of that list, starting with the second. The jobs of
# .github/workflows/ci.yml that run the tests each run one part, because on one runner the tests took two minutes.
# With --branch, it runs only the files that this branch's changes can affect, as scripts/affected-tests decides, or
# every file without uv, which runs scripts/affected-tests. scripts/check runs it this way.
set -euo pipefail
cd "$(dirname "$0")/.."

# Waits for room on the machine, as scripts/loop/run-heavy describes. run-heavy then runs this script again with
# LOOP_HEAVY_COMMAND set. Without uv, which runs run-heavy, the script starts at once.
if [[ -z ${LOOP_HEAVY_COMMAND:-} ]] && command -v uv >/dev/null; then
  exec scripts/loop/run-heavy scripts/test-scripts "$@"
fi

part=1
parts=1
runs_affected_only=""
if [[ $# == 1 && $1 == --branch ]]; then
  runs_affected_only=yes
elif (($# > 0)); then
  if [[ $# != 2 || $1 != --part || ! $2 =~ ^[1-9][0-9]*/[1-9][0-9]*$ ]]; then
    echo "error: scripts/test-scripts takes no argument, --branch, or --part and a part such as 2/3, and it got: $*" >&2
    exit 2
  fi
  part=${2%/*}
  parts=${2#*/}
  if ((part > parts)); then
    echo "error: --part $2 names part $part of $parts. Give a part from 1 to $parts." >&2
    exit 2
  fi
fi

# shellcheck source=scripts/missing-tools
source scripts/missing-tools
# The hooks' tests need jq.
runs_hooks_tests=""
if has jq https://jqlang.org/download/; then
  runs_hooks_tests=yes
fi

# mktemp -d alone ignores TMPDIR on macOS.
outputs=$(mktemp -d "${TMPDIR:-/tmp}/test-scripts.XXXXXX")
stop_tests() {
  local process_id
  for process_id in $(jobs -pr); do
    kill "$process_id" 2>/dev/null || true
  done
  rm -rf "$outputs"
}
trap stop_tests EXIT

# Each test file, in the order that the script prints their outputs, and the argument that it runs with, if any.
test_files=()
test_arguments=()
# Adds a test file to the list: add_test <test file> [<argument>]
add_test() {
  test_files+=("$1")
  test_arguments+=("${2:-}")
}

# -f skips the pattern itself, which a loop gets when no file matches it.
if [[ -n $runs_hooks_tests ]]; then
  for hook_test in scripts/hooks/*.test; do
    if [[ -f $hook_test ]]; then
      add_test "$hook_test"
    fi
  done
fi
# The ShellCheck cases run shellcheck, which the bash-3-2 and macos jobs don't install, so they run only where shellcheck
# is installed, in CI too.
if command -v shellcheck >/dev/null; then
  add_test scripts/test-check --shellcheck-only
fi
add_test scripts/test-check
for script_test in scripts/*.test; do
  if [[ -f $script_test ]]; then
    add_test "$script_test"
  fi
done

# The test files that this branch's changes can affect, one to a line, when the script runs only those.
affected_tests=""
is_selecting=""
if [[ -n $runs_affected_only ]] && command -v uv >/dev/null; then
  affected_tests=$(scripts/affected-tests "${test_files[@]}")
  is_selecting=yes
fi

# Succeeds if the script runs a test file: runs_test <test file>
runs_test() {
  [[ -z $is_selecting || $'\n'$affected_tests$'\n' == *$'\n'"$1"$'\n'* ]]
}

# The process of each test file that the script runs, which writes its output and errors to files named for its place
# in this list.
process_ids=()
for ((place = 0; place < ${#test_files[@]}; place++)); do
  if ((place % parts == part - 1)) && runs_test "${test_files[place]}"; then
    bash "${test_files[place]}" ${test_arguments[place]:+"${test_arguments[place]}"} \
      >"$outputs/${#process_ids[@]}.out" 2>"$outputs/${#process_ids[@]}.err" &
    process_ids+=("$!")
  fi
done
if [[ -n $is_selecting ]] && ((${#process_ids[@]} < ${#test_files[@]})); then
  echo "Ran ${#process_ids[@]} of the ${#test_files[@]} tests of the scripts and hooks, those that this branch's changes can affect, as scripts/affected-tests decides. CI runs them all." >&2
fi

status=0
for ((index = 0; index < ${#process_ids[@]}; index++)); do
  if wait "${process_ids[index]}"; then
    test_status=0
  else
    test_status=$?
  fi
  if ((status == 0 && test_status != 0)); then
    status=$test_status
  fi
  cat "$outputs/$index.out"
  cat "$outputs/$index.err" >&2
done
stop_tests
trap - EXIT
exit "$status"
