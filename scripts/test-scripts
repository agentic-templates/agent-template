#!/usr/bin/env bash
# Runs the tests of the scripts and hooks, each test file in a process of its own, all at the same time: the hooks'
# tests, the cases of scripts/test-check and each scripts/*.test. It prints the outputs of the files in that order, so
# that they don't mix. A failure in any file fails the script.
# scripts/check runs it, and so do the script-tests and bash-3-2 jobs in .github/workflows/ci.yml.
set -euo pipefail
cd "$(dirname "$0")/.."

# shellcheck source=scripts/missing-tools
source scripts/missing-tools
# The hooks' tests need jq.
runs_hooks_tests=""
if has jq https://jqlang.org/download/; then
  runs_hooks_tests=yes
fi

outputs=$(mktemp -d)
stop_tests() {
  local process_id
  for process_id in $(jobs -pr); do
    kill "$process_id" 2>/dev/null || true
  done
  rm -rf "$outputs"
}
trap stop_tests EXIT

# Each test file writes its output and errors to files named for its place in the list.
process_ids=()

# Starts a test file in the background: start_test <command>...
start_test() {
  local index=${#process_ids[@]}
  "$@" >"$outputs/$index.out" 2>"$outputs/$index.err" &
  process_ids[index]=$!
}

if [[ -n $runs_hooks_tests ]]; then
  start_test bash scripts/test-hooks
fi
# The ShellCheck cases run shellcheck, which the bash-3-2 job doesn't install, so they run only where shellcheck is
# installed, in CI too.
if command -v shellcheck >/dev/null; then
  start_test bash scripts/test-check --shellcheck-only
fi
start_test bash scripts/test-check
# -f skips the pattern itself, which the loop gets when no test matches it.
for script_test in scripts/*.test; do
  if [[ -f $script_test ]]; then
    start_test bash "$script_test"
  fi
done

status=0
for ((index = 0; index < ${#process_ids[@]}; index++)); do
  if wait "${process_ids[index]}"; then
    test_status=0
  else
    test_status=$?
  fi
  if ((status == 0 && test_status != 0)); then
    status=$test_status
  fi
  cat "$outputs/$index.out"
  cat "$outputs/$index.err" >&2
done
stop_tests
trap - EXIT
exit "$status"
