"""
CHANGES_FILE = "changes.diff"
# The environment variable that tells scripts/hooks/hand-off that a session is a builder that may hand off its work
HAND_OFF_VARIABLE = "LOOP_HAND_OFF"
CODEX_BRIEF = """Your sandbox can't write the git folder or reach the network, so don't run git or gh. Edit the files in
this worktree, which is on the issue's branch. Run scripts/check, and fix each failure that your change causes. In the
sandbox, it skips the tests that open a TCP port and the coverage report, and CI runs every check on the pull request.

When you end, the script that started you commits your changes, pushes them and opens a pull request, with your last
message under "What changed and why" in its description. Write that message for a developer who joins the project
later, as docs/writing.md says. If scripts/loop/consequential lists a file that your change touches, the pull request
is a draft, because a reviewer reads it before it merges. If you change no file, your last message becomes a comment
on the issue instead: for a research issue, your answer with a recommendation and the evidence, and otherwise what you
need to finish the issue.
"""


class Stop(Exception):
    """Ends the run, with the reason."""


class Outcome(NamedTuple):
    """How a run ended, as its last line says, and what the end line in agents.jsonl takes from it."""

    text: str
    is_ok: bool = True
    # The pull request that the script opened for a Codex builder
    pull_request: int | None = None
    worktree_mb: float | None = None


class Folders(NamedTuple):
    checkout: Path
    worktree: Path
    run: Path
    # The main checkout's git hooks folder, as an absolute path. A relative core.hooksPath would name the worktree's
    # copies of the hooks.
    hooks: str


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/loop/run-builder", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("issue", type=int)
    parser.add_argument("kind", nargs="+", help="the issue's kind, as scripts/take-next-issue printed it")
    parser.add_argument("--tool", required=True, choices=TOOLS)
    parser.add_argument("--type", help="the agent type of a Claude builder, such as builder")
    parser.add_argument("--account", help="the account's name in .loop/accounts.json")
    parser.add_argument("--test", type=int, metavar="PULL_REQUEST", help="build the issue again as a test")
    options = parser.parse_args(argv)
    kind = " ".join(options.kind)
    checkout = paths.main_checkout(Path.cwd())
    run_name = f"test-{options.issue}-{options.type}" if options.test else str(options.issue)
    worktree = checkout / ".claude" / "worktrees" / (run_name if options.test else f"run-{options.issue}")
    try:
        check_kind(kind, options.tool)
        settings = type_settings(options.tool, options.type, options.test)
        account = pick_account(load_accounts(paths.loop_dir() / "accounts.json"), options.tool, options.account)
        check_can_start(options.tool, worktree)
        repository = github_repository(checkout)
        # Every gh command from here on acts on that repository, the builder's too.
        os.environ["GH_REPO"] = repository
        issue = read_issue(options.issue, checkout)
        hooks = run_ok(["git", "rev-parse", "--path-format=absolute", "--git-path", "hooks"], checkout).strip()
    except (AccountsError, Stop) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1

    started = dt.datetime.now().astimezone()
    folders = Folders(checkout, worktree, paths.loop_dir() / "runs" / f"{run_name}-{started:%Y%m%d-%H%M%S}", hooks)
    folders.run.mkdir(parents=True)
    agent_type = options.type or CODEX_TYPE
    label = agent_log.type_label(label_names(issue))
    is_test = options.test is not None
    agent_log.append(
        agent_log.start_line(folders.run.name, agent_type, settings, options.issue, label, kind, is_test, os.getpid())
    )
    begun = time.monotonic()
    try:
        if is_test:
            outcome = test_build(settings, kind, account, issue, options.test, folders)
        else:
            outcome = build(options.tool, settings, kind, account, issue, repository, folders)
    except Stop as stop:
        outcome = Outcome(f"failed: {stop}", is_ok=False)
    minutes = (time.monotonic() - begun) / 60
    status = {
        "issue": options.issue,
        "tool": options.tool,
        "account": account["name"],
        "started": started.isoformat(timespec="seconds"),
        "minutes": round(minutes, 1),
        "outcome": outcome.text,
    }
    (folders.run / "status.json").write_text(json.dumps(status, indent=2) + "\n")
    run_period = (started, started + dt.timedelta(minutes=minutes))
    numbers = run_numbers(options.tool, account, outcome, run_period, folders)
    agent_log.append(agent_log.end_line(folders.run.name, numbers, outcome.worktree_mb, run_usage=children_usage()))
    report = folders.run / "report.md"
    where = f"report {report}" if report.exists() else f"no report, see {folders.run}"
    print(f"issue {options.issue} | {options.tool} {account['name']} | {outcome.text} | {minutes:.1f} min | {where}")
    return 0 if outcome.is_ok else 1


def type_settings(tool: str, agent_type: str | None, test: int | None) -> agent_log.AgentSettings:
    """The settings that the builder runs with: those of a Claude builder's type, and none for a Codex builder."""
    if tool == "codex":
        if agent_type or test:
            raise Stop(
                "a Codex builder runs with Codex's own model and effort, so it takes neither --type nor --test. Leave "
                "them out."
            )
        return agent_log.AgentSettings(None, None, None)
    if not agent_type:
        raise Stop(
            "a Claude builder needs the agent type whose model and effort it runs with. Add --type, such as "
            "--type builder."
        )
    settings = agent_log.agent_settings(agent_type)
    if settings.file_hash is None:
        raise Stop(
            f"there's no agent file .claude/agents/{agent_type}.md for the type {agent_type}. Give a type that "
            ".claude/agents has."
        )
    return settings


def build(
    tool: str,
    settings: agent_log.AgentSettings,
    kind: str,
    account: Account,
    issue: dict[str, Any],
    repository: str,
    folders: Folders,
) -> Outcome:
    """Runs the builder in its worktree, saves the changes that it left on the issue's branch, and removes the
    worktree. Returns how the run ended, with the worktree's size before its removal."""
    branch = issue_branch(issue["number"], repository, folders)
    try:
        add_worktree(branch, folders)
        if tool == "claude":
            run_claude(write_brief(issue, kind, CLAUDE_BRIEF, folders), account, settings, folders, can_hand_off=True)
            outcome = Outcome("finished")
        else:
            run_codex(write_brief(issue, kind, CODEX_BRIEF, folders), account, folders)
            outcome = finish_codex(issue, branch, folders)
    except Stop as stop:
        outcome = Outcome(f"failed: {stop}", is_ok=False)
    finally:
        worktree_mb = agent_log.folder_megabytes(folders.worktree)
        # Another run on the issue can't start while the worktree exists, and scripts/start-issue can't check out the
        # branch while the worktree has it.
        problem = clear_worktree(issue["number"], branch, folders)
    outcome = outcome._replace(worktree_mb=worktree_mb)
    if problem:
        text = f"failed: {problem}" if outcome.is_ok else f"{outcome.text}, and {problem}"
        return outcome._replace(text=text, is_ok=False)
    return outcome


def test_build(
    settings: agent_log.AgentSettings,
    kind: str,
    account: Account,
    issue: dict[str, Any],
    pull_request: int,
    folders: Folders,
) -> Outcome:
    """Builds the issue again from the commit that its pull request started from, writes the diff of the builder's
    changes to the run folder, and removes the worktree. Returns how the run ended, with the worktree's size before its
    removal."""
    base = pull_request_base(pull_request, folders)
    git(["worktree", "add", "--quiet", "--detach", str(folders.worktree), base], folders.checkout, folders.hooks)
    try:
        # A hand-off posts a comment on the issue, and a test build changes nothing on GitHub.
        run_claude(write_brief(issue, kind, TEST_BRIEF, folders), account, settings, folders, can_hand_off=False)
        outcome = Outcome(f"test finished, changes in {folders.run / CHANGES_FILE}")
    except Stop as stop:
        outcome = Outcome(f"failed: {stop}", is_ok=False)
    finally:
        worktree_mb = agent_log.folder_megabytes(folders.worktree)
        git(["add", "--all"], folders.worktree, folders.hooks)
        changes = git(["diff", "--cached", "--binary", base], folders.worktree, folders.hooks)
        (folders.run / CHANGES_FILE).write_text(changes)
        git(["worktree", "remove", "--force", str(folders.worktree)], folders.checkout, folders.hooks)
    return outcome._replace(worktree_mb=worktree_mb)


def pull_request_base(pull_request: int, folders: Folders) -> str:
    """The commit that a pull request started from: the parent of its first commit. GitHub keeps the commits of a pull
    request under refs/pull/<number>/head, also after a squash merge."""
    git(["fetch", "--quiet", "origin", f"refs/pull/{pull_request}/head"], folders.checkout, folders.hooks)
    commits = ["gh", "pr", "view", str(pull_request), "--json", "commits", "--jq", ".commits[0].oid"]
    first = run_ok(commits, folders.checkout).strip()
    return git(["rev-parse", "--verify", "--quiet", f"{first}^"], folders.checkout, folders.hooks).strip()


def run_numbers(
    tool: str, account: Account, outcome: Outcome, run: agent_log.Period, folders: Folders
) -> agent_log.Numbers:
    """The builder's numbers for the end line in agents.jsonl: a Codex builder's from its events and the run's period,
    and a Claude builder's from its transcript, as for an agent of a session, but with the tokens from its events. A
    Claude builder without a transcript, such as one that never started, made no calls."""
    events = read_events(folders.run / "events.jsonl")
    if tool == "codex":
        return codex_numbers(events, run, outcome.pull_request)
    input_tokens, output_tokens = claude_tokens(events)
    sessions = [event["session_id"] for event in events if "session_id" in event]
    project = paths.claude_project_folder(folders.worktree, claude_environment(account))
    transcript = project / f"{sessions[0]}.jsonl" if sessions else None
    if transcript is None or not transcript.exists():
        return agent_log.Numbers(
            run_minutes(run), agent_log.period_texts([run]), 0, input_tokens, output_tokens, None, None
        )
    numbers = agent_log.transcript_numbers(transcript)
    return numbers._replace(input_tokens=input_tokens, output_tokens=output_tokens, requests=None)


def claude_tokens(events: list[dict[str, Any]]) -> tuple[int, int]:
    """The input tokens, cached ones too, and the output tokens of a Claude run, from its last result event. The
    modelUsage of a result counts the whole run until then, with the agents that the builder started, while its usage
    counts only the builder's own replies to the last prompt."""
    results = [event for event in events if event.get("type") == "result"]
    models = results[-1].get("modelUsage", {}).values() if results else []
    input_tokens = sum(model.get(field) or 0 for model in models for field in CLAUDE_INPUT_FIELDS)
    return input_tokens, sum(model.get(CLAUDE_OUTPUT_FIELD) or 0 for model in models)


def codex_numbers(events: list[dict[str, Any]], run: agent_log.Period, pull_request: int | None) -> agent_log.Numbers:
    tool_calls = sum(
        event.get("type") == "item.completed" and event.get("item", {}).get("type") in CODEX_TOOL_ITEMS
        for event in events
    )
    # Codex counts the cached input tokens among the input tokens, and the reasoning tokens among the output tokens.
    usages = [event.get("usage", {}) for event in events if event.get("type") == "turn.completed"]
    input_tokens = sum(usage.get("input_tokens", 0) for usage in usages)
    output_tokens = sum(usage.get("output_tokens", 0) for usage in usages)
    periods = agent_log.period_texts([run])
    return agent_log.Numbers(run_minutes(run), periods, tool_calls, input_tokens, output_tokens, None, pull_request)


def run_minutes(run: agent_log.Period) -> float:
    start, end = run
    return round((end - start).total_seconds() / 60, 1)


def read_events(file: Path) -> list[dict[str, Any]]:
    return list(map(parse_event, file.read_text().splitlines())) if file.exists() else []


def children_usage() -> dict[str, float]:
    """The CPU time of the processes that the run started, and the most memory that one of them used."""
    usage = resource.getrusage(resource.RUSAGE_CHILDREN)
    peak_bytes = peak_memory_bytes(usage)
    return {"cpu_seconds": round(usage.ru_utime + usage.ru_stime, 1), "peak_memory_mb": agent_log.megabytes(peak_bytes)}


def clear_worktree(issue: int, branch: str, folders: Folders) -> str:
    """Saves the changes in the worktree on the issue's branch, as scripts/clear-worktrees does for the issue, removes
    the worktree and pushes the branch. Returns where the changes stay when that fails, or an empty string."""
    if not folders.worktree.exists():
        return ""
    # Git runs the main checkout's hooks, because the worktree's copies are files that the builder can change.
    count = int(os.environ.get("GIT_CONFIG_COUNT", "0"))
    hooks = {"GIT_CONFIG_COUNT": str(count + 1), f"GIT_CONFIG_KEY_{count}": "core.hooksPath"}
    hooks[f"GIT_CONFIG_VALUE_{count}"] = folders.hooks
    # The main checkout's copy, because the script frees the worktrees of the checkout that holds it.
    done = subprocess.run(
        [folders.checkout / "scripts" / "clear-worktrees", str(issue)],
        env=os.environ | hooks,
        capture_output=True,
        text=True,
        check=False,
    )
    if done.returncode != 0:
        return f"scripts/clear-worktrees failed: {one_line(done.stdout + done.stderr)}"
    # The script skips a worktree that doesn't hold the issue's branch, such as one where a check refused the commit of
    # a Codex builder's changes.
    if folders.worktree.exists():
        if has_unpushed_changes(folders):
            return f"the changes stay in {folders.worktree}, off the issue's branch"
        git(["worktree", "remove", "--force", str(folders.worktree)], folders.checkout, folders.hooks)
    try:
        push_saved_changes(branch, folders)
    except Stop as stop:
        return f"the changes stay on the local branch {branch}, because {stop}"
    return ""


def has_unpushed_changes(folders: Folders) -> bool:
    """Whether the worktree has changes that aren't committed, or commits that no branch on origin has."""
    if git(["status", "--porcelain"], folders.worktree, folders.hooks).strip():
        return True
    unpushed = ["rev-list", "--max-count=1", "HEAD", "--not", "--remotes=origin"]
    return bool(git(unpushed, folders.worktree, folders.hooks).strip())


def push_saved_changes(branch: str, folders: Folders) -> None:
    """Pushes the commits that the local branch has and origin's doesn't, such as those that scripts/clear-worktrees
    saved and didn't push because the branch has a pull request. The pull request becomes a draft without auto-merge
    first, so that the unfinished changes can't merge."""
    unpushed = ["rev-list", "--max-count=1", f"refs/heads/{branch}", "--not", f"refs/remotes/origin/{branch}"]
    if not git(unpushed, folders.checkout, folders.hooks).strip():
        return
    pull_request = own_pull_request(branch, folders.checkout)
    if pull_request is not None:
        hold_for_review(pull_request, folders.checkout)
    git(["push", "--quiet", "origin", f"refs/heads/{branch}:refs/heads/{branch}"], folders.checkout, folders.hooks)


def option(flag: str, value: str | None) -> list[str]:
    return [flag, value] if value else []


def check_kind(kind: str, tool: str) -> None:
    if not agent_log.KIND.fullmatch(kind):
        raise Stop(
            f'"{kind}" isn\'t a kind that scripts/take-next-issue prints: research, parent, left behind <pull request> '
            "or other. Give the line that it printed for the issue."
        )
    if tool == "codex" and kind not in CODEX_KINDS:
        raise Stop(f"a Codex builder can't build an issue of the kind {kind}, because it needs gh. Use --tool claude.")


def pick_account(accounts: list[Account], tool: str, name: str | None) -> Account:
    for account in accounts:
        if account["tool"] == tool and (name is None or account["name"] == name):
            return account
    wanted = f"no {tool} account called {name}" if name else f"no {tool} account"
    raise Stop(f".loop/accounts.json lists {wanted}. Add it, as scripts/loop/meter --help shows, or name another one.")


def check_can_start(tool: str, worktree: Path) -> None:
    for program in ("gh", tool):
        if shutil.which(program) is None:
            raise Stop(f"{program} isn't installed. Install it, and run the script again.")
    if worktree.exists():
        raise Stop(
            f"{worktree} exists already, so another run may still use it. Once nobody needs it, remove it with git "
            "worktree remove, and run the script again."
        )


def github_repository(checkout: Path) -> str:
    """The repository that gh acts on, which must be origin's, because the script acts on it with both gh and git."""
    named = run(["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"], checkout)
    if named.returncode != 0:
        raise Stop(f"can't tell which repository gh acts on, because gh failed: {one_line(named.stderr)}")
    url = run(["git", "config", "--get", "remote.origin.url"], checkout).stdout.strip()
    found = REMOTE_URL.match(url)
    if not found:
        raise Stop(
            f'can\'t find the owner and the name of the repository in the URL of origin, "{url}". Set it to the '
            "repository's URL on GitHub with git remote set-url origin <URL>."
        )
    gh_repository, origin = named.stdout.strip(), f"{found[1]}/{found[2]}"
    if gh_repository.lower() != origin.lower():
        raise Stop(
            f"gh acts on {gh_repository}, and origin is {origin}. Set GH_REPO to {origin}, or run the script in a "
            f"checkout of {gh_repository}."
        )
    return gh_repository


def read_issue(number: int, checkout: Path) -> dict[str, Any]:
    issue: dict[str, Any] = json.loads(
        run_ok(["gh", "issue", "view", str(number), "--json", "number,title,body,labels"], checkout)
    )
    if "needs-triage" in label_names(issue):
        raise Stop(shell_function("needs-triage", 'needs_triage_message "$1" "$1"', str(number)).strip())
    return issue


def label_names(issue: dict[str, Any]) -> list[str]:
    return [label["name"] for label in issue["labels"]]


def issue_branch(issue: int, repository: str, folders: Folders) -> str:
    """The issue's branch on origin, which the script creates if the issue has none."""
    git(["fetch", "--prune", "--quiet", "origin"], folders.checkout, folders.hooks)
    branch = newest_linked_branch(issue, repository, folders.checkout)
    if branch is None:
        run_ok(["gh", "issue", "develop", str(issue)], folders.checkout)
        git(["fetch", "--quiet", "origin"], folders.checkout, folders.hooks)
        branch = newest_linked_branch(issue, repository, folders.checkout)
    if branch is None:
        raise Stop(f"gh issue develop created no branch for issue #{issue} that origin has.")
    return branch


def add_worktree(branch: str, folders: Folders) -> None:
    git(["worktree", "add", "--quiet", str(folders.worktree), branch], folders.checkout, folders.hooks)
    git(["merge", "--ff-only", "--quiet", f"refs/remotes/origin/{branch}"], folders.worktree, folders.hooks)


def newest_linked_branch(issue: int, repository: str, checkout: Path) -> str | None:
    """Of the branches that gh lists for the issue in the repository and that origin has, the one whose latest commit
    is newest, as scripts/start-issue picks it."""
    newest: tuple[int, str] | None = None
    # gh prints each branch, a tab and the branch's URL.
    for line in run_ok(["gh", "issue", "develop", "--list", str(issue)], checkout).splitlines():
        branch, _, url = line.partition("\t")
        commit_time = run(["git", "log", "-1", "--format=%ct", f"refs/remotes/origin/{branch}", "--"], checkout)
        if f"/{repository}/".lower() not in url.lower() or commit_time.returncode != 0:
            continue
        candidate = (int(commit_time.stdout), branch)
        newest = max(newest or candidate, candidate)
    return newest[1] if newest else None


def write_brief(issue: dict[str, Any], kind: str, run_brief: str, folders: Folders) -> str:
    """Writes the builder's brief to the run folder, and returns it: the issue, and what the builder must know about
    its kind of run."""
    issue_text = f"Issue #{issue['number']}: {issue['title']}\n\n{issue['body']}\n\n---\n\n"
    brief = issue_text + SHARED_BRIEF.format(kind=kind) + run_brief
    (folders.run / "brief.md").write_text(brief)
    return brief


def run_claude(
    brief: str, account: Account, settings: agent_log.AgentSettings, folders: Folders, *, can_hand_off: bool
) -> None:
    """Runs claude with the type's settings until it ends, and writes its result to report.md in the run folder.
    claude sends the tokens of its requests to the loop's receiver, which this starts if it isn't running. With
    can_hand_off, scripts/hooks/hand-off tells the builder to hand off its work once its context grows too long."""
    try:
        port = request_events.receiver_port(paths.loop_dir())
    except request_events.ReceiverError as error:
        raise Stop(str(error)) from error
    # The first variable makes claude wait through a usage limit. The second keeps the hooks from logging the agents
    # that the builder starts, because the run's tokens count theirs.
    variables = {"CLAUDE_CODE_RETRY_WATCHDOG": "1", agent_log.RUN_VARIABLE: "1"}
    if can_hand_off:
        variables[HAND_OFF_VARIABLE] = "1"
    environment = request_events.with_events(claude_environment(account) | variables, port)
    model_options = [
        *option("--model", settings.model),
        *option("--effort", settings.effort),
        *option("--append-system-prompt", settings.instructions),
        *option("--tools", settings.tools),
        *option("--disallowedTools", settings.disallowed_tools),
        *option("--max-turns", settings.max_turns),
    ]
    result: dict[str, Any] | None = None
    with (
        (folders.run / "events.jsonl").open("w") as events,
        (folders.run / "stderr.log").open("w") as errors,
        subprocess.Popen(
            [*CLAUDE_COMMAND, *model_options, brief],
            cwd=folders.worktree,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=errors,
            text=True,
        ) as process,
    ):
        assert process.stdout is not None
        for line in process.stdout:
            events.write(line)
            event = parse_event(line)
            mode = event.get("permissionMode")
            if event.get("type") == "system" and event.get("subtype") == "init" and mode != "auto":
                process.kill()
                raise Stop(
                    f"claude started in permission mode {mode}, not auto, so it would be denied each action that "
                    "needs permission."
                )
            if event.get("type") == "result":
                result = event
        exit_code = process.wait()
    if result is None:
        raise Stop(f"claude ended with code {exit_code} and gave no result. stderr.log in the run folder says why.")
    problem = claude_problem(result, exit_code)
    if problem:
        raise Stop(problem)
    (folders.run / "report.md").write_text(str(result.get("result", "")))


def claude_problem(result: dict[str, Any], exit_code: int) -> str | None:
    """Why a Claude run with this result event failed, or None."""
    if result.get("subtype") != "success" or result.get("is_error"):
        errors = result.get("errors") or [result.get("result") or "no message"]
        return f"claude's result is {result.get('subtype')}: {', '.join(map(str, errors))}"
    if exit_code != 0:
        return f"claude ended with code {exit_code} after its result. stderr.log in the run folder says why."
    return None


def run_codex(brief: str, account: Account, folders: Folders) -> None:
    """Fills a uv cache of the run's own, and runs codex with it until codex ends. Codex writes its last message to
    report.md in the run folder."""
    environment = codex_environment(account)
    # uv in the sandbox uses a cache of the run's own, which --add-dir lets the sandbox write. Writing uv's shared cache
    # would let the builder change the files that every later uv command on the machine uses. The cache lies in the run
    # folder, which no sandbox can write, so that no other builder can change it, also while uv outside the sandbox
    # fills it.
    with tempfile.TemporaryDirectory(prefix="uv-cache-", dir=folders.run) as uv_cache:
        environment["UV_CACHE_DIR"] = uv_cache
        fill_uv_cache(folders, environment)
        command = [
            "codex",
            "exec",
            "--sandbox",
            "workspace-write",
            "--add-dir",
            uv_cache,
            "--cd",
            str(folders.worktree),
            "--json",
            "--output-last-message",
            str(folders.run / "report.md"),
            brief,
        ]
        with (folders.run / "events.jsonl").open("w") as events, (folders.run / "stderr.log").open("w") as errors:
            done = subprocess.run(
                command,
                cwd=folders.worktree,
                env=environment,
                stdin=subprocess.DEVNULL,
                stdout=events,
                stderr=errors,
                check=False,
            )
    problem = codex_problem(read_events(folders.run / "events.jsonl"), done.returncode)
    if problem:
        raise Stop(problem)


def fill_uv_cache(folders: Folders, environment: dict[str, str]) -> None:
    """Puts the packages of the main checkout's uv.lock, which scripts/check needs, in the uv cache that the environment
    names, because the sandbox can't download them. uv installs them in a folder that the function then deletes, so
    that the main checkout's .venv stays as it is."""
    # The folder lies in the run folder, which no sandbox can write, because uv runs the Python of the folder that it
    # installs in.
    with tempfile.TemporaryDirectory(prefix="uv-environment-", dir=folders.run) as installed:
        done = subprocess.run(
            UV_SYNC,
            cwd=folders.checkout,
            env=environment | {"UV_PROJECT_ENVIRONMENT": installed},
            capture_output=True,
            text=True,
            check=False,
        )
    if done.returncode != 0:
        raise Stop(
            f"uv sync failed in the main checkout, so codex didn't start: {one_line(done.stderr or done.stdout)}"
        )


def codex_environment(account: Account) -> dict[str, str]:
    """This process's environment without the variables that CREDENTIAL_NAME and CREDENTIAL_PREFIXES match, and with
    the account's variables."""
    kept = {
        name: value
        for name, value in os.environ.items()
        if not CREDENTIAL_NAME.search(name) and not name.startswith(CREDENTIAL_PREFIXES)
    }
    return kept | account["env"]


def codex_problem(events: list[dict[str, Any]], exit_code: int) -> str | None:
    """Why a Codex run with these events failed, or None. Its last event about its turn must say that the turn
    completed."""
    turns = [event for event in events if event.get("type") in ("turn.started", "turn.completed", "turn.failed")]
    if not turns:
        return f"codex ended with code {exit_code} before its turn started. stderr.log in the run folder says why."
    last = turns[-1]
    if last["type"] == "turn.failed":
        return f"codex's turn failed: {last.get('error', {}).get('message', 'no message')}"
    if last["type"] == "turn.started":
        return f"codex ended with code {exit_code} before its turn completed. stderr.log in the run folder says why."
    if exit_code != 0:
        return f"codex ended with code {exit_code} after its turn. stderr.log in the run folder says why."
    return None


def parse_event(line: str) -> dict[str, Any]:
    """The event on a line of a builder's output, or an empty one when the line holds none."""
    try:
        event = json.loads(line)
    except ValueError:
        return {}
    return event if isinstance(event, dict) else {}


def finish_codex(issue: dict[str, Any], branch: str, folders: Folders) -> Outcome:
    """Posts what codex did: the pull request of its changes, or its report as a comment when it changed no file.
    Returns the outcome."""
    report_file = folders.run / "report.md"
    report = report_file.read_text().strip() if report_file.exists() else ""
    if not report:
        raise Stop("codex wrote no report, so the script can't describe its change or post its answer.")
    if git(["status", "--porcelain"], folders.worktree, folders.hooks).strip():
        return push_changes(issue, branch, folders, report)
    comment = ["gh", "issue", "comment", str(issue["number"]), "--body", report]
    reason = hook_block(comment, folders.checkout)
    if reason:
        raise Stop(f"the hooks would block codex's report as a comment on the issue: {reason}")
    run_ok(comment, folders.checkout)
    return Outcome("comment")


def push_changes(issue: dict[str, Any], branch: str, folders: Folders, report: str) -> Outcome:
    """Commits the changes and checks the commit, pushes it, and opens a pull request if the branch has none. Returns
    the outcome."""
    title = commit_subject(issue)
    head = commit_changes(title, folders)
    scan_for_leaks(f"refs/remotes/origin/{branch}..{head}", folders.checkout)
    needs_review = is_consequential(head, folders.checkout)
    pull_request = own_pull_request(branch, folders.checkout)
    body = pull_request_body(issue["number"], report)
    if pull_request is None:
        problems = pull_request_problems(title, body, head, folders.checkout)
        if problems:
            raise Stop(f"the pull request's text has problems, so the script pushed nothing: {problems}")
    elif needs_review:
        hold_for_review(pull_request, folders.checkout)
    git(["push", "--quiet", "origin", f"{head}:refs/heads/{branch}"], folders.worktree, folders.hooks)
    if pull_request is not None:
        return Outcome(pull_request_outcome(str(pull_request["number"]), needs_review or pull_request["isDraft"]))
    return open_pull_request(title, body, branch, head, needs_review, folders.checkout)


def commit_changes(title: str, folders: Folders) -> str:
    """Commits the changes in the worktree, unless a file's name suggests a secret, and returns the commit."""
    # The commit stays off the local branch, so that a commit that a check refuses can't go out with a later push.
    git(["switch", "--quiet", "--detach"], folders.worktree, folders.hooks)
    git(["add", "--all"], folders.worktree, folders.hooks)
    staged = git(["diff", "--cached", "--name-only", "--diff-filter=d", "-z"], folders.worktree, folders.hooks)
    secrets = secret_names([path for path in staged.split("\0") if path])
    if secrets:
        raise Stop(f"codex left files whose names suggest a secret, so the script pushed nothing: {', '.join(secrets)}")
    git(["commit", "--quiet", "--message", title], folders.worktree, folders.hooks)
    return git(["rev-parse", "HEAD"], folders.worktree, folders.hooks).strip()


def commit_subject(issue: dict[str, Any]) -> str:
    types = [COMMIT_TYPES[name] for name in label_names(issue) if name in COMMIT_TYPES]
    return f"{types[0] if types else 'chore'}: {issue['title']}"


def pull_request_body(number: int, report: str) -> str:
    return f"Closes #{number}\n\n## What changed and why\n\n{report}\n"


def secret_names(files: list[str]) -> list[str]:
    """The files whose names suggest a secret, as has_secret_name in scripts/secret-file-names tells."""
    each = 'for file in "$@"; do if has_secret_name "$file"; then printf "%s\\n" "$file"; fi; done'
    return shell_function("secret-file-names", each, *files).splitlines()


def scan_for_leaks(commits: str, checkout: Path) -> None:
    done = subprocess.run(
        [TRUSTED_ROOT / "scripts" / "leak-scan", "--range", commits],
        cwd=checkout,
        capture_output=True,
        text=True,
        check=False,
    )
    if done.returncode != 0:
        problems = one_line(done.stdout + done.stderr)
        raise Stop(f"scripts/leak-scan refused codex's commit, so the script pushed nothing: {problems}")


def is_consequential(head: str, checkout: Path) -> bool:
    """Whether scripts/loop/consequential lists a file that the branch changes against main. The script exits with
    code 1 when it crashes too, so only its own line says that a change isn't consequential."""
    done = subprocess.run(
        [TRUSTED_ROOT / "scripts" / "loop" / "consequential", f"refs/remotes/origin/main...{head}"],
        cwd=checkout,
        capture_output=True,
        text=True,
        check=False,
    )
    if done.returncode == 0:
        return True
    if done.returncode == 1 and done.stdout.strip() == "Not consequential.":
        return False
    raise Stop(
        "scripts/loop/consequential can't tell whether a reviewer must read the change, so the script pushed "
        f"nothing: {one_line(done.stderr or done.stdout)}"
    )


def own_pull_request(branch: str, checkout: Path) -> dict[str, Any] | None:
    """The branch's open pull request, if it has one. A pull request from a fork can come from a branch of the same
    name, and a push doesn't change it."""
    fields = "number,isCrossRepository,isDraft,autoMergeRequest"
    listed = json.loads(run_ok(["gh", "pr", "list", "--head", branch, "--state", "open", "--json", fields], checkout))
    own = [pull_request for pull_request in listed if not pull_request["isCrossRepository"]]
    return own[0] if own else None


def hold_for_review(pull_request: dict[str, Any], checkout: Path) -> None:
    """Turns off the pull request's auto-merge and makes it a draft, so that the change that the push adds waits for a
    reviewer."""
    number = str(pull_request["number"])
    if pull_request["autoMergeRequest"]:
        run_ok(["gh", "pr", "merge", number, "--disable-auto"], checkout)
    if not pull_request["isDraft"]:
        run_ok(["gh", "pr", "ready", number, "--undo"], checkout)


def open_pull_request(title: str, body: str, branch: str, head: str, is_draft: bool, checkout: Path) -> Outcome:
    """Opens the pull request, as a draft or with auto-merge, and returns the outcome."""
    command = ["gh", "pr", "create", "--title", title, "--body", body, "--head", branch, "--base", "main"]
    created = run_ok([*command, "--draft"] if is_draft else command, checkout)
    # gh prints the new pull request's URL, which ends in its number.
    number = created.strip().rsplit("/", 1)[-1]
    if is_draft:
        return Outcome(pull_request_outcome(number, True), pull_request=int(number))
    text = f"{pull_request_outcome(number, False)}{turn_on_auto_merge(number, head, checkout)}"
    return Outcome(text, pull_request=int(number))


def pull_request_outcome(number: str, is_draft: bool) -> str:
    return f"draft pull request #{number}" if is_draft else f"pull request #{number}"


def hook_block(command: list[str], checkout: Path) -> str:
    """Why scripts/hooks/before-tool would block an agent's command, or an empty string if it wouldn't."""
    hook_input = {"tool_name": "Bash", "tool_input": {"command": shlex.join(command)}, "cwd": str(checkout)}
    done = subprocess.run(
        [TRUSTED_ROOT / "scripts" / "hooks" / "before-tool"],
        input=json.dumps(hook_input),
        capture_output=True,
        text=True,
        check=False,
    )
    # The hook blocks with code 2, and allows the command with any other code, as when it fails on its own error.
    return one_line(done.stderr) if done.returncode == 2 else ""


def pull_request_problems(title: str, body: str, head: str, checkout: Path) -> str:
    """The problems that scripts/check-pull-request finds in a pull request into main, or an empty string."""
    done = subprocess.run(
        [TRUSTED_ROOT / "scripts" / "check-pull-request", "refs/remotes/origin/main", head],
        cwd=checkout,
        env=os.environ | {"TITLE": title, "BODY": body},
        capture_output=True,
        text=True,
        check=False,
    )
    return "" if done.returncode == 0 else one_line((done.stdout + done.stderr).replace("::error::", ""))


def turn_on_auto_merge(number: str, head: str, checkout: Path) -> str:
    """Turns on auto-merge for the pull request at the commit that the script pushed, as the after-tool hook does for
    an agent's pull request. Returns what the outcome adds."""
    rules = subprocess.run([TRUSTED_ROOT / "scripts" / "check-main-rules"], capture_output=True, text=True, check=False)
    # The script exits with code 1 when main lacks a required check, and with 2 when it can't tell.
    if rules.returncode == 1:
        return f", auto-merge off: {one_line(rules.stderr).removeprefix('error: ')}"
    run_ok(["gh", "pr", "merge", number, "--match-head-commit", head], checkout)
    return ""


def shell_function(file: str, call: str, *arguments: str) -> str:
    """The output of a call of the functions in a file in scripts/ of the checkout that holds this script, such as
    scripts/needs-triage."""
    done = subprocess.run(
        ["bash", "-c", f'source "$0" && {call}', TRUSTED_ROOT / "scripts" / file, *arguments],
        capture_output=True,
        text=True,
        check=True,
    )
    return done.stdout


def git(arguments: list[str], folder: Path, hooks: str) -> str:
    """The output of a git command that must succeed. Git runs the hooks in the folder hooks, as an absolute path."""
    return run_ok(["git", "-c", f"core.hooksPath={hooks}", *arguments], folder)


def run(command: list[str], folder: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, cwd=folder, capture_output=True, text=True, check=False)


def run_ok(command: list[str], folder: Path) -> str:
    """The output of a command that must succeed. A failure ends the run with the command's error."""
    done = run(command, folder)
    if done.returncode != 0:
        raise Stop(f"{command[0]} failed: {one_line(done.stderr or done.stdout)}")
    return done.stdout


def one_line(text: str) -> str:
    return " ".join(text.split())


if __name__ == "__main__":
    sys.exit(main())
