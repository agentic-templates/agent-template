#!/usr/bin/env -S uv run --script --quiet
"""Starts a builder for one issue with Claude Code or Codex, waits for it to end, and says where its report is.

  scripts/loop/run-builder <issue> <kind> --tool claude --type TYPE [--account NAME] [--test PULL_REQUEST]
  scripts/loop/run-builder <issue> <kind> --tool codex [--account NAME]

<issue> <kind> is the line that scripts/take-next-issue printed, such as 12 other. The builder runs on the account
called NAME in .loop/accounts.json, which scripts/loop/meter --help describes, or on the tool's first account there.
A Claude builder runs with the model, effort, instructions, tools, disallowed tools and limit on turns in the agent
file of its type, .claude/agents/TYPE.md in the checkout that holds this script. A Codex builder runs with Codex's own
model and effort, because the agent files name Claude's models.
It works in .claude/worktrees/run-<issue> in the main checkout, on the issue's branch. When the run ends,
scripts/clear-worktrees <issue> commits the changes that the builder left on the branch and removes the worktree, and
the script pushes the branch. If the branch has a pull request, the script turns off its auto-merge and makes it a
draft before the push. If scripts/clear-worktrees or a check refuses the changes, the script keeps them in the
worktree or on the local branch, and the run fails and says where they are. The script doesn't start when that
worktree exists already, or when the issue has needs-triage.

A Claude builder builds the issue as "Build one issue" in docs/building.md describes. It sends the tokens of its
requests to .loop/requests.jsonl, as scripts/loop/claude-with-events does.

A Codex builder runs in a sandbox that can't reach the network or write the git folder, so it only edits files and runs
scripts/check, and it builds only the kinds research and other. Before it starts, the script fills a uv cache of the
run's own with the packages of the main checkout's uv.lock, and the builder's uv installs them from there. So in the
sandbox, scripts/check fails on a package that the branch's uv.lock adds. The builder's heavy commands don't wait their
turn in scripts/loop/run-heavy, because the sandbox can't write the loop folder, where run-heavy keeps the line. If it
could, the builder could change files that run-heavy outside the sandbox trusts. When the builder ends, the script
commits its changes and pushes them, unless a file's name suggests a secret, or scripts/leak-scan or the main
checkout's git hooks refuse the commit. If the branch has no pull request yet, the script opens one with the builder's
report as its description, and turns on auto-merge unless scripts/check-main-rules fails. If scripts/loop/consequential
lists a file that the branch changes, the pull request is a draft without auto-merge instead, also when the branch had
it already. If the builder changed no file, its report becomes a comment on the issue.

The last line gives the issue, the tool and the account, how the run ended, its minutes, and where the builder's
report is. The run folder, .loop/runs/<issue>-<time>, keeps the brief, the builder's events and report, and
status.json. The script also adds a line to .loop/agents.jsonl when the run starts and one when it ends, as
scripts/loop/agent_log.py describes, with the type codex for a Codex builder. The script exits with code 1 when the run
fails or doesn't start.

With --test, the run is a test build of a retrospective, which a Claude builder makes. The builder builds the issue
again from the commit that the pull request PULL_REQUEST started from, in .claude/worktrees/test-<issue>-<type>, on no
branch, and changes nothing on GitHub. When it ends, the script writes the diff of its changes, committed or not, to
changes.diff in the run folder, .loop/runs/test-<issue>-<type>-<time>, and removes the worktree. The lines in
.loop/agents.jsonl say that the run is a test.
"""

import argparse
import datetime as dt
import json
import os
import re
import resource
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any, NamedTuple

import agent_log
import paths
import request_events
from accounts import TOOLS, Account, AccountsError, claude_environment, load_accounts
from machine import peak_memory_bytes

# The checkout that holds this script. The script runs this checkout's checks, such as scripts/hooks/before-tool,
# because the worktree's copies are files that the builder can change, and they would run outside Codex's sandbox.
TRUSTED_ROOT = Path(__file__).resolve().parents[2]
CLAUDE_COMMAND = [
    "claude",
    "-p",
    "--permission-mode",
    "auto",
    "--permission-prompts",
    "none",
    "--output-format",
    "stream-json",
    "--verbose",
]
COMMIT_TYPES = {"feature": "feat", "bug": "fix", "maintenance": "chore"}
# A Codex builder builds only these kinds, because the others need gh.
CODEX_KINDS = ("research", "other")
# The type of a Codex builder in agents.jsonl
CODEX_TYPE = "codex"
# The fields of each model's tokens in the modelUsage of claude's result event
CLAUDE_INPUT_FIELDS = ("inputTokens", "cacheReadInputTokens", "cacheCreationInputTokens")
CLAUDE_OUTPUT_FIELD = "outputTokens"
# The items of a Codex run that are tool calls, as codex exec --json lists them
CODEX_TOOL_ITEMS = ("command_execution", "file_change", "mcp_tool_call", "web_search", "todo_list")
# Fills the uv cache that Codex's sandbox uses, outside the sandbox, in the main checkout. The worktree's files can be a
# builder's, from an earlier run on the branch, and uv runs code that a project's files name, such as a build backend
# or the Python of a .python-version or a .venv, and fetches the URLs in its uv.lock. --no-build keeps uv from building
# a dependency from its source, and the other two options keep it from building the project and its workspace members.
UV_SYNC = ["uv", "sync", "--locked", "--no-build", "--no-install-project", "--no-install-workspace"]
# Codex runs without the variables whose names match, because they can hold a credential, which it can't use in its
# sandbox, or choose another account, such as CODEX_HOME. What it prints ends up in the run folder and on GitHub.
CREDENTIAL_NAME = re.compile(r"TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|API_?KEY|PRIVATE", re.IGNORECASE)
CREDENTIAL_PREFIXES = (
    "GH_",
    "GITHUB_",
    "ANTHROPIC_",
    "AWS_",
    "AZURE_",
    "GOOGLE_",
    "SSH_",
    "CLAUDE",
    "CODEX_",
    "OPENAI_",
)
# The URL of a remote, over HTTPS or SSH. Group 1 holds the repository's owner, and group 2 its name.
REMOTE_URL = re.compile(
    r"^(?:[a-z+]+://(?:[^/@]+@)?[^/:]+(?::\d+)?/|[^/@]+@[^/:]+:)([^/]+)/([^/]+?)(?:\.git)?/?$", re.IGNORECASE
)

