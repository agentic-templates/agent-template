#!/usr/bin/env -S uv run --script --quiet
"""Starts a builder for one issue with Claude Code or Codex, waits for it to end, and says where its report is.

  scripts/loop/run-builder <issue> <kind> --tool claude|codex [--account NAME] [--model MODEL] [--effort EFFORT]

<issue> <kind> is the line that scripts/take-next-issue printed, such as 12 other. The builder runs on the account
called NAME in .loop/accounts.json, which scripts/loop/meter --help describes, or on the tool's first account there.
It works in .claude/worktrees/run-<issue> in the main checkout, on the issue's branch, and the script removes the
worktree when the run ends. The script doesn't start when that worktree exists already, or when the issue has
needs-triage.

A Claude builder builds the issue as "Build one issue" in docs/building.md describes.

A Codex builder runs in a sandbox that can't reach the network or write the git folder, so it only edits files, and
it builds only the kinds research and other. When it ends, the script commits its changes and pushes them, unless a file's
name suggests a secret, or scripts/leak-scan or the main checkout's git hooks refuse the commit. If the branch has no
pull request yet, the script opens one with the builder's report as its description, and turns on auto-merge unless
scripts/check-main-rules fails. If scripts/loop/consequential lists a file that the branch changes, the pull request
is a draft without auto-merge instead, also when the branch had it already. If the builder changed no file, its
report becomes a comment on the issue.

The last line gives the issue, the tool and the account, how the run ended, its minutes, and where the builder's
report is. The run folder, .loop/runs/<issue>-<time>, keeps the brief, the builder's events and report, and
status.json. The script exits with code 1 when the run fails or doesn't start.
"""

import argparse
import datetime as dt
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, NamedTuple

import paths
from accounts import TOOLS, Account, AccountsError, claude_environment, load_accounts

# The checkout that holds this script. The script runs this checkout's checks, such as scripts/hooks/before-tool,
# because the worktree's copies are files that the builder can change, and they would run outside Codex's sandbox.
TRUSTED_ROOT = Path(__file__).resolve().parents[2]
CLAUDE_COMMAND = [
    "claude",
    "-p",
    "--permission-mode",
    "auto",
    "--permission-prompts",
    "none",
    "--output-format",
    "stream-json",
    "--verbose",
]
COMMIT_TYPES = {"feature": "feat", "bug": "fix", "maintenance": "chore"}
# The kinds that scripts/take-next-issue prints. A Codex builder builds only CODEX_KINDS, because the others need gh.
KIND = re.compile(r"research|parent|other|left behind [1-9][0-9]*")
CODEX_KINDS = ("research", "other")
# Codex runs without the variables whose names match, because they can hold a credential, which it can't use in its
# sandbox, or choose another account, such as CODEX_HOME. What it prints ends up in the run folder and on GitHub.
CREDENTIAL_NAME = re.compile(r"TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|API_?KEY|PRIVATE", re.IGNORECASE)
CREDENTIAL_PREFIXES = (
    "GH_",
    "GITHUB_",
    "ANTHROPIC_",
    "AWS_",
    "AZURE_",
    "GOOGLE_",
    "SSH_",
    "CLAUDE",
    "CODEX_",
    "OPENAI_",
)
# The URL of a remote, over HTTPS or SSH. Group 1 holds the repository's owner, and group 2 its name.
REMOTE_URL = re.compile(
    r"^(?:[a-z+]+://(?:[^/@]+@)?[^/:]+(?::\d+)?/|[^/@]+@[^/:]+:)([^/]+)/([^/]+?)(?:\.git)?/?$", re.IGNORECASE
)

SHARED_BRIEF = """You build this issue, of the kind `{kind}`, for the orchestrator of this repository's loop. Read only
"Build one issue" in docs/building.md first. Nobody answers questions while you work, so decide what you can.
"""
CLAUDE_BRIEF = """You work in a worktree of your own, on the issue's branch. If you can't finish the issue, give it back
as that section describes.
"""
CODEX_BRIEF = """Your sandbox can't write the git folder or reach the network, so don't run git or gh. Edit the files in
this worktree, which is on the issue's branch. scripts/check stops with an error where it writes to the git folder or
to uv's cache. CI runs every check on the pull request.

When you end, the script that started you commits your changes, pushes them and opens a pull request, with your last
message under "What changed and why" in its description. Write that message for a developer who joins the project
later, as docs/writing.md says. If scripts/loop/consequential lists a file that your change touches, the pull request
is a draft, because a reviewer reads it before it merges. If you change no file, your last message becomes a comment
on the issue instead: for a research issue, your answer with a recommendation and the evidence, and otherwise what you
need to finish the issue.
"""


class Stop(Exception):
    """Ends the run, with the reason."""


class Folders(NamedTuple):
    checkout: Path
    worktree: Path
    run: Path
    # The main checkout's git hooks folder, as an absolute path. A relative core.hooksPath would name the worktree's
    # copies of the hooks.
    hooks: str


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/loop/run-builder", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("issue", type=int)
    parser.add_argument("kind", nargs="+", help="the issue's kind, as scripts/take-next-issue printed it")
    parser.add_argument("--tool", required=True, choices=TOOLS)
    parser.add_argument("--account", help="the account's name in .loop/accounts.json")
    parser.add_argument("--model")
    parser.add_argument("--effort")
    options = parser.parse_args(argv)
    kind = " ".join(options.kind)
    checkout = paths.main_checkout(Path.cwd())
    worktree = checkout / ".claude" / "worktrees" / f"run-{options.issue}"
    try:
        check_kind(kind, options.tool)
        account = pick_account(load_accounts(paths.loop_dir() / "accounts.json"), options.tool, options.account)
        check_can_start(options.tool, worktree)
        repository = github_repository(checkout)
        # Every gh command from here on acts on that repository, the builder's too.
        os.environ["GH_REPO"] = repository
        issue = read_issue(options.issue, checkout)
        hooks = run_ok(["git", "rev-parse", "--path-format=absolute", "--git-path", "hooks"], checkout).strip()
    except (AccountsError, Stop) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1

    started = dt.datetime.now().astimezone()
    folders = Folders(checkout, worktree, paths.loop_dir() / "runs" / f"{options.issue}-{started:%Y%m%d-%H%M%S}", hooks)
    folders.run.mkdir(parents=True)
    begun = time.monotonic()
    try:
        outcome = build(options, kind, account, issue, repository, folders)
        is_ok = True
    except Stop as stop:
        outcome = f"failed: {stop}"
        is_ok = False
    minutes = (time.monotonic() - begun) / 60
    status = {
        "issue": options.issue,
        "tool": options.tool,
        "account": account["name"],
        "started": started.isoformat(timespec="seconds"),
        "minutes": round(minutes, 1),
        "outcome": outcome,
    }
    (folders.run / "status.json").write_text(json.dumps(status, indent=2) + "\n")
    report = folders.run / "report.md"
    where = f"report {report}" if report.exists() else f"no report, see {folders.run}"
    print(f"issue {options.issue} | {options.tool} {account['name']} | {outcome} | {minutes:.1f} min | {where}")
    return 0 if is_ok else 1


def build(
    options: argparse.Namespace, kind: str, account: Account, issue: dict[str, Any], repository: str, folders: Folders
) -> str:
    """Runs the builder in its worktree, and returns how the run ended."""
    try:
        branch = make_worktree(issue["number"], repository, folders)
        brief = brief_for(issue, kind, options.tool)
        (folders.run / "brief.md").write_text(brief)
        if options.tool == "claude":
            model_options = [*option("--model", options.model), *option("--effort", options.effort)]
            run_claude(brief, account, model_options, folders)
            return "finished"
        effort = f'model_reasoning_effort="{options.effort}"' if options.effort else None
        run_codex(brief, account, [*option("--model", options.model), *option("--config", effort)], folders)
        return finish_codex(issue, branch, folders)
    finally:
        # Another run on the issue can't start while the worktree exists, and scripts/start-issue can't check out the
        # branch while the worktree has it.
        if folders.worktree.exists():
            git(["worktree", "remove", "--force", str(folders.worktree)], folders.checkout, folders.hooks)


def option(flag: str, value: str | None) -> list[str]:
    return [flag, value] if value else []


def check_kind(kind: str, tool: str) -> None:
    if not KIND.fullmatch(kind):
        raise Stop(
            f'"{kind}" isn\'t a kind that scripts/take-next-issue prints: research, parent, left behind <pull request> '
            "or other. Give the line that it printed for the issue."
        )
    if tool == "codex" and kind not in CODEX_KINDS:
        raise Stop(f"a Codex builder can't build an issue of the kind {kind}, because it needs gh. Use --tool claude.")


def pick_account(accounts: list[Account], tool: str, name: str | None) -> Account:
    for account in accounts:
        if account["tool"] == tool and (name is None or account["name"] == name):
            return account
    wanted = f"no {tool} account called {name}" if name else f"no {tool} account"
    raise Stop(f".loop/accounts.json lists {wanted}. Add it, as scripts/loop/meter --help shows, or name another one.")


def check_can_start(tool: str, worktree: Path) -> None:
    for program in ("gh", tool):
        if shutil.which(program) is None:
            raise Stop(f"{program} isn't installed. Install it, and run the script again.")
    if worktree.exists():
        raise Stop(
            f"{worktree} exists already, so another run may still use it. Once nobody needs it, remove it with git "
            "worktree remove, and run the script again."
        )


def github_repository(checkout: Path) -> str:
    """The repository that gh acts on, which must be origin's, because the script acts on it with both gh and git."""
    named = run(["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"], checkout)
    if named.returncode != 0:
        raise Stop(f"can't tell which repository gh acts on, because gh failed: {one_line(named.stderr)}")
    url = run(["git", "config", "--get", "remote.origin.url"], checkout).stdout.strip()
    found = REMOTE_URL.match(url)
    if not found:
        raise Stop(
            f'can\'t find the owner and the name of the repository in the URL of origin, "{url}". Set it to the '
            "repository's URL on GitHub with git remote set-url origin <URL>."
        )
    gh_repository, origin = named.stdout.strip(), f"{found[1]}/{found[2]}"
    if gh_repository.lower() != origin.lower():
        raise Stop(
            f"gh acts on {gh_repository}, and origin is {origin}. Set GH_REPO to {origin}, or run the script in a "
            f"checkout of {gh_repository}."
        )
    return gh_repository


def read_issue(number: int, checkout: Path) -> dict[str, Any]:
    issue: dict[str, Any] = json.loads(
        run_ok(["gh", "issue", "view", str(number), "--json", "number,title,body,labels"], checkout)
    )
    if "needs-triage" in label_names(issue):
        raise Stop(shell_function("needs-triage", 'needs_triage_message "$1" "$1"', str(number)).strip())
    return issue


def label_names(issue: dict[str, Any]) -> list[str]:
    return [label["name"] for label in issue["labels"]]


def make_worktree(issue: int, repository: str, folders: Folders) -> str:
    """Adds the worktree on the issue's branch, and returns the branch."""
    git(["fetch", "--prune", "--quiet", "origin"], folders.checkout, folders.hooks)
    branch = newest_linked_branch(issue, repository, folders.checkout)
    if branch is None:
        run_ok(["gh", "issue", "develop", str(issue)], folders.checkout)
        git(["fetch", "--quiet", "origin"], folders.checkout, folders.hooks)
        branch = newest_linked_branch(issue, repository, folders.checkout)
    if branch is None:
        raise Stop(f"gh issue develop created no branch for issue #{issue} that origin has.")
    git(["worktree", "add", "--quiet", str(folders.worktree), branch], folders.checkout, folders.hooks)
    git(["merge", "--ff-only", "--quiet", f"refs/remotes/origin/{branch}"], folders.worktree, folders.hooks)
    return branch


def newest_linked_branch(issue: int, repository: str, checkout: Path) -> str | None:
    """Of the branches that gh lists for the issue in the repository and that origin has, the one whose latest commit
    is newest, as scripts/start-issue picks it."""
    newest: tuple[int, str] | None = None
    # gh prints each branch, a tab and the branch's URL.
    for line in run_ok(["gh", "issue", "develop", "--list", str(issue)], checkout).splitlines():
        branch, _, url = line.partition("\t")
        commit_time = run(["git", "log", "-1", "--format=%ct", f"refs/remotes/origin/{branch}", "--"], checkout)
        if f"/{repository}/".lower() not in url.lower() or commit_time.returncode != 0:
            continue
        candidate = (int(commit_time.stdout), branch)
        newest = max(newest or candidate, candidate)
    return newest[1] if newest else None


def brief_for(issue: dict[str, Any], kind: str, tool: str) -> str:
    issue_text = f"Issue #{issue['number']}: {issue['title']}\n\n{issue['body']}\n\n---\n\n"
    return issue_text + SHARED_BRIEF.format(kind=kind) + (CLAUDE_BRIEF if tool == "claude" else CODEX_BRIEF)


def run_claude(brief: str, account: Account, model_options: list[str], folders: Folders) -> None:
    """Runs claude until it ends, and writes its result to report.md in the run folder."""
    # The variable makes claude wait through a usage limit.
    environment = claude_environment(account) | {"CLAUDE_CODE_RETRY_WATCHDOG": "1"}
    result: dict[str, Any] | None = None
    with (
        (folders.run / "events.jsonl").open("w") as events,
        (folders.run / "stderr.log").open("w") as errors,
        subprocess.Popen(
            [*CLAUDE_COMMAND, *model_options, brief],
            cwd=folders.worktree,
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=errors,
            text=True,
        ) as process,
    ):
        assert process.stdout is not None
        for line in process.stdout:
            events.write(line)
            event = parse_event(line)
            mode = event.get("permissionMode")
            if event.get("type") == "system" and event.get("subtype") == "init" and mode != "auto":
                process.kill()
                raise Stop(
                    f"claude started in permission mode {mode}, not auto, so it would be denied each action that "
                    "needs permission."
                )
            if event.get("type") == "result":
                result = event
        exit_code = process.wait()
    if result is None:
        raise Stop(f"claude ended with code {exit_code} and gave no result. stderr.log in the run folder says why.")
    problem = claude_problem(result, exit_code)
    if problem:
        raise Stop(problem)
    (folders.run / "report.md").write_text(str(result.get("result", "")))


def claude_problem(result: dict[str, Any], exit_code: int) -> str | None:
    """Why a Claude run with this result event failed, or None."""
    if result.get("subtype") != "success" or result.get("is_error"):
        errors = result.get("errors") or [result.get("result") or "no message"]
        return f"claude's result is {result.get('subtype')}: {', '.join(map(str, errors))}"
    if exit_code != 0:
        return f"claude ended with code {exit_code} after its result. stderr.log in the run folder says why."
    return None


def run_codex(brief: str, account: Account, model_options: list[str], folders: Folders) -> None:
    """Runs codex until it ends. Codex writes its last message to report.md in the run folder."""
    command = [
        "codex",
        "exec",
        "--sandbox",
        "workspace-write",
        "--cd",
        str(folders.worktree),
        "--json",
        "--output-last-message",
        str(folders.run / "report.md"),
        *model_options,
        brief,
    ]
    with (folders.run / "events.jsonl").open("w") as events, (folders.run / "stderr.log").open("w") as errors:
        done = subprocess.run(
            command,
            cwd=folders.worktree,
            env=codex_environment(account),
            stdin=subprocess.DEVNULL,
            stdout=events,
            stderr=errors,
            check=False,
        )
    events_text = (folders.run / "events.jsonl").read_text()
    problem = codex_problem(list(map(parse_event, events_text.splitlines())), done.returncode)
    if problem:
        raise Stop(problem)


def codex_environment(account: Account) -> dict[str, str]:
    """This process's environment without the variables that CREDENTIAL_NAME and CREDENTIAL_PREFIXES match, and with
    the account's variables."""
    kept = {
        name: value
        for name, value in os.environ.items()
        if not CREDENTIAL_NAME.search(name) and not name.startswith(CREDENTIAL_PREFIXES)
    }
    return kept | account["env"]


def codex_problem(events: list[dict[str, Any]], exit_code: int) -> str | None:
    """Why a Codex run with these events failed, or None. Its last event about its turn must say that the turn
    completed."""
    turns = [event for event in events if event.get("type") in ("turn.started", "turn.completed", "turn.failed")]
    if not turns:
        return f"codex ended with code {exit_code} before its turn started. stderr.log in the run folder says why."
    last = turns[-1]
    if last["type"] == "turn.failed":
        return f"codex's turn failed: {last.get('error', {}).get('message', 'no message')}"
    if last["type"] == "turn.started":
        return f"codex ended with code {exit_code} before its turn completed. stderr.log in the run folder says why."
    if exit_code != 0:
        return f"codex ended with code {exit_code} after its turn. stderr.log in the run folder says why."
    return None


def parse_event(line: str) -> dict[str, Any]:
    """The event on a line of a builder's output, or an empty one when the line holds none."""
    try:
        event = json.loads(line)
    except ValueError:
        return {}
    return event if isinstance(event, dict) else {}


def finish_codex(issue: dict[str, Any], branch: str, folders: Folders) -> str:
    """Posts what codex did: the pull request of its changes, or its report as a comment when it changed no file.
    Returns the outcome."""
    report_file = folders.run / "report.md"
    report = report_file.read_text().strip() if report_file.exists() else ""
    if not report:
        raise Stop("codex wrote no report, so the script can't describe its change or post its answer.")
    if git(["status", "--porcelain"], folders.worktree, folders.hooks).strip():
        return push_changes(issue, branch, folders, report)
    comment = ["gh", "issue", "comment", str(issue["number"]), "--body", report]
    reason = hook_block(comment, folders.checkout)
    if reason:
        raise Stop(f"the hooks would block codex's report as a comment on the issue: {reason}")
    run_ok(comment, folders.checkout)
    return "comment"


def push_changes(issue: dict[str, Any], branch: str, folders: Folders, report: str) -> str:
    """Commits the changes and checks the commit, pushes it, and opens a pull request if the branch has none. Returns
    the outcome."""
    title = commit_subject(issue)
    head = commit_changes(title, folders)
    scan_for_leaks(f"refs/remotes/origin/{branch}..{head}", folders.checkout)
    needs_review = is_consequential(head, folders.checkout)
    pull_request = own_pull_request(branch, folders.checkout)
    body = pull_request_body(issue["number"], report)
    if pull_request is None:
        problems = pull_request_problems(title, body, head, folders.checkout)
        if problems:
            raise Stop(f"the pull request's text has problems, so the script pushed nothing: {problems}")
    elif needs_review:
        hold_for_review(pull_request, folders.checkout)
    git(["push", "--quiet", "origin", f"{head}:refs/heads/{branch}"], folders.worktree, folders.hooks)
    if pull_request is not None:
        return pull_request_outcome(str(pull_request["number"]), needs_review or pull_request["isDraft"])
    return open_pull_request(title, body, branch, head, needs_review, folders.checkout)


def commit_changes(title: str, folders: Folders) -> str:
    """Commits the changes in the worktree, unless a file's name suggests a secret, and returns the commit."""
    # The commit stays off the local branch, so that a commit that a check refuses can't go out with a later push.
    git(["switch", "--quiet", "--detach"], folders.worktree, folders.hooks)
    git(["add", "--all"], folders.worktree, folders.hooks)
    staged = git(["diff", "--cached", "--name-only", "--diff-filter=d", "-z"], folders.worktree, folders.hooks)
    secrets = secret_names([path for path in staged.split("\0") if path])
    if secrets:
        raise Stop(f"codex left files whose names suggest a secret, so the script pushed nothing: {', '.join(secrets)}")
    git(["commit", "--quiet", "--message", title], folders.worktree, folders.hooks)
    return git(["rev-parse", "HEAD"], folders.worktree, folders.hooks).strip()


def commit_subject(issue: dict[str, Any]) -> str:
    types = [COMMIT_TYPES[name] for name in label_names(issue) if name in COMMIT_TYPES]
    return f"{types[0] if types else 'chore'}: {issue['title']}"


def pull_request_body(number: int, report: str) -> str:
    return f"Closes #{number}\n\n## What changed and why\n\n{report}\n"


def secret_names(files: list[str]) -> list[str]:
    """The files whose names suggest a secret, as has_secret_name in scripts/secret-file-names tells."""
    each = 'for file in "$@"; do if has_secret_name "$file"; then printf "%s\\n" "$file"; fi; done'
    return shell_function("secret-file-names", each, *files).splitlines()


def scan_for_leaks(commits: str, checkout: Path) -> None:
    done = subprocess.run(
        [TRUSTED_ROOT / "scripts" / "leak-scan", "--range", commits],
        cwd=checkout,
        capture_output=True,
        text=True,
        check=False,
    )
    if done.returncode != 0:
        problems = one_line(done.stdout + done.stderr)
        raise Stop(f"scripts/leak-scan refused codex's commit, so the script pushed nothing: {problems}")


def is_consequential(head: str, checkout: Path) -> bool:
    """Whether scripts/loop/consequential lists a file that the branch changes against main. The script exits with
    code 1 when it crashes too, so only its own line says that a change isn't consequential."""
    done = subprocess.run(
        [TRUSTED_ROOT / "scripts" / "loop" / "consequential", f"refs/remotes/origin/main...{head}"],
        cwd=checkout,
        capture_output=True,
        text=True,
        check=False,
    )
    if done.returncode == 0:
        return True
    if done.returncode == 1 and done.stdout.strip() == "Not consequential.":
        return False
    raise Stop(
        "scripts/loop/consequential can't tell whether a reviewer must read the change, so the script pushed "
        f"nothing: {one_line(done.stderr or done.stdout)}"
    )


def own_pull_request(branch: str, checkout: Path) -> dict[str, Any] | None:
    """The branch's open pull request, if it has one. A pull request from a fork can come from a branch of the same
    name, and a push doesn't change it."""
    fields = "number,isCrossRepository,isDraft,autoMergeRequest"
    listed = json.loads(run_ok(["gh", "pr", "list", "--head", branch, "--state", "open", "--json", fields], checkout))
    own = [pull_request for pull_request in listed if not pull_request["isCrossRepository"]]
    return own[0] if own else None


def hold_for_review(pull_request: dict[str, Any], checkout: Path) -> None:
    """Turns off the pull request's auto-merge and makes it a draft, so that the change that the push adds waits for a
    reviewer."""
    number = str(pull_request["number"])
    if pull_request["autoMergeRequest"]:
        run_ok(["gh", "pr", "merge", number, "--disable-auto"], checkout)
    if not pull_request["isDraft"]:
        run_ok(["gh", "pr", "ready", number, "--undo"], checkout)


def open_pull_request(title: str, body: str, branch: str, head: str, is_draft: bool, checkout: Path) -> str:
    """Opens the pull request, as a draft or with auto-merge, and returns the outcome."""
    command = ["gh", "pr", "create", "--title", title, "--body", body, "--head", branch, "--base", "main"]
    created = run_ok([*command, "--draft"] if is_draft else command, checkout)
    # gh prints the new pull request's URL, which ends in its number.
    number = created.strip().rsplit("/", 1)[-1]
    if is_draft:
        return pull_request_outcome(number, True)
    return f"{pull_request_outcome(number, False)}{turn_on_auto_merge(number, head, checkout)}"


def pull_request_outcome(number: str, is_draft: bool) -> str:
    return f"draft pull request #{number}" if is_draft else f"pull request #{number}"


def hook_block(command: list[str], checkout: Path) -> str:
    """Why scripts/hooks/before-tool would block an agent's command, or an empty string if it wouldn't."""
    hook_input = {"tool_name": "Bash", "tool_input": {"command": shlex.join(command)}, "cwd": str(checkout)}
    done = subprocess.run(
        [TRUSTED_ROOT / "scripts" / "hooks" / "before-tool"],
        input=json.dumps(hook_input),
        capture_output=True,
        text=True,
        check=False,
    )
    # The hook blocks with code 2, and allows the command with any other code, as when it fails on its own error.
    return one_line(done.stderr) if done.returncode == 2 else ""


def pull_request_problems(title: str, body: str, head: str, checkout: Path) -> str:
    """The problems that scripts/check-pull-request finds in a pull request into main, or an empty string."""
    done = subprocess.run(
        [TRUSTED_ROOT / "scripts" / "check-pull-request", "refs/remotes/origin/main", head],
        cwd=checkout,
        env=os.environ | {"TITLE": title, "BODY": body},
        capture_output=True,
        text=True,
        check=False,
    )
    return "" if done.returncode == 0 else one_line((done.stdout + done.stderr).replace("::error::", ""))


def turn_on_auto_merge(number: str, head: str, checkout: Path) -> str:
    """Turns on auto-merge for the pull request at the commit that the script pushed, as the after-tool hook does for
    an agent's pull request. Returns what the outcome adds."""
    rules = subprocess.run([TRUSTED_ROOT / "scripts" / "check-main-rules"], capture_output=True, text=True, check=False)
    # The script exits with code 1 when main lacks a required check, and with 2 when it can't tell.
    if rules.returncode == 1:
        return f", auto-merge off: {one_line(rules.stderr).removeprefix('error: ')}"
    run_ok(["gh", "pr", "merge", number, "--match-head-commit", head], checkout)
    return ""


def shell_function(file: str, call: str, *arguments: str) -> str:
    """The output of a call of the functions in a file in scripts/ of the checkout that holds this script, such as
    scripts/needs-triage."""
    done = subprocess.run(
        ["bash", "-c", f'source "$0" && {call}', TRUSTED_ROOT / "scripts" / file, *arguments],
        capture_output=True,
        text=True,
        check=True,
    )
    return done.stdout


def git(arguments: list[str], folder: Path, hooks: str) -> str:
    """The output of a git command that must succeed. Git runs the hooks in the folder hooks, as an absolute path."""
    return run_ok(["git", "-c", f"core.hooksPath={hooks}", *arguments], folder)


def run(command: list[str], folder: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, cwd=folder, capture_output=True, text=True, check=False)


def run_ok(command: list[str], folder: Path) -> str:
    """The output of a command that must succeed. A failure ends the run with the command's error."""
    done = run(command, folder)
    if done.returncode != 0:
        raise Stop(f"{command[0]} failed: {one_line(done.stderr or done.stdout)}")
    return done.stdout


def one_line(text: str) -> str:
    return " ".join(text.split())


if __name__ == "__main__":
    sys.exit(main())
