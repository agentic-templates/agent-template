# The period over which the meter measures the usage per agent-minute. It measures from the newest reading at least
# this old. A reading older than LONGEST_READING_GAP is from before a time when the loop stopped, and measures nothing.
USAGE_PERIOD = dt.timedelta(minutes=30)
# A pass of the loop starts its agents from the reading that it starts with, so --start-on names an account only from a
# reading this recent.
OLDEST_START_READING = dt.timedelta(minutes=30)
# Waiting at a stop wakes the orchestrator every 50 minutes, and each wake spends some of the week. So a weekly meter
# that reaches its limit further than this from its reset parks the account instead.
LONGEST_STOP = dt.timedelta(hours=10)
SHORTEST_WAIT_SECONDS = 60
# A wait for a reset ends this long after it, so that the next reading sees the new window.
AFTER_RESET_SECONDS = 60
UNKNOWN_RESET_WAIT_SECONDS = 10 * 60
LATEST_TIME = dt.datetime.max.replace(tzinfo=dt.UTC)
EARLIEST_TIME = dt.datetime.min.replace(tzinfo=dt.UTC)
CLAUDE_TIMEOUT_SECONDS = 120
# How often meter --wake looks for a new note of scripts/hooks/hand-off between two readings
HAND_OFF_CHECK_SECONDS = 60
# The longest that meter --wake waits between two readings while an account has no reading, so that it sees the
# reading come back
NO_READING_WAIT_SECONDS = 10 * 60
# The most agents that build that the machine has room for. Each runs scripts/check, which waits in
# scripts/loop/run-heavy while the machine has no room for it. A retrospective changes this from the "Machine" lines of
# scripts/loop/report, which give the readings for each number of agents that worked.
MOST_BUILDING_AGENTS = 6
# The types of the agents that build start with this, as do the versions of them that a retrospective tests.
BUILDER_TYPE_PREFIX = "builder"
# .claude/agents/auditor.md says when a retrospective sets this.
OUTPUT_TOKENS_PER_RETROSPECTIVE: int | None = None
HOURS_PER_RETROSPECTIVE = 30.0
# A retrospective doesn't look back on the work of an earlier one.
AUDITOR = "auditor"
# The subjects of the findings of scripts/loop/waste.py that the meter printed last, so that meter --wake wakes only
# for a new one
PRINTED_FINDINGS = "printed-findings.json"


class Advice(NamedTuple):
    # go, stop, parked, or the types that fit, separated by commas
    text: str
    wait_seconds: int
    # The types that fit
    fitting: list[str]


class Readings(NamedTuple):
    lines: list[str]
    advice: dict[str, str]
    # The shortest wait that an account's advice asks for
    wait_seconds: int
    has_every_account: bool
    # The machine at the last reading
    machine: Machine


class Agent(NamedTuple):
    # How the agents line names the agent: its type, and its issue or pull request
    name: str
    # The subagent's agent id or the run's session id, which names the notes of scripts/hooks/hand-off
    key: str | None
    context: int | None
    is_building: bool


class NoReading(Exception):
    """Why an account gave no reading, with what to do about it."""


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/loop/meter", description=help_text(), formatter_class=argparse.RawDescriptionHelpFormatter
    )
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--wake", action="store_true", help="keep reading until the orchestrator needs to wake")
    modes.add_argument(
        "--start-on",
        metavar="TYPE",
        choices=agent_types("claude"),
        help="print the Claude account to start an agent of the type on, without reading the accounts",
    )
    modes.add_argument(
        "--hand-off",
        metavar="ID",
        help="print the note that scripts/hooks/hand-off gives the agent for its account's room, without reading the "
        "accounts",
    )
    options = parser.parse_args(argv)
    loop_folder = paths.loop_dir()
    loop_folder.mkdir(parents=True, exist_ok=True)
    if options.hand_off:
        runs = agent_log.read_runs(loop_folder / "agents.jsonl")
        note = hand_off_note(options.hand_off, runs, loop_folder / "meter.jsonl", loop_folder / FOLDER_NAME)
        print(note or "none")
        return 0
    try:
        accounts = load_accounts(loop_folder / "accounts.json")
    except AccountsError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    log = loop_folder / "meter.jsonl"
    if options.start_on:
        return start_on(options.start_on, accounts, log)
    hand_offs = loop_folder / FOLDER_NAME
    checkout = paths.main_checkout()
    printed = loop_folder / PRINTED_FINDINGS
    if options.wake:
        readings = wait_for_wake(accounts, log, hand_offs, lambda: has_new_finding(loop_folder, checkout, printed))
    else:
        readings = read_accounts(accounts, log)
    transcripts = agent_log.agent_transcripts(paths.claude_project_folder(checkout))
    running = running_agents(loop_folder, transcripts)
    notes = note_files(hand_offs)
    agents = agents_line(running, hand_off_thresholds(notes), told_for_room(notes))
    runs = agent_log.read_runs(loop_folder / "agents.jsonl")
    try:
        last = max(retrospective_merges(checkout), default=None)
    except GitHubError as error:
        last = None
        retrospective = f"retrospective unknown: {error}"
    else:
        retrospective = retrospective_note(last, runs, transcripts, loop_folder)
    model_account = next((account for account in accounts if account["tool"] == "claude"), SIGNED_IN)
    model_notes = models.notes(models.current(loop_folder, model_account, now()), models.tested())
    findings = waste_findings(runs, transcripts, loop_folder, last)
    machine = machine_line(
        readings.machine,
        building=sum(agent.is_building for agent in running),
        context=orchestrator_context(loop_folder / "state.md", checkout),
        retrospective=" | ".join([retrospective, *model_notes]),
        findings=[finding.text for finding in findings],
    )
    printed.write_text(json.dumps([finding.subject for finding in findings]) + "\n")
    print("\n".join([*readings.lines, agents, machine]))
    return 0 if readings.has_every_account else 1


def help_text() -> str:
    """The docstring, with the numbers that the code keeps in place of {hours}, {period}, {gap}, {start}, {building},
    {retry} and {hand_off}, so that changing a number takes one edit. The docstring's JSON example has braces of its
    own, so str.format can't fill it in."""
    numbers = {
        "{hours}": f"{HOURS_PER_RETROSPECTIVE:g}",
        "{period}": f"{USAGE_PERIOD.total_seconds() / 60:g}",
        "{gap}": f"{LONGEST_READING_GAP.total_seconds() / 60:g}",
        "{start}": f"{OLDEST_START_READING.total_seconds() / 60:g}",
        "{building}": str(MOST_BUILDING_AGENTS),
        "{retry}": f"{NO_READING_WAIT_SECONDS / 60:g}",
        "{hand_off}": f"{account_room.FIRST_HAND_OFF_MINUTES:g}",
    }
    text = str(__doc__)
    for placeholder, number in numbers.items():
        text = text.replace(placeholder, number)
    return text


def now() -> dt.datetime:
    return dt.datetime.now().astimezone()


def wait_for_wake(accounts: list[Account], log: Path, hand_offs: Path, has_new_finding: Callable[[], bool]) -> Readings:
    """Reads until an account's advice differs from its advice at the first reading, which it does too when the account
    loses or gets back its reading, until a reading has a new finding of waste, until scripts/hooks/hand-off writes a
    new note in the folder hand_offs, or until the orchestrator needs a wake while it waits for a reset."""
    started = now()
    notes_at_start = note_files(hand_offs)
    first = read_accounts(accounts, log)
    readings = first
    while not has_new_finding():
        wait = readings.wait_seconds
        if not readings.has_every_account:
            wait = min(wait, NO_READING_WAIT_SECONDS)
        if is_waiting_for_reset(readings):
            wait = min(wait, max(0, math.ceil((started + WAKE_EVERY - now()).total_seconds())))
        if sleep_until_hand_off(wait, hand_offs, notes_at_start):
            break
        readings = read_accounts(accounts, log)
        if readings.advice != first.advice:
            break
        if is_waiting_for_reset(readings) and now() - started >= WAKE_EVERY:
            break
    return readings


def is_waiting_for_reset(readings: Readings) -> bool:
    return "stop" in readings.advice.values()


def sleep_until_hand_off(seconds: int, hand_offs: Path, known: set[str]) -> bool:
    """Sleeps for the seconds, or until the folder hand_offs has a note that isn't in known. Returns whether it has."""
    left = seconds
    while left > 0:
        step = min(left, HAND_OFF_CHECK_SECONDS)
        time.sleep(step)
        left -= step
        if note_files(hand_offs) - known:
            return True
    return False


def read_accounts(accounts: list[Account], log: Path) -> Readings:
    lines: list[str] = []
    advice: dict[str, str] = {}
    waits: list[int] = []
    has_every_account = True
    machine_time = now()
    machine = read_machine(log.parent)
    with log.open("a") as handle:
        handle.write(json.dumps({"at": machine_time.isoformat(timespec="seconds"), "machine": machine}) + "\n")
    runs = agent_log.read_runs(log.parent / "agents.jsonl")
    earlier_runs = run_minutes_by_type(runs)
    transcripts = agent_log.agent_transcripts(paths.claude_project_folder(paths.main_checkout()))
    orchestrators = own_account(accounts, os.environ)
    transcript = orchestrator_transcript(log.parent / "state.md", paths.main_checkout())
    orchestrator_periods = agent_log.session_periods(transcript) if transcript else []
    candidates: list[account_room.Candidate] = []
    for account in accounts:
        reading_time = now()
        try:
            meters, notes = read_meters(account, reading_time)
        except NoReading as problem:
            lines.append(f"{account['name']} | no reading: {problem}")
            has_every_account = False
            continue
        reading: dict[str, Any] = {
            "at": reading_time.isoformat(timespec="seconds"),
            "account": account["name"],
            "meters": meters,
        }
        is_orchestrators = orchestrators is not None and orchestrators["name"] == account["name"]
        orchestrator = orchestrator_periods if is_orchestrators else []
        room, measured = read_room(account["name"], meters, reading_time, log, runs, transcripts, orchestrator)
        result = advise(room, agent_types(account["tool"]), earlier_runs, reading_time)
        reading["per_agent_minute"] = measured
        reading["orchestrator_share"] = room.orchestrator_share
        with log.open("a") as handle:
            handle.write(json.dumps(reading) + "\n")
        advice[account["name"]] = result.text
        waits.append(result.wait_seconds)
        lines.append(account_line(account["name"], meters, room.per_agent_minute, result, notes, reading_time))
        if account["tool"] == "claude":
            candidates.append(account_room.Candidate(account["name"], result.fitting, meters, is_orchestrators))
    lines.append(start_line(candidates))
    return Readings(
        lines,
        advice,
        min(waits, default=UNKNOWN_RESET_WAIT_SECONDS),
        has_every_account,
        machine,
    )


def start_on(agent_type: str, accounts: list[Account], log: Path) -> int:
    """Prints the Claude account to start an agent of the type on, as at each account's newest reading, and logs the
    account that it names, so that the next call counts the agent."""
    runs = agent_log.read_runs(log.parent / "agents.jsonl")
    transcripts = agent_log.agent_transcripts(paths.claude_project_folder(paths.main_checkout()))
    candidates = start_candidates(accounts, runs, transcripts, log)
    if not candidates:
        minutes = OLDEST_START_READING.total_seconds() / 60
        print(
            f"error: no Claude account has a reading from the last {minutes:g} minutes. Run scripts/loop/meter, and "
            "then scripts/loop/meter --start-on again.",
            file=sys.stderr,
        )
        return 1
    building = building_since_reading(runs, transcripts, log)
    if is_building({"type": agent_type}) and building >= MOST_BUILDING_AGENTS:
        print("no account")
        print(building_part(building)[0], file=sys.stderr)
        return 0
    named = account_room.account_for(agent_type, candidates)
    if named is not None:
        entry = {"at": now().isoformat(timespec="seconds"), "start_on": named, "type": agent_type}
        with log.open("a") as handle:
            handle.write(json.dumps(entry) + "\n")
    print(named or "no account")
    return 0


def start_candidates(
    accounts: list[Account], runs: list[agent_log.AgentRun], transcripts: dict[str, Path], log: Path
) -> list[account_room.Candidate]:
    """The Claude accounts with a reading from the last OLDEST_START_READING, each with the types that fit its room."""
    earlier_runs = run_minutes_by_type(runs)
    orchestrators = own_account(accounts, os.environ)
    transcript = orchestrator_transcript(log.parent / "state.md", paths.main_checkout())
    orchestrator_periods = agent_log.session_periods(transcript) if transcript else []
    candidates: list[account_room.Candidate] = []
    for account in accounts:
        readings = account_readings(log, account["name"]) if log.exists() else []
        if account["tool"] != "claude" or not readings:
            continue
        reading_time = dt.datetime.fromisoformat(readings[-1]["at"])
        if now() - reading_time > OLDEST_START_READING:
            continue
        is_orchestrators = orchestrators is not None and orchestrators["name"] == account["name"]
        orchestrator = orchestrator_periods if is_orchestrators else []
        share = account_room.working_share(orchestrator, reading_time)
        room = room_at_reading(account["name"], readings, runs, transcripts, log, share)
        fitting = advise(room, agent_types("claude"), earlier_runs, reading_time).fitting
        candidates.append(account_room.Candidate(account["name"], fitting, room.meters, is_orchestrators))
    return candidates


def building_since_reading(runs: list[agent_log.AgentRun], transcripts: dict[str, Path], log: Path) -> int:
    """The agents that build as at the newest reading: those that started before it and still run, each that started
    since then, and each builder that --start-on named an account for since then and that hasn't started yet."""
    entries = [json.loads(line) for line in log.read_text().splitlines()]
    reading_times = [dt.datetime.fromisoformat(entry["at"]) for entry in entries if "start_on" not in entry]
    reading_time = max(reading_times, default=EARLIEST_TIME)
    building = [run for run in runs if is_building(run.start)]
    running = sum(is_running(run, transcripts) for run in building if agent_log.started(run) <= reading_time)
    # Only an agent on a Claude account can be one that --start-on named, because it names only Claude accounts.
    started = [
        (agent_log.started(run), "codex" if run.start["type"] == "codex" else "claude", run.start["id"])
        for run in building
        if agent_log.started(run) > reading_time
    ]
    named = [
        (dt.datetime.fromisoformat(entry["at"]), "claude")
        for entry in entries
        if "start_on" in entry
        and is_building({"type": entry["type"]})
        and dt.datetime.fromisoformat(entry["at"]) >= reading_time
    ]
    return running + len(account_room.agents_since_reading(started, named))


def room_at_reading(
    account: str,
    readings: list[dict[str, Any]],
    runs: list[agent_log.AgentRun],
    transcripts: dict[str, Path],
    log: Path,
    orchestrator_share: float,
) -> account_room.Room:
    """The account's room at its newest reading, with the agents that ran then, and each agent that started on it since
    then or that --start-on named it for since then."""
    newest = readings[-1]
    reading_time = dt.datetime.fromisoformat(newest["at"])
    meters = newest["meters"]
    per_agent_minute = {name: last_measured(readings, name) for name in meters}
    running: list[account_room.Running] = []
    started: list[tuple[dt.datetime, str, str]] = []
    for run in runs:
        if run.start.get("account") != account:
            continue
        if agent_log.started(run) > reading_time:
            started.append((agent_log.started(run), run.start["type"], run.start["id"]))
        elif is_running(run, transcripts) or (
            run.end is not None and dt.datetime.fromisoformat(run.end["at"]) > reading_time
        ):
            minutes = (reading_time - agent_log.started(run)).total_seconds() / 60
            running.append(account_room.Running(run.start["type"], minutes, run.start["id"]))
    entries = (json.loads(line) for line in log.read_text().splitlines())
    namings = [
        (dt.datetime.fromisoformat(entry["at"]), entry["type"]) for entry in entries if entry.get("start_on") == account
    ]
    named = [(at, agent_type) for at, agent_type in namings if at >= reading_time]
    running += account_room.agents_since_reading(started, named)
    return account_room.Room(meters, per_agent_minute, running, orchestrator_share)


def hand_off_note(agent_id: str, runs: list[agent_log.AgentRun], log: Path, hand_offs: Path) -> str | None:
    """The note that scripts/hooks/hand-off gives the agent whose start line has the id, for its account's room, from
    the newest reading of the account, if any. The hook writes the id in the file of each note that it gives."""
    run = next((run for run in runs if run.start["id"] == agent_id), None)
    account: str | None = run.start.get("account") if run else None
    if account is None or not log.exists():
        return None
    readings = account_readings(log, account)
    if not readings:
        return None
    newest = readings[-1]
    reading_time = dt.datetime.fromisoformat(newest["at"])
    # An older reading is from before a time when the loop stopped.
    if now() - reading_time > LONGEST_READING_GAP:
        return None
    transcripts = agent_log.agent_transcripts(paths.claude_project_folder(paths.main_checkout()))
    room = room_at_reading(account, readings, runs, transcripts, log, newest.get("orchestrator_share", 0.0))
    noted = note_times(hand_offs)
    ends = {run.start["id"]: dt.datetime.fromisoformat(run.end["at"]) for run in runs if run.end is not None}
    known = account_room.HandOffs(
        running={
            run.start["id"] for run in runs if run.start.get("account") == account and is_running(run, transcripts)
        },
        told=set(noted),
        minutes=account_room.hand_off_minutes(noted, ends),
    )
    return account_room.hand_off_note(agent_id, room, run_minutes_by_type(runs), reading_time, known)


def read_meters(account: Account, reading_time: dt.datetime) -> tuple[dict[str, Meter], list[str]]:
    """An account's meters, and notes about the reading for its line."""
    if account["tool"] == "codex":
        meters, snapshot_time = read_codex(account, reading_time)
        minutes = (reading_time - snapshot_time).total_seconds() / 60
        return meters, [f"snapshot {minutes:.0f} min old"]
    output = read_claude(account)
    meters = parse_usage(output, reading_time)
    if not meters:
        first_line = next((line.strip() for line in output.splitlines() if line.strip()), "nothing")
        raise NoReading(
            f'claude -p /usage printed no usage meters, and began with "{first_line}". Run it in an empty folder to '
            "see why."
        )
    return meters, []


def read_claude(account: Account) -> str:
    # An empty folder has no project settings or hooks that would run.
    with tempfile.TemporaryDirectory() as folder:
        try:
            done = subprocess.run(
                ["claude", "-p", "/usage"],
                cwd=folder,
                env=claude_environment(account),
                capture_output=True,
                text=True,
                timeout=CLAUDE_TIMEOUT_SECONDS,
                check=False,
            )
        except FileNotFoundError as error:
            raise NoReading("claude isn't installed. Install Claude Code, or remove the account.") from error
        except subprocess.TimeoutExpired as error:
            raise NoReading(
                f"claude -p /usage didn't end within {CLAUDE_TIMEOUT_SECONDS} seconds. Run it in an empty folder to "
                "see why."
            ) from error
    return done.stdout + done.stderr


def read_codex(account: Account, reading_time: dt.datetime) -> tuple[dict[str, Meter], dt.datetime]:
    """The meters of a Codex account, and the time of the snapshot that gives them, as codex_usage.py reads them."""
    sessions = Path(account["env"].get("CODEX_HOME", os.path.expanduser("~/.codex"))) / "sessions"
    found = codex_usage.read_meters(sessions, reading_time)
    if found is None:
        days = codex_usage.SNAPSHOT_AGE.days
        raise NoReading(
            f"Codex wrote no usage snapshot in {sessions} in the last {days} days. Run codex once, and read again."
        )
    return found


def run_minutes_by_type(runs: list[agent_log.AgentRun]) -> dict[str, list[float]]:
    """The minutes of the runs that ended, by type."""
    minutes: dict[str, list[float]] = {}
    for run in runs:
        if run.end is not None:
            minutes.setdefault(run.start["type"], []).append(float(run.end["minutes"]))
    return minutes


def agent_types(tool: str) -> list[str]:
    """The agent types that an account of the tool can start: those in .claude/agents for Claude, and codex for
    Codex, as agents.jsonl names a run of Codex."""
    if tool == "codex":
        return ["codex"]
    return sorted(file.stem for file in agent_log.AGENTS_FOLDER.glob("*.md"))


def read_room(
    account: str,
    meters: dict[str, Meter],
    reading_time: dt.datetime,
    log: Path,
    runs: list[agent_log.AgentRun],
    transcripts: dict[str, Path],
    orchestrator: list[agent_log.Period],
) -> tuple[account_room.Room, dict[str, float]]:
    """The account's room, and the usage per agent-minute that the reading measured. orchestrator holds the periods
    when the orchestrator worked if the account is its own."""
    readings = account_readings(log, account)
    measured: dict[str, float] = {}
    earlier = next((entry for entry in reversed(readings) if is_measuring_base(entry, reading_time)), None)
    if earlier is not None:
        since = dt.datetime.fromisoformat(earlier["at"])
        minutes = agent_minutes(runs, transcripts, account, since, reading_time, log.parent / "runs")
        minutes += agent_log.minutes_after(orchestrator, since)
        measured = account_room.measured_per_agent_minute(meters, earlier["meters"], minutes)
    per_agent_minute = {name: measured.get(name) or last_measured(readings, name) for name in meters}
    running = [
        account_room.Running(run.start["type"], (reading_time - agent_log.started(run)).total_seconds() / 60)
        for run in runs
        if run.start.get("account") == account and is_running(run, transcripts)
    ]
    share = account_room.working_share(orchestrator, reading_time)
    return account_room.Room(meters, per_agent_minute, running, share), measured


def account_readings(log: Path, account: str) -> list[dict[str, Any]]:
    """The account's readings in the log, oldest first."""
    entries = (json.loads(line) for line in log.read_text().splitlines())
    return [entry for entry in entries if entry.get("account") == account]


def is_measuring_base(entry: dict[str, Any], reading_time: dt.datetime) -> bool:
    age = reading_time - dt.datetime.fromisoformat(entry["at"])
    return USAGE_PERIOD <= age <= LONGEST_READING_GAP


def agent_minutes(
    runs: list[agent_log.AgentRun],
    transcripts: dict[str, Path],
    account: str,
    since: dt.datetime,
    reading_time: dt.datetime,
    runs_folder: Path,
) -> float:
    """The minutes that the agents on the account worked since the time. An agent without an end line counts until the
    reading while is_running says that it runs, and until the last line of its transcript or events once it stopped,
    such as when the user interrupted it."""
    minutes = 0.0
    for run in runs:
        if run.start.get("account") != account:
            continue
        if is_running(run, transcripts):
            minutes += agent_log.minutes_after([(agent_log.started(run), reading_time)], since)
        else:
            minutes += agent_log.minutes_after(agent_log.working_periods(run, transcripts, runs_folder), since)
    return minutes


def last_measured(readings: list[dict[str, Any]], meter: str) -> float:
    """The newest usage per agent-minute of the meter in the readings, or the one before the meter measures any."""
    for entry in reversed(readings):
        measured = entry.get("per_agent_minute", {}).get(meter)
        if measured is not None:
            return float(measured)
    return account_room.first_per_agent_minute(meter)


def advise(
    room: account_room.Room, types: list[str], runs: dict[str, list[float]], reading_time: dt.datetime
) -> Advice:
    parking = [
        name
        for name, meter in room.meters.items()
        if name != account_room.SESSION
        and meter["used"] >= account_room.WEEK_LIMIT_PERCENT
        and is_far_from_reset(meter, reading_time)
    ]
    if parking:
        # The account waits for the last reset of the meters that hold it. An unknown reset could be the last.
        waiting_for = max(parking, key=lambda name: reset_time(room.meters[name]) or LATEST_TIME)
        return Advice("parked", wait_for_reset(room.meters[waiting_for], reading_time), [])
    fitting = account_room.fitting_types(room, types, runs, reading_time)
    if not fitting:
        return Advice("stop", wait_at_stop(room, types, runs, reading_time), [])
    state = "go" if fitting == types else "some"
    # A reading after the advice changed comes too late to stop anything, so the next one comes before half the time
    # until it may change.
    until_change = account_room.minutes_until_change(room, fitting, runs, reading_time) * 60 / 2
    wait = int(max(SHORTEST_WAIT_SECONDS, min(READ_EVERY_SECONDS[state], until_change)))
    return Advice("go" if state == "go" else ", ".join(fitting), wait, fitting)


def wait_at_stop(
    room: account_room.Room, types: list[str], runs: dict[str, list[float]], reading_time: dt.datetime
) -> int:
    """The wait until the last reset of the meters on which the shortest type doesn't fit, or a shorter one while agents
    run on the account, because the room that they need comes back as they end."""
    shortest = min(types, key=lambda agent_type: account_room.run_minutes(agent_type, runs))
    full = [name for name in room.meters if not account_room.fits(shortest, name, room, runs, reading_time)]
    waiting_for = max(full, key=lambda name: reset_time(room.meters[name]) or LATEST_TIME)
    wait = wait_for_reset(room.meters[waiting_for], reading_time)
    return min(wait, READ_EVERY_SECONDS["some"]) if room.running else wait


def is_far_from_reset(meter: Meter, reading_time: dt.datetime) -> bool:
    reset = reset_time(meter)
    return reset is None or reset - reading_time > LONGEST_STOP


def reset_time(meter: Meter) -> dt.datetime | None:
    return dt.datetime.fromisoformat(meter["resets"]) if meter["resets"] else None


def wait_for_reset(meter: Meter, reading_time: dt.datetime) -> int:
    reset = reset_time(meter)
    if reset is None:
        return UNKNOWN_RESET_WAIT_SECONDS
    return max(SHORTEST_WAIT_SECONDS, int((reset - reading_time).total_seconds()) + AFTER_RESET_SECONDS)


def account_line(
    name: str,
    meters: dict[str, Meter],
    per_agent_minute: dict[str, float],
    advice: Advice,
    notes: list[str],
    reading_time: dt.datetime,
) -> str:
    parts = [f"{name} {reading_time:%H:%M}"]
    parts += [f"{meter_name} {describe(meter, reading_time)}" for meter_name, meter in meters.items()]
    usage = ", ".join(f"{meter_name} {percent:.2g}%" for meter_name, percent in per_agent_minute.items())
    parts.append(f"per agent-minute {usage}")
    return " | ".join([*parts, *notes, advice.text])


def start_line(candidates: list[account_room.Candidate]) -> str:
    """The line that names the account to start each type on, other than the auditor, which starts on the
    orchestrator's own account."""
    types = [agent_type for agent_type in agent_types("claude") if agent_type != AUDITOR]
    parts = ["start on"]
    for agent_type in types:
        account = account_room.account_for(agent_type, candidates)
        parts.append(f"{agent_type} {account or 'no account'}")
    return " | ".join(parts)


def describe(meter: Meter, reading_time: dt.datetime) -> str:
    reset = reset_time(meter)
    if reset is None:
        return f"{meter['used']:g}%"
    reset = reset.astimezone(reading_time.tzinfo)
    # A reset more than 20 hours away needs its day, so that it isn't read as today's or tomorrow's.
    shown = f"{reset:%a %H:%M}" if reset - reading_time > dt.timedelta(hours=20) else f"{reset:%H:%M}"
    return f"{meter['used']:g}% resets {shown}"


def machine_line(machine: Machine, building: int, context: int | None, retrospective: str, findings: list[str]) -> str:
    memory, swap = machine["memory_free_gb"], machine["swap_used_gb"]
    context_part = "orchestrator context unknown" if context is None else f"orchestrator context {context // 1000}k"
    return " | ".join(
        [
            "machine",
            f"disk {machine['disk_free_gb']:.0f} GB free",
            "memory unknown" if memory is None else f"memory {memory:.0f} GB free",
            "swap unknown" if swap is None else f"swap {swap:.1f} GB used",
            gpu_part(machine),
            f"load {machine['load']:.1f} on {machine['cores']} cores",
            *building_part(building),
            context_part,
            retrospective,
            *(f"audit due: {finding}" for finding in findings),
        ]
    )


def building_part(building: int) -> list[str]:
    if building < MOST_BUILDING_AGENTS:
        return []
    return [f"{building} agents build, and the limit is {MOST_BUILDING_AGENTS}: start no builder or test build"]


def gpu_part(machine: Machine) -> str:
    percent, memory = machine["gpu_percent"], machine["gpu_memory_used_gb"]
    if percent is None and memory is None:
        return "GPU unknown"
    use = "GPU use unknown" if percent is None else f"GPU {percent:.0f}% busy"
    if memory is None:
        return f"{use}, memory unknown"
    whose = "of the main memory" if machine["gpu_shares_memory"] else "of its own memory"
    return f"{use}, {memory:.1f} GB {whose}"


def running_agents(loop_folder: Path, transcripts: dict[str, Path]) -> list[Agent]:
    """The agents that run, as is_running tells from agents.jsonl in the loop folder. An agent of a session reads its
    context from its transcript, and a run of scripts/loop/run-builder from its events in its run folder."""
    agents = []
    for run in agent_log.read_runs(loop_folder / "agents.jsonl"):
        if not is_running(run, transcripts):
            continue
        issue = run.start.get("issue")
        name = f"{run.start['type']} #{issue}" if issue else run.start["type"]
        building = is_building(run.start)
        transcript = transcripts.get(run.start["id"])
        if transcript is not None:
            agents.append(Agent(name, transcript.stem.removeprefix("agent-"), context_tokens(transcript), building))
            continue
        events = loop_folder / "runs" / run.start["id"] / "events.jsonl"
        session = run_session(events) if events.exists() else None
        agents.append(Agent(name, session, context_tokens(events), building))
    return agents


def is_building(start: dict[str, Any]) -> bool:
    """Whether an agent builds, from its start line: a test build of a retrospective, a Codex run, or an agent of a
    builder type."""
    agent_type = start["type"]
    return bool(start.get("test")) or agent_type == "codex" or agent_type.startswith(BUILDER_TYPE_PREFIX)


def is_running(run: agent_log.AgentRun, transcripts: dict[str, Path]) -> bool:
    """Whether an agent runs: it has no end line, the process that would write that line runs, and the user didn't
    interrupt it last. transcripts holds the transcripts of the agents of sessions, by the ids of their Agent calls. An
    agent whose start line has no process id counts as running, because the meter can't tell whether it ended."""
    if run.end is not None:
        return False
    pid = run.start.get("pid")
    if pid is not None and not process_runs(pid):
        return False
    transcript = transcripts.get(run.start["id"])
    return transcript is None or not is_interrupted(transcript)


def process_runs(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        # Another user's process has the id.
        return True
    return True


def run_session(events: Path) -> str | None:
    """The session id in the first event of a builder's run, which Claude gives it, or None."""
    with events.open(errors="replace") as handle:
        first = handle.readline()
    try:
        session = json.loads(first).get("session_id")
    except ValueError, AttributeError:
        return None
    return session if isinstance(session, str) else None


def agents_line(agents: list[Agent], thresholds: dict[str, int], told_for_room: set[str]) -> str:
    if not agents:
        return "agents | none running"
    parts = ["agents"]
    for agent in agents:
        part = f"{agent.name} {'context unknown' if agent.context is None else f'{agent.context // 1000}k'}"
        threshold = thresholds.get(agent.key or "")
        if threshold:
            part += f", told at {threshold // 1000}k to hand off"
        if agent.key in told_for_room:
            part += ", told to hand off for its account's room"
        parts.append(part)
    return " | ".join(parts)


def orchestrator_context(state_file: Path, checkout: Path) -> int | None:
    transcript = orchestrator_transcript(state_file, checkout)
    return None if transcript is None else context_tokens(transcript)


def orchestrator_transcript(state_file: Path, checkout: Path) -> Path | None:
    session = session_in_state_file(state_file)
    if session is None:
        return None
    return paths.claude_project_folder(checkout) / f"{session}.jsonl"


def session_in_state_file(state_file: Path) -> str | None:
    if not state_file.exists():
        return None
    for line in state_file.read_text().splitlines():
        if line.startswith("session:"):
            return line.removeprefix("session:").strip() or None
    return None


def retrospective_note(
    last: dt.datetime | None, runs: list[agent_log.AgentRun], transcripts: dict[str, Path], loop_folder: Path
) -> str:
    counted = [run for run in runs if not run.start["test"] and run.start["type"] != AUDITOR]
    if OUTPUT_TOKENS_PER_RETROSPECTIVE is not None:
        requests = loop_folder / request_events.REQUESTS_FILE
        event_tokens = request_events.output_tokens(requests.read_text() if requests.exists() else "")
        recent = [run for run in counted if last is None or agent_log.started(run) >= last]
        ends = [end for run in recent if (end := counted_end(run, transcripts))]
        return tokens_note(last, ends, event_tokens, OUTPUT_TOKENS_PER_RETROSPECTIVE)
    minutes = sum(
        agent_log.minutes_after(agent_log.working_periods(run, transcripts, loop_folder / "runs"), last)
        for run in counted
    )
    return hours_note(last, minutes / 60)


def has_new_finding(loop_folder: Path, checkout: Path, printed: Path) -> bool:
    """Whether the logs give a finding of waste whose subject isn't in the file printed. When GitHub doesn't say when
    the last retrospective merged, the time of scripts/check has nothing to compare with."""
    try:
        last = max(retrospective_merges(checkout), default=None)
    except GitHubError:
        last = None
    runs = agent_log.read_runs(loop_folder / "agents.jsonl")
    transcripts = agent_log.agent_transcripts(paths.claude_project_folder(checkout))
    subjects = {finding.subject for finding in waste_findings(runs, transcripts, loop_folder, last)}
    return bool(subjects - set(json.loads(printed.read_text()) if printed.exists() else []))


def waste_findings(
    runs: list[agent_log.AgentRun], transcripts: dict[str, Path], loop_folder: Path, last: dt.datetime | None
) -> list[waste.Finding]:
    """The findings of scripts/loop/waste.py. Without a last retrospective, the time of scripts/check has nothing to
    compare with."""
    reading_time = now()
    heavy = heavy_log.read(loop_folder / heavy_log.NAME)
    agent_minutes = sum(
        agent_log.minutes_after(
            agent_log.working_periods(run, transcripts, loop_folder / "runs"), reading_time - waste.RECENT
        )
        for run in runs
    )
    findings = waste.long_builds(runs, reading_time)
    for finding in (waste.long_waits(heavy, agent_minutes, reading_time), waste.slower_check(heavy, last)):
        if finding:
            findings.append(finding)
    return findings


def since_words(last: dt.datetime | None) -> str:
    return "since the last one" if last else "with no retrospective yet"


def counted_end(run: agent_log.AgentRun, transcripts: dict[str, Path]) -> dict[str, Any] | None:
    """The agent's last end line. An agent of a session without one, such as one whose session ended first, gets the
    requests until the last line of its transcript instead."""
    if run.end is not None:
        return run.end
    transcript = transcripts.get(run.start["id"])
    if transcript is None or not transcript.exists():
        return None
    return {"requests": agent_log.transcript_requests(transcript)}


def tokens_note(
    last: dt.datetime | None, ends: list[dict[str, Any]], event_tokens: dict[str, int], tokens_per_retrospective: int
) -> str:
    since = since_words(last)
    counts = [agent_log.agent_output_tokens(end, event_tokens) for end in ends]
    tokens = sum(tokens for tokens, _ in counts)
    without_event = sum(without_event for _, without_event in counts)
    if tokens >= tokens_per_retrospective:
        note = f"retrospective due: {tokens} output tokens of agents' work {since}"
    else:
        note = f"retrospective not due: {tokens} of {tokens_per_retrospective} output tokens of agents' work {since}"
    if not without_event:
        return note
    requests = sum(len(end.get("requests") or {}) for end in ends)
    return f"{note}, {without_event} of {requests} requests with no event"


def hours_note(last: dt.datetime | None, hours: float) -> str:
    since = since_words(last)
    if hours >= HOURS_PER_RETROSPECTIVE:
        return f"retrospective due: {hours:.1f} hours of agents' work {since}"
    # Rounded down, so that 29.98 hours don't show as 30.0 of 30
    shown = math.floor(hours * 10) / 10
    return f"retrospective not due: {shown:.1f} of {HOURS_PER_RETROSPECTIVE:g} hours of agents' work {since}"


