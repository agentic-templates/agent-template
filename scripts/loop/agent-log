#!/usr/bin/env -S uv run --script --quiet
"""Adds a line about an agent of a Claude Code session to agents.jsonl in the main checkout's .loop folder, from what
Claude Code sends a hook on standard input:

  scripts/loop/agent-log start   before an Agent call, which scripts/hooks/before-tool passes on
  scripts/loop/agent-log end     when an agent ends, from the SubagentStop command in .claude/settings.json
  scripts/loop/agent-log stop    after a TaskStop call, from its PostToolUse command in .claude/settings.json, because
                                 Claude Code sends no SubagentStop for an agent that TaskStop stops

scripts/loop/agent_log.py describes the lines. An agent that no Agent call started, such as one that a skill or Claude
Code itself starts, gets no line. Neither does an agent that a run of scripts/loop/run-builder starts, because the
run's end line counts its tokens. The SubagentStop command exits with code 1 when the script fails, because Claude Code
keeps an agent running when that command exits with code 2, as argparse and uv do on some errors.
"""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any

import agent_log
import paths
from accounts import AccountsError, load_accounts, own_account

# The type that Claude Code gives an Agent call without a subagent_type
DEFAULT_TYPE = "general-purpose"
GH_TIMEOUT_SECONDS = 10
# os.kill takes 0 and negative numbers as groups of processes, so a process id must be positive.
PROCESS_ID = re.compile(r"[1-9][0-9]*")
# The id that Claude Code gives an agent, which names its transcript, agent-<id>.jsonl. An id must name no other file.
AGENT_ID = re.compile(r"[0-9a-z]+")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/loop/agent-log", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    lines = {"start": start_line, "end": end_line, "stop": stopped_line}
    parser.add_argument("event", choices=lines)
    event = parser.parse_args(argv).event
    hook_input: dict[str, Any] = json.load(sys.stdin)
    if os.environ.get(agent_log.RUN_VARIABLE):
        return 0
    line = lines[event](hook_input)
    if line is not None:
        agent_log.append(line)
    return 0


def start_line(hook_input: dict[str, Any]) -> dict[str, Any]:
    call = hook_input["tool_input"]
    agent_type = call.get("subagent_type") or DEFAULT_TYPE
    in_file = agent_log.agent_settings(agent_type)
    settings = in_file._replace(model=call.get("model") or in_file.model, effort=call.get("effort") or in_file.effort)
    issue, kind = agent_log.prompt_subject(call.get("prompt", ""))
    label = agent_log.type_label(issue_labels(issue)) if issue else None
    return agent_log.start_line(
        hook_input["tool_use_id"],
        agent_type,
        settings,
        issue,
        label,
        kind,
        is_test=False,
        pid=claude_process(),
        account=session_account(),
    )


def session_account() -> str | None:
    """The name of the session's own account, or None. An accounts file that can't be read leaves the line without an
    account, because scripts/loop/meter reports the problem, and the agent's start line counts more than its account."""
    try:
        accounts = load_accounts(paths.loop_dir() / "accounts.json")
    except AccountsError:
        return None
    account = own_account(accounts, os.environ)
    return account["name"] if account else None


def claude_process() -> int | None:
    """The id of the Claude Code process, which Claude Code gives its hooks in CLAUDE_PID, or None without one."""
    found = PROCESS_ID.fullmatch(os.environ.get("CLAUDE_PID", ""))
    return int(found[0]) if found else None


def issue_labels(issue: int) -> list[str]:
    """The labels of an issue or a pull request. Without an answer from GitHub, the line goes without a label, because
    the agent's start must not wait longer for it."""
    try:
        done = subprocess.run(
            ["gh", "issue", "view", str(issue), "--json", "labels", "--jq", ".labels[].name"],
            cwd=agent_log.CHECKOUT,
            capture_output=True,
            text=True,
            check=False,
            timeout=GH_TIMEOUT_SECONDS,
        )
    except OSError, subprocess.TimeoutExpired:
        return []
    return done.stdout.split() if done.returncode == 0 else []


def end_line(hook_input: dict[str, Any]) -> dict[str, Any] | None:
    # Claude Code's own agents, such as the one that suggests prompts, end with an empty type.
    if not hook_input.get("agent_type"):
        return None
    return transcript_end_line(Path(hook_input["agent_transcript_path"]).expanduser())


def stopped_line(hook_input: dict[str, Any]) -> dict[str, Any] | None:
    """The end line of the agent that a TaskStop call stopped. A task that isn't an agent of the session, such as a
    command that runs in the background, has no transcript in the session's folder, and gets no line."""
    response = hook_input["tool_response"]
    task_id = response.get("task_id") if isinstance(response, dict) else None
    if not isinstance(task_id, str) or not AGENT_ID.fullmatch(task_id):
        return None
    # Claude Code keeps the transcripts of a session's agents in a folder named after the session's transcript.
    session = Path(hook_input["transcript_path"]).expanduser()
    transcript = session.with_suffix("") / "subagents" / f"agent-{task_id}.jsonl"
    if not transcript.with_suffix(".meta.json").exists():
        return None
    return transcript_end_line(transcript)


def transcript_end_line(transcript: Path) -> dict[str, Any] | None:
    # Claude Code keeps the id of the Agent call that started the agent, the agent's own worktree, and at times its
    # model and effort, next to the agent's transcript.
    meta = json.loads(transcript.with_suffix(".meta.json").read_text())
    if "toolUseId" not in meta:
        return None
    worktree = meta.get("worktreePath")
    worktree_mb = agent_log.folder_megabytes(Path(worktree)) if worktree else None
    numbers = agent_log.transcript_numbers(transcript)
    return agent_log.end_line(meta["toolUseId"], numbers, worktree_mb, meta.get("model"), meta.get("effort"))


if __name__ == "__main__":
    sys.exit(main())
