#!/usr/bin/env -S uv run --script --quiet
"""Lists the files of a change that a reviewer reads before the change merges: the rules, the loop's scripts and the
files that keep agents safe, such as the hooks, the settings and the checks.

RANGE is a git revision range, and it is origin/main...HEAD by default. When RANGE ends at HEAD, the change includes
the changes that aren't committed yet and the new files that git doesn't ignore. A renamed file counts by its old path
and its new one.

The script prints each listed file that the change touches, one to a line, and exits with code 0. If the change touches
none of them, it prints "Not consequential." and exits with code 1. It exits with code 2 when git fails, such as for a
RANGE that names no commit.
"""

import argparse
import subprocess
import sys

# A mistake in one of these files can let a secret out, weaken a check, or change the rules that every later change
# follows. A pattern that ends in * matches each path that starts with the rest of the pattern. Any other pattern
# matches only that path.
CONSEQUENTIAL_PATTERNS = (
    # The rules
    "AGENTS.md",
    "docs/releasing.md",
    "docs/reviewing.md",
    "docs/rules.md",
    # The loop's scripts
    "scripts/loop/*",
    # The files that keep agents safe
    ".claude/*",
    ".codex/*",
    ".github/workflows/*",
    "pyproject.toml",
    "scripts/check",
    "scripts/check-main-rules",
    "scripts/configure-github*",
    "scripts/hooks/*",
    "scripts/required-checks",
    "scripts/text-rules",
)
DEFAULT_RANGE = "origin/main...HEAD"


class GitError(Exception):
    """A git command that failed, with what to do about it."""


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/loop/consequential", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("range", nargs="?", default=DEFAULT_RANGE, metavar="RANGE", help="the change's commits")
    options = parser.parse_args(argv)
    try:
        files = changed_files(options.range)
    except GitError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    listed = consequential_files(files)
    if not listed:
        print("Not consequential.")
        return 1
    print("\n".join(listed))
    return 0


def consequential_files(files: list[str]) -> list[str]:
    """The files that a pattern in CONSEQUENTIAL_PATTERNS matches, each once, sorted."""
    return sorted({file for file in files if is_consequential(file)})


def is_consequential(file: str) -> bool:
    for pattern in CONSEQUENTIAL_PATTERNS:
        if pattern.endswith("*") and file.startswith(pattern.removesuffix("*")):
            return True
        if file == pattern:
            return True
    return False


def changed_files(revision_range: str) -> list[str]:
    # --no-renames lists a renamed file by its old path too, so that moving a hook away from its path counts.
    # --end-of-options keeps a range that starts with - from passing git an option, such as --output.
    files = git_paths("diff", "--name-only", "--no-renames", "-z", "--end-of-options", revision_range)
    if revision_range.endswith("HEAD"):
        files += git_paths("diff", "--name-only", "--no-renames", "-z", "HEAD")
        files += git_paths("ls-files", "--others", "--exclude-standard", "-z")
    return files


def git_paths(*arguments: str) -> list[str]:
    done = subprocess.run(["git", *arguments], capture_output=True, text=True, check=False)
    if done.returncode != 0:
        # git's later lines suggest a -- that this script's argument can't take.
        cause = done.stderr.strip().partition("\n")[0]
        raise GitError(
            f"git {' '.join(arguments)} failed: {cause} Run the script in a checkout of the repository, "
            "with a range of commits that the checkout has. If origin/main is missing, run git fetch origin main."
        )
    return [path for path in done.stdout.split("\0") if path]


if __name__ == "__main__":
    sys.exit(main())
