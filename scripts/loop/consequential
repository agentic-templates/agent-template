#!/usr/bin/env -S uv run --script --quiet
"""Lists the files of a change that a reviewer reads before the change merges: the rules, the scripts and the files
that keep agents safe, such as the hooks, the settings and the checks. scripts/consequential-paths holds their paths.

RANGE is a git revision range, and it is origin/main...HEAD by default. When RANGE ends at HEAD, or names a single
commit, the change includes the changes that aren't committed yet and the new files that git doesn't ignore. A renamed
file counts by its old path and its new one.

The script prints each listed file that the change touches, one to a line, with its path from the top of the
checkout, and exits with code 0. If the change touches none of them, it prints "Not consequential." and exits with
code 1. It exits with code 2 when git fails, such as for a RANGE that names no commit.
"""

import argparse
import fnmatch
import subprocess
import sys
from pathlib import Path


def read_patterns(path: Path) -> tuple[str, ...]:
    """The lines of a file like scripts/consequential-paths that aren't comments."""
    return tuple(line for line in path.read_text(encoding="utf-8").splitlines() if not line.startswith("#"))


# The patterns of the files that a reviewer reads, from the file that the hooks read too.
CONSEQUENTIAL_PATTERNS = read_patterns(Path(__file__).resolve().parents[1] / "consequential-paths")
DEFAULT_RANGE = "origin/main...HEAD"


class GitError(Exception):
    """A git command that failed, with what to do about it."""


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/loop/consequential", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("range", nargs="?", default=DEFAULT_RANGE, metavar="RANGE", help="the change's commits")
    options = parser.parse_args(argv)
    try:
        files = changed_files(options.range)
    except GitError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    listed = consequential_files(files)
    if not listed:
        print("Not consequential.")
        return 1
    print("\n".join(listed))
    return 0


def consequential_files(files: list[str]) -> list[str]:
    """The files that a pattern in CONSEQUENTIAL_PATTERNS matches, each once, sorted."""
    return sorted({file for file in files if is_consequential(file)})


def is_consequential(file: str) -> bool:
    return any(fnmatch.fnmatchcase(file, pattern) for pattern in CONSEQUENTIAL_PATTERNS)


def changed_files(revision_range: str) -> list[str]:
    # git ls-files gives paths from the folder that it runs in, and only for the files inside it.
    top = Path(git_output(["rev-parse", "--show-toplevel"], Path.cwd()).strip())
    # --no-renames lists a renamed file by its old path too, so that moving a hook away from its path counts.
    # --end-of-options keeps a range that starts with - from passing git an option, such as --output.
    files = git_paths(["diff", "--name-only", "--no-renames", "-z", "--end-of-options", revision_range], top)
    if revision_range.endswith("HEAD") or ".." not in revision_range:
        files += git_paths(["diff", "--name-only", "--no-renames", "-z", "HEAD"], top)
        files += git_paths(["ls-files", "--others", "--exclude-standard", "-z"], top)
    return files


def git_paths(arguments: list[str], folder: Path) -> list[str]:
    return [path for path in git_output(arguments, folder).split("\0") if path]


def git_output(arguments: list[str], folder: Path) -> str:
    done = subprocess.run(["git", *arguments], cwd=folder, capture_output=True, text=True, check=False)
    if done.returncode != 0:
        # git's later lines suggest a -- that this script's argument can't take.
        cause = done.stderr.strip().partition("\n")[0]
        raise GitError(
            f"git {' '.join(arguments)} failed: {cause} Run the script in a checkout of the repository, "
            "with a range of commits that the checkout has. If origin/main is missing, run git fetch origin main."
        )
    return done.stdout


if __name__ == "__main__":
    sys.exit(main())
