#!/usr/bin/env -S uv run --script --quiet
"""Runs claude with the arguments it's given, and has it send the tokens of each request that it and its agents make
to the loop's receiver, which this starts if it isn't running. Start the orchestrator with it, as in
scripts/loop/claude or scripts/loop/claude --resume, so that scripts/loop/report counts its agents' exact output
tokens. It turns on only Claude Code's events, without prompts or tool details, as scripts/loop/request_events.py
describes.
"""

import os
import sys

import paths
import request_events


def main(argv: list[str]) -> int:
    try:
        port = request_events.receiver_port(paths.loop_dir())
    except request_events.ReceiverError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    try:
        os.execvpe("claude", ["claude", *argv], os.environ | request_events.telemetry_environment(port))
    except FileNotFoundError:
        print("error: claude isn't installed. Install Claude Code, and run the script again.", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
