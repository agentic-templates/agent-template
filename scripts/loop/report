#!/usr/bin/env -S uv run --script --quiet
"""Prints the numbers that a retrospective reads, for the time since a moment, such as the last retrospective:

  scripts/loop/report --since 2026-10-11T14:00:00Z

The lines are:

  Before                    When the period before starts, which the Type lines compare with. It runs from the last
                            retrospective that merged before --since to --since, or from the first agent if none merged
                            before. There is no period before, and no line, until a retrospective merged by --since.
  CI runs that passed       How many runs of .github/workflows/ci.yml passed, and the median time from a run's start
                            to its end.
  CI jobs                   Each job's median time in those runs, leaving out the runs that skipped it. The jobs that
                            run the tests give the tests' time.
  Type                      A line for each type of the agents that started, from .loop/agents.jsonl, which
                            scripts/loop/agent_log.py describes: how many started and how many ended, the median of
                            their minutes and of their tool calls, and their share of the input tokens that all those
                            agents used. Then their output tokens, and how many pull requests they opened, and how
                            many of those needed a fix after review, failed a check, left the merge queue unmerged, or
                            got a second builder. The test builds of a retrospective don't count. If the agents of the
                            type opened pull requests in the period before, the line gives the same counts for those,
                            as they stood at --since, and a type that started no agent since gets a line for them. If
                            they opened pull requests in both periods, the line names each count whose difference is
                            larger than chance, by Fisher's exact test at the 5% level, with Holm's correction for the
                            number of counts that the report compares.
  Requests of the agents of a session that have no event
                            How many of these requests have no event in .loop/requests.jsonl, which
                            scripts/loop/request_events.py describes, out of all of them. The report takes each
                            request's output tokens from its event, and for a request with no event, from the agent's
                            transcript, which leaves out most of them. Only a session started with
                            scripts/loop/claude-with-events sends events. A run of scripts/loop/run-builder counts its
                            own output tokens exactly.
  Orchestrator's share      The share of the input tokens that the sessions in the main checkout used themselves, out
                            of all that they and their agents used.
  Hook blocks               How many actions the before-tool hook blocked, from .loop/blocks.log, and how many each
                            rule blocked.
  Agents' time              The minutes of the agents in the Type lines, from the first line of each one's transcript to
                            the last, and how many of them have no transcript, such as the runs of
                            scripts/loop/run-builder. Then the minutes and the share of each part of that time, which
                            scripts/loop/agent_time.py describes: the model's time, the tool calls that ran
                            scripts/check, ran a single test file, waited for CI, slept, ran another command or used
                            another tool, and the waits for the agents' background tasks and for the orchestrator.
  Context                   A line for each type of the agents in the Type lines that have a transcript, and one for
                            the sessions in the main checkout, as scripts/loop/context_growth.py measures them: how
                            many agents or sessions it covers, the median and the largest of their peak context, and
                            the share of them whose peak passed the threshold at which scripts/hooks/hand-off tells a
                            builder to hand off, or for the sessions, tells the orchestrator to compact. Then the
                            context that the results of their tool calls added, per tool call, and how many steps it
                            leaves out because their call has no event in .loop/requests.jsonl. Then how many of the
                            agents the hook told to hand off, their compactions, and the three kinds of tool calls
                            whose results added the most, by their share, as the Agents' time line groups the tool
                            calls.
  Heavy command             A line for each command that scripts/loop/run-heavy ran, from .loop/heavy.jsonl: how many
                            runs started and ended, and the median minutes, cores and memory of those that ended.
                            Then how many runs waited, those that a signal stopped while they waited included, their
                            minutes of waiting, and how many of those minutes the readings showed room for the
                            command, before the reservations of the commands that ran and the room that the scheduler
                            keeps free. A last line gives the median and the highest of the highest swap in use
                            during each run.
  Machine                   A line for each number of the machine that scripts/loop/meter records in
                            .loop/meter.jsonl: free disk, free memory, swap in use, GPU use, GPU memory in use and
                            load. Each gives the median and the worst: the lowest of free disk and free memory, and
                            the highest of the others. Free disk also gives its change from the first reading to the
                            last. Swap in use also gives the share of the readings in which it grew since the reading
                            before, out of the readings that give it and follow one that gives it. The load also gives
                            the share of the readings with a load above the number of cores. A number that no reading
                            gives says so. Then a line for each number of agents, from one to the most that worked at a
                            reading: how many readings they worked at, and the median of each number in those
                            readings. An agent in .loop/agents.jsonl worked in the periods that
                            scripts/loop/agent_log.py gives it: from each prompt or message that it received to its
                            last call before the next one, so the time it waited for a message doesn't count. An
                            agent without an end line worked until the last line of its transcript. The test builds
                            of a retrospective count here, because they use the machine too.

With --issues, the report also gives a line for each agent that built an issue, of the kinds other and left behind,
with its numbers, those of its pull request, its peak context, the context added per tool call in the steps that
have an event, and the minutes of each part of its time.

With --messages, the report also gives each message that a person typed in a session in the main checkout, such as
the maintainer's messages to the orchestrator, with its time.

The input tokens count the cached tokens too.

An agent starts on the issue or pull request whose number starts its prompt, as docs/loop.md asks. A pull request
needed a fix after review when it got a commit after an agent of the type reviewer started on it. It got a second
builder when an agent of another type started on it or on its issue after the agent that opened it.

The report counts the CI runs, the agents and the calls that started after the moment. It reads the transcripts that
Claude Code keeps for the main checkout, and prints none of their text other than the messages that --messages asks
for.
"""

import argparse
import datetime as dt
import itertools
import json
import math
import statistics
import sys
from collections import Counter
from pathlib import Path
from typing import Any, NamedTuple

import agent_time
import context_growth
import heavy_log
import paths
import request_events
from agent_log import AgentRun, Period, agent_output_tokens, agent_transcripts, read_runs, started, working_periods
from github import GitHubError, gh_api, retrospective_merges
from hand_offs import FOLDER_NAME, hand_off_thresholds, hook_threshold, note_files
from transcripts import Call, Message, person_messages, read_transcript

CI_WORKFLOW = "ci.yml"
ORCHESTRATOR = "orchestrator"
AGENT = "agent"
REVIEWER = "reviewer"
# The starts of the kinds of the issues that a builder builds, as scripts/take-next-issue prints them
BUILD_KINDS = ("other", "left behind")
# The conclusions of a check suite that count as a failed check. A cancelled one doesn't, because CI cancels the run
# of a pull request's commit when a newer commit comes.
FAILED_CONCLUSIONS = ("FAILURE", "TIMED_OUT", "STARTUP_FAILURE")
# One query asks for the jobs of 100 runs, the most that GitHub takes, because a query for each run took 0.7 seconds,
# as pull request #20 measured, so a week of 200 runs would take more than 2 minutes.
RUNS_PER_QUERY = 100
JOBS_QUERY = """
query($ids: [ID!]!) {
  nodes(ids: $ids) {
    ... on WorkflowRun {
      checkSuite { checkRuns(first: 50) { nodes { name startedAt completedAt conclusion } } }
    }
  }
}"""
# A query asks for 25 pull requests, because GitHub stops a query after 10 seconds, as scripts/open-pull-requests
# found for a page of 100 pull requests.
PULL_REQUESTS_PER_QUERY = 25
PULL_REQUEST_QUERY = """
query($owner: String!, $repo: String!) {
  repository(owner: $owner, name: $repo) { %s }
}
fragment facts on PullRequest {
  commits(first: 100) { nodes { commit { committedDate checkSuites(first: 20) { nodes { conclusion updatedAt } } } } }
  timelineItems(itemTypes: [REMOVED_FROM_MERGE_QUEUE_EVENT], first: 100) {
    nodes { ... on RemovedFromMergeQueueEvent { reason createdAt } }
  }
}"""
# GitHub records a removal from the merge queue with this reason each time the queue merges a pull request.
MERGED_REASON = "merged"
# What each field of PullRequestResult says about a pull request, in the fields' order
RESULT_WORDS = ("needed a fix after review", "failed a check", "left the merge queue unmerged", "got a second builder")
NOTHING_HAPPENED = "no fix after review, failed check, unmerged exit from the merge queue or second builder"
# A difference between two counts is larger than chance when chance alone gives one as large less often than this,
# after Holm's correction.
CHANCE_LEVEL = 0.05
# How many kinds of tool calls a context line names, those whose results added the most context first
MOST_ADDING_KINDS = 3


class CiRun(NamedTuple):
    minutes: float
    # The minutes of each job that passed
    job_minutes: dict[str, float]


class Transcript(NamedTuple):
    role: str
    file: Path
    modified: float
    calls: list[Call]


class Agent(NamedTuple):
    role: str
    file: Path
    calls: list[Call]


class Context(NamedTuple):
    growth: context_growth.Growth
    is_told_to_hand_off: bool


class PullRequest(NamedTuple):
    commit_times: list[dt.datetime]
    failed_check_times: list[dt.datetime]
    unmerged_exit_times: list[dt.datetime]


class PullRequestResult(NamedTuple):
    needed_fix_after_review: bool
    failed_check: bool
    left_merge_queue: bool
    got_second_builder: bool


class MachineNumber(NamedTuple):
    key: str
    name: str
    # The name in the line for each number of agents
    short_name: str
    # Whether the lowest value is the one to watch, as for free memory, rather than the highest
    is_lowest_worst: bool


# The numbers of a machine reading that the report gives, as scripts/loop/machine.py names them
MACHINE_NUMBERS = (
    MachineNumber("disk_free_gb", "Free disk, GB", "free disk", True),
    MachineNumber("memory_free_gb", "Free memory, GB", "free memory", True),
    MachineNumber("swap_used_gb", "Swap in use, GB", "swap in use", False),
    MachineNumber("gpu_percent", "GPU use, %", "GPU use", False),
    MachineNumber("gpu_memory_used_gb", "GPU memory in use, GB", "GPU memory in use", False),
    MachineNumber("load", "Load", "load", False),
)


class ReportError(Exception):
    """A problem that stops the report, with what to do about it."""


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/loop/report", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--since", required=True, type=moment, help="an ISO time with its zone, such as 2026-10-11T14:00:00Z"
    )
    parser.add_argument("--issues", action="store_true", help="also give a line for each agent that built an issue")
    parser.add_argument(
        "--messages", action="store_true", help="also give the messages that a person typed in the main checkout"
    )
    options = parser.parse_args(argv)
    since: dt.datetime = options.since
    checkout = paths.main_checkout()
    all_runs = read_runs(paths.loop_dir() / "agents.jsonl")
    runs = [run for run in all_runs if not run.start["test"]]
    recent = [run for run in runs if started(run) >= since]
    try:
        ci_runs = read_ci_runs(since, checkout)
        period_before = period_before_since(retrospective_merges(checkout), since)
        before = [run for run in runs if period_before and period_before.start <= started(run) < since]
        compared = recent + before
        pull_requests = read_pull_requests(sorted({number for run in compared if (number := opened(run))}), checkout)
        transcripts = read_transcripts(paths.claude_project_folder(checkout), checkout, since)
    except (GitHubError, ReportError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    # The last retrospective counted the period before as it stood at --since, so the period before stops there.
    results = {
        run.start["id"]: pull_request_result(run, pull_requests[number], runs, None if started(run) >= since else since)
        for run in compared
        if (number := opened(run))
    }
    agents = count_once(transcripts, since)
    transcripts_by_id = agent_transcripts(paths.claude_project_folder(checkout))
    files = {
        run.start["id"]: file for run in recent if (file := transcripts_by_id.get(run.start["id"])) and file.exists()
    }
    splits = {agent: agent_time.read_split(file) for agent, file in files.items()}
    event_tokens = request_events.output_tokens(read_log(request_events.REQUESTS_FILE))
    told = hand_off_thresholds(note_files(paths.loop_dir() / FOLDER_NAME))
    contexts = {agent: read_context(file, None, event_tokens, told) for agent, file in files.items()}
    orchestrator_contexts = [
        read_context(agent.file, {call.id for call in agent.calls}, event_tokens, told)
        for agent in agents
        if agent.role == ORCHESTRATOR
    ]
    ends = [run.end for run in recent if run.end]
    lines = [
        f"Since {since.isoformat()}",
        *before_lines(period_before),
        *ci_lines(ci_runs),
        *type_lines(recent, before, results, event_tokens),
        no_event_line(ends, event_tokens),
        orchestrator_line(agents),
        block_line(count_blocks(read_log("blocks.log"), since)),
        time_line(list(splits.values()), len(recent)),
        *context_lines(contexts_by_type(recent, contexts), orchestrator_contexts),
        *heavy_lines(heavy_log.read(paths.loop_dir() / heavy_log.NAME), since),
        *machine_lines(read_machine_readings(read_log("meter.jsonl"), since), periods_of(all_runs, transcripts_by_id)),
    ]
    if options.issues:
        lines += issue_lines(recent, results, event_tokens, splits, contexts)
    if options.messages:
        lines += message_lines(read_messages(paths.claude_project_folder(checkout), since))
    print("\n".join(lines))
    return 0


def read_log(name: str) -> str:
    """The text of a log in the loop folder, which is empty until something writes it."""
    log = paths.loop_dir() / name
    return log.read_text() if log.exists() else ""


def moment(text: str) -> dt.datetime:
    try:
        parsed = dt.datetime.fromisoformat(text)
    except ValueError as error:
        raise argparse.ArgumentTypeError(f"{text!r} isn't an ISO time, such as 2026-10-11T14:00:00Z") from error
    if parsed.tzinfo is None:
        raise argparse.ArgumentTypeError(f"{text!r} has no zone. Add one, as in 2026-10-11T14:00:00Z.")
    return parsed


def read_ci_runs(since: dt.datetime, checkout: Path) -> list[CiRun]:
    """The runs of the CI workflow that started after the time and passed."""
    listed = gh_api(
        f"repos/{{owner}}/{{repo}}/actions/workflows/{CI_WORKFLOW}/runs",
        [
            "--paginate",
            "-X",
            "GET",
            "-f",
            "status=success",
            "-f",
            f"created=>={since.astimezone(dt.UTC):%Y-%m-%dT%H:%M:%SZ}",
            "--jq",
            ".workflow_runs[] | {node_id, run_started_at, updated_at}",
        ],
        checkout,
    )
    runs = [json.loads(line) for line in listed.splitlines()]
    ci_runs = []
    for start in range(0, len(runs), RUNS_PER_QUERY):
        batch = runs[start : start + RUNS_PER_QUERY]
        options = ["-f", f"query={JOBS_QUERY}"]
        for run in batch:
            options += ["-f", f"ids[]={run['node_id']}"]
        nodes = json.loads(gh_api("graphql", options, checkout))["data"]["nodes"]
        for run, node in zip(batch, nodes, strict=True):
            # GitHub gives no node for a run that someone deleted after the listing.
            if node is None:
                continue
            ci_runs.append(ci_run(run, node["checkSuite"]["checkRuns"]["nodes"]))
    return ci_runs


def ci_run(run: dict[str, str], jobs: list[dict[str, str]]) -> CiRun:
    job_minutes = {
        job["name"]: minutes_between(job["startedAt"], job["completedAt"])
        for job in jobs
        if job["conclusion"] == "SUCCESS"
    }
    return CiRun(minutes_between(run["run_started_at"], run["updated_at"]), job_minutes)


def minutes_between(start: str, end: str) -> float:
    return (dt.datetime.fromisoformat(end) - dt.datetime.fromisoformat(start)).total_seconds() / 60


def read_transcripts(project_folder: Path, checkout: Path, since: dt.datetime) -> list[Transcript]:
    """The transcripts that changed after the time: each session's, and those of its agents."""
    if not project_folder.is_dir():
        raise ReportError(
            f"Can't find {project_folder}, where Claude Code keeps the transcripts of the sessions in {checkout}. "
            "If Claude Code keeps its files elsewhere, set CLAUDE_CONFIG_DIR to that folder."
        )
    found: list[tuple[Path, str]] = []
    for session in project_folder.glob("*.jsonl"):
        found.append((session, ORCHESTRATOR))
        found += [(agent, AGENT) for agent in (project_folder / session.stem / "subagents").glob("*.jsonl")]
    transcripts = []
    for file, role in found:
        modified = file.stat().st_mtime
        if modified >= since.timestamp():
            transcripts.append(Transcript(role, file, modified, read_transcript(file)[0]))
    return transcripts


def count_once(transcripts: list[Transcript], since: dt.datetime) -> list[Agent]:
    """The calls of each session and agent that started after the time, each in only one of them. Resuming a session
    makes a transcript that starts with copies of the earlier transcripts' calls, so a call counts in the oldest
    transcript that holds it."""
    seen: set[str] = set()
    agents = []
    for transcript in sorted(transcripts, key=lambda transcript: transcript.modified):
        calls = [call for call in transcript.calls if call.id not in seen and call.start >= since]
        seen.update(call.id for call in transcript.calls)
        if calls:
            agents.append(Agent(transcript.role, transcript.file, calls))
    return agents


def read_messages(project_folder: Path, since: dt.datetime) -> list[Message]:
    """The messages that a person typed in the sessions after the time, in order of time. A resumed session's
    transcript starts with copies of the earlier transcript's messages, so each message counts once."""
    messages: set[Message] = set()
    for session in project_folder.glob("*.jsonl"):
        if session.stat().st_mtime >= since.timestamp():
            messages.update(message for message in person_messages(session) if message.at >= since)
    return sorted(messages)


def message_lines(messages: list[Message]) -> list[str]:
    lines = [f"Messages that a person typed: {len(messages)}"]
    for message in messages:
        lines.append(f"Message at {message.at.isoformat()}:")
        lines += [f"  {text_line}" for text_line in message.text.splitlines()]
    return lines


class PeriodBefore(NamedTuple):
    start: dt.datetime
    # Whether a retrospective merged at the start, rather than the period starting with the first agent
    is_from_retrospective: bool


def period_before_since(merges: list[dt.datetime], since: dt.datetime) -> PeriodBefore | None:
    """The period that the Type lines compare with: from the last retrospective that merged before the time, or from
    the first agent, to the time. There is none until a retrospective merged by the time."""
    if not any(merge <= since for merge in merges):
        return None
    earlier = [merge for merge in merges if merge < since]
    if not earlier:
        return PeriodBefore(dt.datetime.min.replace(tzinfo=dt.UTC), False)
    return PeriodBefore(max(earlier), True)


def before_lines(period: PeriodBefore | None) -> list[str]:
    if period is None:
        return []
    if not period.is_from_retrospective:
        return ["Before: from the first agent, because no retrospective merged before then"]
    return [f"Before: from {period.start.isoformat()}, when the last retrospective before then merged"]


def opened(run: AgentRun) -> int | None:
    """The pull request that the agent opened, or None."""
    return run.end["pull_request"] if run.end else None


def read_pull_requests(numbers: list[int], checkout: Path) -> dict[int, PullRequest]:
    pull_requests = {}
    for start in range(0, len(numbers), PULL_REQUESTS_PER_QUERY):
        batch = numbers[start : start + PULL_REQUESTS_PER_QUERY]
        fields = " ".join(f"pr{number}: pullRequest(number: {number}) {{ ...facts }}" for number in batch)
        options = ["-F", "owner={owner}", "-F", "repo={repo}", "-f", f"query={PULL_REQUEST_QUERY % fields}"]
        repository = json.loads(gh_api("graphql", options, checkout))["data"]["repository"]
        for number in batch:
            pull_requests[number] = pull_request_facts(repository[f"pr{number}"])
    return pull_requests


def pull_request_facts(node: dict[str, Any]) -> PullRequest:
    commits = [entry["commit"] for entry in node["commits"]["nodes"]]
    suites = [suite for commit in commits for suite in commit["checkSuites"]["nodes"]]
    removals = node["timelineItems"]["nodes"]
    return PullRequest(
        commit_times=[dt.datetime.fromisoformat(commit["committedDate"]) for commit in commits],
        failed_check_times=[
            dt.datetime.fromisoformat(suite["updatedAt"])
            for suite in suites
            if suite["conclusion"] in FAILED_CONCLUSIONS
        ],
        unmerged_exit_times=[
            dt.datetime.fromisoformat(removal["createdAt"])
            for removal in removals
            if removal["reason"] != MERGED_REASON
        ],
    )


def pull_request_result(
    opener: AgentRun, pull_request: PullRequest, runs: list[AgentRun], until: dt.datetime | None
) -> PullRequestResult:
    """What happened to the pull request that an agent opened, from its facts and the agents that started later, up to
    the time, or up to now without one."""

    def by_then(time: dt.datetime) -> bool:
        return until is None or time < until

    number = opened(opener)
    later = [run for run in runs if started(opener) < started(run) and by_then(started(run))]
    reviews = [started(run) for run in later if run.start["type"] == REVIEWER and run.start["issue"] == number]
    subjects = {number, opener.start["issue"]} - {None}
    commit_times = [time for time in pull_request.commit_times if by_then(time)]
    return PullRequestResult(
        needed_fix_after_review=bool(reviews) and any(time > min(reviews) for time in commit_times),
        failed_check=any(by_then(time) for time in pull_request.failed_check_times),
        left_merge_queue=any(by_then(time) for time in pull_request.unmerged_exit_times),
        got_second_builder=any(run.start["type"] != REVIEWER and run.start["issue"] in subjects for run in later),
    )


def count_blocks(log: str, since: dt.datetime) -> Counter[str]:
    """The blocks after the time per rule, from the block log's lines: the time, the rule's check, and the words that
    it matched, separated by spaces."""
    blocks: Counter[str] = Counter()
    for line in log.splitlines():
        time, rule = line.split()[:2]
        if dt.datetime.fromisoformat(time) >= since:
            blocks[rule] += 1
    return blocks


def ci_lines(runs: list[CiRun]) -> list[str]:
    if not runs:
        return ["CI runs that passed: 0"]
    median_minutes = statistics.median(run.minutes for run in runs)
    jobs = sorted({job for run in runs for job in run.job_minutes})
    job_parts = [
        f"{job} {statistics.median(run.job_minutes[job] for run in runs if job in run.job_minutes):.1f}" for job in jobs
    ]
    return [
        f"CI runs that passed: {len(runs)}, median {median_minutes:.1f} min",
        "CI jobs, median minutes: " + " | ".join(job_parts),
    ]


def type_lines(
    runs: list[AgentRun], before: list[AgentRun], results: dict[str, PullRequestResult], event_tokens: dict[str, int]
) -> list[str]:
    """A line for each type of the agents that started, and for each type whose agents opened pull requests only in
    the period before."""
    names = {run.start["type"] for run in runs} | {run.start["type"] for run in before if run.start["id"] in results}
    if not names:
        return ["Types: no agent started"]
    all_input = sum(run.end["input_tokens"] for run in runs if run.end)
    p_values: dict[tuple[str, str], float] = {}
    for name in names:
        now, earlier = type_results(name, runs, results), type_results(name, before, results)
        if now and earlier:
            for field, words in enumerate(RESULT_WORDS):
                p_values[(name, words)] = count_p_value(now, earlier, field)
    larger = larger_than_chance(p_values)
    lines = []
    for name in sorted(names):
        line = type_line(name, [run for run in runs if run.start["type"] == name], all_input, results, event_tokens)
        earlier = type_results(name, before, results)
        if earlier:
            line += f" | before: pull requests: {len(earlier)}, {', '.join(result_counts(earlier))}"
        if (name, RESULT_WORDS[0]) in p_values:
            line += " | " + verdict([words for words in RESULT_WORDS if (name, words) in larger])
        lines.append(line)
    return lines


def type_line(
    name: str, runs: list[AgentRun], all_input: int, results: dict[str, PullRequestResult], event_tokens: dict[str, int]
) -> str:
    ends = [run.end for run in runs if run.end]
    line = f"Type {name}: {len(runs)} started, {len(ends)} ended"
    if ends:
        minutes = statistics.median(end["minutes"] for end in ends)
        tool_calls = statistics.median(end["tool_calls"] for end in ends)
        share = sum(end["input_tokens"] for end in ends) / all_input if all_input else 0
        output_tokens = sum(agent_output_tokens(end, event_tokens)[0] for end in ends)
        line += f", median {minutes:.1f} min and {tool_calls:g} tool calls, {share:.0%} of the agents' input tokens"
        line += f" | output tokens: {output_tokens}"
    own = type_results(name, runs, results)
    if not own:
        return f"{line} | pull requests: 0"
    return f"{line} | pull requests: {len(own)}, {', '.join(result_counts(own))}"


def type_results(name: str, runs: list[AgentRun], results: dict[str, PullRequestResult]) -> list[PullRequestResult]:
    """What happened to the pull requests that the agents of the type opened."""
    return [results[run.start["id"]] for run in runs if run.start["type"] == name and run.start["id"] in results]


def result_counts(results: list[PullRequestResult]) -> list[str]:
    return [f"{sum(result[field] for result in results)} {words}" for field, words in enumerate(RESULT_WORDS)]


def verdict(larger: list[str]) -> str:
    return f"larger than chance: {', '.join(larger)}" if larger else "no difference larger than chance"


def count_p_value(now: list[PullRequestResult], earlier: list[PullRequestResult], field: int) -> float:
    """The p-value of the difference of a count from the period before to now."""
    count_now = sum(result[field] for result in now)
    return fisher_exact(count_now, len(now), sum(result[field] for result in earlier), len(earlier))


def larger_than_chance[Key](p_values: dict[Key, float]) -> set[Key]:
    """The keys whose difference is larger than chance, by Holm's correction: the smallest p-value must be below the
    level divided by the number of p-values, the next below the level divided by one fewer, and so on, until one
    isn't. The report tests four counts of each type, so without the correction it would often name a difference
    that chance alone gave."""
    larger: set[Key] = set()
    ordered = sorted(p_values.items(), key=lambda item: item[1])
    for rank, (key, p_value) in enumerate(ordered):
        if p_value >= CHANCE_LEVEL / (len(ordered) - rank):
            break
        larger.add(key)
    return larger


def fisher_exact(count: int, total: int, other_count: int, other_total: int) -> float:
    """The two-sided p-value of Fisher's exact test for count of total against other_count of other_total: the chance
    of a split at most as likely as this one, if both totals drew from one pool with the same share. The test fits
    counts too small for the normal approximation that a chi-squared test relies on."""
    pool = total + other_total
    counted = count + other_count
    # Ways to give each split of the counted to the first total, as whole numbers, so that equal splits compare equal
    ways = [
        math.comb(counted, in_first) * math.comb(pool - counted, total - in_first)
        for in_first in range(max(0, total - (pool - counted)), min(counted, total) + 1)
    ]
    observed = math.comb(counted, count) * math.comb(pool - counted, total - count)
    return sum(way for way in ways if way <= observed) / math.comb(pool, total)


def no_event_line(ends: list[dict[str, Any]], event_tokens: dict[str, int]) -> str:
    requests = sum(len(end.get("requests") or {}) for end in ends)
    without_event = sum(agent_output_tokens(end, event_tokens)[1] for end in ends)
    return f"Requests of the agents of a session that have no event: {without_event} of {requests}"


def issue_lines(
    runs: list[AgentRun],
    results: dict[str, PullRequestResult],
    event_tokens: dict[str, int],
    splits: dict[str, dict[str, float]],
    contexts: dict[str, Context],
) -> list[str]:
    """A line for each agent that built an issue, with its numbers, what happened to its pull request, its context,
    and the split of its time."""
    lines = []
    for run in runs:
        kind = run.start["kind"]
        if not kind or not kind.startswith(BUILD_KINDS):
            continue
        line = f"Issue #{run.start['issue']} {run.start['label']} {kind}: {run.start['type']}"
        time = agent_context_part(contexts.get(run.start["id"])) + agent_time_part(splits.get(run.start["id"]))
        if not run.end:
            lines.append(f"{line}, not ended{time}")
            continue
        end = run.end
        output_tokens, without_event = agent_output_tokens(end, event_tokens)
        line += f", {end['minutes']:.1f} min, {end['tool_calls']} tool calls, {end['input_tokens']} input tokens, "
        line += f"{output_tokens} output tokens"
        if without_event:
            line += f", {without_event} of its requests with no event"
        result = results.get(run.start["id"])
        if result is None:
            lines.append(f"{line} | no pull request{time}")
            continue
        happened = [words for has_happened, words in zip(result, RESULT_WORDS, strict=True) if has_happened]
        lines.append(f"{line} | pull request #{opened(run)}: {', '.join(happened) or NOTHING_HAPPENED}{time}")
    return lines


def time_line(splits: list[dict[str, float]], agents: int) -> str:
    """The minutes and the share of each part of the time of the agents that have a transcript, out of the agents."""
    total = {part: sum(split[part] for split in splits) for part in agent_time.PARTS}
    seconds = sum(total.values())
    line = (
        f"Agents' time: {seconds / 60:.1f} min, from the transcripts of {len(splits)} agents, and "
        f"{agents - len(splits)} agents have none"
    )
    if not seconds:
        return line
    parts = [f"{part} {total[part] / 60:.1f} min ({total[part] / seconds:.0%})" for part in agent_time.PARTS]
    return " | ".join([line, *parts])


def agent_time_part(split: dict[str, float] | None) -> str:
    """The minutes of each part of an agent's time that it spent any in, to end its issue line, or nothing for an
    agent without a transcript or without time in it."""
    parts = [f"{part} {seconds / 60:.1f} min" for part, seconds in (split or {}).items() if seconds]
    return " | time: " + ", ".join(parts) if parts else ""


def read_context(file: Path, counted: set[str] | None, event_tokens: dict[str, int], told: dict[str, int]) -> Context:
    """How the context grew in the calls of a transcript whose ids are counted, or in all of them, and whether
    scripts/hooks/hand-off told the agent or session to hand off its work."""
    calls = context_growth.read_calls(file)
    if counted is None:
        counted = {context.call.id for context in calls}
    growth = context_growth.growth(calls, counted, event_tokens)
    return Context(growth, file.stem.removeprefix("agent-") in told)


def contexts_by_type(runs: list[AgentRun], contexts: dict[str, Context]) -> dict[str, list[Context]]:
    by_type: dict[str, list[Context]] = {}
    for run in runs:
        if run.start["id"] in contexts:
            by_type.setdefault(run.start["type"], []).append(contexts[run.start["id"]])
    return by_type


def context_lines(by_type: dict[str, list[Context]], orchestrator: list[Context]) -> list[str]:
    """A line for each type of the agents with a transcript, measured against the threshold at which
    scripts/hooks/hand-off tells a builder to hand off, and one for the orchestrator's sessions, measured against the
    threshold at which it tells the orchestrator to compact."""
    hand_off = ("the hand-off threshold", hook_threshold("soon_tokens"))
    compaction = ("the compaction threshold", hook_threshold("compact_tokens"))
    lines = [context_line(f"type {name}", "agents", by_type[name], hand_off, True) for name in sorted(by_type)]
    # The hook never tells the orchestrator to hand off.
    return [*lines, context_line("the orchestrator", "sessions", orchestrator, compaction, False)]


def context_line(
    whose: str, unit: str, contexts: list[Context], threshold: tuple[str, int], has_hand_offs: bool
) -> str:
    if not contexts:
        return f"Context of {whose}: no calls"
    growths = [context.growth for context in contexts]
    peaks = [growth.peak for growth in growths]
    threshold_name, threshold_tokens = threshold
    past = sum(peak > threshold_tokens for peak in peaks) / len(peaks)
    added: Counter[str] = Counter()
    for growth in growths:
        added.update(growth.added)
    # The kinds whose results added nothing, such as those whose step shrank the context, stay out.
    added = +added
    told = sum(context.is_told_to_hand_off for context in contexts)
    compactions = sum(growth.compactions for growth in growths)
    without_event = sum(growth.steps_without_event for growth in growths)
    parts = [
        (
            f"Context of {whose}: {len(contexts)} {unit}, peak median {thousands(statistics.median(peaks))}, largest "
            f"{thousands(max(peaks))}, {past:.0%} past {threshold_name} of {thousands(threshold_tokens)}"
        ),
        f"{per_tool_call(growths)}, {without_event} steps without an event left out",
        f"{told} told to hand off, {compactions} compactions" if has_hand_offs else f"{compactions} compactions",
    ]
    total = added.total()
    if total:
        most = ", ".join(f"{kind} {tokens / total:.0%}" for kind, tokens in added.most_common(MOST_ADDING_KINDS))
        parts.append(f"added most by {most}")
    return " | ".join(parts)


def agent_context_part(context: Context | None) -> str:
    """An agent's peak context and the context added per tool call, for its issue line, or nothing for an agent
    without a transcript."""
    if context is None:
        return ""
    return f" | context: peak {thousands(context.growth.peak)}, {per_tool_call([context.growth])}"


def per_tool_call(growths: list[context_growth.Growth]) -> str:
    """The context added per tool call, in the steps that have an event."""
    tool_calls = sum(growth.tool_calls for growth in growths)
    if not tool_calls:
        return "no tool call measured"
    added = sum(sum(growth.added.values()) for growth in growths)
    return f"{thousands(added / tool_calls)} added per tool call"


def thousands(tokens: float) -> str:
    return f"{tokens / 1000:.1f}k"


def orchestrator_line(agents: list[Agent]) -> str:
    """The orchestrator's share of the input tokens, which the transcripts give right, unlike the output tokens."""
    total = sum(call.input_tokens for agent in agents for call in agent.calls)
    if total == 0:
        return "Orchestrator's share of the input tokens: none used"
    own = sum(call.input_tokens for agent in agents if agent.role == ORCHESTRATOR for call in agent.calls)
    return f"Orchestrator's share of the input tokens: {own / total:.0%}"


def block_line(blocks: Counter[str]) -> str:
    parts = [f"{rule} {count}" for rule, count in sorted(blocks.items(), key=lambda item: (-item[1], item[0]))]
    return " | ".join([f"Hook blocks: {blocks.total()}", *parts])


def heavy_lines(entries: list[dict[str, Any]], since: dt.datetime) -> list[str]:
    """A line for each heavy command that started to wait, started, stopped or ended after the time, and one for the
    swap."""
    recent = [entry for entry in entries if dt.datetime.fromisoformat(entry["at"]) >= since]
    if not recent:
        return ["Heavy commands: none ran"]
    commands = sorted({entry["command"] for entry in recent})
    lines = [heavy_line(command, [entry for entry in recent if entry["command"] == command]) for command in commands]
    return [*lines, swap_line([entry for entry in recent if entry["event"] == "end"])]


def heavy_line(command: str, entries: list[dict[str, Any]]) -> str:
    starts = [entry for entry in entries if entry["event"] == "start"]
    ends = [entry for entry in entries if entry["event"] == "end"]
    line = f"Heavy command {command}: {len(starts)} started, {len(ends)} ended"
    if ends:
        minutes = statistics.median(end["seconds"] for end in ends) / 60
        cores = statistics.median(end["used"]["cores"] for end in ends)
        memory = statistics.median(end["used"]["memory_gb"] for end in ends)
        line += f", median {minutes:.1f} min, {cores:.1f} cores and {memory:.1f} GB"
    waits = [entry for entry in entries if entry["event"] in ("start", "stop") and entry["waited_seconds"] > 0]
    minutes_waited = sum(wait["waited_seconds"] for wait in waits) / 60
    minutes_with_room = sum(wait["waited_with_room_seconds"] for wait in waits) / 60
    return (
        f"{line} | {len(waits)} waited, {minutes_waited:.1f} min in all, {minutes_with_room:.1f} min of it while "
        "the readings showed room"
    )


def swap_line(ends: list[dict[str, Any]]) -> str:
    swaps = [end["highest_swap_used_gb"] for end in ends if end["highest_swap_used_gb"] is not None]
    if not swaps:
        return "Swap while heavy commands ran: no readings"
    return (
        f"Swap while heavy commands ran, the highest in each run, GB: median {statistics.median(swaps):.1f}, "
        f"highest {max(swaps):.1f}"
    )


class MachineReading(NamedTuple):
    at: dt.datetime
    machine: dict[str, Any]


def read_machine_readings(log: str, since: dt.datetime) -> list[MachineReading]:
    """The machine readings in the meter's log after the time, in the order of their times. A reading from before the
    meter read the machine has none."""
    readings = []
    for line in log.splitlines():
        entry = json.loads(line)
        at = dt.datetime.fromisoformat(entry["at"])
        if at >= since and "machine" in entry:
            readings.append(MachineReading(at, entry["machine"]))
    return sorted(readings, key=lambda reading: reading.at)


def periods_of(runs: list[AgentRun], transcripts_by_id: dict[str, Path]) -> list[Period]:
    """The periods in which the agents worked, as scripts/loop/agent_log.py tells them."""
    runs_folder = paths.loop_dir() / "runs"
    return [period for run in runs for period in working_periods(run, transcripts_by_id, runs_folder)]


def agents_running(at: dt.datetime, periods: list[Period]) -> int:
    """How many agents worked at the time. The periods of one agent don't overlap, so each period counts one agent."""
    return sum(1 for start, end in periods if start <= at < end)


def machine_lines(readings: list[MachineReading], periods: list[Period]) -> list[str]:
    if not readings:
        return ["Machine: no readings"]
    running = [agents_running(reading.at, periods) for reading in readings]
    lines = [machine_line(number, readings) for number in MACHINE_NUMBERS]
    for count in range(1, max(running) + 1):
        lines.append(agents_line(count, [reading for reading, n in zip(readings, running, strict=True) if n == count]))
    return lines


def machine_line(number: MachineNumber, readings: list[MachineReading]) -> str:
    known = known_values(number, readings)
    if not known:
        return f"{number.name}: no readings"
    worst = f"lowest {min(known):.1f}" if number.is_lowest_worst else f"highest {max(known):.1f}"
    parts = [f"median {statistics.median(known):.1f}", worst]
    if number.key == "disk_free_gb":
        parts.append(f"net change {known[-1] - known[0]:+.1f}")
    if number.key == "swap_used_gb":
        parts.append(swap_growth(readings))
    if number.key == "load":
        machines = [reading.machine for reading in readings if reading.machine["load"] is not None]
        above = sum(1 for machine in machines if machine["load"] > machine["cores"])
        parts.append(f"above the cores in {above / len(machines):.0%} of the readings")
    return f"{number.name}: {', '.join(parts)}"


def swap_growth(readings: list[MachineReading]) -> str:
    """The share of the readings in which the swap in use grew since the reading before. Swap stays in use after the
    memory frees up again, so only its growth shows that the machine ran out of memory. A reading counts only when it
    and the reading before both give swap."""
    swaps = [reading.machine["swap_used_gb"] for reading in readings]
    pairs = [(before, after) for before, after in itertools.pairwise(swaps) if before is not None and after is not None]
    if not pairs:
        return "no two readings in a row to compare"
    grew = sum(1 for before, after in pairs if after > before)
    return f"grew since the reading before in {grew / len(pairs):.0%} of the readings"


def known_values(number: MachineNumber, readings: list[MachineReading]) -> list[float]:
    """The number in each reading that gives it."""
    return [reading.machine[number.key] for reading in readings if reading.machine[number.key] is not None]


def agents_line(count: int, readings: list[MachineReading]) -> str:
    """The median of each number in the readings while the count of agents worked."""
    label = f"Median with {count} agent{'' if count == 1 else 's'}"
    if not readings:
        return f"{label}: no readings"
    medians = []
    for number in MACHINE_NUMBERS:
        known = known_values(number, readings)
        medians.append(f"{number.short_name} {statistics.median(known):.1f}" if known else f"{number.short_name} none")
    plural = "" if len(readings) == 1 else "s"
    return f"{label}, {len(readings)} reading{plural}: {', '.join(medians)}"


