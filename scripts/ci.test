#!/usr/bin/env bash
# Runs the step of .github/workflows/ci.yml that runs the tests of the scripts and hooks on small sets of tests, and
# checks that each job that runs those tests has that step, and a matrix that lists every part. It also checks that the
# bash-3-2 job runs the tests as a user other than root.
set -euo pipefail
cd "$(dirname "$0")/.."

base=$(mktemp -d)
trap 'rm -rf "$base"' EXIT

# Prints a key's value in a step of a job, such as the step's command: step_value <workflow> <job> <step name> <key>
step_value() {
  awk -v job="$2" -v step="$3" -v key="        $4: " '
    $0 == "  " job ":" { in_job = 1; next }
    in_job && /^  [[:alnum:]_-]+:/ { exit }
    in_job && $0 == "      - name: " step { in_step = 1; next }
    in_step && /^      - / { exit }
    in_step && index($0, key) == 1 { print substr($0, length(key) + 1); exit }
  ' "$1"
}

# The jobs that run the tests of the scripts and hooks, each with its own bash or tools.
test_jobs=(script-tests bash-3-2 macos)
test_step="Run the tests of the scripts and hooks"

# Run the workflow's command so removing the runner from CI also fails these cases.
step=$(step_value .github/workflows/ci.yml script-tests "$test_step" run)
if [[ -z $step ]]; then
  echo "error: the script-tests job has no step \"$test_step\". Add the step to .github/workflows/ci.yml." >&2
  exit 1
fi
for job in "${test_jobs[@]}"; do
  if [[ $(step_value .github/workflows/ci.yml "$job" "$test_step" run) != "$step" ]]; then
    echo "error: the step \"$test_step\" of the $job job in .github/workflows/ci.yml must run $step, as the step of the script-tests job does. Add the step, or change its command to $step." >&2
    exit 1
  fi
done
printf '%s\n' "$step" > "$base/step"

# The step runs with only these commands and a case's stand-ins for tools on PATH, so that each case decides
# whether jq and shellcheck are installed.
commands=$base/commands
mkdir "$commands"
ln -s "$BASH" "$commands/bash"
for command in cat dirname mktemp rm sleep touch; do
  ln -s "$(command -v "$command")" "$commands/$command"
done

case_count=0
failed_cases=0

# Cases for the matrices of the jobs that run the tests of the scripts and hooks, which must list every part, because a
# part that's left out leaves its test files untested.

# Prints the parts that the matrix of a job lists, one to a line: matrix_parts <workflow> <job>
matrix_parts() {
  awk -v job="$2" '
    $0 == "  " job ":" { in_job = 1; next }
    in_job && /^  [[:alnum:]_-]+:/ { exit }
    in_job && /^        part: \[/ {
      sub(/^        part: \[/, "")
      sub(/\][[:space:]]*$/, "")
      gsub(/,[[:space:]]*/, "\n")
      print
      exit
    }
  ' "$1"
}

# Prints an error and fails unless the matrix of a job lists each part from 1/<count> to <count>/<count>, in order,
# with the count of its first part: check_matrix <workflow> <job>
check_matrix() {
  local workflow=$1 job=$2 listed count number expected=""
  listed=$(matrix_parts "$workflow" "$job")
  if [[ -z $listed ]]; then
    echo "error: the $job job in $workflow has no matrix of parts. Give it one, such as \"part: [1/2, 2/2]\", because its test step runs scripts/test-scripts --part." >&2
    return 1
  fi
  listed=${listed//$'\n'/, }
  count=${listed%%,*}
  count=${count#*/}
  if [[ ! $count =~ ^[1-9][0-9]*$ ]]; then
    count=1
  fi
  for ((number = 1; number <= count; number++)); do
    expected+=${expected:+, }$number/$count
  done
  if [[ $listed != "$expected" ]]; then
    echo "error: the matrix of the $job job in $workflow lists the parts $listed, so some test files don't run. List the parts $expected." >&2
    return 1
  fi
}

# Checks the result of a check of a job, such as check_matrix:
# expect_check <check> <description> <workflow> <job> <exit code> <errors>
expect_check() {
  local check=$1 description=$2 check_status=0 errors
  case_count=$((case_count + 1))
  errors=$("$check" "$3" "$4" 2>&1) || check_status=$?
  if [[ $check_status != "$5" || $errors != "$6" ]]; then
    echo "error: $check $description. Expected status $5 and errors \"$6\", got status $check_status and errors \"$errors\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Writes a workflow whose job tests lists the parts given: write_matrix_workflow <file> [<part list>]
write_matrix_workflow() {
  {
    printf '%s\n' "jobs:" "  tests:" "    runs-on: ubuntu-latest"
    if [[ -n ${2:-} ]]; then
      printf '%s\n' "    strategy:" "      matrix:" "        part: [$2]"
    fi
    printf '%s\n' "  other:" "    strategy:" "      matrix:" "        part: [1/1]"
  } >"$1"
}

write_matrix_workflow "$base/complete.yml" "1/3, 2/3, 3/3"
expect_check check_matrix "passes for every part from 1/3 to 3/3" "$base/complete.yml" tests 0 ""
write_matrix_workflow "$base/missing.yml" "1/4, 2/4, 4/4"
expect_check check_matrix "fails when a part is missing" "$base/missing.yml" tests 1 \
  "error: the matrix of the tests job in $base/missing.yml lists the parts 1/4, 2/4, 4/4, so some test files don't run. List the parts 1/4, 2/4, 3/4, 4/4."
write_matrix_workflow "$base/extra.yml" "1/2, 2/2, 3/2"
expect_check check_matrix "fails when a part is above the count" "$base/extra.yml" tests 1 \
  "error: the matrix of the tests job in $base/extra.yml lists the parts 1/2, 2/2, 3/2, so some test files don't run. List the parts 1/2, 2/2."
write_matrix_workflow "$base/none.yml"
expect_check check_matrix "fails when the job has no matrix" "$base/none.yml" tests 1 \
  "error: the tests job in $base/none.yml has no matrix of parts. Give it one, such as \"part: [1/2, 2/2]\", because its test step runs scripts/test-scripts --part."
for job in "${test_jobs[@]}"; do
  expect_check check_matrix "passes for the $job job in .github/workflows/ci.yml" .github/workflows/ci.yml "$job" 0 ""
done

# Cases for the user that runs the tests in the bash-3-2 job. Its container runs as root, and root can write to a folder
# that a test made read-only, so a test of how a script handles such a folder would fail only in that job.

# Prints an error and fails unless the test step of a job runs GitHub's bash shell with su, as a user other than root:
# check_test_user <workflow> <job>
check_test_user() {
  local shell pattern='^su ([a-z_][a-z0-9_-]*) -c "bash --noprofile --norc -eo pipefail [{]0[}]"$'
  shell=$(step_value "$1" "$2" "$test_step" shell)
  if [[ $shell =~ $pattern && ${BASH_REMATCH[1]} != root ]]; then
    return 0
  fi
  echo "error: the step \"$test_step\" of the $2 job in $1 must run the tests as a user other than root, because root can write to a folder that a test made read-only. Its shell is \"$shell\". Make it su <user> -c \"bash --noprofile --norc -eo pipefail {0}\", with a user that an earlier step adds." >&2
  return 1
}

# Writes a workflow whose job tests has the test step, with the shell given, and a step after it with a shell of its
# own: write_user_workflow <file> [<shell>]
write_user_workflow() {
  {
    printf '%s\n' "jobs:" "  tests:" "    steps:" "      - name: $test_step"
    if [[ -n ${2:-} ]]; then
      printf '%s\n' "        shell: $2"
    fi
    printf '%s\n' "        run: scripts/test-scripts" "      - name: Later step" "        shell: bash" "        run: true"
  } >"$1"
}

# Prints the error of check_test_user for the tests job: user_error <workflow> <shell>
user_error() {
  echo "error: the step \"$test_step\" of the tests job in $1 must run the tests as a user other than root, because root can write to a folder that a test made read-only. Its shell is \"$2\". Make it su <user> -c \"bash --noprofile --norc -eo pipefail {0}\", with a user that an earlier step adds."
}

tester_shell='su tester -c "bash --noprofile --norc -eo pipefail {0}"'
write_user_workflow "$base/tester.yml" "$tester_shell"
expect_check check_test_user "passes for su as a user other than root" "$base/tester.yml" tests 0 ""
write_user_workflow "$base/no-shell.yml"
expect_check check_test_user "fails when the test step has no shell" "$base/no-shell.yml" tests 1 \
  "$(user_error "$base/no-shell.yml" "")"
root_shell='su root -c "bash --noprofile --norc -eo pipefail {0}"'
write_user_workflow "$base/root.yml" "$root_shell"
expect_check check_test_user "fails for su as root" "$base/root.yml" tests 1 "$(user_error "$base/root.yml" "$root_shell")"
write_user_workflow "$base/bash.yml" bash
expect_check check_test_user "fails for a shell without su" "$base/bash.yml" tests 1 "$(user_error "$base/bash.yml" bash)"
expect_check check_test_user "passes for the bash-3-2 job in .github/workflows/ci.yml" .github/workflows/ci.yml bash-3-2 0 ""

# Makes a folder for a case, with a copy of the runner and of the file it reads, an empty scripts/hooks/, a stand-in
# for scripts/test-check that does nothing, a stand-in for jq and an empty temporary folder, and sets case_dir to it.
# The step runs the whole list of test files, as part 1 of 1, unless the case sets part: new_case
new_case() {
  case_dir=$(mktemp -d "$base/case.XXXXXX")
  mkdir -p "$case_dir/scripts/hooks" "$case_dir/tools" "$case_dir/tmp"
  cp scripts/test-scripts scripts/missing-tools "$case_dir/scripts/"
  printf '%s\n' '#!/usr/bin/env bash' > "$case_dir/scripts/test-check"
  add_tool jq
  part=1/1
}

# Makes a tool count as installed in the case, with a stand-in that does nothing: add_tool <tool>
add_tool() {
  printf '%s\n' '#!/usr/bin/env bash' > "$case_dir/tools/$1"
  chmod +x "$case_dir/tools/$1"
}

# Runs the step in the case's folder, with CI set to the value given or empty, the matrix's part in PART and the case's
# temporary folder in TMPDIR, and sets status and output: run_step [<CI>]
# GitHub's bash shell exits on a failing command and sets pipefail.
run_step() {
  status=0
  output=$(cd "$case_dir" && CI=${1:-} PART=$part TMPDIR=$case_dir/tmp PATH=$case_dir/tools:$commands \
    "$BASH" --noprofile --norc -eo pipefail "$base/step" 2>&1) || status=$?
}

# Checks the result of run_step, and that the step left no files in the case's temporary folder:
# expect_result <description> <exit code> <output>
expect_result() {
  local description=$1 expected_status=$2 expected_output=$3 left_files
  case_count=$((case_count + 1))
  left_files=$(ls -A "$case_dir/tmp")
  if [[ $status != "$expected_status" || $output != "$expected_output" || -n $left_files ]]; then
    echo "error: the script-test step $description. Expected status $expected_status, output \"$expected_output\" and no files left in TMPDIR, got status $status, output \"$output\" and these files in TMPDIR: \"$left_files\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

new_case
run_step
expect_result "succeeds when no test matches" 0 ""

new_case
mkdir "$case_dir/scripts/directory.test"
printf '%s\n' 'exit 1' > "$case_dir/scripts/not-a-test"
run_step
expect_result "skips directories and files whose names do not match" 0 ""

new_case
printf '%s\n' '#!/usr/bin/env bash' 'echo first' > "$case_dir/scripts/first.test"
printf '%s\n' '#!/usr/bin/env bash' 'echo second' > "$case_dir/scripts/second test.test"
run_step
output=$(printf '%s\n' "$output" | sort)
expect_result "runs every matching regular file, including non-executable files and names with spaces" 0 $'first\nsecond'

new_case
printf '%s\n' '#!/usr/bin/env bash' 'exit 7' > "$case_dir/scripts/first.test"
printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$case_dir/scripts/last.test"
chmod +x "$case_dir/scripts/"*.test
run_step
expect_result "fails when a test before the last test fails" 7 ""

new_case
cat > "$case_dir/scripts/version.test" <<'TEST'
#!/usr/bin/env bash
printf '%s\n' "$BASH_VERSION"
./scripts/child
TEST
cat > "$case_dir/scripts/child" <<'CHILD'
#!/usr/bin/env bash
printf '%s\n' "$BASH_VERSION"
CHILD
cp "$case_dir/scripts/child" "$case_dir/scripts/hooks/version.test"
cp "$case_dir/scripts/child" "$case_dir/scripts/test-check"
chmod +x "$case_dir/scripts/version.test" "$case_dir/scripts/child"
run_step
expect_result "uses the current bash for every test file and child scripts" 0 "$BASH_VERSION"$'\n'"$BASH_VERSION"$'\n'"$BASH_VERSION"$'\n'"$BASH_VERSION"

# Each test file must start before any of them ends. Run one after another, they time out.
new_case
for name in hooks check first second; do
  case "$name" in
    hooks) file=hooks/hooks.test ;;
    check) file=test-check ;;
    *) file=$name.test ;;
  esac
  cat > "$case_dir/scripts/$file" <<TEST
#!/usr/bin/env bash
echo "$name started"
touch "$name.started"
for ((tries = 0; tries < 100; tries++)); do
  if [[ -f hooks.started && -f check.started && -f first.started && -f second.started ]]; then
    echo "$name passed"
    exit 0
  fi
  sleep 0.1
done
echo "error: the test files did not start together." >&2
exit 1
TEST
done
run_step
expect_result "runs every test file at the same time and keeps the output of each together" 0 \
  $'hooks started\nhooks passed\ncheck started\ncheck passed\nfirst started\nfirst passed\nsecond started\nsecond passed'

for failing_test in hooks/failing.test test-check; do
  new_case
  printf '%s\n' '#!/usr/bin/env bash' 'echo failed >&2' 'exit 7' > "$case_dir/scripts/$failing_test"
  printf '%s\n' '#!/usr/bin/env bash' 'echo scripts passed' > "$case_dir/scripts/pass.test"
  run_step
  expect_result "fails when scripts/$failing_test fails and still waits for the script tests" 7 $'failed\nscripts passed'
done

# Cases for --part, which runs every so many test files of the list, as each job of the matrix does.

# Writes stand-ins that print their names, for a list of five test files: hooks/alpha.test, test-check, bravo.test,
# charlie.test and delta.test: write_named_tests
write_named_tests() {
  local name
  for name in hooks/alpha bravo charlie delta; do
    printf '%s\n' '#!/usr/bin/env bash' "echo ${name#hooks/}" > "$case_dir/scripts/$name.test"
  done
  printf '%s\n' '#!/usr/bin/env bash' 'echo check' > "$case_dir/scripts/test-check"
}

new_case
write_named_tests
part=1/2
run_step
expect_result "runs the first, third and fifth test files for part 1 of 2" 0 $'alpha\nbravo\ndelta'

new_case
write_named_tests
part=2/2
run_step
expect_result "runs the second and fourth test files for part 2 of 2" 0 $'check\ncharlie'

new_case
write_named_tests
part=5/5
run_step
expect_result "runs the fifth test file for part 5 of 5" 0 "delta"

new_case
write_named_tests
part=3/2
run_step
expect_result "fails for a part above the number of parts, before it starts a test" 2 \
  "error: --part 3/2 names part 3 of 2. Give a part from 1 to 2."

for part_value in 0/2 1/0 2 "" a/b; do
  new_case
  write_named_tests
  part=$part_value
  run_step
  expect_result "fails for the part \"$part_value\", before it starts a test" 2 \
    "error: scripts/test-scripts takes no argument, --branch, or --part and a part such as 2/3, and it got: --part $part_value"
done

# Case for stopping the runner, which stops each test that still runs. The stand-in runs for 10 seconds, unless it's
# stopped.

# Waits up to 10 seconds for a file to exist, and fails if it doesn't: wait_for_file <path>
wait_for_file() {
  local tries
  for ((tries = 0; tries < 100; tries++)); do
    if [[ -e $1 ]]; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

# Starts the runner in the background, with a temporary folder of the case's own, and stops it once the stand-in
# endless.test has started. Prints an error and fails if the runner leaves the stand-in running or leaves files in
# the temporary folder: stop_runner
stop_runner() {
  local runner
  # exec makes the runner the process that kill stops.
  (cd "$case_dir" && TMPDIR=$case_dir/tmp PATH=$case_dir/tools:$commands exec scripts/test-scripts >/dev/null 2>&1) &
  runner=$!
  if ! wait_for_file "$case_dir/endless.started"; then
    echo "error: scripts/test-scripts didn't start endless.test within 10 seconds." >&2
    return 1
  fi
  kill "$runner"
  # The redirection hides the shell's message that the runner was stopped.
  wait "$runner" 2>/dev/null || true
  if ! wait_for_file "$case_dir/endless.stopped"; then
    echo "error: when scripts/test-scripts stops, it must stop each test that still runs, but endless.test went on running." >&2
    return 1
  fi
  if [[ -n $(ls -A "$case_dir/tmp") ]]; then
    echo "error: when scripts/test-scripts stops, it must remove its files from TMPDIR, but it left: $(ls -A "$case_dir/tmp")" >&2
    return 1
  fi
}

new_case
printf '%s\n' '#!/usr/bin/env bash' "trap 'touch endless.stopped; exit 1' TERM" 'touch endless.started' \
  'for ((tries = 0; tries < 100; tries++)); do' '  sleep 0.1' 'done' > "$case_dir/scripts/endless.test"
case_count=$((case_count + 1))
if ! stop_runner; then
  failed_cases=$((failed_cases + 1))
fi

# Cases for the ShellCheck cases of scripts/test-check, which its option --shellcheck-only runs.

new_case
add_tool shellcheck
printf '%s\n' '#!/usr/bin/env bash' 'echo "test-check ran with [$*]"' > "$case_dir/scripts/test-check"
run_step
output=$(printf '%s\n' "$output" | LC_ALL=C sort)
expect_result "runs the ShellCheck cases of scripts/test-check too, where shellcheck is installed" 0 \
  $'test-check ran with [--shellcheck-only]\ntest-check ran with []'

new_case
add_tool shellcheck
printf '%s\n' '#!/usr/bin/env bash' 'if [[ $* == --shellcheck-only ]]; then echo "the ShellCheck cases failed" >&2; exit 7; fi' \
  > "$case_dir/scripts/test-check"
printf '%s\n' '#!/usr/bin/env bash' 'echo "scripts passed"' > "$case_dir/scripts/pass.test"
run_step
expect_result "fails when the ShellCheck cases of scripts/test-check fail" 7 $'the ShellCheck cases failed\nscripts passed'

new_case
printf '%s\n' '#!/usr/bin/env bash' 'echo "test-check ran with [$*]"' > "$case_dir/scripts/test-check"
run_step true
expect_result "skips the ShellCheck cases of scripts/test-check where shellcheck isn't installed, in CI too" 0 \
  "test-check ran with []"

# Cases for the hooks' tests, which need jq.

new_case
rm "$case_dir/tools/jq"
printf '%s\n' '#!/usr/bin/env bash' 'echo "the hooks tests ran"' > "$case_dir/scripts/hooks/hook.test"
printf '%s\n' '#!/usr/bin/env bash' 'echo "scripts passed"' > "$case_dir/scripts/pass.test"
run_step
expect_result "skips the hooks' tests where jq isn't installed, and runs the other tests" 0 \
  $'Skipped the jq check because jq is not installed. To run it here, install it: https://jqlang.org/download/\nscripts passed'

new_case
rm "$case_dir/tools/jq"
printf '%s\n' '#!/usr/bin/env bash' 'echo "the hooks tests ran"' > "$case_dir/scripts/hooks/hook.test"
printf '%s\n' '#!/usr/bin/env bash' 'echo "scripts passed"' > "$case_dir/scripts/pass.test"
run_step true
expect_result "fails in CI where jq isn't installed, before it starts a test" 1 \
  "error: jq is not installed. Install it in scripts/install-check-tools, or in an earlier step of this job in .github/workflows/ci.yml."

# Cases for --branch, which scripts/check uses to run only the test files that the branch's changes can affect.

# Runs scripts/test-scripts --branch in the case's folder, with the commands of a folder on PATH, and sets status and
# output: run_branch <folder of commands>
# LOOP_HEAVY_COMMAND keeps the runner from waiting its turn through scripts/loop/run-heavy, which the case has no copy of.
run_branch() {
  status=0
  output=$(cd "$case_dir" && LOOP_HEAVY_COMMAND=test TMPDIR=$case_dir/tmp PATH=$case_dir/tools:$1 \
    scripts/test-scripts --branch 2>&1) || status=$?
}

new_case
write_named_tests
run_branch "$commands"
expect_result "runs every test file with --branch where uv, which runs scripts/affected-tests, isn't installed" 0 \
  $'alpha\ncheck\nbravo\ncharlie\ndelta'

if command -v uv >/dev/null; then
  branch_commands=$base/branch-commands
  cp -R "$commands" "$branch_commands"
  for command in git uv; do
    ln -s "$(command -v "$command")" "$branch_commands/$command"
  done
  new_case
  write_named_tests
  cp scripts/affected-tests .python-version "$case_dir/scripts/"
  mv "$case_dir/scripts/.python-version" "$case_dir/"
  git -C "$case_dir" init --quiet --initial-branch=main
  git -C "$case_dir" add --all
  git -C "$case_dir" -c user.name=test -c user.email=test@example.com commit --quiet -m "chore: start"
  git -C "$case_dir" update-ref refs/remotes/origin/main HEAD
  echo 'echo again' >> "$case_dir/scripts/charlie.test"
  run_branch "$branch_commands"
  expect_result "runs only the test file that the branch changes with --branch" 0 \
    $'Ran 1 of the 5 tests of the scripts and hooks, those that this branch\'s changes can affect, as scripts/affected-tests decides. CI runs them all.\ncharlie\nagain'
fi

if ((failed_cases > 0)); then
  echo "error: $failed_cases of the $case_count cases in scripts/ci.test failed. The errors above say which." >&2
  exit 1
fi
echo "scripts/ci.test passed. Cases: $case_count."
