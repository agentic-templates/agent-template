#!/usr/bin/env bash
# Runs the bash 3.2 job's test runner on small sets of tests, and checks that the script-tests job runs it too.
set -euo pipefail
cd "$(dirname "$0")/.."

base=$(mktemp -d)
trap 'rm -rf "$base"' EXIT

# Prints the command of a step in a job of .github/workflows/ci.yml: step_command <job> <step name>
step_command() {
  awk -v job="$1" -v step="$2" '
    $0 == "  " job ":" { in_job = 1; next }
    in_job && /^  [[:alnum:]_-]+:/ { exit }
    in_job && $0 == "      - name: " step { in_step = 1; next }
    in_step && /^        run: / { sub(/^        run: /, ""); print; exit }
  ' .github/workflows/ci.yml
}

# Run the workflow's command so removing the runner from CI also fails these cases.
step=$(step_command bash-3-2 "Run tests with bash 3.2")
if [[ -z $step ]]; then
  echo "error: the bash-3-2 job has no test step. Add the step to .github/workflows/ci.yml." >&2
  exit 1
fi
script_tests_step=$(step_command script-tests "Run the tests of the scripts and hooks")
if [[ $script_tests_step != "$step" ]]; then
  echo "error: the step \"Run the tests of the scripts and hooks\" of the script-tests job in .github/workflows/ci.yml must run $step, as the test step of the bash-3-2 job does. Add the step, or change its command to $step." >&2
  exit 1
fi
printf '%s\n' "$step" > "$base/step"

# The step runs with only these commands and a case's stand-ins for tools on PATH, so that each case decides
# whether jq and shellcheck are installed.
commands=$base/commands
mkdir "$commands"
ln -s "$BASH" "$commands/bash"
for command in cat dirname mktemp rm sleep touch; do
  ln -s "$(command -v "$command")" "$commands/$command"
done

case_count=0
failed_cases=0

# Makes a folder for a case, with a copy of the runner and of the file it reads, an empty scripts/hooks/, a stand-in
# for scripts/test-check that does nothing, and a stand-in for jq, and sets case_dir to it. The step runs the whole
# list of test files, as part 1 of 1, unless the case sets part: new_case
new_case() {
  case_dir=$(mktemp -d "$base/case.XXXXXX")
  mkdir -p "$case_dir/scripts/hooks" "$case_dir/tools"
  cp scripts/test-scripts scripts/missing-tools "$case_dir/scripts/"
  printf '%s\n' '#!/usr/bin/env bash' > "$case_dir/scripts/test-check"
  add_tool jq
  part=1/1
}

# Makes a tool count as installed in the case, with a stand-in that does nothing: add_tool <tool>
add_tool() {
  printf '%s\n' '#!/usr/bin/env bash' > "$case_dir/tools/$1"
  chmod +x "$case_dir/tools/$1"
}

# Runs the step in the case's folder, with CI set to the value given or empty, and the matrix's part in PART, and sets
# status and output: run_step [<CI>]
# GitHub's bash shell exits on a failing command and sets pipefail.
run_step() {
  status=0
  output=$(cd "$case_dir" && CI=${1:-} PART=$part PATH=$case_dir/tools:$commands \
    "$BASH" --noprofile --norc -eo pipefail "$base/step" 2>&1) || status=$?
}

expect_result() {
  local description=$1 expected_status=$2 expected_output=$3
  case_count=$((case_count + 1))
  if [[ $status != "$expected_status" || $output != "$expected_output" ]]; then
    echo "error: the script-test step $description. Expected status $expected_status and output \"$expected_output\", got status $status and output \"$output\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

new_case
run_step
expect_result "succeeds when no test matches" 0 ""

new_case
mkdir "$case_dir/scripts/directory.test"
printf '%s\n' 'exit 1' > "$case_dir/scripts/not-a-test"
run_step
expect_result "skips directories and files whose names do not match" 0 ""

new_case
printf '%s\n' '#!/usr/bin/env bash' 'echo first' > "$case_dir/scripts/first.test"
printf '%s\n' '#!/usr/bin/env bash' 'echo second' > "$case_dir/scripts/second test.test"
run_step
output=$(printf '%s\n' "$output" | sort)
expect_result "runs every matching regular file, including non-executable files and names with spaces" 0 $'first\nsecond'

new_case
printf '%s\n' '#!/usr/bin/env bash' 'exit 7' > "$case_dir/scripts/first.test"
printf '%s\n' '#!/usr/bin/env bash' 'exit 0' > "$case_dir/scripts/last.test"
chmod +x "$case_dir/scripts/"*.test
run_step
expect_result "fails when a test before the last test fails" 7 ""

new_case
cat > "$case_dir/scripts/version.test" <<'TEST'
#!/usr/bin/env bash
printf '%s\n' "$BASH_VERSION"
./scripts/child
TEST
cat > "$case_dir/scripts/child" <<'CHILD'
#!/usr/bin/env bash
printf '%s\n' "$BASH_VERSION"
CHILD
cp "$case_dir/scripts/child" "$case_dir/scripts/hooks/version.test"
cp "$case_dir/scripts/child" "$case_dir/scripts/test-check"
chmod +x "$case_dir/scripts/version.test" "$case_dir/scripts/child"
run_step
expect_result "uses the current bash for every test file and child scripts" 0 "$BASH_VERSION"$'\n'"$BASH_VERSION"$'\n'"$BASH_VERSION"$'\n'"$BASH_VERSION"

# Each test file must start before any of them ends. Run one after another, they time out.
new_case
for name in hooks check first second; do
  case "$name" in
    hooks) file=hooks/hooks.test ;;
    check) file=test-check ;;
    *) file=$name.test ;;
  esac
  cat > "$case_dir/scripts/$file" <<TEST
#!/usr/bin/env bash
echo "$name started"
touch "$name.started"
for ((tries = 0; tries < 100; tries++)); do
  if [[ -f hooks.started && -f check.started && -f first.started && -f second.started ]]; then
    echo "$name passed"
    exit 0
  fi
  sleep 0.1
done
echo "error: the test files did not start together." >&2
exit 1
TEST
done
run_step
expect_result "runs every test file at the same time and keeps the output of each together" 0 \
  $'hooks started\nhooks passed\ncheck started\ncheck passed\nfirst started\nfirst passed\nsecond started\nsecond passed'

for failing_test in hooks/failing.test test-check; do
  new_case
  printf '%s\n' '#!/usr/bin/env bash' 'echo failed >&2' 'exit 7' > "$case_dir/scripts/$failing_test"
  printf '%s\n' '#!/usr/bin/env bash' 'echo scripts passed' > "$case_dir/scripts/pass.test"
  run_step
  expect_result "fails when scripts/$failing_test fails and still waits for the script tests" 7 $'failed\nscripts passed'
done

# Cases for --part, which runs every so many test files of the list, as each job of the matrix does.

# Writes stand-ins that print their names, for a list of five test files: hooks/alpha.test, test-check, bravo.test,
# charlie.test and delta.test: write_named_tests
write_named_tests() {
  local name
  for name in hooks/alpha bravo charlie delta; do
    printf '%s\n' '#!/usr/bin/env bash' "echo ${name#hooks/}" > "$case_dir/scripts/$name.test"
  done
  printf '%s\n' '#!/usr/bin/env bash' 'echo check' > "$case_dir/scripts/test-check"
}

new_case
write_named_tests
part=1/2
run_step
expect_result "runs the first, third and fifth test files for part 1 of 2" 0 $'alpha\nbravo\ndelta'

new_case
write_named_tests
part=2/2
run_step
expect_result "runs the second and fourth test files for part 2 of 2" 0 $'check\ncharlie'

new_case
write_named_tests
part=5/5
run_step
expect_result "runs the fifth test file for part 5 of 5" 0 "delta"

new_case
write_named_tests
part=3/2
run_step
expect_result "fails for a part above the number of parts, before it starts a test" 2 \
  "error: --part 3/2 names part 3 of 2. Give a part from 1 to 2."

for part_value in 0/2 1/0 2 "" a/b; do
  new_case
  write_named_tests
  part=$part_value
  run_step
  expect_result "fails for the part \"$part_value\", before it starts a test" 2 \
    "error: scripts/test-scripts takes no argument, or --part and a part such as 2/3, and it got: --part $part_value"
done

# Case for stopping the runner, which stops each test that still runs. The stand-in runs for 10 seconds, unless it's
# stopped.

# Waits up to 10 seconds for a file to exist, and fails if it doesn't: wait_for_file <path>
wait_for_file() {
  local tries
  for ((tries = 0; tries < 100; tries++)); do
    if [[ -e $1 ]]; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

# Starts the runner in the background, with a temporary folder of the case's own, and stops it once the stand-in
# endless.test has started. Prints an error and fails if the runner leaves the stand-in running or leaves files in
# the temporary folder: stop_runner
stop_runner() {
  local runner
  mkdir "$case_dir/tmp"
  # exec makes the runner the process that kill stops.
  (cd "$case_dir" && TMPDIR=$case_dir/tmp PATH=$case_dir/tools:$commands exec scripts/test-scripts >/dev/null 2>&1) &
  runner=$!
  if ! wait_for_file "$case_dir/endless.started"; then
    echo "error: scripts/test-scripts didn't start endless.test within 10 seconds." >&2
    return 1
  fi
  kill "$runner"
  # The redirection hides the shell's message that the runner was stopped.
  wait "$runner" 2>/dev/null || true
  if ! wait_for_file "$case_dir/endless.stopped"; then
    echo "error: when scripts/test-scripts stops, it must stop each test that still runs, but endless.test went on running." >&2
    return 1
  fi
  if [[ -n $(ls -A "$case_dir/tmp") ]]; then
    echo "error: when scripts/test-scripts stops, it must remove its files from TMPDIR, but it left: $(ls -A "$case_dir/tmp")" >&2
    return 1
  fi
}

new_case
printf '%s\n' '#!/usr/bin/env bash' "trap 'touch endless.stopped; exit 1' TERM" 'touch endless.started' \
  'for ((tries = 0; tries < 100; tries++)); do' '  sleep 0.1' 'done' > "$case_dir/scripts/endless.test"
case_count=$((case_count + 1))
if ! stop_runner; then
  failed_cases=$((failed_cases + 1))
fi

# Cases for the ShellCheck cases of scripts/test-check, which its option --shellcheck-only runs.

new_case
add_tool shellcheck
printf '%s\n' '#!/usr/bin/env bash' 'echo "test-check ran with [$*]"' > "$case_dir/scripts/test-check"
run_step
output=$(printf '%s\n' "$output" | LC_ALL=C sort)
expect_result "runs the ShellCheck cases of scripts/test-check too, where shellcheck is installed" 0 \
  $'test-check ran with [--shellcheck-only]\ntest-check ran with []'

new_case
add_tool shellcheck
printf '%s\n' '#!/usr/bin/env bash' 'if [[ $* == --shellcheck-only ]]; then echo "the ShellCheck cases failed" >&2; exit 7; fi' \
  > "$case_dir/scripts/test-check"
printf '%s\n' '#!/usr/bin/env bash' 'echo "scripts passed"' > "$case_dir/scripts/pass.test"
run_step
expect_result "fails when the ShellCheck cases of scripts/test-check fail" 7 $'the ShellCheck cases failed\nscripts passed'

new_case
printf '%s\n' '#!/usr/bin/env bash' 'echo "test-check ran with [$*]"' > "$case_dir/scripts/test-check"
run_step true
expect_result "skips the ShellCheck cases of scripts/test-check where shellcheck isn't installed, in CI too" 0 \
  "test-check ran with []"

# Cases for the hooks' tests, which need jq.

new_case
rm "$case_dir/tools/jq"
printf '%s\n' '#!/usr/bin/env bash' 'echo "the hooks tests ran"' > "$case_dir/scripts/hooks/hook.test"
printf '%s\n' '#!/usr/bin/env bash' 'echo "scripts passed"' > "$case_dir/scripts/pass.test"
run_step
expect_result "skips the hooks' tests where jq isn't installed, and runs the other tests" 0 \
  $'Skipped the jq check because jq is not installed. To run it here, install it: https://jqlang.org/download/\nscripts passed'

new_case
rm "$case_dir/tools/jq"
printf '%s\n' '#!/usr/bin/env bash' 'echo "the hooks tests ran"' > "$case_dir/scripts/hooks/hook.test"
printf '%s\n' '#!/usr/bin/env bash' 'echo "scripts passed"' > "$case_dir/scripts/pass.test"
run_step true
expect_result "fails in CI where jq isn't installed, before it starts a test" 1 \
  "error: jq is not installed. Install it in scripts/install-check-tools, or in an earlier step of this job in .github/workflows/ci.yml."

if ((failed_cases > 0)); then
  echo "error: $failed_cases of the $case_count cases in scripts/ci.test failed. The errors above say which." >&2
  exit 1
fi
echo "scripts/ci.test passed. Cases: $case_count."
