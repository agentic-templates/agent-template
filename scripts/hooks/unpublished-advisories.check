#!/usr/bin/env bash
# Blocks the commands that would post the GHSA ID of one of this repository's security advisories that isn't published,
# closed or withdrawn, such as GHSA-2c5x-3m4v-7q8r, because the ID stays private until the advisory is published, and
# GitHub keeps the text of an issue or a comment in its edit history after an edit takes the ID out. The commands and
# their text are:
# - the title and body of gh issue create, its alias gh issue new, gh issue edit, gh pr create, its alias gh pr new,
#   and gh pr edit
# - the body of gh issue comment, gh pr comment and gh pr review
# - the comment that -c or --comment gives to gh issue close, gh issue reopen, gh pr close and gh pr reopen
# - the subject and body of the commit that gh pr merge makes
# - the title and notes of gh release create, its alias gh release new, and gh release edit
# - each message and trailer that -m, --message, -F, --file and --trailer give git commit
# - each message that -m, --message, -F and --file give git merge, the value of its --into-name, and the names of the
#   commits that it merges, which git can write into the merge commit's message
# - the repository and the branches that git pull names, which git can write into the merge commit's message
# It reads a prefix of one of these long flags that git reads as the flag, such as --mess for --message, as that flag.
# It reads the text as read_text and read_body in helpers.bash read it, as the command writes it, without running $( )
# or filling in variables. It blocks a relative path to a body file when it can't tell the folder that the path starts
# from, as after cd "$folder". It finds an ID in any case, because the name of an advisory's private fork holds the ID in
# lower case. It asks GitHub about each ID that it finds, so a command without one asks nothing. When GitHub answers that
# the repository has no advisory of that ID, the hook allows the ID. GitHub answers so for an advisory of another
# repository, such as one that Dependabot names, and also for one that gh's account may not see. When gh fails in
# another way, such as without a network, the hook blocks the command, because it can't tell whether the ID is private.
# It allows a gh command whose -R or --repo names the advisory's private fork, because the fork is private too. A commit
# message counts in any repository, because step 3 of "Fix a security vulnerability" in docs/releasing.md pushes the
# fork's commits to origin before the advisory is published. A command that posts to the advisory itself, such as gh api
# with the advisory's endpoint, goes ahead, because the hook reads no gh api command. It doesn't read the text that git
# takes from the repository for the message of a merge commit: the branch that the merge goes into, the URL and the
# branch of FETCH_HEAD, the branch that @{-1} or - names, the upstream branch, when the command names no commit or names
# the branch with @{upstream}, the URL of the remote that git pull pulls from when the command gives no URL, the message
# of an annotated tag that git merges, and with --log, the subjects of the merged commits and the descriptions of their
# branches.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"

# The flags that take a value, as gh release create --help, gh release edit --help, git commit -h, git merge -h and
# git pull -h list them. git reads the value of a short flag whose value is optional, such as -S, only from the same
# word, as in -Skey, so these flags have lists of their own.
release_create_flags_with_value=" --discussion-category -n --notes -F --notes-file --notes-start-tag --target -t --title -R --repo "
release_edit_flags_with_value=" --discussion-category -n --notes -F --notes-file --tag --target -t --title -R --repo "
git_commit_flags_with_value=" -F --file --author --date -m --message -c --reedit-message -C --reuse-message --fixup --squash --trailer -t --template --cleanup -U --unified --inter-hunk-context --pathspec-from-file "
git_merge_flags_with_value=" --cleanup -s --strategy -X --strategy-option -m --message -F --file --into-name "
git_pull_flags_with_value=" --cleanup -s --strategy -X --strategy-option --upload-pack --depth --shallow-since --shallow-exclude --deepen --refmap -o --server-option --negotiation-restrict --negotiation-tip --negotiation-include "
git_commit_flags_with_optional_value=" -S -u "
git_merge_flags_with_optional_value=" -S "
git_pull_flags_with_optional_value=" -r -S -j "

# Each flag that gives text to the message, after the shortest prefix that git 2.56 reads as the flag. git reads a long
# flag from any prefix of it that starts no other long flag of the subcommand, as in --mess for --message.
git_commit_message_flag_prefixes=" --m:--message --fil:--file --tr:--trailer "
git_merge_message_flag_prefixes=" --m:--message --fi:--file --i:--into-name "

# A GHSA ID in any case. GitHub writes GHSA in capitals and the rest in lower case.
ghsa_id='[Gg][Hh][Ss][Aa]-[0-9A-Za-z]{4}-[0-9A-Za-z]{4}-[0-9A-Za-z]{4}'

what_is_checked="the text for the IDs of security advisories that aren't published"

# Adds the title and body that a gh command gives to posted_text, and sets destination to the repository that its -R or
# --repo names, or to empty: read_gh_text <flags that take a value> [<flag that gives the body> <flag that gives its file>]
read_gh_text() {
  if ! read_text "$1"; then
    return 0
  fi
  if [[ -n $has_title ]]; then
    posted_text+=$title$'\n'
  fi
  if [[ -n $body_source ]]; then
    read_body "$what_is_checked" "${@:2}"
    posted_text+=$body$'\n'
  fi
  read_arguments 3 "$1"
  destination=${repository[1]:-}
}

# Adds the text that the gh command in command_words posts to posted_text, as read_gh_text reads it.
read_gh_command_text() {
  case "${command_words[1]:-} ${command_words[2]:-}" in
    "issue create" | "issue new") read_gh_text "$issue_create_flags_with_value" ;;
    "issue edit") read_gh_text "$issue_edit_flags_with_value" ;;
    "issue comment" | "pr comment") read_gh_text "$comment_flags_with_value" ;;
    "pr review") read_gh_text "$review_flags_with_value" ;;
    "issue close") read_gh_text "$issue_close_flags_with_value" ;;
    "pr close") read_gh_text "$pr_close_flags_with_value" ;;
    "issue reopen" | "pr reopen") read_gh_text "$reopen_flags_with_value" ;;
    "pr create" | "pr new") read_gh_text "$pr_create_flags_with_value" ;;
    "pr edit") read_gh_text "$pr_edit_flags_with_value" ;;
    "pr merge") read_gh_text "$merge_flags_with_value" ;;
    "release create" | "release new") read_gh_text "$release_create_flags_with_value" --notes --notes-file ;;
    "release edit") read_gh_text "$release_edit_flags_with_value" --notes --notes-file ;;
  esac
}

# Prints the folder that git opens a relative path to the file of -F from: the folder that the command runs in, as each
# -C before the subcommand changes it, or nothing when the hook can't tell the folder. read_git_options puts the agent's
# folder first in git_folder, so the loop starts after it.
git_file_folder() {
  local i
  for ((i = 2; i < ${#git_folder[@]}; i += 2)); do
    if [[ ${git_folder[i]} != -C ]]; then
      continue
    fi
    # An absolute folder doesn't depend on the folder before it, which the hook may not know, as after cd "$folder".
    if expand_home "${git_folder[i + 1]}" && [[ $expanded_path == /* ]]; then
      command_folder=/
    fi
    change_command_folder "${git_folder[i + 1]}"
  done
  printf '%s' "$command_folder"
}

# Sets body_source, body_file and body_folder for read_body to read the file of -F: read_message_file <path>
# git commit reads - as standard input, and the shell opens the file of a < redirection from the folder that the command
# runs in. git opens any other file from the folder that git_file_folder prints, and git merge opens a file named - too.
read_message_file() {
  body_source=file body_file=$1
  if [[ $1 == - && ${command_words[git_subcommand]} == commit ]]; then
    return 0
  fi
  if [[ $1 == - ]]; then
    body_file=./-
  fi
  body_folder=$(git_file_folder)
}

# Sets full_word to a word of git with its long flag in full when the word gives a prefix of the flag that git reads as
# the flag, as --message=text for --mess=text, and otherwise to the word: expand_flag_prefix <word> <prefixes>
expand_flag_prefix() {
  local name=${1%%=*} pair flag
  full_word=$1
  for pair in $2; do
    flag=${pair#*:}
    if [[ $name == "${pair%%:*}"* && $flag == "$name"* ]]; then
      full_word=$flag${1#"$name"}
      return 0
    fi
  done
}

# Adds each message and trailer that a git commit or git merge command in command_words gives to posted_text, and the
# value of the --into-name of git merge. Adds the names of the commits that git merge merges, and of the repository and
# the branches that git pull pulls, to merged_names.
read_git_command_text() {
  local subcommand flags_with_value flags_with_optional_value message_flag_prefixes="" i word has_dashes="" full_word
  local flag value value_is_next_word flags_before
  read_git_options
  subcommand=${command_words[git_subcommand]:-}
  case $subcommand in
    commit)
      flags_with_value=$git_commit_flags_with_value
      flags_with_optional_value=$git_commit_flags_with_optional_value
      message_flag_prefixes=$git_commit_message_flag_prefixes
      ;;
    merge)
      flags_with_value=$git_merge_flags_with_value
      flags_with_optional_value=$git_merge_flags_with_optional_value
      message_flag_prefixes=$git_merge_message_flag_prefixes
      ;;
    pull)
      flags_with_value=$git_pull_flags_with_value
      flags_with_optional_value=$git_pull_flags_with_optional_value
      ;;
    *) return 0 ;;
  esac
  for ((i = git_subcommand + 1; i < ${#command_words[@]}; i++)); do
    word=${command_words[i]}
    # git merge reads each word that isn't a flag or a flag's value as a commit, also after --, and git pull reads it as
    # the repository or a branch. git commit reads it as a path.
    if [[ -n $has_dashes || $word != -* ]]; then
      if [[ $subcommand != commit ]]; then
        merged_names+=$word$'\n'
      fi
      continue
    fi
    if [[ $word == -- ]]; then
      has_dashes=yes
      continue
    fi
    expand_flag_prefix "$word" "$message_flag_prefixes"
    split_flag_word "$full_word" "$flags_with_value" "$flags_with_optional_value"
    if [[ -n $value_is_next_word ]]; then
      i=$((i + 1))
      value=${command_words[i]:-}
    fi
    body_folder=$command_folder
    case $flag in
      -m | --message | --trailer) body_source=text body_word=$value body_may_expand=${command_word_may_expand[i]:-} ;;
      -F | --file) read_message_file "$value" ;;
      --into-name)
        posted_text+=$value$'\n'
        continue
        ;;
      *) continue ;;
    esac
    read_body "$what_is_checked" -m -F
    posted_text+=$body$'\n'
  done
}

# Sets advisory_state to the state of the advisory of an ID in this repository, and advisory_fork to the full name of
# its private fork, or to empty when it has none. Fails when GitHub has no such advisory, and blocks the command when gh
# fails in another way: read_advisory <ID as the text writes it> <ID as GitHub writes it>
read_advisory() {
  local answer
  # gh finds the repository from the folder it runs in, as scripts/record-vulnerability does when it opens an advisory.
  if answer=$(cd -- "$hooks_folder" && gh api "repos/{owner}/{repo}/security-advisories/$2" \
    --jq '[.state, (.private_fork.full_name // "")] | @tsv' 2>&1); then
    # The fork comes last, because it can be empty, and read joins the tabs around an empty field.
    IFS=$'\t' read -r advisory_state advisory_fork <<<"$answer"
    return 0
  fi
  if [[ $answer == *"(HTTP 404)"* ]]; then
    return 1
  fi
  block "Blocked: this hook can't tell whether $1 is the ID of a security advisory of this repository that isn't published yet. Write the text without the ID, or run the command again once gh works. gh failed: $answer"
}

# Succeeds if the gh command's -R or --repo names a repository, in any case: posts_to <owner/name>
posts_to() {
  local result=1
  read_name_with_owner "$destination"
  shopt -s nocasematch
  if [[ -n $destination && $name_with_owner == "$1" ]]; then
    result=0
  fi
  shopt -u nocasematch
  return "$result"
}

# Sets unpublished_id to the first ID in a text, as the text writes it, of an advisory of this repository that isn't
# published, closed or withdrawn, unless the command posts to the advisory's private fork. Fails when the text holds no
# such ID: find_unpublished_id <text>
find_unpublished_id() {
  local rest=$1 found id
  while [[ $rest =~ $ghsa_id ]]; do
    found=${BASH_REMATCH[0]}
    rest=${rest#*"$found"}
    id=GHSA-$(tr '[:upper:]' '[:lower:]' <<<"${found:5}")
    if ! read_advisory "$found" "$id"; then
      continue
    fi
    case $advisory_state in
      published | closed | withdrawn) continue ;;
    esac
    if posts_to "$advisory_fork"; then
      continue
    fi
    unpublished_id=$found
    return 0
  done
  return 1
}

# Blocks the gh or git command in command_words when it would post the ID of an advisory that isn't published. A
# relative path to a body file starts from the folder that the command runs in, as follow_cd in helpers.bash finds it.
check_posted_text() {
  posted_text="" merged_names="" destination="" body_folder=$command_folder
  case ${command_words[0]##*/} in
    gh) read_gh_command_text ;;
    git) read_git_command_text ;;
  esac
  if find_unpublished_id "$posted_text"; then
    block "Blocked: this command would post $unpublished_id, the ID of a security advisory of this repository that isn't published yet. Write the text without the ID, and run the command again."
  fi
  # git writes the names into the message of a merge commit when the command gives none, and with --log, or the
  # setting merge.log, also after a message that it gives.
  if find_unpublished_id "$merged_names"; then
    block "Blocked: this command gives git a name or URL that holds $unpublished_id, the ID of a security advisory of this repository that isn't published yet, and git can write it into the merge commit's message. Merge the commit by its SHA, as in git merge <SHA>, and run the command again."
  fi
}

check_simple_command() {
  record_written_files
  drop_command_prefixes "$@"
  move_flags_after_gh_subcommand
  if ((${#command_words[@]} == 0)); then
    return 0
  fi
  check_posted_text
  follow_cd
}

read_input
if [[ $tool_name == Bash ]]; then
  # The folder the agent works in. Cursor doesn't send it, so for Cursor the hook's own folder counts.
  command_folder=${cwd:-$PWD}
  written_files=()
  for_each_simple_command check_simple_command "$shell_command"
fi
