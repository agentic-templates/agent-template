#!/usr/bin/env bash
# Claude Code runs this hook before it compacts a conversation, because .claude/settings.json lists it. It records what
# started the compaction, in the file that compaction_record in scripts/loop-folder names for the session: auto when
# Claude Code compacts on its own because the context filled, or manual after /compact. After the compaction,
# scripts/hooks/session-start reads the record, deletes it, and tells the orchestrator after an automatic compaction
# that its state file may be behind, because such a compaction can come in the middle of a step.
# It records only what session-start reads: a compaction of a session that can run the loop, as can_run_loop in
# session-start decides, which is a session in the main checkout whose input has no agent_id. A subagent's input can
# hold the orchestrator's session id and lack an agent_id, but a subagent works in a worktree. The hook also records
# nothing when the loop's folder has no state file, because then no orchestrator runs.
# Copilot CLI and Cursor also run the hooks in .claude/settings.json, so the hook does nothing outside Claude Code.
# It prints nothing, and exits with code 0 even when it fails, so that it never stops a compaction.

if [[ -z ${CLAUDECODE:-} ]]; then
  exit 0
fi

# shellcheck source=scripts/loop-folder
source "${BASH_SOURCE[0]%/*}/../loop-folder" || exit 0

fields=$(jq -r '.session_id // "", .agent_id // "", .trigger // ""' 2>/dev/null) || exit 0
{
  IFS= read -r session_id
  IFS= read -r agent_id
  IFS= read -r trigger
} <<<"$fields"
if [[ -n $agent_id ]]; then
  exit 0
fi

# The hook finds the checkout and the loop's folder from the folder that it runs in, as session-start does, so that
# both find the same ones.
git_folders=$(git rev-parse --path-format=absolute --absolute-git-dir --git-common-dir --show-toplevel 2>/dev/null) ||
  exit 0
{
  IFS= read -r git_folder
  IFS= read -r shared_git_folder
  IFS= read -r checkout
} <<<"$git_folders"
if [[ $git_folder != "$shared_git_folder" ]]; then
  exit 0
fi
loop=$(loop_folder "$shared_git_folder" "$checkout")
if [[ ! -f $loop/state.md ]] || ! record=$(compaction_record "$loop" "$session_id"); then
  exit 0
fi
mkdir -p "${record%/*}" 2>/dev/null && printf '%s\n' "$trigger" 2>/dev/null >"$record"
exit 0
