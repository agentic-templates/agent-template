#!/usr/bin/env bash
# Tests the functions of testing.bash that stand in for the tools: make_sample_input makes, in little CPU time, the input
# that jq made from the same values, and run_hook runs the hook as a bash process of its own runs it.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"

copies=$(mktemp -d)
trap 'rm -rf "$copies"' EXIT

# Prints the sample input as jq made it before make_sample_input: sample_input_from_jq <tool> <tool name> <value>
# shellcheck disable=SC2016 # The $ in the jq programs names jq's variables, such as $value.
sample_input_from_jq() {
  local tool=$1 tool_name=$2 value=$3 tool_input program
  case $tool_name in
    Bash | apply_patch) tool_input='{command: $value}' ;;
    Read) tool_input='{file_path: $value}' ;;
    Write) tool_input='{file_path: $value, content: "Rules"}' ;;
    Edit) tool_input='{file_path: $value, old_string: "Rules", new_string: "More rules"}' ;;
  esac
  case $tool in
    claude-code)
      program='{session_id: "abc123", transcript_path: "\($home)/.claude/projects/p/abc123.jsonl",
        cwd: $cwd, permission_mode: "default", hook_event_name: "PreToolUse",
        tool_name: $tool_name, tool_input: TOOL_INPUT, tool_use_id: "toolu_01"}'
      ;;
    codex)
      program='{session_id: "abc123", turn_id: "1", transcript_path: null, cwd: $cwd,
        hook_event_name: "PreToolUse", model: "gpt-5", permission_mode: "default",
        tool_name: $tool_name, tool_input: TOOL_INPUT, tool_use_id: "call_01"}'
      ;;
    copilot-cli)
      program='{session_id: "abc123", timestamp: 1759536000000, cwd: $cwd,
        hook_event_name: "PreToolUse", tool_name: $tool_name, tool_input: TOOL_INPUT}'
      ;;
    cursor)
      if [[ $tool_name == Bash ]]; then
        tool_name=Shell
      fi
      program='{conversation_id: "abc123", generation_id: "def456", model: "auto", hook_event_name: "PreToolUse",
        cursor_version: "2.1.0", workspace_roots: [$cwd], transcript_path: null,
        tool_name: $tool_name, tool_input: TOOL_INPUT}'
      ;;
  esac
  jq -n --arg home "$test_home" --arg cwd "$test_cwd" --arg tool_name "$tool_name" --arg value "$value" \
    "${program/TOOL_INPUT/$tool_input}"
}

# Checks that make_sample_input makes the input that jq makes: expect_same_input <tool> <tool name> <value>
expect_same_input() {
  make_sample_input "$@"
  expect_input_from_jq "$@"
}

# Checks that sample_input_json, which make_sample_input made, is the input that jq makes from the same values:
# expect_input_from_jq <tool> <tool name> <value>
expect_input_from_jq() {
  local expected actual
  case_count=$((case_count + 1))
  expected=$(sample_input_from_jq "$@" | jq -S .)
  actual=$(jq -S . 2>&1 <<<"$sample_input_json") || true
  if [[ $actual != "$expected" ]]; then
    echo "error: for $1, $2 and [$3], make_sample_input must make the input $expected, but it made $sample_input_json" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Each tool's input for each tool name that it sends
for tool_name in Bash Read Write Edit apply_patch; do
  find_tools "$tool_name"
  for tool in $tools; do
    expect_same_input "$tool" "$tool_name" "README.md"
  done
done

# Values with the characters that JSON escapes, and others that it doesn't
# shellcheck disable=SC2016 # The values are text, so their $ stays as written.
values=('' 'say "hi" \ there' '\n is two characters' $'two\nlines\twith a tab and a return\r'
  $'\001 \037 \177 \033' 'é ü 漢字 😀' $'é\n漢字\t😀' '$HOME `pwd` $(id)')
for value in "${values[@]}"; do
  expect_same_input claude-code Bash "$value"
done
test_cwd='/tmp/a "folder" with \ in it'
expect_same_input codex Bash ls
test_cwd=$test_home/project

# make_sample_input makes the input of a long text of many lines in little CPU time, because block-log.test's limit
# for the hook on a long command includes making its input. bash 3.2 took 36 seconds to replace the line breaks in a
# text of 60 KB. The case measures the CPU time, because a busy machine, as in CI, stretches the time on the clock.
long_text=""
for ((line = 1; line <= 2500; line++)); do
  long_text+="Line $line of a long text"$'\n'
done
max_cpu_milliseconds=2000
TIMEFORMAT='%U %S'
{ time make_sample_input claude-code Bash "$long_text"; } 2>"$copies/cpu-time"
read -r user_seconds system_seconds <"$copies/cpu-time"
# The times have three decimals, so without the dot they're in milliseconds.
cpu_milliseconds=$((10#${user_seconds/./} + 10#${system_seconds/./}))
case_count=$((case_count + 1))
if ((cpu_milliseconds > max_cpu_milliseconds)); then
  echo "error: make_sample_input took $cpu_milliseconds ms of CPU time for a text of ${#long_text} characters in 2500 lines, and the limit is $max_cpu_milliseconds ms." >&2
  failed_cases=$((failed_cases + 1))
fi
expect_input_from_jq claude-code Bash "$long_text"

# run_hook gives the result that the hook gives in a bash process of its own.
for command in ls 'cat .env' 'sudo ls' 'git push --force origin main' 'gh pr merge 5 --admin'; do
  make_sample_input claude-code Bash "$command"
  expected_status=0
  expected_message=$(HOME=$test_home bash "$hooks_folder/before-tool" 2>&1 >/dev/null <<<"$sample_input_json") ||
    expected_status=$?
  run_hook "$sample_input_json"
  expect_result "Run by run_hook, the hook for Bash \"$command\"" "$expected_status" "$expected_message"
done

# The hook in run_hook sees the test's environment, but not the test's own variables. This check in a copy of the
# scripts blocks every command when it sees either.
cp -R "${hooks_folder%/*}" "$copies/scripts"
hooks_folder=$copies/scripts/hooks
# shellcheck disable=SC2016 # The lines are the check's code, so their $ stays as written.
printf '%s\n' '#!/usr/bin/env bash' 'source "${BASH_SOURCE[0]%/*}/helpers.bash"' \
  'if [[ -n ${test_variable+set} ]]; then block "Blocked: the hook sees test_variable."; fi' \
  'if [[ -n ${TEST_ENVIRONMENT+set} ]]; then block "Blocked: the hook sees TEST_ENVIRONMENT."; fi' \
  >"$hooks_folder/variables.check"
chmod +x "$hooks_folder/variables.check"
expect_allow Bash ls
test_variable=global
expect_allow Bash ls
# A local variable of a test function hides the global one.
run_in_function() {
  # shellcheck disable=SC2034 # The check in the copy looks for it.
  local test_variable=local
  expect_allow Bash ls
}
run_in_function
unset test_variable
export TEST_ENVIRONMENT=yes
expect_block Bash ls "Blocked: the hook sees TEST_ENVIRONMENT."
unset TEST_ENVIRONMENT

# A test file stops a hook that runs for more than its time limit, fails the case that ran it with an error that names
# the case, and goes on with its next cases. The hook in the copy waits on a process of its own, as one that never
# returns would wait, but returns after 30 seconds, so that a test file that doesn't stop it fails instead of hanging.
# shellcheck disable=SC2016 # The lines are the check's code, so their $ stays as written.
printf '%s\n' '#!/usr/bin/env bash' 'if [[ $HOOK_COMMAND == "echo hang" ]]; then sleep 30; fi' \
  >"$hooks_folder/hangs.check"
chmod +x "$hooks_folder/hangs.check"
printf '%s\n' "source '$hooks_folder/testing.bash'" 'expect_allow Bash "echo hang"' 'expect_allow Bash ls' \
  finish_tests >"$copies/hangs.test"
case_count=$((case_count + 1))
status=0
message=$(HOOK_TESTS_WAKE_SECONDS=2 bash "$copies/hangs.test" 2>&1) || status=$?
expected="error: In claude-code, the hook for Bash \"echo hang\" must exit with code 0 and the message \"\", but the hook ran for more than 2 seconds, so the test stopped it.
error: 1 of the 2 cases in $copies/hangs.test failed. The errors above say which."
if [[ $status != 1 || $message != "$expected" ]]; then
  echo "error: a test file whose hook doesn't return in a case must exit with code 1 and the message \"$expected\", but it exited with code $status and the message \"$message\"." >&2
  failed_cases=$((failed_cases + 1))
fi

# A test file stops a run_check that runs for more than the time limit, even in $( ), where the stop kills all of
# run_check. The next case passes, and finish_tests fails the test file.
# shellcheck disable=SC2016 # The lines are the test's code, so their $ stays as written.
printf '%s\n' "source '$hooks_folder/testing.bash'" \
  'output=$(run_check hangs "$(sample_input claude-code Bash "echo hang")") || true' 'expect_allow Bash ls' \
  finish_tests >"$copies/check-hangs.test"
case_count=$((case_count + 1))
status=0
message=$(HOOK_TESTS_WAKE_SECONDS=2 bash "$copies/check-hangs.test" 2>&1) || status=$?
expected="error: a hook in $copies/check-hangs.test ran for more than 2 seconds, so the test stopped it."
if [[ $status != 1 || $message != "$expected" ]]; then
  echo "error: a test file whose run_check doesn't return must exit with code 1 and the message \"$expected\", but it exited with code $status and the message \"$message\"." >&2
  failed_cases=$((failed_cases + 1))
fi
rm "$hooks_folder/hangs.check"

# finish_tests fails a test that defines a function of helpers.bash again, because the hook would call the test's.
printf '%s\n' "source '$hooks_folder/testing.bash'" 'block() { :; }' finish_tests >"$copies/redefines.test"
case_count=$((case_count + 1))
status=0
message=$(bash "$copies/redefines.test" 2>&1) || status=$?
expected="error: $copies/redefines.test defines a function or a variable of helpers.bash again, so the hook in its cases used the test's instead. Rename the test's function or variable."
if [[ $status != 1 || $message != "$expected" ]]; then
  echo "error: finish_tests must exit with code 1 and the message \"$expected\" for a test that defines block again, but it exited with code $status and the message \"$message\"." >&2
  failed_cases=$((failed_cases + 1))
fi

finish_tests
