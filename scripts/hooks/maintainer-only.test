#!/usr/bin/env bash
# Tests scripts/hooks/maintainer-only.check through scripts/hooks/before-tool. Most cases run a copy of the scripts in
# a repository whose origin is jtmpl/project, so that they can list repositories in its loop's folder. The copy is in a
# temporary folder, where deleting is allowed anyway, so the cases of deleting in the repository run this repository's
# own hook.
# shellcheck disable=SC2088 # The messages give each path as the command writes it, with ~.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"
# The cases check the list that the hook finds on its own.
unset HOOK_ALLOWED_REPOSITORIES

base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT
# git looks for no repository above the temporary folder, and reads none of the person's settings.
export GIT_CEILING_DIRECTORIES=$base GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=Tester GIT_AUTHOR_EMAIL=tester@example.com GIT_COMMITTER_NAME=Tester GIT_COMMITTER_EMAIL=tester@example.com
own_hooks=$hooks_folder
own_checkout=$(cd "$hooks_folder/../.." && pwd -P)
project=$base/project
git init --quiet "$project"
git -C "$project" remote add origin git@github.com:jtmpl/project.git
git -C "$project" commit --quiet --allow-empty -m Start
cp -R "${hooks_folder%/*}" "$project/scripts"
# git runs the hooks in the project's scripts/git-hooks, as in a repository that was set up.
"$project/scripts/install-git-hooks" >/dev/null
hooks_folder=$project/scripts/hooks
test_cwd=$project

# A stand-in for gh, first on the PATH, that fails, as gh does without a network. The other checks then ask nothing
# of GitHub, and allow these commands.
mkdir "$base/bin"
printf '%s\n' '#!/usr/bin/env bash' 'exit 1' >"$base/bin/gh"
chmod +x "$base/bin/gh"
PATH=$base/bin:$PATH

ask="Ask the maintainer, and go on with the other work."
test_repositories="If it's a repository that agents created from this template to test it, add its owner/name to .loop/allowed-repositories in the main checkout first. Otherwise, ask the maintainer, and go on with the other work."

# The messages that block an action: sudo_message <command>, machine <command>, settings_file <path as written>,
# git_config <option>, deleting <command> <what it deletes>, public <repository> and other_repository <repository>
sudo_message() {
  echo "Blocked: $1 runs a command as another user, such as the machine's administrator, and only the maintainer may change the machine's settings or security. Do the work without $1, such as in the repository or a temporary folder, or ask the maintainer."
}
machine() {
  echo "Blocked: this $1 command changes the machine's disks, settings or security, and only the maintainer may do that. $ask"
}
settings_file() {
  echo "Blocked: $1 holds settings of the machine or of a tool, and only the maintainer may change them. $ask"
}
git_config() {
  echo "Blocked: git config $1 changes the settings of git outside this repository, and only the maintainer may change them. $ask"
}
deleting() {
  echo "Blocked: $1 would delete $2, and only the maintainer may delete outside the repository, its worktrees and the temporary folders. Delete only inside them, or ask the maintainer."
}
public() {
  echo "Blocked: this makes $1 public, and only the maintainer may make a repository public. $test_repositories"
}
other_repository() {
  echo "Blocked: this posts to $1, which isn't this repository, and only the maintainer may post to another repository. $test_repositories"
}
list_names="bash -c 'compgen -e'"
env_option() {
  echo "Blocked: the hooks can't tell which command env runs after its option $1, so they can't check that command. Run the command without that option. The hooks read only env's options -i, -0, -u, -C, -P and -v, and their long forms."
}
# wrapper_option <wrapper> <option> [<the options that the hooks read>]
wrapper_option() {
  echo "Blocked: the hooks can't tell which command $1 runs after its option $2, so they can't check that command. Run the command without that option${3:+, or with one that the hooks read: $3}."
}
environment="Blocked: this command prints the whole environment, which holds tokens. Print only the variables you need, by name, as in printenv PATH. To list the variables' names without their values, run $list_names."
no_verify="Blocked: --no-verify skips the pre-push hook, which scans the push for leaks. Push without it. If the scan finds a leak, take it out of the commits."
# The messages that block a push whose git hooks aren't the repository's: other_hooks <folder that git names>,
# unknown_hooks <git's error> [<what to do, when git can't change to a folder>], and unknown_push_folder
other_hooks() {
  echo "Blocked: this push would run the git hooks in $1, not the ones in scripts/git-hooks of the repository's main checkout or of one of its worktrees, so the pre-push hook wouldn't scan the push for leaks. If the repository's core.hooksPath names another folder, or none, run scripts/install-git-hooks. Push from the main checkout or a worktree, without setting core.hooksPath for the push."
}
unknown_hooks() {
  echo "Blocked: the hook can't tell which git hooks this push would run, so it can't check that the pre-push hook scans the push for leaks. git fails with the push's options and the variables before git, as the command writes them: $1. ${2:-Fix what git says.} The hook fills in only HOME, in folders and in the variables before git, and runs no \$( ), so write any other variable or \$( ) in those words out in full."
}
new_folder="The hook asks git before any part of the command runs, so if the command creates that folder, push in a command of its own after it."
unknown_push_folder="Blocked: the hook can't tell which folder this push runs in, so it can't check that the pre-push hook scans the push for leaks. Push in a folder that exists, and name it without variables or \$( ), as in git -C <folder> push."
# Prints git's error, on one line, when it reads the project with options before its subcommand, because its words
# differ between versions of git: git_error <option>...
git_error() {
  local error
  error=$(git -C "$project" "$@" rev-parse --git-path hooks 2>&1 >/dev/null) || true
  echo "${error//$'\n'/ }"
}
push_to_url="Blocked: this pushes to a URL instead of a remote, and only the maintainer may do that. Push to a remote that git remote -v lists, such as origin, or ask the maintainer."
admin_merge="Blocked: --admin merges the pull request without the checks that main requires, and only the maintainer may skip them. Merge without --admin, so that the merge waits for the checks."
security="Blocked: this changes the repository's rules or security settings, and only the maintainer may do that. $ask"

# sudo, doas and su, also after env or NAME=value words
expect_block Bash 'sudo ls' "$(sudo_message sudo)"
expect_block Bash 'FOO=1 sudo -n true' "$(sudo_message sudo)"
expect_block Bash 'env sudo make install' "$(sudo_message sudo)"
expect_block Bash 'env -u CLAUDECODE sudo ls' "$(sudo_message sudo)"
expect_block Bash '/usr/bin/sudo ls' "$(sudo_message sudo)"
expect_block Bash 'git status && doas ls' "$(sudo_message doas)"
expect_block Bash 'su -c whoami' "$(sudo_message su)"
expect_allow Bash 'man sudo'
expect_allow Bash 'echo "sudo and diskutil erase are blocked"'
expect_allow Bash $'git commit -F - <<\'EOF\'\nfix: stop sudo ls and rm -rf ~ in the docs\nEOF'

# The commands that change the machine's disks, settings or security
expect_block Bash 'diskutil eraseDisk APFS Empty disk2' "$(machine diskutil)"
expect_block Bash 'defaults write com.apple.dock autohide -bool true' "$(machine defaults)"
expect_block Bash 'launchctl load ~/Library/LaunchAgents/com.example.plist' "$(machine launchctl)"
expect_block Bash 'systemctl restart nginx' "$(machine systemctl)"
expect_block Bash 'systemctl --user restart app' "$(machine systemctl)"
expect_block Bash 'crontab -e' "$(machine crontab)"
expect_block Bash 'crontab jobs.txt' "$(machine crontab)"
expect_block Bash 'dd if=image.iso of=/dev/disk2 bs=1m' "$(machine dd)"
expect_block Bash 'sysctl -w kern.maxfiles=65536' "$(machine sysctl)"
expect_block Bash 'networksetup -setdnsservers Wi-Fi 1.1.1.1' "$(machine networksetup)"
expect_block Bash 'mkfs.ext4 /dev/sdb1' "$(machine mkfs.ext4)"
expect_block Bash 'shutdown -h now' "$(machine shutdown)"
expect_block Bash 'diskutil apfs deleteVolume disk3s5' "$(machine diskutil)"
expect_block Bash 'diskutil apfs' "$(machine diskutil)"
expect_block Bash 'tmutil deletelocalsnapshots /' "$(machine tmutil)"
expect_block Bash 'tmutil localsnapshot' "$(machine tmutil)"
expect_allow Bash 'diskutil list'
expect_allow Bash 'diskutil apfs list'
expect_allow Bash 'diskutil apfs listSnapshots /'
expect_allow Bash 'tmutil listlocalsnapshots /'
expect_allow Bash 'defaults read com.apple.dock'
expect_allow Bash 'launchctl getenv PATH'
expect_allow Bash 'systemctl status nginx'
expect_allow Bash 'systemctl'
expect_allow Bash 'crontab -l'
expect_allow Bash 'dd if=/dev/zero of=disk.img bs=1m count=1'
expect_allow Bash 'sysctl -n hw.ncpu'
expect_allow Bash 'networksetup -listallhardwareports'
expect_allow Bash 'pmset -g'

# Writing a settings file in the home folder, with a redirection, a command that writes files or the agent's
# file-writing tool
expect_block Bash "echo 'export DEBUG=1' >> ~/.zshrc" "$(settings_file '~/.zshrc')"
expect_block Bash 'echo "[user]" | tee -a ~/.gitconfig' "$(settings_file '~/.gitconfig')"
# shellcheck disable=SC2016 # The command is the text that the agent sends, so $HOME stays as written.
expect_block Bash 'cat settings.json > "$HOME/.claude/settings.json"' "$(settings_file '$HOME/.claude/settings.json')"
expect_block Bash 'printf "*.log\n" >~/.config/git/ignore' "$(settings_file '~/.config/git/ignore')"
expect_block Bash 'echo "Host *" >>~/.ssh/config' "$(settings_file '~/.ssh/config')"
expect_block Write "$test_home/.zshrc" "$(settings_file "$test_home/.zshrc")"
expect_block Edit "$test_home/.claude/settings.local.json" "$(settings_file "$test_home/.claude/settings.local.json")"
expect_block Write "$test_home/Library/LaunchAgents/com.example.plist" \
  "$(settings_file "$test_home/Library/LaunchAgents/com.example.plist")"
expect_block apply_patch $'*** Begin Patch\n*** Add File: '"$test_home"$'/.codex/config.toml\n+model = "gpt-5"\n*** End Patch\n' \
  "$(settings_file "$test_home/.codex/config.toml")"
expect_block Bash 'cp settings.json ~/.claude/settings.json' "$(settings_file '~/.claude/settings.json')"
expect_block Bash 'mv new.zshrc ~/.zshrc' "$(settings_file '~/.zshrc')"
expect_block Bash 'install -m 644 zshrc ~/.zshrc' "$(settings_file '~/.zshrc')"
# shellcheck disable=SC2016 # The command is the text that the agent sends, so $PWD stays as written.
expect_block Bash 'ln -sf "$PWD/zshrc" ~/.zshrc' "$(settings_file '~/.zshrc')"
expect_block Bash 'cp -t ~/.config/git ignore' "$(settings_file '~/.config/git/ignore')"
expect_block Bash "sed -i '' 's/a/b/' ~/.zshrc" "$(settings_file '~/.zshrc')"
expect_block Bash "sed -i 's/a/b/' ~/.bashrc" "$(settings_file '~/.bashrc')"
expect_block Bash "sed -i.bak -e 's/a/b/' ~/.gitconfig" "$(settings_file '~/.gitconfig')"
expect_block Bash "sed --in-place=.bak 's/a/b/' ~/.profile" "$(settings_file '~/.profile')"
expect_block Bash "perl -pi -e 's/a/b/' ~/.zshrc" "$(settings_file '~/.zshrc')"
expect_block Bash 'git config --global user.email agent@example.com' "$(git_config --global)"
expect_block Bash 'git config --system core.editor vim' "$(git_config --system)"
expect_block Bash 'git config set --global user.name Agent' "$(git_config --global)"
expect_block Bash 'git -C . config --global --unset user.email' "$(git_config --global)"
expect_block Bash 'git config --global --add safe.directory /tmp/project' "$(git_config --global)"
expect_allow Bash 'echo done > ~/.cache/notes.txt'
expect_allow Bash 'cp ~/.zshrc zshrc.backup'
expect_allow Bash 'cp settings.json /tmp/settings.json'
expect_allow Bash 'mv notes.txt ~/notes.txt'
expect_allow Bash 'ln -s ~/.zshrc'
expect_allow Bash "sed 's/a/b/' ~/.zshrc"
expect_allow Bash "sed -i '' 's/a/b/' notes.txt"
expect_allow Bash "perl -pe 's/a/b/' ~/.zshrc"
expect_allow Bash "perl -Ilib -e 'print 1' ~/.zshrc"
expect_allow Bash 'git config --global user.email'
expect_allow Bash 'git config --global --get user.email'
expect_allow Bash 'git config get --global user.email'
expect_allow Bash 'git config --global --list'
expect_allow Bash 'git config user.email agent@example.com'
expect_allow Bash 'cat ~/.zshrc'
expect_allow Bash 'echo "*.log" > .gitignore'
expect_allow Write "$test_home/notes/todo.md"
expect_allow Write "$test_home/.claude/projects/notes.md"
expect_allow Write "$project/.zshrc"
# A relative path starts from the folder that the agent works in, or that a cd before it changes to.
home_with_project=$base/home
mkdir -p "$home_with_project/project"
test_home=$home_with_project test_cwd=$home_with_project/project
expect_block apply_patch $'*** Begin Patch\n*** Add File: ../.bashrc\n+alias ll="ls -l"\n*** End Patch\n' \
  "$(settings_file ../.bashrc)"
expect_block Bash 'cd ~ && echo "alias ll=\"ls -l\"" >> .bashrc' "$(settings_file .bashrc)"
expect_allow Bash 'echo "alias ll=\"ls -l\"" >> .bashrc'
# cp, mv, install and ln write into the folder that their last word names.
expect_block Bash 'cp .zshrc ~' "$(settings_file '~/.zshrc')"
expect_block Bash 'mv ../dotfiles/.vimrc ~/' "$(settings_file '~/.vimrc')"
expect_allow Bash 'cp notes.txt ~'
# Claude Code's Write resolves a .. after a symlink as text, so it leads to the folder that holds the link.
ln -s "$project/scripts" "$home_with_project/link"
expect_block Write "$home_with_project/link/../.zshrc" "$(settings_file "$home_with_project/.zshrc")"
# It fills in a leading ~/ before it resolves the .. as text.
expect_block Write '~/link/../.zshrc' "$(settings_file "$home_with_project/.zshrc")"
test_home=/home-for-tests/someone test_cwd=$project

# Deleting outside the repository's worktrees and the temporary folders
expect_block Bash 'rm -rf /' "$(deleting rm /)"
expect_block Bash 'rm -rf ~' "$(deleting rm '~')"
expect_block Bash 'rm -rf ~/notes' "$(deleting rm '~/notes')"
# shellcheck disable=SC2016 # The command is the text that the agent sends, so $HOME stays as written.
expect_block Bash 'rm -rf "$HOME/notes"' "$(deleting rm '$HOME/notes')"
expect_block Bash 'rm /etc/hosts' "$(deleting rm /etc/hosts)"
expect_block Bash 'rmdir ~/empty' "$(deleting rmdir '~/empty')"
expect_block Bash 'rm -rf build ~/notes' "$(deleting rm '~/notes')"
expect_block Bash 'cd /usr && rm -rf share' "$(deleting rm share)"
expect_block Bash 'rm -rf /tmp' "$(deleting rm /tmp)"
expect_block Bash 'find ~ -name "*.log" -delete' "$(deleting find 'files in ~')"
expect_block Bash "find ~/Documents -name '*.log' -exec rm -f {} +" "$(deleting find 'files in ~/Documents')"
expect_allow Bash 'rm -rf build ./node_modules'
expect_allow Bash 'rm -f /tmp/output.txt'
expect_allow Bash 'cd /tmp && rm -rf scratch'
expect_allow Bash "rm -rf '$base/scratch'"
# shellcheck disable=SC2016 # The commands are the text that the agent sends, so the variables stay as written.
expect_allow Bash 'rm -rf "$TMPDIR/run"'
# shellcheck disable=SC2016
expect_allow Bash 'cd "$folder" && rm -rf build'
expect_allow Bash 'find /tmp -name "*.log" -delete'
expect_allow Bash 'find ~ -name "*.log"'
expect_allow Bash 'git rm -r ~/notes'
# A cd in a subshell changes the folder only inside it.
expect_block Bash '(cd /usr && rm -rf share)' "$(deleting rm share)"
# shellcheck disable=SC2016 # The commands are the text that the agent sends, so $( ) and the backticks stay as written.
expect_allow Bash 'folder=$(cd /usr && pwd); rm -rf build'
# shellcheck disable=SC2016
expect_allow Bash 'echo "`cd /usr && pwd`" && rm -rf build'
expect_allow Bash '(cd /usr) && rm -rf build'
# A cd that the shell runs itself, as after builtin, changes its folder, and one that another program runs, as after
# timeout, doesn't. The hooks block a cd after time, command or noglob, because the shell may run either. It runs the
# program time for a quoted 'time', as for \time, and the hooks see the word without its quotes. Without the block, the
# checks wouldn't know the folder after the cd, and would allow more than in either folder.
expect_block Bash 'builtin cd /usr && rm -rf share' "$(deleting rm share)"
for wrapper in time "'time'" "time -p" command noglob; do
  expect_block Bash "$wrapper cd /tmp && rm -rf share" "$cd_after_wrapper"
  expect_block Bash "cd /usr && $wrapper cd /tmp && rm -rf share" "$cd_after_wrapper"
done
expect_allow Bash 'timeout 10 cd /usr && rm -rf build'
expect_allow Bash 'env cd /usr && rm -rf build'
# env -C runs only the command after it in another folder.
expect_block Bash 'env -C /usr rm -rf share' "$(deleting rm share)"
expect_block Bash 'env -C / rm -rf usr/share' "$(deleting rm usr/share)"
expect_block Bash 'env -iC/usr rm -rf share' "$(deleting rm share)"
expect_block Bash 'env --chdir=/usr rm -rf share' "$(deleting rm share)"
expect_allow Bash 'env -C /usr true && rm -rf build'
hooks_folder=$own_hooks test_cwd=$own_checkout
expect_allow Bash 'rm -rf build'
expect_allow Bash "rm -rf '$own_checkout/.claude/worktrees/issue-1'"
expect_allow Bash 'find . -name "*.pyc" -delete'
expect_block Bash 'rm -rf ~/notes' "$(deleting rm '~/notes')"
hooks_folder=$project/scripts/hooks test_cwd=$project

# Printing the whole environment
expect_block Bash 'env' "$environment"
expect_block Bash 'env | grep TOKEN' "$environment"
expect_block Bash 'FOO=1 env -0' "$environment"
expect_block Bash '/usr/bin/env' "$environment"
expect_block Bash 'printenv' "$environment"
# cut prints the later lines of a value that spans several lines.
expect_block Bash 'env | cut -d= -f1' "$environment"
expect_block Bash 'env -u CLAUDECODE' "$environment"
expect_block Bash 'env -0u CLAUDECODE FOO=1' "$environment"
expect_block Bash 'env --unset CLAUDECODE' "$environment"
expect_block Bash 'env --env0-from variables' "$(env_option --env0-from)"
expect_allow Bash 'printenv HOME'
expect_allow Bash "$list_names"
expect_allow Bash 'env FOO=1 make test'
expect_allow Bash 'env -u GH_TOKEN make test'
expect_allow Bash 'env -u CLAUDECODE claude -p hello'
expect_allow Bash 'env --ignore-environment --null --debug -P /usr/bin --unset=GH_TOKEN -- make test'
# env runs the command in the value of -S, and GNU's env reads --uns as --unset.
expect_block Bash "env -S 'claude -p hello'" "$(env_option -S)"
expect_block Bash 'env -Sgit push --no-verify' "$(env_option -Sgit)"
expect_block Bash 'env --uns CLAUDECODE git push --no-verify' "$(env_option --uns)"
# shellcheck disable=SC2016 # The command is the text that the agent sends, so $PATH stays as written.
expect_allow Bash 'echo "$PATH"'

# Pushing without the pre-push hook, or to a URL
expect_block Bash 'git push --no-verify origin main' "$no_verify"
expect_block Bash 'git -C . push --no-verify' "$no_verify"
expect_block Bash 'env -u CLAUDECODE git push --no-verify' "$no_verify"
expect_block Bash '/usr/bin/env -C build git push --no-verify' "$no_verify"
# env reads each word with = before the command as a variable to set.
expect_block Bash 'env x.y=1 git push --no-verify' "$no_verify"
# The wrappers that run the command after them, with each way to write their options and timeout's duration
expect_block_behind_wrappers 'git push --no-verify' "$no_verify"
for wrapper in "timeout 10" "/usr/bin/timeout -k5 10" "timeout -fk 5 10" "timeout --kill-after 5 --preserve-status 1h" \
  "timeout -s KILL -v 10" "timeout -pvsKILL 10" "timeout --foreground --verbose -- 10" time "/usr/bin/time -l" \
  "/usr/bin/time -ao times.txt" "time --format=%e --output times.txt --append --portability --quiet --verbose" \
  "time -hqv -f %e" nice "nice -10" "nice --10" "nice -+10" "nice -n5" "nice -n -5" "nice --adjustment=5" \
  "nice --adjustment 5" "nohup --" "stdbuf -o L" "stdbuf -i0 -e0" "stdbuf --input=0 --output L --error=0" command \
  "command -p --" "builtin --" "nohup nice -n 5 timeout 10" "env FOO=1 timeout 10" "timeout 10 env -u CLAUDECODE" \
  "time nohup"; do
  expect_block Bash "$wrapper git push --no-verify" "$no_verify"
done
# The hooks can't tell which word is the command after an option that they don't read. GNU's timeout reads --sig as
# --signal.
timeout_options="-f -p -v -k -s --foreground --preserve-status --verbose --kill-after --signal"
expect_block Bash 'timeout --sig KILL 10 git push --no-verify' "$(wrapper_option timeout --sig "$timeout_options")"
expect_block Bash 'timeout -x 10 git status' "$(wrapper_option timeout -x "$timeout_options")"
expect_block Bash 'timeout --foreground=yes 10 git status' "$(wrapper_option timeout --foreground=yes "$timeout_options")"
expect_block Bash 'nice -x git status' "$(wrapper_option nice -x "-n --adjustment")"
expect_block Bash 'stdbuf -oL -x git status' "$(wrapper_option stdbuf -x "-i -o -e --input --output --error")"
expect_block Bash 'command -px git status' "$(wrapper_option command -px "-p -v -V")"
expect_block Bash 'nohup -x git status' "$(wrapper_option nohup -x)"
expect_block Bash 'builtin --help' "$(wrapper_option builtin --help)"
expect_allow Bash 'timeout 10 git push origin HEAD'
# command -v and command -V look a command up instead of running it, and Claude Code doesn't drop xargs with an option.
expect_allow Bash 'command -v uv'
expect_allow Bash 'command -V uv'
expect_allow Bash 'command -pv git'
expect_allow Bash 'xargs -n1 echo'
# git takes the start of a long option as the option, unless another option starts the same way, as with --no-ver,
# which could be --no-verbose too.
expect_block Bash 'git push --no-veri origin main' "$no_verify"
expect_block Bash 'git push origin HEAD --no-verif' "$no_verify"
expect_allow Bash 'git push --verb origin HEAD'
# --veri is the start of --verify, which runs the pre-push hook.
expect_allow Bash 'git push --veri origin HEAD'
# git's options before the subcommand, with and without a value
expect_block Bash 'git -c color.ui=never push --no-verify' "$no_verify"
expect_block Bash 'git --git-dir=.git push --no-verify' "$no_verify"
expect_block Bash 'git --git-dir .git --no-pager --work-tree . push --no-verify' "$no_verify"
expect_block Bash 'git --attr-source HEAD -C . push https://github.com/someone/else.git main' "$push_to_url"
expect_allow Bash 'git -c color.ui=never push origin HEAD'
# git reads -h, --help, -v and --version as the subcommand help or version, which then reads the words after it.
expect_allow Bash 'git --help push --no-verify'
expect_allow Bash 'git -c color.ui=never -h push --no-verify'
expect_allow Bash 'git -v push --no-verify'
expect_allow Bash 'git --version push --no-verify'
expect_block Bash 'git push https://github.com/someone/else.git main' "$push_to_url"
expect_block Bash 'git push git@github.com:someone/else.git HEAD' "$push_to_url"
expect_block Bash 'git push -o ci.skip ssh://git@github.com/jtmpl/project.git HEAD' "$push_to_url"
# A push whose remote or refspec has a variable or a $( ) is blocked, because the hook can't tell before the command
# runs whether its remote is a URL.
# shellcheck disable=SC2016 # The $ in these words is for the hook to read, not for the test to expand.
{
  expect_block Bash 'git push "$remote" HEAD' "$(expanded_push_word '$remote')"
  expect_block Bash 'git push origin "HEAD:$(git branch --show-current)"' \
    "$(expanded_push_word 'HEAD:$(git branch --show-current)')"
}
expect_allow Bash 'git push -u origin HEAD'
expect_allow Bash 'git push'
expect_allow Bash 'git push --force-with-lease origin HEAD:main'
expect_allow Bash 'git commit --no-verify -m "Save the work"'

# Pushing with git hooks other than the repository's. git finds them from core.hooksPath, which the repository's config,
# -c, --config-env, a file that a setting includes, and the variables before git can set. A relative one starts from
# the folder that the push runs in, which -C, --git-dir and --work-tree can move.
hooks_elsewhere=$base/hooks
elsewhere=$base/elsewhere
mkdir "$elsewhere"
expect_block Bash "git -c core.hooksPath=$hooks_elsewhere push" "$(other_hooks "$hooks_elsewhere")"
# git reads the name of a setting in any case.
expect_block Bash "git -c Core.HooksPath=$hooks_elsewhere push origin HEAD" "$(other_hooks "$hooks_elsewhere")"
expect_allow Bash "git -c core.hooksPathOld=$hooks_elsewhere push"
expect_allow Bash 'git -c core.hooksPath=scripts/git-hooks push'
expect_allow Bash "git -c core.hooksPath=$project/scripts/git-hooks/ push"
git -C "$project" config core.hooksPath .husky/_
expect_block Bash 'git push' "$(other_hooks "$project/.husky/_")"
git -C "$project" config --unset core.hooksPath
expect_block Bash 'git push origin HEAD' "$(other_hooks "$project/.git/hooks")"
"$project/scripts/install-git-hooks" >/dev/null
expect_block Bash "GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=$hooks_elsewhere git push" \
  "$(other_hooks "$hooks_elsewhere")"
expect_block Bash "env GIT_CONFIG_PARAMETERS=\"'core.hooksPath'='$hooks_elsewhere'\" git push" "$(other_hooks "$hooks_elsewhere")"
expect_block Bash "GIT_DIR=$project/.git git -C $elsewhere push" "$(other_hooks "$elsewhere/scripts/git-hooks")"
# The value of a wrapper's option sets no variable, as with time -o, which names the file that time writes to.
expect_allow Bash "time -o GIT_DIR=$elsewhere/.git git push"
expect_allow Bash 'GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=color.ui GIT_CONFIG_VALUE_0=never git push'
printf '[core]\n\thooksPath = %s\n' "$hooks_elsewhere" >"$base/hooks.gitconfig"
expect_block Bash "git -c include.path=$base/hooks.gitconfig push" "$(other_hooks "$hooks_elsewhere")"
expect_block Bash "git -C $elsewhere --git-dir=$project/.git push" "$(other_hooks "$elsewhere/scripts/git-hooks")"
expect_block Bash 'git -C ../elsewhere --git-dir=../project/.git --work-tree=../project push origin HEAD' \
  "$(other_hooks "$elsewhere/scripts/git-hooks")"
expect_block Bash 'git -C .git --bare push' "$(other_hooks "$project/.git/scripts/git-hooks")"
expect_allow Bash "git --git-dir=$project/.git push"
# Outside the work tree, git runs a relative core.hooksPath from the folder that it runs in.
expect_allow Bash "git --work-tree=$elsewhere push"
# A builder that scripts/loop/run-builder starts pushes from a worktree of the main checkout. git runs the worktree's
# own hooks, as the relative core.hooksPath of scripts/install-git-hooks names them, or the main checkout's, as
# GIT_CONFIG_COUNT, GIT_CONFIG_KEY_0 and GIT_CONFIG_VALUE_0 name them for the commands that run-builder runs.
builder_worktree=$base/run-5
git -C "$project" worktree add --quiet --detach "$builder_worktree"
test_cwd=$builder_worktree
expect_allow Bash 'git push -u origin HEAD'
expect_allow Bash "git -c core.hooksPath=$project/scripts/git-hooks push -u origin HEAD"
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=$project/scripts/git-hooks
expect_allow Bash 'git push -u origin HEAD'
expect_block Bash "GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_1=core.hooksPath GIT_CONFIG_VALUE_1=$hooks_elsewhere git push" \
  "$(other_hooks "$hooks_elsewhere")"
unset GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0
test_cwd=$project
expect_allow Bash "git -C $builder_worktree push"
# When git fails, the hook can't tell which hooks the push would run. It gives git the words as the command writes
# them, and passes on only the variables that say where the repository and its settings are.
expect_block Bash 'git -C missing push' \
  "$(unknown_hooks "fatal: cannot change to 'missing': No such file or directory" "$new_folder")"
expect_block Bash 'git worktree add ../wt && git -C ../wt push' \
  "$(unknown_hooks "fatal: cannot change to '../wt': No such file or directory" "$new_folder")"
# shellcheck disable=SC2016 # The commands are the text that the agent sends, so the variables stay as written.
expect_block Bash 'git -C "$folder" push' \
  "$(unknown_hooks "fatal: cannot change to '\$folder': No such file or directory" "$new_folder")"
expect_block Bash "cd $elsewhere && git push" "$(unknown_hooks "$(git_error -C "$elsewhere")")"
expect_block Bash 'git -c core.hookspath push' "$(unknown_hooks "$(git_error -c core.hookspath)")"
expect_block Bash 'git --config-env core.hooksPath=HOOKS push' \
  "$(unknown_hooks "$(git_error --config-env core.hooksPath=HOOKS)")"
expect_block Bash "HOOKS=$hooks_elsewhere git --config-env=core.hooksPath=HOOKS push" \
  "$(unknown_hooks "$(git_error --config-env=core.hooksPath=HOOKS)")"
# shellcheck disable=SC2016
expect_block Bash 'git -c core.hooksPath=$HOOKS push' "$(other_hooks "$project/\$HOOKS")"
# shellcheck disable=SC2016
expect_block Bash 'cd "$folder" && git push' "$unknown_push_folder"
# The hook fills in HOME in the folders and the variables before git, as the shell does: ~ at the start of a word or
# after NAME=, and $HOME and ${HOME}. The shell leaves ~ after the = of an option as it is.
test_home=$base
expect_allow Bash 'git -C ~/project push'
# shellcheck disable=SC2016
expect_allow Bash 'git -C "$HOME/project" push'
# shellcheck disable=SC2016
expect_allow Bash 'git --work-tree ~/project --git-dir "${HOME}/project/.git" push'
# shellcheck disable=SC2016
expect_allow Bash 'git --git-dir=$HOME/project/.git push'
expect_allow Bash 'GIT_DIR=~/project/.git git push'
expect_allow Bash 'env GIT_DIR=~/project/.git git push'
# shellcheck disable=SC2016
expect_block Bash 'git -C ~/elsewhere --git-dir=$HOME/project/.git push' "$(other_hooks "$elsewhere/scripts/git-hooks")"
# shellcheck disable=SC2088
expect_block Bash 'git --git-dir=~/project/.git push' "$(unknown_hooks "$(git_error '--git-dir=~/project/.git')")"
test_home=/home-for-tests/someone
# A config file that the command names can't make the hook's git write trace output, to a file that the config chooses.
trace=$base/trace
printf '[trace2]\n\tnormalTarget = %s\n\teventTarget = %s\n\tperfTarget = %s\n' "$trace-normal" "$trace-event" \
  "$trace-perf" >"$base/trace.gitconfig"
expect_allow Bash "GIT_CONFIG_GLOBAL=$base/trace.gitconfig git push"
for file in "$trace-normal" "$trace-event" "$trace-perf"; do
  case_count=$((case_count + 1))
  if [[ -e $file ]]; then
    echo "error: For a push with GIT_CONFIG_GLOBAL=$base/trace.gitconfig, the hook's git must write no trace output, but it wrote $file." >&2
    failed_cases=$((failed_cases + 1))
  fi
done

# Merging without the checks, and changing the rules or the security settings
expect_block Bash 'gh pr merge 5 --admin' "$admin_merge"
expect_block Bash 'gh pr -R jtmpl/project merge --squash --admin' "$admin_merge"
expect_block Bash 'gh api -X PUT repos/jtmpl/project/branches/main/protection --input rules.json' "$security"
expect_block Bash 'gh api repos/jtmpl/project/hooks --input hook.json' "$security"
expect_block Bash 'gh api --method DELETE "repos/{owner}/{repo}/rulesets/12"' "$security"
expect_block Bash 'gh api -X DELETE "repos/{owner}/{repo}/vulnerability-alerts"' "$security"
expect_block Bash 'gh api -X PATCH "repos/{owner}/{repo}" -f "security_and_analysis[secret_scanning][status]=disabled"' "$security"
# gh reads -f and -F after other short flags in one word, as split_flag_word in helpers.bash does, with the field in
# the same word or the next. Its -i takes no value.
for field in '-i -f ' '-if ' -if -iF= -f=; do
  expect_block Bash "gh api ${field}security_and_analysis[secret_scanning][status]=disabled -X PATCH repos/{owner}/{repo}" \
    "$security"
done
expect_block Bash 'gh repo edit --enable-secret-scanning-push-protection=false' "$security"
expect_block Bash 'gh repo edit jtmpl/project --enable-advanced-security=false' "$security"
expect_allow Bash 'gh pr merge 5 --squash'
expect_allow Bash 'gh pr merge 5 --subject "Allow --admin" --squash'
# gh reads a value after = as Go's strconv.ParseBool does.
for value in 1 t T true TRUE True; do
  expect_block Bash "gh pr merge 5 --admin=$value" "$admin_merge"
done
for value in 0 f F false FALSE False; do
  expect_allow Bash "gh pr merge 5 --squash --admin=$value"
done
# gh knows that --help takes no value, so it finds the subcommand right after it, and keeps the last value of --help,
# so that it merges.
expect_before_and_after_subcommand 2 "$admin_merge" pr '--help' merge '--help=false --admin 5'
expect_allow Bash 'gh api repos/jtmpl/project/branches/main/protection'
expect_allow Bash 'gh api "repos/{owner}/{repo}/rulesets?includes_parents=false"'
expect_allow Bash 'gh api -X get "repos/{owner}/{repo}/rulesets"'
expect_block Bash 'gh repo deploy-key add key.pub --title CI' "$security"
expect_block Bash 'gh repo deploy-key delete 12345' "$security"
# gh finds the subcommand of a nested group after flags, as it finds the subcommand of a group.
expect_before_and_after_subcommand 2 "$security" 'repo deploy-key' '--title CI' add 'key.pub'
expect_before_and_after_subcommand 2 "$security" 'repo deploy-key' '-R jtmpl/other' delete '12345'
expect_allow Bash 'gh repo edit --enable-secret-scanning-push-protection'
expect_allow Bash 'gh repo deploy-key list'

# Making a repository public, before and after the list of allowed repositories names it
publishing=(
  'gh repo create jtmpl/listed --public'
  "gh repo create --description 'A project' jtmpl/listed --public"
  'gh repo edit jtmpl/listed --visibility public --accept-visibility-change-consequences'
  'gh api -X PATCH repos/jtmpl/listed -F private=false'
  'gh api -X PATCH repos/jtmpl/listed --field=visibility=public'
  'gh api -iX PATCH repos/jtmpl/listed -iF private=false'
)
for command in "${publishing[@]}"; do
  expect_block Bash "$command" "$(public jtmpl/listed)"
done
mkdir "$project/.loop"
printf '%s\n' jtmpl/listed '  https://github.com/jtmpl/From-URL.git  ' '' >"$project/.loop/allowed-repositories"
for command in "${publishing[@]}"; do
  expect_allow Bash "$command"
done
expect_block Bash 'gh repo create jtmpl/new --public' "$(public jtmpl/new)"
expect_block Bash 'gh repo new other --public --clone' "$(public other)"
expect_block Bash 'gh repo create --public --source . --push' "$(public 'a new repository')"
expect_block Bash 'gh repo edit --visibility=public' "$(public 'this repository')"
expect_block Bash 'gh api -X PATCH repos/jtmpl/other -f private=false' "$(public jtmpl/other)"
expect_block Bash 'gh api -X POST orgs/jtmpl/repos -f name=new -F private=false' "$(public 'a repository')"
expect_allow Bash 'gh repo create JTMPL/Listed --public'
expect_allow Bash 'gh repo create jtmpl/from-url --public'
expect_allow Bash 'gh repo create jtmpl/secret --private'
for value in 1 t T true TRUE True; do
  expect_block Bash "gh repo create jtmpl/new --public=$value" "$(public jtmpl/new)"
done
for value in 0 f F false FALSE False; do
  expect_allow Bash "gh repo create jtmpl/new --public=$value"
done
expect_allow Bash 'gh repo view --json visibility'

# Making a gist public
gist="Blocked: this makes a gist public, and only the maintainer may make something public outside this repository. $ask"
expect_block Bash 'gh gist create --public notes.md' "$gist"
expect_block Bash 'gh gist create -p -d Notes notes.md' "$gist"
expect_allow Bash 'gh gist create notes.md'
expect_allow Bash 'gh gist create -d --public notes.md'
# gh reads -p in a word of several short flags, before the first flag that takes a value, which the rest of the word
# or the next word gives.
for command in 'gh gist create -wp notes.md' 'gh gist create -pd Notes notes.md' "gh gist create -pd'My notes' notes.md"; do
  expect_block Bash "$command" "$gist"
done
for command in 'gh gist create -dp notes.md' 'gh gist create -d-p notes.md' 'gh gist create --desc=-p notes.md'; do
  expect_allow Bash "$command"
done
for value in 1 t T true TRUE True; do
  expect_block Bash "gh gist create --public=$value notes.md" "$gist"
  expect_block Bash "gh gist create -p=$value notes.md" "$gist"
  expect_block Bash "gh gist create -wp=$value notes.md" "$gist"
done
for value in 0 f F false FALSE False; do
  expect_allow Bash "gh gist create --public=$value notes.md"
  expect_allow Bash "gh gist create -p=$value notes.md"
done

# Posting to a repository other than this one, or one that the list names
expect_block Bash 'gh pr comment 5 -R someone/else --body Hello' "$(other_repository someone/else)"
expect_block Bash 'gh issue comment -Rsomeone/else 5 --body Hello' "$(other_repository someone/else)"
# gh drops the = after a short flag when more follows it, as split_flag_word in helpers.bash describes.
expect_block Bash 'gh issue comment -R=someone/else 5 --body Hello' "$(other_repository someone/else)"
# Once the list names someone/else, the hook allows the same command.
cp "$project/.loop/allowed-repositories" "$base/allowed-repositories"
echo someone/else >>"$project/.loop/allowed-repositories"
expect_allow Bash 'gh issue comment -R=someone/else 5 --body Hello'
mv "$base/allowed-repositories" "$project/.loop/allowed-repositories"
# A word can hold several short flags, as split_flag_word in helpers.bash reads it, and -R can be the last of them.
# The -a of gh pr review takes no value. The hooks list no flags of gh run rerun, so the hook reads its -d, which takes
# no value, as a flag without a value too. The -c of gh issue close takes a comment, so -cRsomeone/else there is the
# comment Rsomeone/else, and the -b of gh pr comment takes the next word as the body, even when it starts with -R.
for command in 'gh pr review 5 -a -R someone/else' 'gh pr review 5 -aRsomeone/else' 'gh pr review -aR someone/else 5' \
  'gh run rerun 12 -dRsomeone/else'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
expect_allow Bash 'gh issue close 5 -cRsomeone/else'
expect_allow Bash 'gh pr comment 5 -b -Rsomeone/else'
# For a command whose flags the hooks don't list, -R can be part of the value of a flag before it, such as the -j of
# gh run rerun, which takes a job. The hook then checks the repository that gh posts to without -R as well.
for command in 'GH_REPO=someone/else gh run rerun 12 -jRjtmpl/project' \
  'GH_REPO=someone/else gh run rerun 12 -j -Rjtmpl/project'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
# gh takes the last -R that is a flag, so a later -R that can be the value of a flag before it can hide an earlier one.
for command in 'gh run rerun 12 -R someone/else -j -Rjtmpl/project' \
  'gh run rerun 12 -Rsomeone/else -jRjtmpl/project' 'gh run rerun 12 --repo=someone/else --job -R=jtmpl/project'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
# A word with an expansion can become nothing, so that a later -R becomes the value of the flag before it, for a
# command whose flags the hooks list too.
# shellcheck disable=SC2016 # The commands are the text that the agent sends, so the expansions stay as written.
for command in 'gh pr comment 5 -R someone/else -b $EMPTY -Rjtmpl/project' \
  'gh issue close 5 -R someone/else -c $EMPTY -Rjtmpl/project' \
  'gh pr review 5 -R someone/else -a -b ${EMPTY} --repo=jtmpl/project'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
# A flag word with an expansion can end in another flag once the shell expands it, such as the -a of gh pr review, so
# the -R after it can be a flag rather than the value of -b or -c.
# shellcheck disable=SC2016 # The commands are the text that the agent sends, so the expansions stay as written.
for command in 'gh pr review 5 -$b -Rsomeone/else' 'gh pr review 5 -${M}b -R someone/else' \
  'gh issue close 5 -${X}c --repo=someone/else'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
# An earlier word with an expansion can also become nothing, become a flag that takes a value, or leave the flag in its
# own word without a value, as -b$X does when X is empty. Then the flag before a -R takes another word as its value.
# shellcheck disable=SC2016 # The commands are the text that the agent sends, so the expansions stay as written.
for command in 'gh pr comment 5 -b $EMPTY -b -Rsomeone/else' 'gh issue close 5 -c $EMPTY -c -Rsomeone/else' \
  'gh pr review 5 -b $EMPTY -b --repo=someone/else' 'gh pr review 5 -b $EMPTY -b -R someone/else' \
  'gh pr comment 5 $X -b -Rsomeone/else' 'gh pr comment 5 "$X" -b -Rsomeone/else' \
  'gh pr comment 5 -b$X -b -Rsomeone/else' 'gh pr comment 5 -$X -b -Rsomeone/else'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
# ANSI-C quoting, locale quoting, brace expansion and a pattern can become a flag that takes a value too, as each of
# these becomes -b.
for command in "gh pr comment 5 \$'-b' -b -Rsomeone/else" 'gh pr comment 5 $"-b" -b -Rsomeone/else' \
  'gh pr comment 5 {-b,} -b -Rsomeone/else' 'gh pr comment 5 -[b] -b -Rsomeone/else'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
# Then every -R after that word can be the value of a flag before it, and gh posts to the repository that it finds
# without -R, unless a -R comes before that word.
# shellcheck disable=SC2016 # The commands are the text that the agent sends, so the expansions stay as written.
for command in 'GH_REPO=someone/else gh pr comment 5 -b $EMPTY -Rjtmpl/project' \
  'GH_REPO=someone/else gh issue close 5 -c ${EMPTY} --repo=jtmpl/project' \
  'GH_REPO=someone/else gh pr comment 5 $X -Rjtmpl/project' \
  'GH_REPO=someone/else gh pr comment 5 -b $EMPTY -Rjtmpl/project -b $EMPTY -Rjtmpl/listed'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
# shellcheck disable=SC2016 # The commands are the text that the agent sends, so the expansions stay as written.
for command in 'GH_REPO=jtmpl/listed gh pr comment 5 -b $EMPTY -Rjtmpl/project' \
  'GH_REPO=jtmpl/project gh issue close 5 -c ${EMPTY} --repo=jtmpl/listed' \
  'GH_REPO=someone/else gh pr comment 5 -R jtmpl/project -b $EMPTY -Rjtmpl/listed'; do
  expect_allow Bash "$command"
done
expect_allow Bash 'gh run rerun 12 -dRjtmpl/listed'
# gh repo edit, delete, archive and unarchive take no -R, so a -R there is part of the value of a flag before it, such
# as the -d of gh repo edit, which takes a description.
for command in 'gh repo edit someone/else -dRjtmpl/project' 'gh repo edit someone/else -d -Rjtmpl/project'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
expect_block Bash 'gh issue -R someone/else comment 5 --body Hello' "$(other_repository someone/else)"
expect_block Bash 'gh release -R someone/else upload v1 app.tar' "$(other_repository someone/else)"
expect_block Bash 'gh workflow run ci.yml --repo=github.com/someone/else' "$(other_repository someone/else)"
# gh finds the subcommand of every group after the repository flag, as it does after the subcommand's other flags.
expect_before_and_after_subcommand 2 "$(other_repository someone/else)" secret '-R someone/else' set 'TOKEN'
expect_before_and_after_subcommand 2 "$(other_repository someone/else)" workflow '-R someone/else' run 'ci.yml'
expect_block Bash 'gh issue comment https://github.com/someone/else/issues/5 --body Hello' \
  "$(other_repository someone/else)"
expect_block Bash 'gh api -X POST repos/someone/else/issues -f title=Bug -f body=Description' \
  "$(other_repository someone/else)"
expect_block Bash 'gh api -if body=Thanks repos/someone/else/issues/5/comments' "$(other_repository someone/else)"
# gh finds api after the flags of gh api too.
expect_block Bash 'gh -X POST api repos/someone/else/issues -f title=Bug' "$(other_repository someone/else)"
expect_block Bash 'gh repo edit someone/else --description "A project"' "$(other_repository someone/else)"
expect_block Bash 'gh repo archive someone/else --yes' "$(other_repository someone/else)"
expect_block Bash 'gh pr comment --body Thanks https://github.com/someone/else/pull/5' "$(other_repository someone/else)"
expect_block Bash 'gh issue close --comment Done https://github.com/someone/else/issues/5' \
  "$(other_repository someone/else)"
# -c and --comment of gh pr review, and -c of gh issue develop, take no value, so the URL after them names the
# repository. -ac of gh pr review is -a and -c, and -ab is -a and -b, which takes the word after it.
for command in 'gh pr review -c https://github.com/someone/else/pull/5' \
  'gh pr review --comment https://github.com/someone/else/pull/5' \
  'gh pr review -b Thanks -ac https://github.com/someone/else/pull/5' \
  'gh issue develop -c https://github.com/someone/else/issues/5'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
expect_allow Bash 'gh issue close 5 -c https://github.com/someone/else/issues/9'
expect_allow Bash 'gh pr close 5 --comment https://github.com/someone/else/pull/9'
expect_allow Bash 'gh pr review 5 -ab https://github.com/someone/else/pull/9'
# The hooks list no flags of gh project create, whose -t and --template take a value, or of gh project link, whose -T
# does.
for command in 'gh project create -t https://github.com/someone/else/issues/9' \
  'gh project create --template https://github.com/someone/else/issues/9' \
  'gh project link 5 -T https://github.com/someone/else/issues/9'; do
  expect_allow Bash "$command"
done
expect_block Bash 'gh pr close 5 -R someone/else' "$(other_repository someone/else)"
expect_block Bash 'GH_REPO=someone/else gh issue comment 5 --body Hello' "$(other_repository someone/else)"
expect_block Bash 'env GH_REPO=someone/else gh pr comment 5 --body Hello' "$(other_repository someone/else)"
expect_block Bash 'GH_REPO=someone/else gh api -X POST "repos/{owner}/{repo}/issues/5/comments" -f body=Thanks' \
  "$(other_repository someone/else)"
expect_allow Bash 'gh pr comment 5 -R jtmpl/project --body Hello'
expect_allow Bash 'gh pr comment 5 -R JTMPL/Project --body Hello'
expect_allow Bash 'gh pr comment 5 -R=jtmpl/project --body Hello'
expect_allow Bash 'gh pr comment 5 --body Hello'
expect_allow Bash 'gh pr comment 5 -R jtmpl/listed --body Hello'
expect_allow Bash 'gh issue comment 5 --body "The same bug: https://github.com/someone/else/issues/9"'
expect_allow Bash 'gh issue comment 5 --body https://github.com/someone/else/issues/9'
expect_allow Bash 'GH_REPO=jtmpl/project gh pr comment 5 --body Hello'
expect_allow Bash 'GH_REPO=someone/else gh pr comment 5 -R jtmpl/project --body Hello'
# time -o names the file that time writes to, so GH_REPO=someone/else sets no variable there.
expect_allow Bash 'time -o GH_REPO=someone/else gh pr comment 5 --body Hello'
# A GH_REPO that a command of the Bash call exports or assigns holds for each gh command after it. The hook checks it
# for each gh command of the call, wherever it's written, because a gh command in a loop or a function can run after a
# GH_REPO that the call sets later in its text.
for command in 'export GH_REPO=someone/else; gh pr comment 5 --body Hello' \
  'GH_REPO=someone/else && gh issue comment 5 --body Hello' 'declare -x GH_REPO=someone/else; gh pr close 5' \
  'export GH_REPO=someone/else; gh pr view 5; gh issue comment 5 --body Hello' \
  'for pass in 1 2; do date; gh pr comment 5 --body Hello; export GH_REPO=someone/else; done' \
  $'post() {\n  gh pr comment 5 --body Hello\n}\nexport GH_REPO=someone/else\npost' \
  'gh pr comment 5 --body Hello; export GH_REPO=someone/else'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
expect_block Bash "export GH_REPO=someone/else; gh api -X PATCH 'repos/{owner}/{repo}' -F private=false" \
  "$(public someone/else)"
expect_allow Bash 'export GH_REPO=jtmpl/project; gh pr comment 5 --body Hello'
expect_allow Bash 'export GH_REPO=; gh pr comment 5 --body Hello'
expect_allow Bash 'export GH_REPO=someone/else; gh pr view 5'
expect_allow Bash 'export GH_REPO=someone/else; gh pr comment 5 -R jtmpl/project --body Hello'
expect_allow Bash 'export GH_REPO=someone/else; GH_REPO=jtmpl/project gh pr comment 5 --body Hello'
expect_allow Bash 'GH_REPO=someone/else make; gh pr comment 5 --body Hello'
# Once the list names someone/else, the hook allows the post.
cp "$project/.loop/allowed-repositories" "$base/allowed-repositories"
echo someone/else >>"$project/.loop/allowed-repositories"
expect_allow Bash 'export GH_REPO=someone/else; gh pr comment 5 --body Hello'
mv "$base/allowed-repositories" "$project/.loop/allowed-repositories"
expect_allow Bash 'gh api -X POST "repos/{owner}/{repo}/issues/5/comments" -f body=Thanks'
expect_allow Bash 'gh pr list --repo someone/else'
expect_allow Bash 'gh pr view 42 -R someone/else'
expect_allow Bash 'gh api repos/someone/else/issues'
# A command with --help only prints its help. gh reads --help after -- as an argument, and after a flag that takes a
# value as that value. -h isn't help, because gh repo edit reads it as --homepage.
expect_allow Bash 'gh repo edit -R someone/else --help'
expect_allow Bash 'gh issue comment 5 --body Hello --repo=someone/else --help'
expect_allow Bash 'gh api -X POST repos/someone/else/issues -f title=Bug --help'
expect_block Bash 'gh repo edit -R someone/else' "$(other_repository someone/else)"
expect_block Bash 'gh repo edit someone/else --description --help' "$(other_repository someone/else)"
expect_block Bash 'gh release upload v1 -R someone/else -- --help' "$(other_repository someone/else)"
expect_block Bash 'gh repo edit someone/else -h https://example.com' "$(other_repository someone/else)"
expect_allow Bash "gh issue comment 5 -R someone/else --body '' --help"
# gh keeps the last value that the command gives --help, and reads it as is_true_flag_value in helpers.bash does. The
# hook doesn't know that --enable-issues takes no value, so it reads the --help=false after it as a flag. -- can be the
# value of the flag before it, so that gh reads the words after it as flags.
expect_block Bash 'gh repo edit -R someone/else --help --help=false' "$(other_repository someone/else)"
expect_allow Bash 'gh repo edit -R someone/else --help=false --help'
expect_allow Bash 'gh repo edit -R someone/else --help=0 --help=true'
expect_block Bash 'gh repo edit -R someone/else --help --enable-issues --help=false' "$(other_repository someone/else)"
expect_block Bash 'gh repo edit someone/else --help --description -- --help=false' "$(other_repository someone/else)"
# A word with an expansion can become nothing, so that --help is the value of the flag before it, or it can become --
# or --help=false.
# shellcheck disable=SC2016 # The commands are the text that the agent sends, so the expansions stay as written.
for command in 'gh issue comment 5 -R someone/else --body $EMPTY --help' \
  'gh issue comment 5 -R someone/else --body ${EMPTY} --help' \
  'gh issue comment 5 -R someone/else --body $(true) --help' \
  'gh release upload v1 -R someone/else $separator notes.md --help' \
  'gh issue comment 5 -R someone/else --body Hello --help $flag'; do
  expect_block Bash "$command" "$(other_repository someone/else)"
done
# shellcheck disable=SC2016 # The command is the text that the agent sends, so $repo stays as written.
expect_allow Bash 'gh pr comment 5 -R "$repo" --body Hello'
# Without a repository, gh posts to the one that origin names in the folder it runs in.
other_clone=$base/other
git init --quiet "$other_clone"
git -C "$other_clone" remote add origin https://github.com/someone/else.git
expect_block Bash "cd '$other_clone' && gh issue comment 5 --body Hello" "$(other_repository someone/else)"
expect_block Bash "cd '$other_clone' && gh issue comment 5 -b \$EMPTY -Rjtmpl/project" "$(other_repository someone/else)"
expect_block Bash "cd '$other_clone' && gh api -X POST 'repos/{owner}/{repo}/issues' -f title=Bug" \
  "$(other_repository someone/else)"
test_cwd=$other_clone
expect_block Bash 'gh pr comment 5 --body Hello' "$(other_repository someone/else)"
# gh posts to the origin when the shell doesn't export a GH_REPO that an earlier command assigns.
expect_block Bash 'GH_REPO=jtmpl/project; gh pr comment 5 --body Hello' "$(other_repository someone/else)"
test_cwd=$project
expect_allow Bash "(cd '$other_clone' && gh pr list) && gh pr comment 5 --body Hello"
expect_allow Bash "cd '$base' && gh issue comment 5 --body Hello"
# shellcheck disable=SC2016 # The command is the text that the agent sends, so $folder stays as written.
expect_allow Bash 'cd "$folder" && gh issue comment 5 --body Hello'
local_clone=$base/local-clone
git init --quiet "$local_clone"
git -C "$local_clone" remote add origin "$base/origin.git"
expect_allow Bash "cd '$local_clone' && gh issue comment 5 --body Hello"
# A cd after time, command or noglob, as in the cases of deleting above, also when it follows a cd to a folder outside
# the repository and comes before a post with gh or a write to a settings file
for wrapper in time "'time'" command noglob; do
  expect_block Bash "cd '$other_clone' && $wrapper cd '$base' && gh issue comment 5 --body Hello" "$cd_after_wrapper"
  test_home=$base
  expect_block Bash "cd ~ && $wrapper cd /tmp && echo 'export DEBUG=1' >>.zshrc" "$cd_after_wrapper"
  test_home=/home-for-tests/someone
done

# A worktree reads the list in the main checkout.
worktree=$base/worktree
git -C "$project" worktree add --quiet --detach "$worktree"
cp -R "$project/scripts" "$worktree/scripts"
hooks_folder=$worktree/scripts/hooks test_cwd=$worktree
expect_allow Bash 'gh repo create jtmpl/listed --public'
expect_block Bash 'gh pr comment 5 -R someone/else --body Hello' "$(other_repository someone/else)"
hooks_folder=$project/scripts/hooks test_cwd=$project

# Writing the file of reviewed fixes in the main checkout's loop folder. Only the orchestrator's session, the one that
# the state file names, may write it. A builder runs as a subagent of that session, with an agent id of its own, or in
# a session of its own.
orchestrator=11111111-aaaa-4bbb-8ccc-000000000001
printf '%s\n' "session: $orchestrator" "goal: the release" >"$project/.loop/state.md"
reviewed_fixes=$project/.loop/reviewed-fixes
only_orchestrator() {
  echo "Blocked: only the orchestrator writes $1, because a release includes each fix that it marks as reviewed without asking the maintainer. Go on with the other work, and list the change in your report."
}
# Checks that the hook blocks an action that writes the file, unless the orchestrator's session takes it:
# expect_only_orchestrator <tool name> <command, patch or path> <the file's path as the message names it>
expect_only_orchestrator() {
  expect_action_from abc123 "" "$1" "$2" 2 "$(only_orchestrator "$3")"
  expect_action_from "$orchestrator" agent-7 "$1" "$2" 2 "$(only_orchestrator "$3")"
  expect_action_from "$orchestrator" "" "$1" "$2" 0 ""
}
mark='refs/private-fork/GHSA-1234-5678-9abc/fix 0123456789abcdef0123456789abcdef01234567'
expect_only_orchestrator Bash "echo '$mark' >> .loop/reviewed-fixes" .loop/reviewed-fixes
expect_only_orchestrator Bash "echo '$mark' >'$reviewed_fixes'" "$reviewed_fixes"
expect_only_orchestrator Bash "printf '%s\n' '$mark' | tee -a .loop/reviewed-fixes" .loop/reviewed-fixes
expect_only_orchestrator Bash "cd .loop && echo '$mark' >> reviewed-fixes" reviewed-fixes
expect_only_orchestrator Bash 'cp /tmp/reviewed-fixes .loop/' .loop/reviewed-fixes
expect_only_orchestrator Bash 'mv marks.txt .loop/reviewed-fixes' .loop/reviewed-fixes
expect_only_orchestrator Bash "sed -i '' 's/0123/4567/' .loop/reviewed-fixes" .loop/reviewed-fixes
expect_only_orchestrator Bash "perl -pi -e 's/0123/4567/' .loop/reviewed-fixes" .loop/reviewed-fixes
# macOS finds a file by its name in any case.
expect_only_orchestrator Bash "echo '$mark' >> .loop/Reviewed-Fixes" .loop/Reviewed-Fixes
expect_only_orchestrator Write "$reviewed_fixes" "$reviewed_fixes"
expect_only_orchestrator Edit "$reviewed_fixes" "$reviewed_fixes"
expect_only_orchestrator apply_patch $'*** Begin Patch\n*** Add File: .loop/reviewed-fixes\n+'"$mark"$'\n*** End Patch\n' \
  .loop/reviewed-fixes
expect_allow Bash 'cat .loop/reviewed-fixes'
expect_allow Bash "grep -c GHSA .loop/reviewed-fixes > counts.txt"
expect_allow Bash "echo '$mark' >> notes/reviewed-fixes"
expect_allow Write "$project/.loop/allowed-repositories"
# A worktree's own loop folder holds no file that a release reads.
test_cwd=$worktree
expect_block Bash "echo '$mark' >> '$reviewed_fixes'" "$(only_orchestrator "$reviewed_fixes")"
expect_allow Bash "echo '$mark' >> .loop/reviewed-fixes"
test_cwd=$project

# Without an origin, the hook can't tell which repository is this one.
git -C "$project" remote remove origin
expect_allow Bash 'gh pr comment 5 -R someone/else --body Hello'

finish_tests
