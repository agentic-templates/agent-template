#!/usr/bin/env bash
# Tests scripts/hooks/secret-files.check through scripts/hooks/before-tool, with a sample input from each tool.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"
every_tool=yes

env_reason="holds secrets, and AGENTS.md says never to read them. .env.example lists the variables."
home_reason="holds secrets, and AGENTS.md says never to read them."

# A command on the list that names a secret file
expect_block Bash 'cat .env' "Blocked: .env $env_reason"
expect_block Bash 'head -n 5 config/.env.local' "Blocked: config/.env.local $env_reason"
expect_block Bash 'grep KEY .env' "Blocked: .env $env_reason"
expect_block Bash 'cp .env /tmp/x' "Blocked: .env $env_reason"
expect_block Bash 'source .env' "Blocked: .env $env_reason"
expect_block Bash 'grep --file=.env notes.txt' "Blocked: .env $env_reason"
expect_block Bash 'sudo FOO=1 env cat .env' "Blocked: .env $env_reason"

# Any command that takes its input from a secret file
expect_block Bash 'wc -l < .env' "Blocked: .env $env_reason"

# A secret file in a later simple command
expect_block Bash 'cd app && cat .env' "Blocked: .env $env_reason"

# The secret files in the home folder, in each way to write it
expect_block Bash 'cat ~/.netrc' "Blocked: ~/.netrc $home_reason"
# shellcheck disable=SC2016 # The command is the text that the agent sends, so $HOME stays as written.
expect_block Bash 'less "$HOME"/.aws/credentials' "Blocked: \$HOME/.aws/credentials $home_reason"
# shellcheck disable=SC2016
expect_block Bash 'tail ${HOME}/.config/gh/hosts.yml' "Blocked: \${HOME}/.config/gh/hosts.yml $home_reason"
expect_block Bash "cat $test_home/.ssh/id_ed25519" "Blocked: $test_home/.ssh/id_ed25519 $home_reason"

# The tool's own file-reading tool
expect_block Read "$test_home/project/.env" "Blocked: $test_home/project/.env $env_reason"
expect_block Read "$test_home/.netrc" "Blocked: $test_home/.netrc $home_reason"

# Commands that only mention a secret file, or that read files but aren't on the list
expect_allow Bash 'cat .env.example'
expect_allow Bash 'cat README.md'
expect_allow Bash 'echo .env >> .gitignore'
expect_allow Bash 'git commit -m "Ignore .env"'
expect_allow Bash 'ls ~/.ssh'
expect_allow Bash 'cat ~/.sshx'
expect_allow Bash 'cat template > .env'
expect_allow Bash 'vim .env'
expect_allow Read "$test_home/project/README.md"

# The hook allows the action when it fails on its own error.
no_jq=$(mktemp -d)
trap 'rm -rf "$no_jq"' EXIT
ln -s "$(command -v bash)" "$no_jq/bash"
input=$(sample_input claude-code Bash 'cat .env')
hook_status=0
hook_message=$(PATH=$no_jq "$hooks_folder/before-tool" 2>&1 >/dev/null <<<"$input") || hook_status=$?
expect_result "Without jq on the PATH, the hook" 0 ""

run_hook 'cat .env'
expect_result "With input that isn't JSON, the hook" 0 ""

run_hook '{"tool_name": "Bash", "tool_input": "cat .env"}'
expect_result "With a check that fails on its own error, the hook" 0 ""

# shellcheck disable=SC2016 # Inspect the substitutions without running them.
for command in 'echo "$(cat .env)"' 'echo $(cat .env)' 'echo "`cat .env`"' 'echo `cat .env`' \
  'echo "$(printf '\''%s'\'' "$(cat .env)")"' $'cat <<EOF\n$(cat .env)\nEOF'; do
  expect_block Bash "$command" "Blocked: .env $env_reason"
done

finish_tests
