#!/usr/bin/env bash
# Tests that split_flag_word in helpers.bash splits a word of a gh command into the flag and its value as gh reads them,
# that is_true_flag_value reads the value of a flag that takes no value as gh does, and that stops_for_help and
# read_help_flag read such words as a request for help as gh does.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"
# shellcheck source=scripts/hooks/helpers.bash
source "$hooks_folder/helpers.bash"

# The flags of gh pr review that take a value. Its -c and --comment take none.
review_flags=" -b --body -F --body-file -R --repo "

# Checks what split_flag_word sets for a word of gh pr review:
# expect_split <word> <flag> <value> <value_is_next_word> <flags_before>
expect_split() {
  local flag value value_is_next_word flags_before
  case_count=$((case_count + 1))
  split_flag_word "$1" "$review_flags"
  if [[ $flag != "$2" || $value != "$3" || $value_is_next_word != "$4" || $flags_before != "$5" ]]; then
    echo "error: split_flag_word must split [$1] into the flag [$2], the value [$3], value_is_next_word [$4] and flags_before [$5], but it gave [$flag], [$value], [$value_is_next_word] and [$flags_before]." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Long flags
expect_split --body=Text --body Text "" ""
expect_split --body= --body "" "" ""
expect_split --body --body "" yes ""
expect_split --comment --comment "" "" ""

# One short flag, with its value in the same word or the next. gh drops the = after a short flag only when more
# follows it.
expect_split -bText -b Text "" ""
expect_split -b=Text -b Text "" ""
expect_split -b==Text -b =Text "" ""
expect_split -b= -b = "" ""
expect_split -b -b "" yes ""
expect_split -c -c "" "" ""

# Several short flags in one word, where each flag but the last takes no value
expect_split -cb -b "" yes c
expect_split -cbText -b Text "" c
expect_split -cb=Text -b Text "" c
expect_split -cb= -b = "" c
expect_split -ccb -b "" yes cc
expect_split -cc -c "" "" c
# gh reads what follows the = after a flag that takes no value as that flag's value, even when it starts with a flag
# that takes one.
expect_split -c=bText -c bText "" ""
expect_split -cc=false -c false "" c

# Checks whether is_true_flag_value reads the value of a flag that takes no value as true:
# expect_flag_value <value> <true or false>
expect_flag_value() {
  local found=false
  case_count=$((case_count + 1))
  if is_true_flag_value "$1"; then
    found=true
  fi
  if [[ $found != "$2" ]]; then
    echo "error: is_true_flag_value must read the value [$1] as $2, but it read it as $found." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# A flag without a value is true. gh reads a value after = as Go's strconv.ParseBool does, and fails on a value that
# ParseBool doesn't accept, such as yes.
for value in "" 1 t T true TRUE True; do
  expect_flag_value "$value" true
done
for value in 0 f F false FALSE False yes tRUE 2; do
  expect_flag_value "$value" false
done

# Checks whether stops_for_help reads a word of gh pr review, as split_flag_word splits it, as a request for help where
# gh stops reading the flags: expect_stop <word> <yes or no>
expect_stop() {
  local flag value value_is_next_word flags_before answer=no
  case_count=$((case_count + 1))
  split_flag_word "$1" "$review_flags"
  if stops_for_help; then
    answer=yes
  fi
  if [[ $answer != "$2" ]]; then
    echo "error: stops_for_help must answer [$2] for [$1], but it answered [$answer]." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# gh has no flag -h of its own, so it stops at the h of a word of short flags, even with a value after the h.
for word in -h -ch -hc -cch -hb -h=false -ch=false -hc=false; do
  expect_stop "$word" yes
done
# Here the h is the value of a flag, or the word holds no h. gh reads the flags after --help.
for word in -c --comment -bh -cbh -Rh -c=h --body=-h --help; do
  expect_stop "$word" no
done

# Checks what read_help_flag sets asks_for_help to after these words of gh pr review, as split_flag_word splits each:
# expect_help_flag <yes or empty> <word>...
expect_help_flag() {
  local flag value value_is_next_word flags_before asks_for_help="" expected=$1 word
  shift
  case_count=$((case_count + 1))
  for word in "$@"; do
    split_flag_word "$word" "$review_flags"
    read_help_flag
  done
  if [[ $asks_for_help != "$expected" ]]; then
    echo "error: after the words [$*], read_help_flag must set asks_for_help to [$expected], but it set it to [$asks_for_help]." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# gh reads the value of --help as is_true_flag_value does, and keeps the last value that the command gives it.
expect_help_flag yes --help
expect_help_flag yes --help=true
expect_help_flag "" --help=false
expect_help_flag "" --help --help=false
expect_help_flag "" --help=1 --help=false
expect_help_flag yes --help=false --help
expect_help_flag yes --help --comment
expect_help_flag "" -c --comment

# In a command with a word that may expand, such as -${x}h or $x -h, the shell can turn the letters or the word
# before the h into a flag that takes the h as its value, so neither helper reads the command as asking for help.
command_word_may_expand=("" yes)
for word in -h -ch '-${x}h'; do
  expect_stop "$word" no
done
expect_help_flag "" --help
command_word_may_expand=("" command)
expect_stop -h no
expect_help_flag "" --help
command_word_may_expand=()

finish_tests
