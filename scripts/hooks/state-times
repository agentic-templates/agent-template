#!/usr/bin/env bash
# Claude Code runs this hook after each Edit, Write and CronCreate, because .claude/settings.json lists it. It writes
# the clock's time into the orchestrator's state file, .loop/state.md in the main checkout, because the orchestrator
# has no clock, so a time that it writes itself is a guess:
# - on the updated: line, after each Edit or Write of the file
# - in place of the now on a "taken in: now" line, after each Edit or Write of the file. The orchestrator writes that
#   line before it reads the maintainer's comments on GitHub, so that its next pass reads from that time.
# - on the heartbeat: line, after CronCreate schedules the heartbeat that docs/loop.md gives. Claude Code ends a
#   recurring prompt 7 days after it's scheduled, and CronList doesn't say when that was.
# It replaces the first line of each name, and adds an updated: or heartbeat: line that the file lacks at its end. It
# prints nothing, and does nothing when it can't tell what to do, such as when the state file doesn't exist.

# A heartbeat: line that the hook adds after an Edit or a Write gets this time, because the hook can't tell when an
# earlier heartbeat was scheduled. The orchestrator then finds the heartbeat 6 days old or more, and schedules it again.
unknown_heartbeat=1970-01-01T00:00:00Z

# shellcheck source=scripts/loop-folder
source "${BASH_SOURCE[0]%/*}/../loop-folder" || exit 0

fields=$(jq -r '.tool_name // "", .tool_input.file_path // "", .cwd // "",
  (.tool_input.prompt // "" | startswith("Loop heartbeat:"))' 2>/dev/null) || exit 0
{
  IFS= read -r tool
  IFS= read -r path
  IFS= read -r cwd
  IFS= read -r is_heartbeat
} <<<"$fields"
# Every agent's edits run this hook, so it leaves the other files before it asks git anything.
case $tool in
  Edit | Write)
    if [[ ${path##*/} != state.md ]]; then
      exit 0
    fi
    name=updated
    other_name=heartbeat
    ;;
  CronCreate)
    if [[ $is_heartbeat != true ]]; then
      exit 0
    fi
    name=heartbeat
    other_name=updated
    ;;
  *) exit 0 ;;
esac

git_folders=$(git -C "${BASH_SOURCE[0]%/*}" rev-parse --path-format=absolute --git-common-dir --show-toplevel 2>/dev/null) ||
  exit 0
state_file=$(loop_folder "${git_folders%%$'\n'*}" "${git_folders#*$'\n'}")/state.md
if [[ ! -f $state_file ]]; then
  exit 0
fi
if [[ $name == updated ]]; then
  if [[ $path != /* ]]; then
    path=$cwd/$path
  fi
  if [[ ! $path -ef $state_file ]]; then
    exit 0
  fi
fi

time=$(date -u +%Y-%m-%dT%H:%M:%SZ)
other_time=$time
if [[ $other_name == heartbeat ]]; then
  other_time=$unknown_heartbeat
fi
# The hook moves a new file over the state file, so that session-start, hand-off and the meter, which read the file at
# any time, never find it half written.
new_file=$(mktemp "$state_file.XXXXXX") || exit 0
if ! awk -v name="$name:" -v time="$time" -v other_name="$other_name:" -v other_time="$other_time" '
  index($0, name) == 1 && !has_name { print name " " time; has_name = 1; next }
  index($0, other_name) == 1 { has_other_name = 1 }
  $0 == "taken in: now" { print "taken in: " time; next }
  { print }
  END {
    if (!has_name) print name " " time
    if (!has_other_name) print other_name " " other_time
  }' "$state_file" >"$new_file" || ! mv -f "$new_file" "$state_file"; then
  rm -f "$new_file"
fi
exit 0
