#!/usr/bin/env bash
# Blocks the agent's file-writing tool from creating or changing a file that makes a tool skip AGENTS.md.
# scripts/instruction-file-names lists the names, and scripts/check fails on the same ones.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"
# shellcheck source=scripts/instruction-file-names
source "${BASH_SOURCE[0]%/*}/../instruction-file-names"

repository_root=$(CDPATH='' cd -- "${BASH_SOURCE[0]%/*}/../.." && pwd -P)

block_if_instruction_file() {
  local path relative
  path=$(physical_path "$1" "${cwd:-$PWD}")
  if [[ $path != "$repository_root"/* ]]; then
    return 0
  fi
  relative=${path#"$repository_root"/}
  shopt -s nocasematch
  if [[ $relative =~ $instruction_file ]]; then
    block "Blocked: $relative makes a tool skip AGENTS.md. Put its rules into AGENTS.md or a guide in docs/ instead." "$1"
  fi
  shopt -u nocasematch
}

read_input
# Deleting a file goes ahead, because that's the fix, and the list leaves out the files that a patch deletes.
read_tool_paths
for path in ${tool_paths[@]+"${tool_paths[@]}"}; do
  block_if_instruction_file "$path"
done
