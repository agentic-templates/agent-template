#!/usr/bin/env bash
# Tests that .claude/settings.json and .codex/hooks.json run the hooks. Each file must be one JSON object, and one of
# its PreToolUse commands, run as written, must block a command that reads .env. The hooks let an action through
# when they fail on their own, so a broken file or command turns them off in every agent without an error.
# Also tests that the commands in .claude/settings.json run the hooks of the git worktree that the agent works in,
# and that the PreToolUse commands in both files run the main checkout's before-tool when the worktree's can't run.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"

# The agents run the commands from the repository's root.
cd "$hooks_folder/../.."
copies=$(mktemp -d)
checkouts=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$copies" "$checkouts"' EXIT

# Prints why a settings file doesn't run the hooks, or nothing if it does: settings_problem <file> <tool>
# The commands get the tool's form of input, as sample_input writes it.
settings_problem() {
  local file=$1 tool=$2 input encoded_command command status
  if [[ ! -f $file ]]; then
    echo "$file doesn't exist, so the agents that read it run no hooks. Restore it."
    return 0
  fi
  if ! jq -e --slurp 'length == 1 and (.[0] | type == "object")' "$file" >/dev/null 2>&1; then
    echo "$file isn't one JSON object, so the agents that read it run no hooks. Fix its JSON."
    return 0
  fi
  input=$(sample_input "$tool" Bash 'cat .env')
  # jq prints each command as a JSON string, so that a command with line breaks stays on one line.
  while IFS= read -r encoded_command; do
    command=$(jq -r . <<<"$encoded_command")
    status=0
    HOME=$test_home sh -c "$command" <<<"$input" >/dev/null 2>&1 || status=$?
    if ((status == 2)); then
      return 0
    fi
  done < <(jq -c '.hooks.PreToolUse[]?.hooks[]?.command? | strings' "$file")
  echo "No PreToolUse command in $file exits with code 2 on a command that reads .env, so the agents that read it run no hooks. Fix the commands, which the agents run with sh -c from the repository's root."
}

# Checks that the test finds a problem in a broken settings file: expect_problem <file> <tool> <problem>
expect_problem() {
  local file=$1 tool=$2 expected=$3 problem
  case_count=$((case_count + 1))
  problem=$(settings_problem "$file" "$tool")
  if [[ $problem != "$expected" ]]; then
    echo "error: for $file, the test must find \"$expected\", but it found \"$problem\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks a settings file, and copies of it that break it: check_settings <file> <tool>
check_settings() {
  local file=$1 tool=$2 broken=$copies/${1##*/} problem content
  case_count=$((case_count + 1))
  problem=$(settings_problem "$file" "$tool")
  if [[ -n $problem ]]; then
    echo "error: $problem" >&2
    failed_cases=$((failed_cases + 1))
    # The copies are made from the file, so they can't show anything while the file itself is broken.
    return 0
  fi

  content=$(<"$file")
  printf '%s\n' "${content%\}}" >"$broken"
  expect_problem "$broken" "$tool" "$broken isn't one JSON object, so the agents that read it run no hooks. Fix its JSON."

  jq '.hooks.PreToolUse[].hooks[].command = "exit 0"' "$file" >"$broken"
  expect_problem "$broken" "$tool" "No PreToolUse command in $broken exits with code 2 on a command that reads .env, so the agents that read it run no hooks. Fix the commands, which the agents run with sh -c from the repository's root."

  rm "$broken"
  expect_problem "$broken" "$tool" "$broken doesn't exist, so the agents that read it run no hooks. Restore it."
}

check_settings .claude/settings.json claude-code
check_settings .codex/hooks.json codex

# Files that hold two JSON objects, or a value that isn't an object
printf '{}\n{}\n' >"$copies/two.json"
expect_problem "$copies/two.json" claude-code "$copies/two.json isn't one JSON object, so the agents that read it run no hooks. Fix its JSON."
echo '[]' >"$copies/array.json"
expect_problem "$copies/array.json" codex "$copies/array.json isn't one JSON object, so the agents that read it run no hooks. Fix its JSON."

# The commands in a git worktree. Claude Code can run the commands in the main checkout while the agent works in a
# worktree, and the main checkout can be older than the worktree. The cases run in a repository whose hooks print
# their own path, with a worktree, and in a second repository with the same hooks. git looks for no repository above
# the temporary folder, and reads none of the person's settings.
export GIT_CEILING_DIRECTORIES=$checkouts GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=Tester GIT_AUTHOR_EMAIL=tester@example.com GIT_COMMITTER_NAME=Tester GIT_COMMITTER_EMAIL=tester@example.com
repository=$checkouts/repository
worktree=$checkouts/worktree
other=$checkouts/other
settings=$PWD/.claude/settings.json
for checkout in "$repository" "$other"; do
  git init --quiet --initial-branch=main "$checkout"
  mkdir -p "$checkout/scripts/hooks"
  for hook in before-tool after-tool after-edit session-start; do
    # The stand-in reads its input before it prints its path. Otherwise it could exit before the command's printf
    # writes the input, and where SIGPIPE is ignored, as in CI, printf would print an I/O error.
    # shellcheck disable=SC2016 # $0 expands when the hook runs.
    printf '#!/bin/sh\ncat >/dev/null\necho "$0"\n' >"$checkout/scripts/hooks/$hook"
    chmod +x "$checkout/scripts/hooks/$hook"
  done
  git -C "$checkout" add scripts
  git -C "$checkout" commit --quiet -m "Add the hooks"
done
git -C "$repository" worktree add --quiet -b work "$worktree"
mkdir "$checkouts/plain"

# Checks which hook the commands for an event in .claude/settings.json run from the repository's main checkout:
# expect_hook <event> <tool> <folder the agent works in> <checkout whose hook must run> [<matcher>]
# The tool is claude-code, copilot-cli or cursor. For SessionStart, only Claude Code counts, because the hook
# does nothing in the other tools. For PostToolUse, the matcher picks the commands: Bash or Edit|Write.
expect_hook() {
  local event=$1 tool=$2 checkout=$4 matcher=${5:-} input expected encoded_command command output commands=0
  test_cwd=$3
  if [[ $event == SessionStart ]]; then
    input=$(jq -n --arg cwd "$test_cwd" '{session_id: "abc123", cwd: $cwd, hook_event_name: "SessionStart", source: "startup"}')
    expected=$checkout/scripts/hooks/session-start
  elif [[ $event == PostToolUse && $matcher == Bash ]]; then
    input=$(sample_input "$tool" Bash ls)
    expected=$checkout/scripts/hooks/after-tool
  elif [[ $event == PostToolUse ]]; then
    input=$(sample_input "$tool" Edit README.md)
    expected=$checkout/scripts/hooks/after-edit
  else
    input=$(sample_input "$tool" Bash ls)
    expected=$checkout/scripts/hooks/before-tool
  fi
  while IFS= read -r encoded_command; do
    command=$(jq -r . <<<"$encoded_command")
    commands=$((commands + 1))
    case_count=$((case_count + 1))
    output=$(cd "$repository" && HOME=$test_home sh -c "$command" <<<"$input" 2>&1) || true
    if [[ $output != "$expected" ]]; then
      echo "error: In $tool, with the agent in $test_cwd, the $event command in .claude/settings.json must run $expected, but it printed \"$output\"." >&2
      failed_cases=$((failed_cases + 1))
    fi
  done < <(jq -c --arg event "$event" --arg matcher "$matcher" \
    '.hooks[$event][]? | select($matcher == "" or .matcher == $matcher) | .hooks[]?.command? | strings' "$settings")
  if ((commands == 0)); then
    case_count=$((case_count + 1))
    echo "error: .claude/settings.json has no $event command${matcher:+ with the matcher $matcher}, so the agents never run $expected. Add the command." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# The worktree, and a folder in it
expect_hook PreToolUse claude-code "$worktree" "$worktree"
expect_hook PreToolUse copilot-cli "$worktree" "$worktree"
expect_hook PreToolUse claude-code "$worktree/scripts" "$worktree"
expect_hook SessionStart claude-code "$worktree" "$worktree"
expect_hook PostToolUse claude-code "$worktree" "$worktree" Bash
expect_hook PostToolUse claude-code "$worktree" "$worktree" "Edit|Write"

# The main checkout
expect_hook PreToolUse claude-code "$repository" "$repository"
expect_hook SessionStart claude-code "$repository" "$repository"

# Cursor doesn't send the folder the agent works in, so the hooks of the folder it runs the command in run.
expect_hook PreToolUse cursor "$worktree" "$repository"

# A hook never runs another repository's code, so the hooks of the folder the command runs in run.
expect_hook PreToolUse claude-code "$other" "$repository"
expect_hook SessionStart claude-code "$other" "$repository"
expect_hook PostToolUse claude-code "$other" "$repository" Bash
expect_hook PostToolUse claude-code "$other" "$repository" "Edit|Write"

# A folder outside any repository, and a folder that doesn't exist
expect_hook PreToolUse claude-code "$checkouts/plain" "$repository"
expect_hook PreToolUse claude-code "$checkouts/missing" "$repository"

# A before-tool that can't run. bash exits with code 2 when it can't parse a file, such as one with a conflict marker
# that a merge left, and the tools read code 2 as a block. The stand-ins run stand-in checks in order, as before-tool
# runs its checks, and the first check that blocks ends the hook.

# Writes a stand-in before-tool into a checkout: write_hook <checkout> <check>...
# The check env blocks cat .env with a reason that names the checkout, and the check conflict is a conflict marker.
# The stand-in reads its input first, for the reason that the stand-ins above do.
write_hook() {
  local checkout=$1 hook=$1/scripts/hooks/before-tool check
  shift
  # shellcheck disable=SC2016 # $(cat) expands when the hook runs.
  printf '%s\n' '#!/usr/bin/env bash' 'input=$(cat)' >"$hook"
  for check in "$@"; do
    case $check in
      env) printf '%s\n' "case \$input in *'cat .env'*) echo \"Blocked by the hook in $checkout.\" >&2; exit 2 ;; esac" ;;
      conflict) printf '%s\n' '<<<<<<< HEAD' 'exit 0' '=======' 'exit 2' '>>>>>>> other' ;;
    esac
  done >>"$hook"
}

# Prints the error that the stand-in before-tool of a checkout gives on an empty input: hook_error <checkout>
hook_error() {
  "$1/scripts/hooks/before-tool" </dev/null 2>&1 || true
}

# Checks what the PreToolUse command of a settings file tells the agent about a command:
# expect_pre_tool_result <file> <tool> <checkout the agent works in> <command> <exit code> <message>
# The message is the additional context that the command prints when it exits with code 0, or what it prints on
# stderr when it exits with code 2. Claude Code runs the command in the main checkout and sends the folder the agent
# works in, while Codex runs the command in that folder.
expect_pre_tool_result() {
  local file=$1 tool=$2 command_text=$4 expected_status=$5 expected_message=$6 folder=$repository command input
  local status=0 output message
  test_cwd=$3
  if [[ $tool == codex ]]; then
    folder=$test_cwd
  fi
  command=$(jq -r '.hooks.PreToolUse[0].hooks[0].command' "$file")
  input=$(sample_input "$tool" Bash "$command_text")
  case_count=$((case_count + 1))
  output=$(cd "$folder" && HOME=$test_home sh -c "$command" <<<"$input" 2>"$copies/errors") || status=$?
  message=$(<"$copies/errors")
  if ((status == 0)); then
    message=""
    if [[ -n $output ]]; then
      message=$(jq -r '.hookSpecificOutput | select(.hookEventName == "PreToolUse") | .additionalContext' \
        <<<"$output" 2>/dev/null) || message=$output
    fi
  fi
  if [[ $status != "$expected_status" || $message != "$expected_message" ]]; then
    echo "error: In $tool, with the agent in $test_cwd, for \"$command_text\", the PreToolUse command in $file must exit with code $expected_status and tell \"$expected_message\", but it exited with code $status and told \"$message\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks the PreToolUse command of a settings file with each hook that can't run: check_broken_hooks <file> <tool>
check_broken_hooks() {
  local file=$1 tool=$2 error
  local note="$worktree/scripts/hooks/before-tool can't run, so the main checkout's copy checked this action instead."

  # A worktree whose hook has a syntax error. The main checkout's copy allows ls and blocks cat .env.
  write_hook "$repository" env
  write_hook "$worktree" conflict
  error=$(hook_error "$worktree")
  expect_pre_tool_result "$file" "$tool" "$worktree" ls 0 "$note Fix the file that this error names: $error"
  expect_pre_tool_result "$file" "$tool" "$worktree" 'cat .env' 2 \
    "$error"$'\n'"$note Fix the file that the error above names."$'\n'"Blocked by the hook in $repository."

  # From here on, the main checkout's copy allows every action, so only the worktree's hook can block one.
  # In a worktree whose hook has a working check before a check with a syntax error, a block from the working check
  # stands.
  write_hook "$repository"
  write_hook "$worktree" env conflict
  error=$(hook_error "$worktree")
  expect_pre_tool_result "$file" "$tool" "$worktree" 'cat .env' 2 "Blocked by the hook in $worktree."
  expect_pre_tool_result "$file" "$tool" "$worktree" ls 0 "$note Fix the file that this error names: $error"

  # A worktree whose hook works
  write_hook "$worktree" env
  expect_pre_tool_result "$file" "$tool" "$worktree" 'cat .env' 2 "Blocked by the hook in $worktree."

  # In the main checkout, no other copy can check the action, so the command blocks it.
  write_hook "$repository" conflict
  expect_pre_tool_result "$file" "$tool" "$repository" ls 2 "$(hook_error "$repository")"
}

check_broken_hooks "$settings" claude-code
check_broken_hooks "$PWD/.codex/hooks.json" codex

finish_tests
