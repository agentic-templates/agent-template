#!/usr/bin/env bash
# Blocks opening a pull request with gh pr create, or its alias gh pr new, when the title job in
# .github/workflows/pr-title.yml would fail on it: when scripts/check-title fails on its title, or
# scripts/check-pull-request on its title, body, branch and commits. The message gives the scripts' errors. It also
# blocks a pull request that isn't a draft and changes a file that scripts/consequential-paths lists, because a reviewer
# reads that change before it merges, and the after-tool hook turns on auto-merge for every pull request that isn't a
# draft. When a pull request has both problems, one message names both.
# - The hook reads the title from --title, and the body as read_body in helpers.bash reads it, as the command writes
#   them, without running $( ) or filling in variables. It blocks a command that gives no title or no body, such as
#   one with --fill.
# - The pull request's branch and commits are those that find_commits in helpers.bash finds. The hook allows the
#   command when it can't find the commits, such as outside a git repository, before the branch exists here, or after
#   a cd to a folder that it can't tell.
# - A relative path to a body file starts from the folder that gh runs in, and git finds the repository from it. That's
#   the folder the agent works in, or the one that a cd before gh changes to, as follow_cd in helpers.bash finds it.
# It also blocks gh pr edit with --title, --body or --body-file when the title job would fail on the pull request with
# the new title or body. It reads them as it reads those of gh pr create, and asks gh pr view for the rest of the pull
# request: the title or body that the command keeps, the branch, the base branch unless --base changes it, the latest
# commit, which it fetches from origin when this repository lacks it, and the author. For a merged pull request, whose
# issue is closed, and one from Dependabot, of which the title job checks only the title, and when gh can't find the
# pull request or the hook can't find its commits, the hook checks only the title and body that the command gives: the
# title with scripts/check-title, and both for paths into a home folder, semicolons and dashes, as
# scripts/hooks/posted-text.check checks the text of other commands.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"
# shellcheck source=scripts/text-rules
source "${BASH_SOURCE[0]%/*}/../text-rules"

# The folder of scripts/check-title, scripts/check-pull-request and scripts/consequential-paths, as an absolute path,
# because the hook changes to the folder that the agent works in.
scripts_folder=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)

no_title="Blocked: the command gives no title, so this hook can't check it. Give the title with --title."

# Prints each file that the pull request changes and scripts/consequential-paths lists, one to a line.
consequential_files() {
  local pattern file
  local -a patterns=()
  # The test after || also reads a last line that has no line break, as scripts/loop/consequential does.
  while IFS= read -r pattern || [[ -n $pattern ]]; do
    if [[ $pattern != '#'* ]]; then
      patterns+=("$pattern")
    fi
  done <"$scripts_folder/consequential-paths"
  # --no-renames lists a renamed file by its old path too, as scripts/loop/consequential does.
  git diff --name-only --no-renames -z "$base_commit...$head_commit" | while IFS= read -r -d '' file; do
    for pattern in "${patterns[@]}"; do
      # shellcheck disable=SC2053 # The pattern stays unquoted, so that its * matches any characters.
      if [[ $file == $pattern ]]; then
        printf '%s\n' "$file"
        break
      fi
    done
  done
}

check_gh_pr_create() {
  local message
  if ! opens_pull_request; then
    return 0
  fi
  if [[ -z $pr_has_title ]]; then
    block "$no_title"
  fi
  if [[ -z $command_folder ]] || ! cd -- "$command_folder" 2>/dev/null; then
    return 0
  fi
  read_body "the pull request's body"
  if ! find_commits; then
    return 0
  fi
  # One block names both problems, so that the agent fixes them in one try.
  message=$(
    draft_message
    title_job_message "gh pr create"
  )
  if [[ -n $message ]]; then
    block "$message"
  fi
}

# Prints the message that blocks a pull request that isn't a draft and changes files that scripts/consequential-paths
# lists, and prints nothing for any other pull request.
draft_message() {
  local files
  if [[ -n $pr_is_draft ]]; then
    return 0
  fi
  files=$(consequential_files)
  if [[ -n $files ]]; then
    printf '%s\n' "Blocked: this pull request changes files that a reviewer reads before the change merges: ${files//$'\n'/, }. Run gh pr create again with --draft, so that it waits for the review, and say in your report that it's a draft."
  fi
}

check_gh_pr_edit() {
  local message
  if ! edits_pull_request_text; then
    return 0
  fi
  if [[ -z $command_folder ]] || ! cd -- "$command_folder" 2>/dev/null; then
    return 0
  fi
  if [[ -n $body_source ]]; then
    read_body "the pull request's body"
  fi
  if can_check_as_title_job; then
    message=$(title_job_message "gh pr edit")
    if [[ -n $message ]]; then
      block "$message"
    fi
  else
    block_if_given_text_fails
  fi
}

# Succeeds if the hook can check the pull request that gh pr edit edits as the title job would, and sets base_commit and
# head_commit. It reads the pull request with read_edited_pull_request, and fetches its latest commit from origin when
# this repository lacks it.
can_check_as_title_job() {
  read_edited_pull_request || return 1
  # The issue that a merged pull request closes is closed, so scripts/check-pull-request would fail on it, though the
  # title job no longer decides anything for it. Of a pull request from Dependabot, the job checks only the title.
  if [[ $pull_request_state == MERGED || $pull_request_author == app/dependabot ]]; then
    return 1
  fi
  find_base_commit "${pr_base:-$base_branch}" || return 1
  if ! git rev-parse --verify --quiet "$head_commit^{commit}" >/dev/null; then
    GIT_TERMINAL_PROMPT=0 git fetch --quiet origin -- "$head_commit" >/dev/null 2>&1 || return 1
  fi
}

# Blocks gh pr edit when the title or body that the command gives has a problem that the hook finds without the rest of
# the pull request: a title that scripts/check-title fails, or a path into a home folder, a semicolon or a dash between
# words in prose, as scripts/text-rules finds them.
block_if_given_text_fails() {
  local problems output
  problems=$(
    if [[ -n $pr_has_title ]]; then
      # The subshell drops the trap, which would otherwise turn every exit code of the script into 1.
      if ! output=$(trap - ERR && TITLE=$pr_title "$scripts_folder/check-title" 2>&1); then
        printf '%s\n' "${output//::error::/}"
      fi
      title_problems "$pr_title"
    fi
    if [[ -n $body_source ]]; then
      body_problems "$body"
    fi
  )
  if [[ -n $problems ]]; then
    block "$(problems_message "Blocked: the text that this command would post has these problems:" "$problems" "gh pr edit")"
  fi
}

# Succeeds if command_words changes the title or body of a pull request with gh pr edit, rather than show the
# command's help. It reads the command's flags with read_pull_request_flags in helpers.bash.
edits_pull_request_text() {
  if [[ ${command_words[0]##*/} != gh || ${command_words[1]:-} != pr || ${command_words[2]:-} != edit ]]; then
    return 1
  fi
  read_pull_request_flags "$pr_edit_flags_with_value" && [[ -n $pr_has_title || -n $body_source ]]
}

# Reads the pull request that gh pr edit edits from gh pr view, and fails when gh can't find it. It sets pr_title and
# body to the pull request's when the command doesn't give them, and sets pull_request_state, base_branch, head_branch,
# head_commit and pull_request_author. head_branch is empty when the branch is in a fork.
read_edited_pull_request() {
  local answer fields is_from_fork
  # Without a pull request in the arguments, gh pr view and gh pr edit both take the current branch's.
  read_arguments 3 "$pr_edit_flags_with_value"
  answer=$(gh pr view ${target[@]+"${target[@]}"} \
    --json title,body,state,baseRefName,headRefName,headRefOid,isCrossRepository,author 2>/dev/null) || return 1
  fields=$(jq -r '[.state, .baseRefName, .headRefName, .headRefOid, .isCrossRepository, .author.login] | @tsv' <<<"$answer")
  IFS=$'\t' read -r pull_request_state base_branch head_branch head_commit is_from_fork pull_request_author <<<"$fields"
  if [[ -z $pr_has_title ]]; then
    pr_title=$(jq -r .title <<<"$answer")
  fi
  if [[ -z $body_source ]]; then
    body=$(jq -r .body <<<"$answer")
  fi
  # scripts/check-pull-request takes the branch only when it's in this repository.
  if [[ $is_from_fork == true ]]; then
    head_branch=""
  fi
}

# Prints the message that blocks the command when the title job in .github/workflows/pr-title.yml would fail on the
# pull request, which gives the errors of scripts/check-title and scripts/check-pull-request, and prints nothing when
# the job would pass: title_job_message <command, such as gh pr create>
# The pull request has the title pr_title, the body body, the branch head_branch, and the commits from base_commit to
# head_commit.
title_job_message() {
  local problems="" output
  # The subshells drop the trap, which would otherwise turn every exit code of the scripts into 1.
  if ! output=$(trap - ERR && TITLE=$pr_title "$scripts_folder/check-title" 2>&1); then
    problems+=$output$'\n'
  fi
  if ! output=$(trap - ERR && TITLE=$pr_title BODY=$body BRANCH=$head_branch "$scripts_folder/check-pull-request" "$base_commit" "$head_commit" 2>&1); then
    problems+=$output$'\n'
  fi
  if [[ -z $problems ]]; then
    return 0
  fi
  # The scripts mark each error for GitHub Actions.
  problems=${problems//::error::/}
  problems_message "Blocked: the checks on pull requests in CI would fail on this one:" "${problems%$'\n'}" "$1"
}

# Prints the message that lists the problems that the hook found in the command:
# problems_message <first line> <problems, one to a line> <command, such as gh pr create>
problems_message() {
  local message="$1"$'\n'"$2"$'\n'"Fix each problem, and run $3 again."
  if [[ -n $body_may_expand || -n $pr_title_may_expand ]]; then
    message+=" This hook reads the title and body as the command writes them, without running \$( ) or filling in variables."
  fi
  printf '%s\n' "$message"
}

check_simple_command() {
  record_written_files
  drop_command_prefixes "$@"
  move_flags_after_gh_subcommand
  if ((${#command_words[@]} == 0)); then
    return 0
  fi
  check_gh_pr_create
  check_gh_pr_edit
  follow_cd
}

read_input
if [[ $tool_name == Bash ]]; then
  # The folder that gh runs in, as follow_cd in helpers.bash describes.
  command_folder=${cwd:-$PWD}
  written_files=()
  for_each_simple_command check_simple_command "$shell_command"
fi
