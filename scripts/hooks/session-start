#!/usr/bin/env bash
# Claude Code runs this hook when a session starts, and again after /clear and after a compaction, because
# .claude/settings.json lists it. Claude Code adds what the hook prints to Claude's context.
# It prints a note for each of these that it finds, and nothing when it finds none:
# - a compaction, after which Claude must read its guides again. Claude Code then reads again only CLAUDE.md and up to
#   five of the files that Claude read or edited, the most recently changed first, so the rules from the guides often
#   survive only in the summary. Its docs don't say whether it reads AGENTS.md again, so the note covers AGENTS.md too.
# - a CLAUDE.md, .claude/CLAUDE.md or CLAUDE.local.md that makes Claude Code skip AGENTS.md
# - a gh older than the rules need
# - a missing jq, which the hooks need
# - the orchestrator's state file, which it prints for the orchestrator, and for a new session that can take over the
#   loop once the orchestrator's process has ended. Any other session gets a line that names the orchestrator. After a
#   compaction that Claude Code started on its own, the orchestrator also gets a line that says the file may be behind.
#   The hook reads what started the compaction from the record that scripts/hooks/before-compact wrote, and deletes it.
# In a Claude Code on the web session, it also installs the tools that scripts/check runs, as CI does.
# Copilot CLI and Cursor also run the hooks in .claude/settings.json, so the hook does nothing outside Claude Code.
# When it fails on its own error, it exits with code 0, so that a broken hook never stops work.
set -eEuo pipefail
trap 'exit 0' ERR

if [[ -z ${CLAUDECODE:-} ]]; then
  exit 0
fi

# shellcheck source=scripts/minimum-gh-version
source "${BASH_SOURCE[0]%/*}/../minimum-gh-version"
# shellcheck source=scripts/loop-folder
source "${BASH_SOURCE[0]%/*}/../loop-folder"
home=${HOME%/}

# Claude Code replaces a hook's output of more than 10,000 characters with its start, and doesn't ask Claude to read
# the rest. So the hook counts the bytes it prints, which are never fewer than its characters, and cuts the state file
# to fit.
output_limit=10000
printed_bytes=0

# Prints a line, and adds its bytes to printed_bytes: note <line>
note() {
  # In the C locale, ${#1} counts bytes.
  local LC_ALL=C
  printf '%s\n' "$1"
  printed_bytes=$((printed_bytes + ${#1} + 1))
}

# Prints a path with the symlinks in its folder resolved, or nothing if its folder doesn't exist.
physical_path() {
  local folder
  folder=$(CDPATH='' cd -- "${1%/*}" 2>/dev/null && pwd -P) || return 0
  echo "$folder/${1##*/}"
}

# The repository is the nearest folder at or above this one that holds .git.
repository=""
folder=$PWD
while [[ -n $folder ]]; do
  if [[ -e $folder/.git ]]; then
    repository=$folder
    break
  fi
  folder=${folder%/*}
done
agents_md=""
if [[ -n $repository && -f $repository/AGENTS.md ]]; then
  agents_md=$(physical_path "$repository/AGENTS.md")
fi

# Succeeds if a file imports the repository's AGENTS.md with an @ line.
# Claude Code takes the path from the importing file's own folder: imports_agents_md <file>
imports_agents_md() {
  local file=$1 line target
  if [[ -z $agents_md ]]; then
    return 1
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ ! $line =~ ^[[:space:]]*@([^[:space:]]+) ]]; then
      continue
    fi
    target=${BASH_REMATCH[1]}
    # The import is text, so ~ is matched as written.
    # shellcheck disable=SC2088
    case $target in
      "~/"*) target=$home/${target#"~/"} ;;
      /*) ;;
      *) target=${file%/*}/$target ;;
    esac
    if [[ $(physical_path "$target") == "$agents_md" ]]; then
      return 0
    fi
  done <"$file"
  return 1
}

# Succeeds if the person's settings have Claude Code read both CLAUDE.md and AGENTS.md.
# That's the "Project instructions" option in /config. Without jq, the hook can't tell, so it counts as not set.
reads_both_files() {
  local setting
  if ! command -v jq >/dev/null || [[ ! -f $home/.claude/settings.json ]]; then
    return 1
  fi
  setting=$(jq -r '.pluginConfigs["agents-md@builtin"].options.instructionFiles // ""' "$home/.claude/settings.json" 2>/dev/null) || return 1
  [[ $setting == claude-md-and-agents-md ]]
}

# 1. A compaction. Claude Code sends the event as JSON on standard input, with the session's id, a subagent's
# agent_id, and a source field that is compact after a compaction. Without jq, or with input that isn't JSON, the
# fields are empty. The subshells drop the trap, which would otherwise take a field from input that is only partly JSON.
IFS= read -r -d '' input || true
event_source=$(trap - ERR && jq -r '.source // empty' 2>/dev/null <<<"$input") || event_source=""
session_id=$(trap - ERR && jq -r '.session_id // empty' 2>/dev/null <<<"$input") || session_id=""
agent_id=$(trap - ERR && jq -r '.agent_id // empty' 2>/dev/null <<<"$input") || agent_id=""
if [[ $event_source == compact ]]; then
  note "This conversation was just compacted, so the guides that this session read from docs/ survive only in the summary. Read again each guide that \"Read the guides\" in AGENTS.md names for the work you're doing, and AGENTS.md itself if its text isn't in your context."
fi

# 2. Files that make Claude Code read them instead of AGENTS.md, in this folder and each folder above it.
# ~/.claude/CLAUDE.md doesn't count, because Claude Code reads it alongside AGENTS.md.
hiding_files=()
imported=false
folder=$PWD
while true; do
  for name in CLAUDE.md .claude/CLAUDE.md CLAUDE.local.md; do
    file=${folder%/}/$name
    if [[ -f $file && $file != "$home/.claude/CLAUDE.md" ]]; then
      hiding_files+=("$file")
      if imports_agents_md "$file"; then
        imported=true
      fi
    fi
  done
  if [[ -z $folder || $folder == / ]]; then
    break
  fi
  folder=${folder%/*}
  folder=${folder:-/}
done
if ((${#hiding_files[@]} > 0)) && ! $imported && ! reads_both_files; then
  note "Claude Code didn't load AGENTS.md, which holds this repository's rules, because these files make it read them instead:"
  for file in "${hiding_files[@]}"; do
    note "- $file"
  done
  note "Read AGENTS.md before you do anything else, and follow it. Then tell the person which files hide AGENTS.md, and how to fix that: move or delete those files, or set \"Project instructions\" in /config so that Claude Code reads both CLAUDE.md and AGENTS.md."
fi

# 3. A gh older than the rules need. If the version can't be read, the hook says nothing about gh.
if ! command -v gh >/dev/null; then
  note "The rules in AGENTS.md need gh $minimum_gh_version or later, and gh isn't installed. Tell the person, and that https://github.com/cli/cli#installation says how to install it."
else
  found=$(older_gh_version "$(gh --version 2>/dev/null || true)")
  if [[ -n $found ]]; then
    note "The rules in AGENTS.md need gh $minimum_gh_version or later, and this machine has gh $found. Tell the person, and that https://github.com/cli/cli#installation says how to update it."
  fi
fi

# 4. A missing jq. The hooks need it to read what the tool sends them, and without it they let every action through.
if ! command -v jq >/dev/null; then
  note "The hooks in scripts/hooks need jq, and it isn't installed, so they let every action through. Tell the person, and that they can install it with a package manager, such as brew install jq on macOS or sudo apt install jq on Ubuntu."
fi

# 5. In a Claude Code on the web session, install shellcheck, actionlint and zizmor, so that scripts/check runs
# every check there. The folder is under the home folder, so that the tools survive a resumed session.
# The PATH line in CLAUDE_ENV_FILE puts the folder first for the session's later commands, so these versions win.
if [[ ${CLAUDE_CODE_REMOTE:-} == true ]]; then
  tools_folder=$home/.check-tools
  if [[ ! -x $tools_folder/shellcheck || ! -x $tools_folder/actionlint || ! -x $tools_folder/zizmor ]]; then
    # The subshell drops the trap, which would otherwise turn the install's failure into success.
    if ! install_error=$(trap - ERR && "${BASH_SOURCE[0]%/*}/../install-check-tools" "$tools_folder" 2>&1); then
      note "The check tools shellcheck, actionlint and zizmor are missing, because scripts/install-check-tools failed: $install_error"
      note "scripts/check skips their checks, and CI still runs them."
    fi
  fi
  if [[ -x $tools_folder/shellcheck && -x $tools_folder/actionlint && -x $tools_folder/zizmor && -n ${CLAUDE_ENV_FILE:-} ]]; then
    # shellcheck disable=SC2016 # $PATH expands when Claude Code reads the file.
    printf 'export PATH="%s:$PATH"\n' "$tools_folder" >>"$CLAUDE_ENV_FILE"
  fi
fi

# 6. The orchestrator's state file, .loop/state.md in the main checkout. Its session line holds the orchestrator's
# session id, and its pid line the id of its Claude Code process, which Claude Code gives its hooks in CLAUDE_PID.
# The hook reads both lines, because /clear gives the session a new id in the same process, and claude --resume gives
# the same session a new process.
# This step comes last, so that no note after the file reads as part of it.

# Succeeds if a process with the id runs: is_running <process id>
# The id must be a positive number, because kill -0 also succeeds for 0 and -1, which name groups of processes.
is_running() {
  [[ $1 =~ ^[1-9][0-9]*$ ]] && kill -0 "$1" 2>/dev/null
}

# Prints notes, and then as many whole lines of the state file as fit in output_limit, so that the hook splits no
# character of more than one byte: print_state_file <note>...
print_state_file() {
  # In the C locale, ${#line} counts bytes.
  local LC_ALL=C line file_bytes=0
  for line in "$@"; do
    note "$line"
  done
  while IFS= read -r line || [[ -n $line ]]; do
    file_bytes=$((file_bytes + ${#line} + 1))
  done <"$state_file"
  # The blank line before the file takes one byte.
  if ((printed_bytes + 1 + file_bytes > output_limit)); then
    note "The file is too long to show here in full. Read the rest of it from $state_file."
  fi
  note ""
  while IFS= read -r line || [[ -n $line ]]; do
    if ((printed_bytes + ${#line} + 1 > output_limit)); then
      return 0
    fi
    note "$line"
  done <"$state_file"
}

state_file=""
in_main_checkout=""
if [[ -n $repository && -n $session_id && -n ${CLAUDE_PID:-} ]] &&
  git_folder=$(git -C "$repository" rev-parse --absolute-git-dir 2>/dev/null) &&
  shared_git_folder=$(git -C "$repository" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  loop=$(loop_folder "$shared_git_folder" "$repository")
  state_file=$loop/state.md
  if [[ $git_folder == "$shared_git_folder" ]]; then
    in_main_checkout=yes
  fi
fi
if [[ -n $state_file && -f $state_file ]]; then
  owner=$(state_field "$state_file" session)
  owner_process=$(state_field "$state_file" pid)
  both_lines="\"session: $session_id\" and \"pid: $CLAUDE_PID\" as the session and pid lines"
  # A builder runs as a subagent in the orchestrator's process, so it has the orchestrator's pid, and its input can
  # hold the orchestrator's session id. A subagent's input can have an agent_id, and a builder works in a worktree.
  can_run_loop=""
  if [[ -z $agent_id && -n $in_main_checkout ]]; then
    can_run_loop=yes
  fi
  # A compaction that Claude Code starts on its own can come in the middle of a step, such as after the orchestrator
  # started a builder and before it wrote the builder in its state file. A compaction that the orchestrator asks for,
  # or that the maintainer types, comes between turns. Only a session that can run the loop reads and deletes its
  # record, because a subagent's input can hold the orchestrator's session id.
  behind_note=""
  if [[ -n $can_run_loop && $event_source == compact ]] && record=$(compaction_record "$loop" "$session_id") &&
    [[ -f $record ]]; then
    trigger=""
    IFS= read -r trigger 2>/dev/null <"$record" || true
    rm -f "$record" || true
    if [[ $trigger == auto ]]; then
      behind_note="Claude Code compacted this conversation when the context filled, maybe in the middle of a step. So your state file may lack the steps you took after the time on its updated: line. Before you go on, check the file against the open pull requests, the issues assigned to you and the agents that scripts/loop/meter lists, and add to it what it lacks."
    fi
  fi
  if [[ -n $can_run_loop && $owner == "$session_id" && $owner_process == "$CLAUDE_PID" ]]; then
    print_state_file "You are this repository's orchestrator. Continue the loop from your state file, $state_file, which follows." \
      ${behind_note:+"$behind_note"}
  elif [[ -n $can_run_loop && ($owner == "$session_id" || $owner_process == "$CLAUDE_PID") ]]; then
    print_state_file "You are this repository's orchestrator, in a new session or process. Write $both_lines of your state file, $state_file. Then continue the loop from the file, which follows." \
      ${behind_note:+"$behind_note"}
  # A session that started earlier has work of its own, so only a new session can take over the loop.
  elif [[ -n $can_run_loop && $event_source == startup ]] && ! is_running "$owner_process"; then
    print_state_file "The Claude Code process of this repository's orchestrator has ended. If the maintainer asks you to continue its work, take over the loop: write $both_lines of its state file, $state_file, and continue the loop from the file, which follows."
  elif [[ -n $owner ]]; then
    note "Session $owner is this repository's orchestrator, and keeps the loop's state in $state_file."
  fi
fi
exit 0
