#!/usr/bin/env bash
# Claude Code runs this hook when a session starts, and again after /clear and after a compaction, because
# .claude/settings.json lists it. Claude Code adds what the hook prints to Claude's context.
# It prints a note for each of these that it finds, and nothing when it finds none:
# - a compaction, after which Claude must read its guides again. Claude Code then reads again only CLAUDE.md and up to
#   five of the files that Claude read or edited, the most recently changed first, so the rules from the guides often
#   survive only in the summary. Its docs don't say whether it reads AGENTS.md again, so the note covers AGENTS.md too.
# - a CLAUDE.md, .claude/CLAUDE.md or CLAUDE.local.md that makes Claude Code skip AGENTS.md
# - a gh older than the rules need
# - a missing jq, which the hooks need
# In a Claude Code on the web session, it also installs the tools that scripts/check runs, as CI does.
# Copilot CLI and Cursor also run the hooks in .claude/settings.json, so the hook does nothing outside Claude Code.
# When it fails on its own error, it exits with code 0, so that a broken hook never stops work.
set -eEuo pipefail
trap 'exit 0' ERR

if [[ -z ${CLAUDECODE:-} ]]; then
  exit 0
fi

# shellcheck source=scripts/minimum-gh-version
source "${BASH_SOURCE[0]%/*}/../minimum-gh-version"
home=${HOME%/}

# Prints a path with the symlinks in its folder resolved, or nothing if its folder doesn't exist.
physical_path() {
  local folder
  folder=$(CDPATH='' cd -- "${1%/*}" 2>/dev/null && pwd -P) || return 0
  echo "$folder/${1##*/}"
}

# The repository is the nearest folder at or above this one that holds .git.
repository=""
folder=$PWD
while [[ -n $folder ]]; do
  if [[ -e $folder/.git ]]; then
    repository=$folder
    break
  fi
  folder=${folder%/*}
done
agents_md=""
if [[ -n $repository && -f $repository/AGENTS.md ]]; then
  agents_md=$(physical_path "$repository/AGENTS.md")
fi

# Succeeds if a file imports the repository's AGENTS.md with an @ line.
# Claude Code takes the path from the importing file's own folder: imports_agents_md <file>
imports_agents_md() {
  local file=$1 line target
  if [[ -z $agents_md ]]; then
    return 1
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ ! $line =~ ^[[:space:]]*@([^[:space:]]+) ]]; then
      continue
    fi
    target=${BASH_REMATCH[1]}
    # The import is text, so ~ is matched as written.
    # shellcheck disable=SC2088
    case $target in
      "~/"*) target=$home/${target#"~/"} ;;
      /*) ;;
      *) target=${file%/*}/$target ;;
    esac
    if [[ $(physical_path "$target") == "$agents_md" ]]; then
      return 0
    fi
  done <"$file"
  return 1
}

# Succeeds if the person's settings have Claude Code read both CLAUDE.md and AGENTS.md.
# That's the "Project instructions" option in /config. Without jq, the hook can't tell, so it counts as not set.
reads_both_files() {
  local setting
  if ! command -v jq >/dev/null || [[ ! -f $home/.claude/settings.json ]]; then
    return 1
  fi
  setting=$(jq -r '.pluginConfigs["agents-md@builtin"].options.instructionFiles // ""' "$home/.claude/settings.json" 2>/dev/null) || return 1
  [[ $setting == claude-md-and-agents-md ]]
}

# 1. A compaction. Claude Code sends the event as JSON on standard input, and its source field is compact after a
# compaction. Without jq, or with input that isn't JSON, the source is empty. The subshell drops the trap, which would
# otherwise take the source from input that is only partly JSON.
event_source=$(trap - ERR && jq -r '.source // empty' 2>/dev/null) || event_source=""
if [[ $event_source == compact ]]; then
  echo "This conversation was just compacted, so the guides that this session read from docs/ survive only in the summary. Read again each guide that \"Read the guides\" in AGENTS.md names for the work you're doing, and AGENTS.md itself if its text isn't in your context."
fi

# 2. Files that make Claude Code read them instead of AGENTS.md, in this folder and each folder above it.
# ~/.claude/CLAUDE.md doesn't count, because Claude Code reads it alongside AGENTS.md.
hiding_files=()
imported=false
folder=$PWD
while true; do
  for name in CLAUDE.md .claude/CLAUDE.md CLAUDE.local.md; do
    file=${folder%/}/$name
    if [[ -f $file && $file != "$home/.claude/CLAUDE.md" ]]; then
      hiding_files+=("$file")
      if imports_agents_md "$file"; then
        imported=true
      fi
    fi
  done
  if [[ -z $folder || $folder == / ]]; then
    break
  fi
  folder=${folder%/*}
  folder=${folder:-/}
done
if ((${#hiding_files[@]} > 0)) && ! $imported && ! reads_both_files; then
  echo "Claude Code didn't load AGENTS.md, which holds this repository's rules, because these files make it read them instead:"
  printf -- '- %s\n' "${hiding_files[@]}"
  echo "Read AGENTS.md before you do anything else, and follow it. Then tell the person which files hide AGENTS.md, and how to fix that: move or delete those files, or set \"Project instructions\" in /config so that Claude Code reads both CLAUDE.md and AGENTS.md."
fi

# 3. A gh older than the rules need. If the version can't be read, the hook says nothing about gh.
if ! command -v gh >/dev/null; then
  echo "The rules in AGENTS.md need gh $minimum_gh_version or later, and gh isn't installed. Tell the person, and that https://github.com/cli/cli#installation says how to install it."
else
  found=$(older_gh_version "$(gh --version 2>/dev/null || true)")
  if [[ -n $found ]]; then
    echo "The rules in AGENTS.md need gh $minimum_gh_version or later, and this machine has gh $found. Tell the person, and that https://github.com/cli/cli#installation says how to update it."
  fi
fi

# 4. A missing jq. The hooks need it to read what the tool sends them, and without it they let every action through.
if ! command -v jq >/dev/null; then
  echo "The hooks in scripts/hooks need jq, and it isn't installed, so they let every action through. Tell the person, and that they can install it with a package manager, such as brew install jq on macOS or sudo apt install jq on Ubuntu."
fi

# 5. In a Claude Code on the web session, install shellcheck, actionlint and zizmor, so that scripts/check runs
# every check there. The folder is under the home folder, so that the tools survive a resumed session.
# The PATH line in CLAUDE_ENV_FILE puts the folder first for the session's later commands, so these versions win.
if [[ ${CLAUDE_CODE_REMOTE:-} == true ]]; then
  tools_folder=$home/.check-tools
  if [[ ! -x $tools_folder/shellcheck || ! -x $tools_folder/actionlint || ! -x $tools_folder/zizmor ]]; then
    # The subshell drops the trap, which would otherwise turn the install's failure into success.
    if ! install_error=$(trap - ERR && "${BASH_SOURCE[0]%/*}/../install-check-tools" "$tools_folder" 2>&1); then
      echo "The check tools shellcheck, actionlint and zizmor are missing, because scripts/install-check-tools failed: $install_error"
      echo "scripts/check skips their checks, and CI still runs them."
    fi
  fi
  if [[ -x $tools_folder/shellcheck && -x $tools_folder/actionlint && -x $tools_folder/zizmor && -n ${CLAUDE_ENV_FILE:-} ]]; then
    # shellcheck disable=SC2016 # $PATH expands when Claude Code reads the file.
    printf 'export PATH="%s:$PATH"\n' "$tools_folder" >>"$CLAUDE_ENV_FILE"
  fi
fi
exit 0
