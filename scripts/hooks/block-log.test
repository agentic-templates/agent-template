#!/usr/bin/env bash
# Tests that the checks of scripts/hooks/before-tool add a line to .loop/blocks.log in the main checkout for each
# action that they block. The hook finds the log from the repository that it's in, so the cases run copies of the
# scripts in a git repository and in a worktree of it.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"
# The cases check the log that the hook finds on its own.
unset HOOK_BLOCK_LOG LOOP_DIR

base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT
# git looks for no repository above the temporary folder, and reads none of the person's settings.
export GIT_CEILING_DIRECTORIES=$base GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=Tester GIT_AUTHOR_EMAIL=tester@example.com GIT_COMMITTER_NAME=Tester GIT_COMMITTER_EMAIL=tester@example.com
main_checkout=$base/main
worktree=$base/worktree
git init --quiet "$main_checkout"
git -C "$main_checkout" commit --quiet --allow-empty -m Start
git -C "$main_checkout" worktree add --quiet --detach "$worktree"
cp -R "${hooks_folder%/*}" "$main_checkout/scripts"
cp -R "${hooks_folder%/*}" "$worktree/scripts"
log=$main_checkout/.loop/blocks.log
# The hook must block a long command within this many seconds of CPU time, well within the time that the tools give
# a hook.
max_cpu_seconds=10

env_message="Blocked: .env holds secrets, and AGENTS.md says never to read them. .env.example lists the variables."
token_message="Blocked: this command prints the token that gh uses, and AGENTS.md says never to read or print secrets. gh commands use the token without it."

# Runs the copy of the hook in a checkout on Claude Code's input, and sets hook_status and hook_message:
# run_copy <checkout> <tool name> <command or path>
run_copy() {
  hook_status=0
  hook_message=$(HOME=$test_home "$1/scripts/hooks/before-tool" 2>&1 >/dev/null <<<"$(sample_input claude-code "$2" "$3")") ||
    hook_status=$?
}

# Prints the number of lines in a file, or 0 if it doesn't exist: line_count <file>
line_count() {
  if [[ -f $1 ]]; then
    wc -l <"$1" | tr -d ' '
  else
    echo 0
  fi
}

# Checks the number of lines in the log: expect_line_count <description> <number>
expect_line_count() {
  local count
  case_count=$((case_count + 1))
  count=$(line_count "$log")
  if [[ $count != "$2" ]]; then
    echo "error: $1, the log must have $2 lines, but it has $count." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks that the last line of a log is the time in UTC, a space and a text:
# expect_last_line <description> <text> [<log>]
expect_last_line() {
  local description=$1 text=$2 file=${3:-$log} last="" time='[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z'
  case_count=$((case_count + 1))
  if [[ -f $file ]]; then
    last=$(tail -n 1 "$file")
  fi
  if [[ ! $last =~ ^$time\ (.*)$ || ${BASH_REMATCH[1]} != "$text" ]]; then
    echo "error: $description, the last line of $file must be the time and \"$text\", but it's \"$last\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks that a folder doesn't exist: expect_no_folder <description> <folder>
expect_no_folder() {
  case_count=$((case_count + 1))
  if [[ -e $2 ]]; then
    echo "error: $1, the hook must not create $2." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks the line that the block of a git credential fill command adds, after the time and the check's file name:
# expect_line_for <command> <text>
expect_line_for() {
  run_copy "$main_checkout" Bash "$1"
  expect_result "For $1, the hook" 2 "$token_message"
  expect_last_line "After $1" "forbidden-commands.check $2"
}

# An action that goes ahead adds no line.
run_copy "$main_checkout" Bash 'cat README.md'
expect_result "For cat README.md, the hook" 0 ""
expect_no_folder "After an action that goes ahead" "$main_checkout/.loop"

# A block adds a line with the time, the check's file name and what the check matched, here the path.
run_copy "$main_checkout" Bash 'cat .env'
expect_result "For cat .env, the hook" 2 "$env_message"
expect_line_count "After one block" 1
expect_last_line "After cat .env" "secret-files.check .env"

# A worktree's block goes in the main checkout's log.
run_copy "$worktree" Read "$worktree/.env"
expect_result "For a Read of the worktree's .env, the hook" 2 "Blocked: $worktree/.env holds secrets, and AGENTS.md says never to read them. .env.example lists the variables."
expect_line_count "After a block in the worktree" 2
expect_last_line "After a Read of the worktree's .env" "secret-files.check $worktree/.env"
expect_no_folder "After a block in the worktree" "$worktree/.loop"

# A check of the file-writing tools gives the path that the tool would write.
run_copy "$main_checkout" Write "$main_checkout/CLAUDE.md"
expect_result "For a Write of CLAUDE.md, the hook" 2 "Blocked: CLAUDE.md makes a tool skip AGENTS.md. Put its rules into AGENTS.md or a guide in docs/ instead."
expect_last_line "After a Write of CLAUDE.md" "instruction-files.check $main_checkout/CLAUDE.md"
run_copy "$main_checkout" Write "$test_home/.zshrc"
expect_result "For a Write of ~/.zshrc, the hook" 2 "Blocked: $test_home/.zshrc holds settings of the machine or of a tool, and only the maintainer may change them. Ask the maintainer, and go on with the other work."
expect_last_line "After a Write of ~/.zshrc" "maintainer-only.check $test_home/.zshrc"

# Unless the check gives what it matched, the line holds the simple command that the check blocked.
expect_line_for 'cd app && git credential fill' 'git credential fill'

# The line leaves out each value that could hold a secret.
expect_line_for 'GH_TOKEN=abc123 git credential fill' 'GH_TOKEN=[left out] git credential fill'
expect_line_for 'MYSQL_PWD=abc123 git credential fill' 'MYSQL_PWD=[left out] git credential fill'
expect_line_for 'git credential fill --password abc123' 'git credential fill --password [left out]'
expect_line_for 'git credential fill --pat abc123' 'git credential fill --pat [left out]'
expect_line_for 'git credential fill -p abc123' 'git credential fill -p [left out]'
expect_line_for 'git credential fill -u me:abc123' 'git credential fill -u me:[left out]'
expect_line_for 'git credential fill --API-KEY=abc123' 'git credential fill --API-KEY=[left out]'
expect_line_for 'git credential fill Cookie:session=abc123' 'git credential fill Cookie:[left out]'
expect_line_for "git credential fill 'Bearer abc123'" 'git credential fill Bearer [left out]'
expect_line_for "git credential fill 'Authorization: Bearer abc123'" 'git credential fill Authorization: [left out]'
expect_line_for 'git credential fill Authorization: Bearer abc123' 'git credential fill Authorization: [left out] [left out]'
expect_line_for "git credential fill '{\"private_key\": \"abc123\"}'" 'git credential fill {"private_key": [left out]'
expect_line_for 'git credential fill https://someone:abc123@example.com/repository' \
  'git credential fill https://someone:[left out]@example.com/repository'
expect_line_for 'git credential fill https://someone:abc/123@example.com/repository' \
  'git credential fill https://someone:[left out]@example.com/repository'

# The line leaves out each word that holds a token of a shape in scripts/token-shapes. The cases join each token from
# two parts, so that this file holds none.
key=AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCd
tokens=(
  "gh""p_$key"
  "github""_pat_11ABCDEFG0_$key"
  "glp""at-${key:0:20}"
  "sk-""ant-api03-$key"
  "sk-""proj-$key"
  "sk-""$key"
  "sk_""live_$key"
  "AKI""AIOSFODNN7EXAMPLE"
  "xox""b-1234567890-abcdefghij"
  "AIz""aSyA-${key:0:31}"
)
for token in "${tokens[@]}"; do
  expect_line_for "git credential fill $token" 'git credential fill [left out]'
done
expect_line_for "git credential fill 'the key ${tokens[0]} works' --verbose" 'git credential fill [left out] --verbose'

# The word after a flag named for a secret stays when it's a flag too, because then it's no secret.
expect_line_for 'git credential fill --with-token --verbose' 'git credential fill --with-token --verbose'

# A command that spans lines takes one line.
expect_line_for $'git credential fill "first line\nsecond line"' 'git credential fill first line second line'

# The hook blocks a long command with line breaks in little time. bash 3.2 took minutes to replace the line breaks in
# a word of 60 KB. The case measures the CPU time of the hook, because a busy machine, as in CI, stretches the time on
# the clock many times over.
body="" logged_body=""
for ((line = 1; line <= 2500; line++)); do
  body+="Line $line of a long body"$'\n'
  logged_body+="Line $line of a long body "
done
TIMEFORMAT='%U %S'
{ time run_copy "$main_checkout" Bash "git credential fill \"$body\""; } 2>"$base/cpu-time"
expect_result "For git credential fill with a long body, the hook" 2 "$token_message"
expect_last_line "After git credential fill with a long body" "forbidden-commands.check git credential fill $logged_body"
read -r user_seconds system_seconds <"$base/cpu-time"
# The times have three decimals, so without the dot they're in milliseconds.
cpu_milliseconds=$((10#${user_seconds/./} + 10#${system_seconds/./}))
case_count=$((case_count + 1))
if ((cpu_milliseconds > max_cpu_seconds * 1000)); then
  echo "error: the hook took $cpu_milliseconds ms of CPU time to block a command of ${#body} characters, and the limit is $max_cpu_seconds seconds." >&2
  failed_cases=$((failed_cases + 1))
fi

# HOOK_BLOCK_LOG names another log.
blocks_before=$(line_count "$log")
HOOK_BLOCK_LOG=$base/other.log run_copy "$main_checkout" Bash 'cat .env'
expect_result "With HOOK_BLOCK_LOG, the hook" 2 "$env_message"
expect_last_line "With HOOK_BLOCK_LOG" "secret-files.check .env" "$base/other.log"
expect_line_count "With HOOK_BLOCK_LOG" "$blocks_before"

# LOOP_DIR names another loop folder, which holds the log.
LOOP_DIR=$base/other-loop run_copy "$main_checkout" Bash 'cat .env'
expect_result "With LOOP_DIR, the hook" 2 "$env_message"
expect_last_line "With LOOP_DIR" "secret-files.check .env" "$base/other-loop/blocks.log"
expect_line_count "With LOOP_DIR" "$blocks_before"

# Without the token shapes, the line leaves out every word.
mv "$main_checkout/scripts/token-shapes" "$base/token-shapes"
run_copy "$main_checkout" Bash 'cat .env'
expect_result "Without scripts/token-shapes, the hook" 2 "$env_message"
expect_last_line "Without scripts/token-shapes" "secret-files.check"
mv "$base/token-shapes" "$main_checkout/scripts/token-shapes"

# A log that can't be written changes neither the block nor its message.
rm "$log"
mkdir "$log"
run_copy "$main_checkout" Bash 'cat .env'
expect_result "With a folder in place of the log, the hook" 2 "$env_message"
rm -rf "$main_checkout/.loop"
echo "Not a folder" >"$main_checkout/.loop"
run_copy "$main_checkout" Bash 'cat .env'
expect_result "With .loop as a file, the hook" 2 "$env_message"

finish_tests
