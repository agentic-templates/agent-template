#!/usr/bin/env bash
# Blocks the gh commands that would post text with a problem that scripts/check-pull-request finds in a pull request:
# a path into a home folder, or a semicolon or a dash between words in prose, as scripts/text-rules finds them.
# The commands and their text are:
# - the title and body of gh issue create, its alias gh issue new, and gh issue edit
# - the body of gh issue comment, gh pr comment and gh pr review
# - the comment that -c or --comment gives to gh issue close, gh issue reopen, gh pr close and gh pr reopen
# It reads the title, the comment and the body as read_text and read_body in helpers.bash read them, as the command
# writes them, without running $( ) or filling in variables. It allows a command that gives none of them,
# such as gh issue edit 7 --add-label ready. scripts/hooks/pull-request-rules.check checks the text of gh pr create and
# gh pr edit.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"
# shellcheck source=scripts/text-rules
source "${BASH_SOURCE[0]%/*}/../text-rules"

# Blocks a gh command whose text has a problem, with a message that lists every problem: check_text <flags that take a value>
check_text() {
  local problems message
  if ! read_text "$1"; then
    return 0
  fi
  if [[ -n $body_source ]]; then
    read_body "the body for paths into a home folder, semicolons and dashes"
  fi
  problems=$(
    if [[ -n $has_title ]]; then
      title_problems "$title"
    fi
    if [[ -n $body_source ]]; then
      body_problems "$body"
    fi
  )
  if [[ -z $problems ]]; then
    return 0
  fi
  message="Blocked: the text that this command would post has these problems:"$'\n'"$problems"$'\n'
  message+="Fix each problem, and run gh ${command_words[1]} ${command_words[2]} again."
  if [[ -n $body_may_expand || -n $title_may_expand ]]; then
    message+=" This hook reads the text as the command writes it, without running \$( ) or filling in variables."
  fi
  block "$message"
}

check_simple_command() {
  record_written_files
  drop_command_prefixes "$@"
  move_flags_after_gh_subcommand
  if ((${#command_words[@]} < 3)) || [[ ${command_words[0]##*/} != gh ]]; then
    return 0
  fi
  case "${command_words[1]} ${command_words[2]}" in
    "issue create" | "issue new") check_text "$issue_create_flags_with_value" ;;
    "issue edit") check_text "$issue_edit_flags_with_value" ;;
    "issue comment" | "pr comment") check_text "$comment_flags_with_value" ;;
    "pr review") check_text "$review_flags_with_value" ;;
    "issue close") check_text "$issue_close_flags_with_value" ;;
    "pr close") check_text "$pr_close_flags_with_value" ;;
    "issue reopen" | "pr reopen") check_text "$reopen_flags_with_value" ;;
  esac
}

read_input
if [[ $tool_name == Bash ]]; then
  # A relative path to a body file starts from the folder the agent works in. Cursor doesn't send that folder, so for
  # Cursor the hook's own folder counts.
  cd -- "${cwd:-.}" 2>/dev/null || exit 0
  written_files=()
  for_each_simple_command check_simple_command "$shell_command"
fi
