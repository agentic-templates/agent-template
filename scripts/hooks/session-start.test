#!/usr/bin/env bash
# Tests scripts/hooks/session-start, run from a stand-in working folder two levels below a stand-in home folder.
# The cases assume that no CLAUDE.md, .claude/CLAUDE.md or CLAUDE.local.md exists above the system's temporary folder.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"

base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT
home=$base/home
above=$home/work
work=$above/repository

# A stand-in for gh, first on the PATH, that reports the version in TEST_GH_VERSION.
stand_in=$base/bin
mkdir -p "$stand_in"
# shellcheck disable=SC2016 # The stand-in reads TEST_GH_VERSION when it runs.
printf '#!/usr/bin/env bash\necho "gh version $TEST_GH_VERSION (2026-08-20)"\n' >"$stand_in/gh"
chmod +x "$stand_in/gh"
export TEST_GH_VERSION=2.98.0

# A stand-in for curl, first on the PATH, that records each call and then fails, so that an install fails without the network.
# A stand-in for uname reports Linux on x86-64, which scripts/install-check-tools needs before it calls curl.
# shellcheck disable=SC2016 # $1 is the stand-in's own argument.
printf '#!/usr/bin/env bash\ncase $1 in -s) echo Linux ;; -m) echo x86_64 ;; esac\n' >"$stand_in/uname"
chmod +x "$stand_in/uname"
curl_calls=$base/curl-calls
printf '#!/usr/bin/env bash\necho "curl $*" >>"%s"\nexit 1\n' "$curl_calls" >"$stand_in/curl"
chmod +x "$stand_in/curl"

# A folder whose PATH has bash and the stand-in gh, but no jq.
no_jq=$base/no-jq
mkdir -p "$no_jq"
ln -s "$(command -v bash)" "$no_jq/bash"
ln -s "$stand_in/gh" "$no_jq/gh"

# A folder whose PATH has bash and jq, but no gh.
no_gh=$base/no-gh
mkdir -p "$no_gh"
ln -s "$(command -v bash)" "$no_gh/bash"
ln -s "$(command -v jq)" "$no_gh/jq"

# The file that the hook reads on standard input, in place of the JSON that Claude Code sends it.
input_file=$base/input

# Gives each case a new home and working folder, with a repository that has an AGENTS.md,
# and the input that Claude Code sends when a session starts.
new_folders() {
  rm -rf "$home"
  mkdir -p "$work/.git"
  echo "# How to work in this repository" >"$work/AGENTS.md"
  echo '{"source": "startup"}' >"$input_file"
}

# Runs the hook in the working folder as Claude Code does on a person's machine, and sets hook_status and hook_output.
# Arguments such as CLAUDE_CODE_REMOTE=true set more variables: run_session_start [<name>=<value>...]
run_session_start() {
  hook_status=0
  hook_output=$(cd "$work" && env -u CLAUDE_CODE_REMOTE -u CLAUDE_ENV_FILE -u CLAUDE_PID -u LOOP_DIR HOME="$home" CLAUDECODE=1 \
    PATH="$stand_in:$PATH" "$@" "$hooks_folder/session-start" <"$input_file") || hook_status=$?
}

# Checks the hook's output: expect_output <description> <text the output holds, or "" for no output>
expect_output() {
  local description=$1 text=$2
  case_count=$((case_count + 1))
  if [[ -z $text && -n $hook_output ]]; then
    echo "error: $description, the hook must print nothing, but it printed: $hook_output" >&2
    failed_cases=$((failed_cases + 1))
  elif [[ -n $text && $hook_output != *"$text"* ]]; then
    echo "error: $description, the hook's note must hold \"$text\", but it printed: $hook_output" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks that the hook's output doesn't hold a text: expect_output_without <description> <text>
expect_output_without() {
  local description=$1 text=$2
  case_count=$((case_count + 1))
  if [[ $hook_output == *"$text"* ]]; then
    echo "error: $description, the hook must not print \"$text\", but it printed: $hook_output" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

hidden="Claude Code didn't load AGENTS.md"
compacted="This conversation was just compacted, so the guides that this session read from docs/ survive only in the summary. Read again each guide that \"Read the guides\" in AGENTS.md names for the work you're doing, and AGENTS.md itself if its text isn't in your context."

new_folders
echo '{"source": "compact"}' >"$input_file"
run_session_start
expect_output "After a compaction" "$compacted"

new_folders
echo '{"source": "compact"}' >"$input_file"
echo "Rules" >"$work/CLAUDE.md"
run_session_start
expect_output "After a compaction, with a CLAUDE.md in the working folder, the note about the compaction comes first" \
  "$compacted"$'\n'"$hidden"

for source in startup clear resume; do
  new_folders
  echo "{\"source\": \"$source\"}" >"$input_file"
  run_session_start
  expect_output "With the source $source" ""
done

new_folders
: >"$input_file"
run_session_start
expect_output "With no input" ""

new_folders
echo '{}' >"$input_file"
run_session_start
expect_output "With the input {}" ""

new_folders
echo 'source: compact' >"$input_file"
run_session_start
expect_output "With input that isn't JSON" ""

new_folders
echo '{"source": "compact"}' >"$input_file"
hook_output=$(cd "$work" && HOME=$home CLAUDECODE=1 PATH=$no_jq "$hooks_folder/session-start" <"$input_file")
expect_output_without "After a compaction, without jq" "$compacted"
expect_output "After a compaction, without jq" "The hooks in scripts/hooks need jq"

new_folders
echo '{"source": "compact"}' >"$input_file"
hook_output=$(cd "$work" && HOME=$home PATH=$stand_in:$PATH env -u CLAUDECODE "$hooks_folder/session-start" <"$input_file")
expect_output "After a compaction, without CLAUDECODE" ""

new_folders
run_session_start
expect_output "With no file that hides AGENTS.md" ""

new_folders
echo "Rules" >"$work/CLAUDE.md"
run_session_start
expect_output "With a CLAUDE.md in the working folder" "- $work/CLAUDE.md"
expect_output "With a CLAUDE.md in the working folder" "Read AGENTS.md before you do anything else"

new_folders
mkdir -p "$above/.claude"
echo "Rules" >"$above/.claude/CLAUDE.md"
run_session_start
expect_output "With a .claude/CLAUDE.md in the folder above" "- $above/.claude/CLAUDE.md"

new_folders
echo "Rules" >"$work/CLAUDE.local.md"
run_session_start
expect_output "With a CLAUDE.local.md in the working folder" "- $work/CLAUDE.local.md"

new_folders
mkdir -p "$home/.claude"
echo "Rules" >"$home/.claude/CLAUDE.md"
run_session_start
expect_output "With only ~/.claude/CLAUDE.md" ""

new_folders
printf 'Rules\n@AGENTS.md\n' >"$work/CLAUDE.md"
run_session_start
expect_output "With a CLAUDE.md next to AGENTS.md that imports it" ""

new_folders
printf 'Rules\n@AGENTS.md\n' >"$above/CLAUDE.md"
run_session_start
expect_output "With a CLAUDE.md above the repository whose @AGENTS.md line doesn't reach it" "- $above/CLAUDE.md"

new_folders
echo "Rules" >"$work/CLAUDE.md"
mkdir -p "$home/.claude"
echo '{"pluginConfigs": {"agents-md@builtin": {"options": {"instructionFiles": "claude-md-and-agents-md"}}}}' >"$home/.claude/settings.json"
run_session_start
expect_output "With Project instructions set to read both files" ""

new_folders
echo "Rules" >"$work/CLAUDE.md"
hook_output=$(cd "$work" && HOME=$home PATH=$stand_in:$PATH env -u CLAUDECODE "$hooks_folder/session-start" <"$input_file")
expect_output "Without CLAUDECODE" ""

new_folders
TEST_GH_VERSION=2.97.0
run_session_start
expect_output "With gh 2.97.0" "need gh 2.98 or later, and this machine has gh 2.97.0"
TEST_GH_VERSION="something else"
run_session_start
expect_output "With a gh whose version can't be read" ""
TEST_GH_VERSION=2.98.0

new_folders
hook_output=$(cd "$work" && HOME=$home CLAUDECODE=1 PATH=$no_gh "$hooks_folder/session-start" <"$input_file")
expect_output "Without gh" "need gh 2.98 or later, and gh isn't installed"

new_folders
echo "Rules" >"$work/CLAUDE.md"
mkdir -p "$home/.claude"
echo '{"pluginConfigs": {"agents-md@builtin": {"options": {"instructionFiles": "claude-md-and-agents-md"}}}}' >"$home/.claude/settings.json"
hook_output=$(cd "$work" && HOME=$home CLAUDECODE=1 PATH=$no_jq "$hooks_folder/session-start" <"$input_file")
expect_output "Without jq" "The hooks in scripts/hooks need jq"
expect_output "Without jq, which the hook needs to read the settings" "$hidden"

# In a Claude Code on the web session, the hook installs the check tools into a folder under the home folder,
# and puts that folder first on the PATH through CLAUDE_ENV_FILE.
tools_folder=$home/.check-tools
env_file=$base/env-file

# Checks that the stand-in curl was called or not, and what the env file holds: expect_install <description> <called or not called> <env file text>
expect_install() {
  local description=$1 curl=$2 env_text=$3 calls="" written=""
  case_count=$((case_count + 1))
  if [[ -f $curl_calls ]]; then
    calls=$(<"$curl_calls")
  fi
  if [[ -f $env_file ]]; then
    written=$(<"$env_file")
  fi
  if [[ $curl == "not called" && -n $calls ]]; then
    echo "error: $description, the hook must not call curl, but it called: $calls" >&2
    failed_cases=$((failed_cases + 1))
  elif [[ $curl == called && -z $calls ]]; then
    echo "error: $description, the hook must try to install the tools with curl, but it didn't call curl." >&2
    failed_cases=$((failed_cases + 1))
  elif [[ $written != "$env_text" ]]; then
    echo "error: $description, CLAUDE_ENV_FILE must hold \"$env_text\", but it holds \"$written\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

new_folders
rm -f "$curl_calls" "$env_file"
run_session_start CLAUDE_ENV_FILE="$env_file"
expect_install "Without CLAUDE_CODE_REMOTE" "not called" ""

new_folders
rm -f "$curl_calls" "$env_file"
mkdir -p "$tools_folder"
for tool in shellcheck actionlint zizmor; do
  printf '#!/usr/bin/env bash\n' >"$tools_folder/$tool"
  chmod +x "$tools_folder/$tool"
done
run_session_start CLAUDE_CODE_REMOTE=true CLAUDE_ENV_FILE="$env_file"
expect_install "With CLAUDE_CODE_REMOTE=true and the three tools in the folder" "not called" "export PATH=\"$tools_folder:\$PATH\""

new_folders
rm -f "$curl_calls" "$env_file"
run_session_start CLAUDE_CODE_REMOTE=true CLAUDE_ENV_FILE="$env_file"
case_count=$((case_count + 1))
if ((hook_status != 0)); then
  echo "error: With CLAUDE_CODE_REMOTE=true and an install that fails, the hook must exit with code 0, but it exited with code $hook_status." >&2
  failed_cases=$((failed_cases + 1))
fi
expect_output "With CLAUDE_CODE_REMOTE=true and an install that fails" "The check tools shellcheck, actionlint and zizmor are missing"
expect_install "With CLAUDE_CODE_REMOTE=true and an install that fails" called ""

# The orchestrator's state file. The hook asks git where the main checkout is, so these cases run in git repositories,
# with none of the person's git settings. The repository's folder name has characters of two bytes, so that the cases
# of a long state file check that the hook counts bytes, not characters.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=Tester GIT_AUTHOR_EMAIL=tester@example.com
export GIT_COMMITTER_NAME=Tester GIT_COMMITTER_EMAIL=tester@example.com
work=$above/dépôt
state_file=$work/.loop/state.md
state_text="Ship the importer."

# A process that runs, which is this test's own, and one that has ended
running_process=$$
true &
ended_process=$!
wait "$ended_process"
# The process of another session, or of the orchestrator after claude --resume, which differs from the other two
if ((running_process > ended_process)); then
  new_process=$((running_process + 1))
else
  new_process=$((ended_process + 1))
fi

# Prints a state file with a session line and a pid line: state_lines <session id> <process id>
state_lines() {
  printf '# Loop state\n\nsession: %s\npid: %s\n\n## Next\n%s\n' "$1" "$2" "$state_text"
}

# Gives each case a git repository whose state file names the session owner-1 and the process that runs.
new_state_file() {
  new_folders
  git init --quiet "$work"
  mkdir -p "$work/.loop"
  state_lines owner-1 "$running_process" >"$state_file"
}

# Writes the input that Claude Code sends when a session starts: session_input <source> <session id>
session_input() {
  printf '{"source": "%s", "session_id": "%s"}\n' "$1" "$2" >"$input_file"
}

owner_note="You are this repository's orchestrator. Continue the loop from your state file, $state_file, which follows."
other_note="Session owner-1 is this repository's orchestrator, and keeps the loop's state in $state_file."
long_note="The file is too long to show here in full. Read the rest of it from $state_file."

# Prints the note for the orchestrator in a new session or process: new_lines_note <session id> <process id>
new_lines_note() {
  echo "You are this repository's orchestrator, in a new session or process. Write \"session: $1\" and \"pid: $2\" as the session and pid lines of your state file, $state_file. Then continue the loop from the file, which follows."
}

# Prints the note for a session that can take over the loop: take_over_note <session id> <process id>
take_over_note() {
  echo "The Claude Code process of this repository's orchestrator has ended. If the maintainer asks you to continue its work, take over the loop: write \"session: $1\" and \"pid: $2\" as the session and pid lines of its state file, $state_file, and continue the loop from the file, which follows."
}

new_state_file
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "After a compaction of the orchestrator, the state file follows the note about the compaction" \
  "$compacted"$'\n'"$owner_note"$'\n\n'"$(<"$state_file")"

# LOOP_DIR names another loop folder, which holds the state file.
new_state_file
other_loop=$home/other-loop
mkdir -p "$other_loop"
mv "$state_file" "$other_loop/state.md"
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process" LOOP_DIR="$other_loop"
expect_output "With LOOP_DIR, the state file in its folder follows the note" \
  "You are this repository's orchestrator. Continue the loop from your state file, $other_loop/state.md, which follows."$'\n\n'"$(<"$other_loop/state.md")"

new_state_file
session_input clear new-2
run_session_start CLAUDE_PID="$running_process"
expect_output "After /clear in the orchestrator's process" "$(new_lines_note new-2 "$running_process")"$'\n\n'"$(<"$state_file")"
state_lines new-2 "$running_process" >"$state_file"
session_input compact new-2
run_session_start CLAUDE_PID="$running_process"
expect_output "After /clear and a compaction, once the orchestrator wrote both lines" "$owner_note"

new_state_file
state_lines owner-1 "$ended_process" >"$state_file"
session_input resume owner-1
run_session_start CLAUDE_PID="$new_process"
expect_output "After claude --resume starts the orchestrator in a new process" \
  "$(new_lines_note owner-1 "$new_process")"$'\n\n'"$(<"$state_file")"
state_lines owner-1 "$new_process" >"$state_file"
session_input clear new-3
run_session_start CLAUDE_PID="$new_process"
expect_output "After /clear in the resumed orchestrator, once it wrote both lines" "$(new_lines_note new-3 "$new_process")"

new_state_file
state_lines owner-1 "$ended_process" >"$state_file"
session_input startup new-4
run_session_start CLAUDE_PID="$new_process"
expect_output "For a new session in the main checkout, after the orchestrator's process ended" \
  "$(take_over_note new-4 "$new_process")"$'\n\n'"$(<"$state_file")"

# A pid line that holds no positive number names no process that runs.
for pid_line in "pid: 0" "pid: -1" "pid: none" ""; do
  new_state_file
  printf 'session: owner-1\n%s\n\n%s\n' "$pid_line" "$state_text" >"$state_file"
  session_input startup new-4
  run_session_start CLAUDE_PID="$new_process"
  expect_output "For a new session in the main checkout, with \"$pid_line\" in place of the pid line" \
    "$(take_over_note new-4 "$new_process")"
done

for source in startup resume clear compact; do
  new_state_file
  session_input "$source" someone-else
  run_session_start CLAUDE_PID="$new_process"
  expect_output "With the source $source, for another session while the orchestrator's process runs" "$other_note"
  expect_output_without "With the source $source, for another session while the orchestrator's process runs" "$state_text"
done

for source in resume clear compact; do
  new_state_file
  state_lines owner-1 "$ended_process" >"$state_file"
  session_input "$source" someone-else
  run_session_start CLAUDE_PID="$new_process"
  expect_output "With the source $source, for another session after the orchestrator's process ended" "$other_note"
  expect_output_without "With the source $source, for another session after the orchestrator's process ended" "$state_text"
done

# Makes the working folder a worktree of a main checkout elsewhere, whose state file names the session owner-1 and a
# process: new_worktree <process id>
main_checkout=$base/main
new_worktree() {
  new_folders
  rm -rf "$work" "$main_checkout"
  git init --quiet "$main_checkout"
  git -C "$main_checkout" commit --quiet --allow-empty -m Start
  git -C "$main_checkout" worktree add --quiet --detach "$work"
  mkdir -p "$main_checkout/.loop"
  state_lines owner-1 "$1" >"$main_checkout/.loop/state.md"
}
builder_note="Session owner-1 is this repository's orchestrator, and keeps the loop's state in $main_checkout/.loop/state.md."

# A builder that runs as a subagent has the orchestrator's pid, and its input can hold the orchestrator's session id.
new_worktree "$running_process"
echo '{"source": "compact", "session_id": "owner-1", "agent_id": "agent-7"}' >"$input_file"
run_session_start CLAUDE_PID="$running_process"
expect_output "After a compaction of a builder that runs as a subagent in a worktree" "$builder_note"
expect_output_without "After a compaction of a builder that runs as a subagent in a worktree" "$state_text"

new_worktree "$running_process"
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "After a compaction of a builder in a worktree, whose input has no agent_id" "$builder_note"
expect_output_without "After a compaction of a builder in a worktree, whose input has no agent_id" "$state_text"

new_state_file
echo '{"source": "compact", "session_id": "owner-1", "agent_id": "agent-7"}' >"$input_file"
run_session_start CLAUDE_PID="$running_process"
expect_output "After a compaction of a subagent whose hook runs in the main checkout" "$other_note"
expect_output_without "After a compaction of a subagent whose hook runs in the main checkout" "$state_text"

new_worktree "$running_process"
session_input startup builder-5
run_session_start CLAUDE_PID="$new_process"
expect_output "For a builder in a worktree with a process of its own, while the orchestrator's process runs" "$builder_note"
expect_output_without "For a builder in a worktree with a process of its own, while the orchestrator's process runs" \
  "$state_text"

new_worktree "$ended_process"
session_input startup builder-5
run_session_start CLAUDE_PID="$new_process"
expect_output "For a builder in a worktree with a process of its own, after the orchestrator's process ended" "$builder_note"
expect_output_without "For a builder in a worktree with a process of its own, after the orchestrator's process ended" \
  "$state_text"

new_state_file
rm -rf "$work/.git"
git init --quiet --separate-git-dir "$base/elsewhere.git" "$work"
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "With the git folder outside the repository, the state file is in the repository's folder" "$owner_note"

new_state_file
echo '{"source": "startup"}' >"$input_file"
run_session_start CLAUDE_PID="$running_process"
expect_output "With a state file, and no session id in the input" ""

new_state_file
session_input startup owner-1
run_session_start
expect_output "With a state file, and no CLAUDE_PID" ""
case_count=$((case_count + 1))
if ((hook_status != 0)); then
  echo "error: With a state file, and no CLAUDE_PID, the hook must exit with code 0, but it exited with code $hook_status." >&2
  failed_cases=$((failed_cases + 1))
fi

new_state_file
rm "$state_file"
session_input startup owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "Without a state file" ""

new_state_file
printf 'pid: %s\n\n%s\n' "$running_process" "$state_text" >"$state_file"
session_input startup someone-else
run_session_start CLAUDE_PID="$new_process"
expect_output "For another session, with a state file that has no session line" ""

# A line of 40 characters of two bytes each, so that a cut by bytes alone could split a character
wide_line=$(printf 'é%.0s' $(seq 40))
wide_line_bytes=$(($(printf '%s\n' "$wide_line" | wc -c)))

# Writes a state file of a size in bytes: the orchestrator's lines, wide lines, and a last line of x's that ends with
# "last" and fills the size: long_state_file <bytes>
long_state_file() {
  local start start_bytes wide_lines filler line
  start="session: owner-1"$'\n'"pid: $running_process"$'\n'
  start_bytes=$(($(printf '%s' "$start" | wc -c)))
  # The last line takes at least the 5 bytes of "last" and its line break.
  wide_lines=$((($1 - start_bytes - 5) / wide_line_bytes))
  filler=$(($1 - start_bytes - 5 - wide_lines * wide_line_bytes))
  {
    printf '%s' "$start"
    for ((line = 0; line < wide_lines; line++)); do
      printf '%s\n' "$wide_line"
    done
    printf '%*s' "$filler" '' | tr ' ' x
    printf 'last\n'
  } >"$state_file"
}

# Claude Code keeps at most 10,000 characters of a hook's output. Checks that the output has at most 10,000 bytes, and
# so at most 10,000 characters: expect_output_fits <description>
expect_output_fits() {
  local description=$1 bytes
  case_count=$((case_count + 1))
  # The command substitution in run_session_start drops the line break at the end of the output.
  bytes=$(($(printf '%s\n' "$hook_output" | wc -c)))
  if ((bytes > 10000)); then
    echo "error: $description, the hook's output must have at most 10,000 bytes, but it has $bytes." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks how the hook's output ends: expect_output_end <description> <text>
expect_output_end() {
  local description=$1 text=$2
  case_count=$((case_count + 1))
  if [[ $hook_output != *"$text" ]]; then
    echo "error: $description, the hook's output must end with \"$text\", but it ends with \"${hook_output: -200}\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# The size of a state file that makes the output 10,000 bytes, after the orchestrator's note and a blank line
fitting_bytes=$((10000 - $(printf '%s\n\n' "$owner_note" | wc -c)))

new_state_file
long_state_file "$fitting_bytes"
session_input startup owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "With a state file that makes the output exactly 10,000 bytes" "$owner_note"$'\n\n'"$(<"$state_file")"
expect_output_without "With a state file that makes the output exactly 10,000 bytes" "$long_note"
expect_output_fits "With a state file that makes the output exactly 10,000 bytes"

long_state_file "$((fitting_bytes + 1))"
run_session_start CLAUDE_PID="$running_process"
expect_output "With a state file one byte too long" "$owner_note"$'\n'"$long_note"$'\n\n'"session: owner-1"
expect_output_end "With a state file one byte too long, the output ends with a whole line" $'\n'"$wide_line"
expect_output_fits "With a state file one byte too long"

long_state_file "$fitting_bytes"
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "After a compaction, with a state file that fits only without the note about the compaction" \
  "$compacted"$'\n'"$owner_note"$'\n'"$long_note"
expect_output_end "After a compaction, with a state file that fits only without the note about the compaction" \
  $'\n'"$wide_line"
expect_output_fits "After a compaction, with a state file that fits only without the note about the compaction"

new_state_file
printf 'session: owner-1\npid: %s\n%*s\nShip the importer.\n' "$running_process" 10000 '' >"$state_file"
session_input startup owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output_end "With a state file whose third line alone is too long, the output ends before it" \
  "$owner_note"$'\n'"$long_note"$'\n\n'"session: owner-1"$'\n'"pid: $running_process"
expect_output_fits "With a state file whose third line alone is too long"

finish_tests
