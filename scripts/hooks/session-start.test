#!/usr/bin/env bash
# Tests scripts/hooks/session-start, run from a stand-in working folder two levels below a stand-in home folder, and
# scripts/hooks/before-compact, which records for it what started a compaction.
# The cases assume that no CLAUDE.md, .claude/CLAUDE.md or CLAUDE.local.md exists above the system's temporary folder.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"

base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT
home=$base/home
above=$home/work
work=$above/repository

# A stand-in for gh, first on the PATH, that reports the version in TEST_GH_VERSION.
stand_in=$base/bin
mkdir -p "$stand_in"
# shellcheck disable=SC2016 # The stand-in reads TEST_GH_VERSION when it runs.
printf '#!/usr/bin/env bash\necho "gh version $TEST_GH_VERSION (2026-08-20)"\n' >"$stand_in/gh"
chmod +x "$stand_in/gh"
export TEST_GH_VERSION=2.98.0

# A stand-in for curl, first on the PATH, that records each call and then fails, so that an install fails without the network.
# A stand-in for uname reports Linux on x86-64, which scripts/install-check-tools needs before it calls curl.
# shellcheck disable=SC2016 # $1 is the stand-in's own argument.
printf '#!/usr/bin/env bash\ncase $1 in -s) echo Linux ;; -m) echo x86_64 ;; esac\n' >"$stand_in/uname"
chmod +x "$stand_in/uname"
curl_calls=$base/curl-calls
printf '#!/usr/bin/env bash\necho "curl $*" >>"%s"\nexit 1\n' "$curl_calls" >"$stand_in/curl"
chmod +x "$stand_in/curl"

# A folder whose PATH has bash and the stand-in gh, but no jq.
no_jq=$base/no-jq
mkdir -p "$no_jq"
ln -s "$(command -v bash)" "$no_jq/bash"
ln -s "$stand_in/gh" "$no_jq/gh"

# A folder whose PATH has bash and jq, but no gh.
no_gh=$base/no-gh
mkdir -p "$no_gh"
ln -s "$(command -v bash)" "$no_gh/bash"
ln -s "$(command -v jq)" "$no_gh/jq"

# The file that the hook reads on standard input, in place of the JSON that Claude Code sends it.
input_file=$base/input

# Gives each case a new home and working folder, with a repository that has an AGENTS.md,
# and the input that Claude Code sends when a session starts.
new_folders() {
  rm -rf "$home"
  mkdir -p "$work/.git"
  echo "# How to work in this repository" >"$work/AGENTS.md"
  echo '{"source": "startup"}' >"$input_file"
}

# Runs the hook in the working folder as Claude Code does on a person's machine, and sets hook_status and hook_output.
# Arguments such as CLAUDE_CODE_REMOTE=true set more variables: run_session_start [<name>=<value>...]
run_session_start() {
  hook_status=0
  hook_output=$(cd "$work" && env -u CLAUDE_CODE_REMOTE -u CLAUDE_ENV_FILE -u CLAUDE_PID -u LOOP_DIR HOME="$home" CLAUDECODE=1 \
    PATH="$stand_in:$PATH" "$@" "$hooks_folder/session-start" <"$input_file") || hook_status=$?
}

# Checks the hook's output: expect_output <description> <text the output holds, or "" for no output>
expect_output() {
  local description=$1 text=$2
  case_count=$((case_count + 1))
  if [[ -z $text && -n $hook_output ]]; then
    echo "error: $description, the hook must print nothing, but it printed: $hook_output" >&2
    failed_cases=$((failed_cases + 1))
  elif [[ -n $text && $hook_output != *"$text"* ]]; then
    echo "error: $description, the hook's note must hold \"$text\", but it printed: $hook_output" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks that the hook's output doesn't hold a text: expect_output_without <description> <text>
expect_output_without() {
  local description=$1 text=$2
  case_count=$((case_count + 1))
  if [[ $hook_output == *"$text"* ]]; then
    echo "error: $description, the hook must not print \"$text\", but it printed: $hook_output" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

hidden="Claude Code didn't load AGENTS.md"
compacted="This conversation was just compacted, so the guides that this session read from docs/ survive only in the summary. Read again each guide that \"Read the guides\" in AGENTS.md names for the work you're doing, and AGENTS.md itself if its text isn't in your context."

new_folders
echo '{"source": "compact"}' >"$input_file"
run_session_start
expect_output "After a compaction" "$compacted"

new_folders
echo '{"source": "compact"}' >"$input_file"
echo "Rules" >"$work/CLAUDE.md"
run_session_start
expect_output "After a compaction, with a CLAUDE.md in the working folder, the note about the compaction comes first" \
  "$compacted"$'\n'"$hidden"

for source in startup clear resume; do
  new_folders
  echo "{\"source\": \"$source\"}" >"$input_file"
  run_session_start
  expect_output "With the source $source" ""
done

new_folders
: >"$input_file"
run_session_start
expect_output "With no input" ""

new_folders
echo '{}' >"$input_file"
run_session_start
expect_output "With the input {}" ""

new_folders
echo 'source: compact' >"$input_file"
run_session_start
expect_output "With input that isn't JSON" ""

new_folders
echo '{"source": "compact"}' >"$input_file"
hook_output=$(cd "$work" && HOME=$home CLAUDECODE=1 PATH=$no_jq "$hooks_folder/session-start" <"$input_file")
expect_output_without "After a compaction, without jq" "$compacted"
expect_output "After a compaction, without jq" "The hooks in scripts/hooks need jq"

new_folders
echo '{"source": "compact"}' >"$input_file"
hook_output=$(cd "$work" && HOME=$home PATH=$stand_in:$PATH env -u CLAUDECODE "$hooks_folder/session-start" <"$input_file")
expect_output "After a compaction, without CLAUDECODE" ""

new_folders
run_session_start
expect_output "With no file that hides AGENTS.md" ""

new_folders
echo "Rules" >"$work/CLAUDE.md"
run_session_start
expect_output "With a CLAUDE.md in the working folder" "- $work/CLAUDE.md"
expect_output "With a CLAUDE.md in the working folder" "Read AGENTS.md before you do anything else"

new_folders
mkdir -p "$above/.claude"
echo "Rules" >"$above/.claude/CLAUDE.md"
run_session_start
expect_output "With a .claude/CLAUDE.md in the folder above" "- $above/.claude/CLAUDE.md"

new_folders
echo "Rules" >"$work/CLAUDE.local.md"
run_session_start
expect_output "With a CLAUDE.local.md in the working folder" "- $work/CLAUDE.local.md"

new_folders
mkdir -p "$home/.claude"
echo "Rules" >"$home/.claude/CLAUDE.md"
run_session_start
expect_output "With only ~/.claude/CLAUDE.md" ""

new_folders
printf 'Rules\n@AGENTS.md\n' >"$work/CLAUDE.md"
run_session_start
expect_output "With a CLAUDE.md next to AGENTS.md that imports it" ""

new_folders
printf 'Rules\n@AGENTS.md\n' >"$above/CLAUDE.md"
run_session_start
expect_output "With a CLAUDE.md above the repository whose @AGENTS.md line doesn't reach it" "- $above/CLAUDE.md"

new_folders
echo "Rules" >"$work/CLAUDE.md"
mkdir -p "$home/.claude"
echo '{"pluginConfigs": {"agents-md@builtin": {"options": {"instructionFiles": "claude-md-and-agents-md"}}}}' >"$home/.claude/settings.json"
run_session_start
expect_output "With Project instructions set to read both files" ""

new_folders
echo "Rules" >"$work/CLAUDE.md"
hook_output=$(cd "$work" && HOME=$home PATH=$stand_in:$PATH env -u CLAUDECODE "$hooks_folder/session-start" <"$input_file")
expect_output "Without CLAUDECODE" ""

new_folders
TEST_GH_VERSION=2.97.0
run_session_start
expect_output "With gh 2.97.0" "need gh 2.98 or later, and this machine has gh 2.97.0"
TEST_GH_VERSION="something else"
run_session_start
expect_output "With a gh whose version can't be read" ""
TEST_GH_VERSION=2.98.0

new_folders
hook_output=$(cd "$work" && HOME=$home CLAUDECODE=1 PATH=$no_gh "$hooks_folder/session-start" <"$input_file")
expect_output "Without gh" "need gh 2.98 or later, and gh isn't installed"

new_folders
echo "Rules" >"$work/CLAUDE.md"
mkdir -p "$home/.claude"
echo '{"pluginConfigs": {"agents-md@builtin": {"options": {"instructionFiles": "claude-md-and-agents-md"}}}}' >"$home/.claude/settings.json"
hook_output=$(cd "$work" && HOME=$home CLAUDECODE=1 PATH=$no_jq "$hooks_folder/session-start" <"$input_file")
expect_output "Without jq" "The hooks in scripts/hooks need jq"
expect_output "Without jq, which the hook needs to read the settings" "$hidden"

# In a Claude Code on the web session, the hook installs the check tools into a folder under the home folder,
# and puts that folder first on the PATH through CLAUDE_ENV_FILE.
tools_folder=$home/.check-tools
env_file=$base/env-file

# Checks that the stand-in curl was called or not, and what the env file holds: expect_install <description> <called or not called> <env file text>
expect_install() {
  local description=$1 curl=$2 env_text=$3 calls="" written=""
  case_count=$((case_count + 1))
  if [[ -f $curl_calls ]]; then
    calls=$(<"$curl_calls")
  fi
  if [[ -f $env_file ]]; then
    written=$(<"$env_file")
  fi
  if [[ $curl == "not called" && -n $calls ]]; then
    echo "error: $description, the hook must not call curl, but it called: $calls" >&2
    failed_cases=$((failed_cases + 1))
  elif [[ $curl == called && -z $calls ]]; then
    echo "error: $description, the hook must try to install the tools with curl, but it didn't call curl." >&2
    failed_cases=$((failed_cases + 1))
  elif [[ $written != "$env_text" ]]; then
    echo "error: $description, CLAUDE_ENV_FILE must hold \"$env_text\", but it holds \"$written\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

new_folders
rm -f "$curl_calls" "$env_file"
run_session_start CLAUDE_ENV_FILE="$env_file"
expect_install "Without CLAUDE_CODE_REMOTE" "not called" ""

new_folders
rm -f "$curl_calls" "$env_file"
mkdir -p "$tools_folder"
for tool in shellcheck actionlint zizmor; do
  printf '#!/usr/bin/env bash\n' >"$tools_folder/$tool"
  chmod +x "$tools_folder/$tool"
done
run_session_start CLAUDE_CODE_REMOTE=true CLAUDE_ENV_FILE="$env_file"
expect_install "With CLAUDE_CODE_REMOTE=true and the three tools in the folder" "not called" "export PATH=\"$tools_folder:\$PATH\""

new_folders
rm -f "$curl_calls" "$env_file"
run_session_start CLAUDE_CODE_REMOTE=true CLAUDE_ENV_FILE="$env_file"
case_count=$((case_count + 1))
if ((hook_status != 0)); then
  echo "error: With CLAUDE_CODE_REMOTE=true and an install that fails, the hook must exit with code 0, but it exited with code $hook_status." >&2
  failed_cases=$((failed_cases + 1))
fi
expect_output "With CLAUDE_CODE_REMOTE=true and an install that fails" "The check tools shellcheck, actionlint and zizmor are missing"
expect_install "With CLAUDE_CODE_REMOTE=true and an install that fails" called ""

# The orchestrator's state file. The hook asks git where the main checkout is, so these cases run in git repositories,
# with none of the person's git settings. The repository's folder name has characters of two bytes, so that the cases
# of a long state file check that the hook counts bytes, not characters.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=Tester GIT_AUTHOR_EMAIL=tester@example.com
export GIT_COMMITTER_NAME=Tester GIT_COMMITTER_EMAIL=tester@example.com
work=$above/dépôt
state_file=$work/.loop/state.md
state_text="Ship the importer."

# A process that runs, which is this test's own, and one that has ended
running_process=$$
true &
ended_process=$!
wait "$ended_process"
# The process of another session, or of the orchestrator after claude --resume, which differs from the other two
if ((running_process > ended_process)); then
  new_process=$((running_process + 1))
else
  new_process=$((ended_process + 1))
fi

# Prints a state file with a session line and a pid line: state_lines <session id> <process id>
state_lines() {
  printf '# Loop state\n\nsession: %s\npid: %s\n\n## Next\n%s\n' "$1" "$2" "$state_text"
}

# Gives each case a git repository whose state file names the session owner-1 and the process that runs.
new_state_file() {
  new_folders
  git init --quiet "$work"
  mkdir -p "$work/.loop"
  state_lines owner-1 "$running_process" >"$state_file"
}

# Writes the input that Claude Code sends when a session starts: session_input <source> <session id>
session_input() {
  printf '{"source": "%s", "session_id": "%s"}\n' "$1" "$2" >"$input_file"
}

# The note after a compaction of the orchestrator, when the hook shows it docs/loop.md and docs/writing.md
compacted_with_guides="This conversation was just compacted, so the guides that this session read from docs/ survive only in the summary. Read again each guide that \"Read the guides\" in AGENTS.md names for the work you're doing, other than docs/loop.md and docs/writing.md, which this hook shows you, and AGENTS.md itself if its text isn't in your context."
in_one_part="which this hook shows you in 1 part"
owner_note="You are this repository's orchestrator. Continue the loop from your state file, $state_file, $in_one_part."
other_note="Session owner-1 is this repository's orchestrator, and keeps the loop's state in $state_file."

# Prints the note for the orchestrator in a new session or process: new_lines_note <session id> <process id>
new_lines_note() {
  echo "You are this repository's orchestrator, in a new session or process. Write \"session: $1\" and \"pid: $2\" as the session and pid lines of your state file, $state_file. Then continue the loop from the file, $in_one_part."
}

# Prints the note for a session that can take over the loop: take_over_note <session id> <process id>
take_over_note() {
  echo "The Claude Code process of this repository's orchestrator has ended. If the maintainer asks you to continue its work, take over the loop: write \"session: $1\" and \"pid: $2\" as the session and pid lines of its state file, $state_file, and continue the loop from the file, $in_one_part."
}

# .claude/settings.json runs the hook once more for each part of the files that it shows, with the part's number.
part_hooks=$(sed -n 's/^part_hooks=\([0-9][0-9]*\)$/\1/p' "$hooks_folder/session-start")
if [[ -z $part_hooks ]]; then
  echo "error: scripts/hooks/session-start has no line part_hooks=<number>, so the cases can't tell how many parts .claude/settings.json runs it for. Restore the line, or change this test to read the number from its new place." >&2
  exit 1
fi

# Runs the hook in the working folder for each part at the same time, as Claude Code does, and as run_session_start
# runs it for the notes. Sets part_outputs to what it printed for each part, and part_count to the number of parts
# before the first that printed nothing: run_parts [<name>=<value>...]
run_parts() {
  local part output
  for ((part = 1; part <= part_hooks; part++)); do
    (cd "$work" && env -u CLAUDE_CODE_REMOTE -u CLAUDE_ENV_FILE -u CLAUDE_PID -u LOOP_DIR HOME="$home" CLAUDECODE=1 \
      PATH="$stand_in:$PATH" "$@" "$hooks_folder/session-start" "$part" <"$input_file" >"$base/part-$part" || true) &
  done
  wait
  part_outputs=()
  part_count=0
  for ((part = 1; part <= part_hooks; part++)); do
    output=$(<"$base/part-$part")
    part_outputs+=("$output")
    if [[ -n $output && $part_count == $((part - 1)) ]]; then
      part_count=$part
    fi
  done
}

# Prints the text of a file as the parts in part_outputs show it: the lines under each heading that names the file,
# joined into the line before after a heading that goes on from the middle of a line: shown_text <file's name>
# The names are paths in the repository, or the full path for a file outside it.
shown_text() {
  printf '%s\n' "${part_outputs[@]}" |
    awk -v name="$1" -v names="$1|.loop/state.md|docs/loop.md|docs/writing.md" '
      BEGIN { name_count = split(names, known, "|") }
      # Prints the file that a heading names, or nothing for another line, and sets joins to 1 when the line after
      # the heading goes on from the line before it.
      function heading(line,    i) {
        for (i = 1; i <= name_count; i++) {
          if (line == known[i] ":") { joins = 0; return known[i] }
          if (index(line, known[i] ", from line ") == 1 && line ~ /, from line [0-9]+:$/) { joins = 0; return known[i] }
          if (index(line, known[i] ", from the middle of line ") == 1 && line ~ /, from the middle of line [0-9]+:$/) {
            joins = 1
            return known[i]
          }
        }
        return ""
      }
      /^Part [0-9]+ of [0-9]+ of the files that scripts\/hooks\/session-start shows you\.$/ { next }
      { file = heading($0) }
      file != "" { current = file; next }
      current == name {
        if (started && !joins) printf "\n"
        printf "%s", $0
        started = 1
        joins = 0
      }
      END { if (started) printf "\n" }'
}

# Prints the problems of the parts in part_outputs, or nothing when they have none: that a part after part_count prints
# anything, that a part lacks the first line that numbers it among all the parts, and that a part has more than 10,000
# bytes, or bytes that aren't UTF-8. Claude Code keeps at most 10,000 characters of a hook's output, and a part's bytes
# are never fewer than its characters: part_problems <number of all the parts>
part_problems() {
  local all_parts=$1 index part bytes
  for ((index = 0; index < part_hooks; index++)); do
    part=${part_outputs[index]}
    if ((index >= part_count)); then
      if [[ -n $part ]]; then
        printf 'part %s, after the last part, printed "%s". ' "$((index + 1))" "${part:0:200}"
      fi
      continue
    fi
    if [[ ${part%%$'\n'*} != "Part $((index + 1)) of $all_parts of the files that scripts/hooks/session-start shows you." ]]; then
      printf 'part %s starts with "%s". ' "$((index + 1))" "${part%%$'\n'*}"
    fi
    # The command substitution in run_parts drops the line break at the end of the part.
    bytes=$(($(printf '%s\n' "$part" | LC_ALL=C wc -c)))
    if ((bytes > 10000)); then
      printf 'part %s has %s bytes. ' "$((index + 1))" "$bytes"
    fi
    # jq reads each byte that isn't part of a UTF-8 character as the character U+FFFD. With -R, jq 1.7.1 also damages
    # a character that crosses the end of a block it reads, so it reads the part with --rawfile.
    if [[ $(printf '%s\n' "$part" | jq -n -j --rawfile text /dev/stdin '$text') != "$part" ]]; then
      printf 'part %s has bytes that are not UTF-8. ' "$((index + 1))"
    fi
  done
}

# Checks that the parts show each named file whole and no other file, in parts that start with part 1, each with at
# most 10,000 bytes: expect_parts <description> <file's name>...
expect_parts() {
  local description=$1 name path problems known
  shift
  case_count=$((case_count + 1))
  problems=$(part_problems "$part_count")
  if ((part_count == 0)); then
    problems+="no part printed anything. "
  fi
  for name in "$@"; do
    path=$name
    if [[ $name != /* ]]; then
      path=$work/$name
    fi
    if [[ $(shown_text "$name") != "$(<"$path")" ]]; then
      problems+="the parts don't show $name as it is. "
    fi
  done
  for known in .loop/state.md docs/loop.md docs/writing.md; do
    if [[ " $* " != *" $known "* && -n $(shown_text "$known") ]]; then
      problems+="the parts show $known. "
    fi
  done
  if [[ -n $problems ]]; then
    echo "error: $description, the parts must show $* whole, and no other file, with at most 10,000 bytes in each part, but $problems" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks that no part prints anything: expect_no_parts <description>
expect_no_parts() {
  local description=$1 part
  case_count=$((case_count + 1))
  for part in "${part_outputs[@]}"; do
    if [[ -n $part ]]; then
      echo "error: $description, the hook must print no part of any file, but it printed: ${part:0:300}" >&2
      failed_cases=$((failed_cases + 1))
      return 0
    fi
  done
}

# Writes stand-ins for docs/loop.md and docs/writing.md, of a fixed size, so that the cases don't depend on the guides.
write_guides() {
  local line
  mkdir -p "$work/docs"
  for ((line = 1; line <= 150; line++)); do
    printf 'Step %s of the loop: %090d\n' "$line" 0
  done >"$work/docs/loop.md"
  for ((line = 1; line <= 30; line++)); do
    printf 'Rule %s of writing: %090d\n' "$line" 0
  done >"$work/docs/writing.md"
}

# A line of 40 characters of two bytes each, so that a cut by bytes alone could split a character
wide_line=$(printf 'é%.0s' $(seq 40))

# Writes a state file of more than two parts: the orchestrator's lines, wide lines, a line of 12,000 bytes, which is
# too long for one part, and a last line.
long_state_file() {
  local line
  {
    state_lines owner-1 "$running_process"
    for ((line = 0; line < 200; line++)); do
      printf '%s\n' "$wide_line"
    done
    printf 'é%.0s' $(seq 6000)
    printf '\nlast\n'
  } >"$state_file"
}

new_state_file
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "After a compaction of the orchestrator, the note on the state file follows the note about the compaction" \
  "$compacted"$'\n'"$owner_note"
run_parts CLAUDE_PID="$running_process"
expect_parts "After a compaction of the orchestrator, in a repository without docs/loop.md and docs/writing.md" \
  .loop/state.md

# docs/loop.md and docs/writing.md, after a compaction of the orchestrator
new_state_file
write_guides
long_state_file
session_input compact owner-1
run_parts CLAUDE_PID="$running_process"
expect_parts "After a compaction of the orchestrator" .loop/state.md docs/loop.md docs/writing.md
run_session_start CLAUDE_PID="$running_process"
expect_output "After a compaction of the orchestrator" "$compacted_with_guides"$'\n'"You are this repository's orchestrator. Continue the loop from your state file, $state_file, which this hook shows you, with docs/loop.md and docs/writing.md, in $part_count parts."
expect_output_without "After a compaction of the orchestrator" "This hook shows only"

state_lines new-2 "$running_process" >"$state_file"
session_input compact owner-1
run_parts CLAUDE_PID="$running_process"
expect_parts "After /clear and a compaction, before the orchestrator wrote both lines" \
  .loop/state.md docs/loop.md docs/writing.md

for source in startup resume clear; do
  new_state_file
  write_guides
  session_input "$source" owner-1
  run_parts CLAUDE_PID="$running_process"
  expect_parts "With the source $source, for the orchestrator" .loop/state.md
done

new_state_file
write_guides
state_lines owner-1 "$ended_process" >"$state_file"
session_input startup new-4
run_parts CLAUDE_PID="$new_process"
expect_parts "For a new session in the main checkout, after the orchestrator's process ended" .loop/state.md

# A state file that needs more parts than .claude/settings.json runs the hook for
new_state_file
{
  state_lines owner-1 "$running_process"
  for ((line = 1; line <= part_hooks * 100; line++)); do
    printf 'Entry %s: %0100d\n' "$line" 0
  done
} >"$state_file"
session_input startup owner-1
run_parts CLAUDE_PID="$running_process"
case_count=$((case_count + 1))
all_parts=$(sed -n "1s/^Part 1 of \([0-9]*\) of the files that .*/\1/p" <<<"${part_outputs[0]}")
problems=$(part_problems "$all_parts")
shown=$(shown_text .loop/state.md)
shown_lines=$(($(printf '%s\n' "$shown" | wc -l)))
if [[ -n $problems || $part_count != "$part_hooks" || $all_parts -le $part_hooks ||
  $shown != "$(head -n "$shown_lines" "$state_file")" ]]; then
  echo "error: With a state file too long for $part_hooks parts, the hook must print all $part_hooks parts, number them among more than $part_hooks, and show the file from its start, with at most 10,000 bytes in each part, but it printed $part_count parts, numbered among \"$all_parts\", that show the file's first $shown_lines lines${problems:+, and }$problems" >&2
  failed_cases=$((failed_cases + 1))
fi
run_session_start CLAUDE_PID="$running_process"
expect_output "With a state file too long for $part_hooks parts" "This hook shows only the first $part_hooks of the $all_parts parts. Read the rest from the files themselves, from line $((shown_lines + 1)) of .loop/state.md to the end of .loop/state.md."

# LOOP_DIR names another loop folder, which holds the state file.
new_state_file
other_loop=$home/other-loop
mkdir -p "$other_loop"
mv "$state_file" "$other_loop/state.md"
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process" LOOP_DIR="$other_loop"
expect_output "With LOOP_DIR, the note names the state file in its folder" \
  "You are this repository's orchestrator. Continue the loop from your state file, $other_loop/state.md, $in_one_part."
run_parts CLAUDE_PID="$running_process" LOOP_DIR="$other_loop"
expect_parts "With LOOP_DIR" "$other_loop/state.md"

# Before a compaction, Claude Code runs scripts/hooks/before-compact, with a trigger that is auto when Claude Code
# compacts on its own because the context filled, and manual after /compact.
behind_note="Claude Code compacted this conversation when the context filled, maybe in the middle of a step. So your state file may lack the steps you took after the time on its updated: line. Before you go on, check the file against the open pull requests, the issues assigned to you and the agents that scripts/loop/meter lists, and add to it what it lacks."

# Prints the input that Claude Code sends before a compaction: compact_input <trigger> <session id> [<agent id>]
compact_input() {
  jq -n --arg trigger "$1" --arg session_id "$2" --arg agent_id "${3:-}" --arg cwd "$work" \
    '{session_id: $session_id, cwd: $cwd, hook_event_name: "PreCompact", trigger: $trigger, custom_instructions: ""}
      + if $agent_id == "" then {} else {agent_id: $agent_id} end'
}

# Runs scripts/hooks/before-compact in the working folder as Claude Code does, and checks that it prints nothing and
# exits with code 0: run_before_compact <trigger> <session id> [<agent id>]
run_before_compact() {
  local status=0 output
  output=$(cd "$work" && env -u LOOP_DIR HOME="$home" CLAUDECODE=1 "$hooks_folder/before-compact" \
    <<<"$(compact_input "$@")" 2>&1) || status=$?
  case_count=$((case_count + 1))
  if ((status != 0)) || [[ -n $output ]]; then
    echo "error: Before a compaction of the session $2${3:+ and the agent $3}, with the trigger $1, scripts/hooks/before-compact must print nothing and exit with code 0, but it exited with code $status and printed: $output" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks that the hooks left no record of a compaction in the loop's folder: expect_no_records <description>
expect_no_records() {
  local records
  case_count=$((case_count + 1))
  records=$(ls -A "$work/.loop/compactions" 2>/dev/null) || true
  if [[ -n $records ]]; then
    echo "error: $1, the hooks must leave no record of a compaction, but $work/.loop/compactions holds: $records" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

new_state_file
run_before_compact auto owner-1
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "After an automatic compaction of the orchestrator" "$compacted"$'\n'"$owner_note"$'\n'"$behind_note"
expect_no_records "After an automatic compaction of the orchestrator"

new_state_file
run_before_compact manual owner-1
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "After a manual compaction of the orchestrator" "$compacted"$'\n'"$owner_note"
expect_output_without "After a manual compaction of the orchestrator" "$behind_note"
expect_no_records "After a manual compaction of the orchestrator"

new_state_file
run_before_compact auto new-2
session_input compact new-2
run_session_start CLAUDE_PID="$running_process"
expect_output "After /clear and an automatic compaction, before the orchestrator wrote both lines" \
  "$(new_lines_note new-2 "$running_process")"$'\n'"$behind_note"

# A subagent's input can hold the orchestrator's session id.
new_state_file
run_before_compact manual owner-1
run_before_compact auto owner-1 agent-7
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "After a manual compaction of the orchestrator, during which a subagent's compaction started" \
  "$owner_note"
expect_output_without "After a manual compaction of the orchestrator, during which a subagent's compaction started" \
  "$behind_note"

new_state_file
run_before_compact auto owner-1
echo '{"source": "compact", "session_id": "owner-1", "agent_id": "agent-7"}' >"$input_file"
run_session_start CLAUDE_PID="$running_process"
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "After an automatic compaction of the orchestrator, during which a subagent's compaction ended" \
  "$owner_note"$'\n'"$behind_note"

new_state_file
run_before_compact manual owner-1
run_before_compact auto someone-else
session_input compact someone-else
run_session_start CLAUDE_PID="$new_process"
expect_output "After an automatic compaction of another session" "$other_note"
expect_output_without "After an automatic compaction of another session" "$behind_note"
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "After a manual compaction of the orchestrator, during which another session's compaction started" \
  "$owner_note"
expect_output_without \
  "After a manual compaction of the orchestrator, during which another session's compaction started" "$behind_note"
expect_no_records "After the compactions of the orchestrator and another session"

new_state_file
mkdir -p "$work/.loop/compactions"
run_before_compact auto ../state.md
session_input compact ../state.md
run_session_start CLAUDE_PID="$new_process"
case_count=$((case_count + 1))
if [[ $(<"$state_file") != "$(state_lines owner-1 "$running_process")" ]]; then
  echo "error: After a compaction of the session ../state.md, the hooks must leave the state file as it was, but it holds: $(<"$state_file")" >&2
  failed_cases=$((failed_cases + 1))
fi

new_state_file
(cd "$work" && env -u CLAUDECODE -u LOOP_DIR HOME="$home" "$hooks_folder/before-compact" <<<"$(compact_input auto owner-1)") ||
  true
expect_no_records "Before a compaction, without CLAUDECODE"

new_state_file
rm "$state_file"
run_before_compact auto owner-1
expect_no_records "Before a compaction, without a state file"

# A record that is empty, or that the hook can't read, doesn't say that Claude Code started the compaction.
for record_kind in empty unreadable; do
  new_state_file
  mkdir -p "$work/.loop/compactions"
  record=$work/.loop/compactions/owner-1
  if [[ $record_kind == empty ]]; then
    : >"$record"
  else
    echo auto >"$record"
    chmod 0 "$record"
  fi
  session_input compact owner-1
  run_session_start CLAUDE_PID="$running_process"
  expect_output "After a compaction of the orchestrator, with an $record_kind record" "$compacted"$'\n'"$owner_note"
  expect_output_without "After a compaction of the orchestrator, with an $record_kind record" "$behind_note"
  expect_no_records "After a compaction of the orchestrator, with an $record_kind record"
done

# The orchestrator asks the maintainer's compaction sender for a compaction with a request, which names its session on
# the first line: write_request <loop folder> <session id>
write_request() {
  printf '%s\nResume from .loop/state.md.\n' "$2" >"$1/compact-request.txt"
}

# Checks whether the hook left the request in place: expect_request <description> <loop folder> <kept|deleted>
expect_request() {
  local found=deleted
  case_count=$((case_count + 1))
  if [[ -f $2/compact-request.txt ]]; then
    found=kept
  fi
  if [[ $found != "$3" ]]; then
    echo "error: $1, the hook must have $3 the compaction request, but it $found it" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

new_state_file
write_request "$work/.loop" owner-1
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_request "After a compaction of the orchestrator, which asked for it" "$work/.loop" deleted

new_state_file
write_request "$work/.loop" someone-else
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_request "After a compaction of the orchestrator, with a request of another session" "$work/.loop" kept

new_state_file
write_request "$work/.loop" owner-1
session_input clear owner-1
run_session_start CLAUDE_PID="$running_process"
expect_request "After /clear in the orchestrator, which asked for a compaction" "$work/.loop" kept

new_state_file
write_request "$work/.loop" owner-1
echo '{"source": "compact", "session_id": "owner-1", "agent_id": "agent-7"}' >"$input_file"
run_session_start CLAUDE_PID="$running_process"
expect_request "After a compaction of a subagent of the orchestrator, which asked for one" "$work/.loop" kept

# The parts that the hook prints for a part's number don't touch the record or the request, because Claude Code runs
# them at the same time as the hook's notes, which read both.
new_state_file
run_before_compact auto owner-1
write_request "$work/.loop" owner-1
session_input compact owner-1
run_parts CLAUDE_PID="$running_process"
expect_request "After a compaction of the orchestrator, once the hook printed the parts" "$work/.loop" kept
run_session_start CLAUDE_PID="$running_process"
expect_output "After an automatic compaction of the orchestrator, once the hook printed the parts" \
  "$owner_note"$'\n'"$behind_note"

new_state_file
session_input clear new-2
run_session_start CLAUDE_PID="$running_process"
expect_output "After /clear in the orchestrator's process" "$(new_lines_note new-2 "$running_process")"
state_lines new-2 "$running_process" >"$state_file"
session_input compact new-2
run_session_start CLAUDE_PID="$running_process"
expect_output "After /clear and a compaction, once the orchestrator wrote both lines" "$owner_note"

new_state_file
state_lines owner-1 "$ended_process" >"$state_file"
session_input resume owner-1
run_session_start CLAUDE_PID="$new_process"
expect_output "After claude --resume starts the orchestrator in a new process" "$(new_lines_note owner-1 "$new_process")"
state_lines owner-1 "$new_process" >"$state_file"
session_input clear new-3
run_session_start CLAUDE_PID="$new_process"
expect_output "After /clear in the resumed orchestrator, once it wrote both lines" "$(new_lines_note new-3 "$new_process")"

new_state_file
state_lines owner-1 "$ended_process" >"$state_file"
session_input startup new-4
run_session_start CLAUDE_PID="$new_process"
expect_output "For a new session in the main checkout, after the orchestrator's process ended" \
  "$(take_over_note new-4 "$new_process")"

# A pid line that holds no positive number names no process that runs.
for pid_line in "pid: 0" "pid: -1" "pid: none" ""; do
  new_state_file
  printf 'session: owner-1\n%s\n\n%s\n' "$pid_line" "$state_text" >"$state_file"
  session_input startup new-4
  run_session_start CLAUDE_PID="$new_process"
  expect_output "For a new session in the main checkout, with \"$pid_line\" in place of the pid line" \
    "$(take_over_note new-4 "$new_process")"
done

for source in startup resume clear compact; do
  new_state_file
  write_guides
  session_input "$source" someone-else
  run_session_start CLAUDE_PID="$new_process"
  expect_output "With the source $source, for another session while the orchestrator's process runs" "$other_note"
  run_parts CLAUDE_PID="$new_process"
  expect_no_parts "With the source $source, for another session while the orchestrator's process runs"
done

for source in resume clear compact; do
  new_state_file
  write_guides
  state_lines owner-1 "$ended_process" >"$state_file"
  session_input "$source" someone-else
  run_session_start CLAUDE_PID="$new_process"
  expect_output "With the source $source, for another session after the orchestrator's process ended" "$other_note"
  run_parts CLAUDE_PID="$new_process"
  expect_no_parts "With the source $source, for another session after the orchestrator's process ended"
done

# Makes the working folder a worktree of a main checkout elsewhere, whose state file names the session owner-1 and a
# process: new_worktree <process id>
main_checkout=$base/main
new_worktree() {
  new_folders
  rm -rf "$work" "$main_checkout"
  git init --quiet "$main_checkout"
  git -C "$main_checkout" commit --quiet --allow-empty -m Start
  git -C "$main_checkout" worktree add --quiet --detach "$work"
  mkdir -p "$main_checkout/.loop"
  state_lines owner-1 "$1" >"$main_checkout/.loop/state.md"
  write_guides
}
builder_note="Session owner-1 is this repository's orchestrator, and keeps the loop's state in $main_checkout/.loop/state.md."

# A builder that runs as a subagent has the orchestrator's pid, and its input can hold the orchestrator's session id.
new_worktree "$running_process"
echo '{"source": "compact", "session_id": "owner-1", "agent_id": "agent-7"}' >"$input_file"
run_session_start CLAUDE_PID="$running_process"
expect_output "After a compaction of a builder that runs as a subagent in a worktree" "$builder_note"
run_parts CLAUDE_PID="$running_process"
expect_no_parts "After a compaction of a builder that runs as a subagent in a worktree"

new_worktree "$running_process"
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_output "After a compaction of a builder in a worktree, whose input has no agent_id" "$builder_note"
run_parts CLAUDE_PID="$running_process"
expect_no_parts "After a compaction of a builder in a worktree, whose input has no agent_id"

new_worktree "$running_process"
write_request "$main_checkout/.loop" owner-1
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
expect_request "After a compaction of a builder in a worktree, whose input has no agent_id" "$main_checkout/.loop" kept

# Runs a function of these cases with another working folder: in_folder <folder> <function> [<argument>...]
in_folder() {
  local saved_work=$work
  work=$1
  shift
  "$@"
  work=$saved_work
}
main_owner_note="You are this repository's orchestrator. Continue the loop from your state file, $main_checkout/.loop/state.md, $in_one_part."

# The orchestrator works in the main checkout, and its subagent in a worktree, with the orchestrator's session id and no
# agent_id in its input.
new_worktree "$running_process"
in_folder "$main_checkout" run_before_compact manual owner-1
run_before_compact auto owner-1
session_input compact owner-1
in_folder "$main_checkout" run_session_start CLAUDE_PID="$running_process"
expect_output "After a manual compaction of the orchestrator, during which its subagent in a worktree started one" \
  "$main_owner_note"
expect_output_without "After a manual compaction of the orchestrator, during which its subagent in a worktree started one" \
  "$behind_note"
in_folder "$main_checkout" expect_no_records \
  "After a manual compaction of the orchestrator, during which its subagent in a worktree started one"

new_worktree "$running_process"
in_folder "$main_checkout" run_before_compact auto owner-1
session_input compact owner-1
run_session_start CLAUDE_PID="$running_process"
in_folder "$main_checkout" run_session_start CLAUDE_PID="$running_process"
expect_output "After an automatic compaction of the orchestrator, during which its subagent in a worktree ended one" \
  "$main_owner_note"$'\n'"$behind_note"
in_folder "$main_checkout" expect_no_records \
  "After an automatic compaction of the orchestrator, during which its subagent in a worktree ended one"

new_state_file
write_guides
echo '{"source": "compact", "session_id": "owner-1", "agent_id": "agent-7"}' >"$input_file"
run_session_start CLAUDE_PID="$running_process"
expect_output "After a compaction of a subagent whose hook runs in the main checkout" "$other_note"
run_parts CLAUDE_PID="$running_process"
expect_no_parts "After a compaction of a subagent whose hook runs in the main checkout"

new_worktree "$running_process"
