#!/usr/bin/env bash
# Claude Code runs this hook after each tool call, because .claude/settings.json lists it. It tells the orchestrator,
# and the builders, auditors, reviewers and researchers that it starts, to shrink their context once it grows past a
# threshold, because each call reads the whole context again, so a long context costs more on every step, and the agent
# works worse.
# The orchestrator is the session that the session: line of the state file names. Once its context passes
# compact_tokens, it asks for a compaction, as "Compact your context" in docs/loop.md describes. It gets the note once
# each time its context passes the threshold: the hook creates .loop/told-to-compact when it gives the note, and deletes
# the file once the context is below the threshold again, as after a compaction. Until the note, the hook refuses the
# orchestrator's request for a compaction: it deletes the request while the context is at or below compact_tokens,
# because the note comes at the first tool call past that size. While the request is more than late_request_minutes
# old, the hook tells the orchestrator that the compaction hasn't come, with what the maintainer's compaction sender
# says in .loop/compact-waiting.txt that it waits for. It sets the request's time to now when it tells, so that it
# tells again only after late_request_minutes more.
# A builder, an auditor, a reviewer or a researcher hands off its work: once its context first passes soon_tokens, at
# its next stopping point, and once it first passes now_tokens, after the step it's on. These are the subagents of
# those types that the orchestrator's session starts itself, and the agents that scripts/loop/run-builder starts,
# which have their type in LOOP_HAND_OFF. Each type gets the steps of its own hand-off. Other agents, and the
# maintainer's other sessions, get no note, because the notes' steps are those of the orchestrator and these types.
# Each note comes once to each agent. For each note, the hook creates a file in .loop/hand-offs, named
# <agent>.<threshold>, where <agent> is a subagent's agent id or a session's id. scripts/loop/meter reads them.
# The files are in the .loop of the main checkout. When the hook can't create a note's file, the note says so. The hook
# says nothing when it can't tell the context's size, such as when it can't find the agent's transcript, or after a
# compaction until the agent's next reply.

compact_tokens=300000
soon_tokens=400000
now_tokens=500000
late_request_minutes=10
# The latest reply is near the end of the transcript, followed only by the results of its tool calls.
transcript_tail_bytes=400000

# shellcheck source=scripts/loop-folder
source "${BASH_SOURCE[0]%/*}/../loop-folder" || exit 0

fields=$(jq -r '.agent_id // "", .agent_type // "", .session_id // "", .transcript_path // ""' 2>/dev/null) || exit 0
{
  IFS= read -r agent_id
  IFS= read -r agent_type
  IFS= read -r session_id
  IFS= read -r transcript
} <<<"$fields"

find_loop_folder() {
  local git_folders
  git_folders=$(git -C "${BASH_SOURCE[0]%/*}" rev-parse --path-format=absolute --git-common-dir --show-toplevel 2>/dev/null) ||
    return 1
  loop_folder "${git_folders%%$'\n'*}" "${git_folders#*$'\n'}"
}

# Prints the size of the context that the latest call of a transcript read, or nothing if it can't tell:
# context_size <transcript>
# The size is the call's input tokens, cached or not. The transcript gives most replies the output tokens from the
# start of their stream, so the size leaves them out. Claude Code marks each compaction with an entry of the subtype
# compact_boundary, and the replies before it read the context from before the compaction, so after such an entry, the
# hook can't tell the size until the next reply.
context_size() {
  if [[ ! -f $1 ]]; then
    return 0
  fi
  tail -c "$transcript_tail_bytes" "$1" | grep -F -e '"usage"' -e '"compact_boundary"' | jq -R -n '
    reduce (inputs | fromjson?) as $entry (null;
      if $entry.type == "system" and $entry.subtype == "compact_boundary" then null
      elif $entry.type == "assistant" then ($entry.message.usage? // .)
      else . end)
    | select(.)
    | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)' 2>/dev/null
}

# Creates the file of a note, and fails if it exists already. With noclobber, the redirection fails when the file
# exists, so of two calls that end at the same time, only one gives the note. When the hook can't create the file, it
# gives the note, and adds the file to unwritten: claim_note <file>
unwritten=""
claim_note() {
  if (set -o noclobber && : >"$1") 2>/dev/null; then
    return 0
  fi
  if [[ -e $1 ]]; then
    return 1
  fi
  unwritten+=" $1"
}

# Tells the agent something, in the form that Claude Code adds to its context: tell <message>
tell() {
  jq -n --arg message "$1" '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $message}}'
}

# Deletes the orchestrator's request for a compaction, and prints why: refuse_request <request> <context size>
refuse_request() {
  local why="because your context is $(($2 / 1000))k tokens. Go on with the loop, and ask for a compaction only after the hook tells you that your context has passed $((compact_tokens / 1000))k tokens."
  if rm -f "$1" 2>/dev/null; then
    echo "scripts/hooks/hand-off deleted your request for a compaction, $1, $why"
  else
    echo "scripts/hooks/hand-off refuses your request for a compaction, $1, $why It couldn't delete the file, so delete it."
  fi
}

# Prints that the orchestrator's request for a compaction hasn't come, if the request is more than
# late_request_minutes old, and sets the request's time to now: tell_late_request <request> <loop folder>
tell_late_request() {
  local waiting message
  if [[ -z $(find "$1" -prune -mmin +"$late_request_minutes" 2>/dev/null) ]]; then
    return 0
  fi
  message="The compaction that you asked for in $1 hasn't come in $late_request_minutes minutes."
  if waiting=$(cat "$2/compact-waiting.txt" 2>/dev/null); then
    message+=" The compaction sender says that it waits for this: ${waiting%.}."
  fi
  # When the hook can't set the time, it tells the orchestrator again at each tool call.
  touch "$1" 2>/dev/null
  echo "$message Read your compaction sender's log, or ask the maintainer to check the sender or to type /compact."
}

# Tells the orchestrator to ask for a compaction, once each time its context passes compact_tokens, and refuses a
# request for one before then. Tells it when the compaction that it asked for hasn't come.
tell_orchestrator() {
  local loop size told request message=""
  loop=$(find_loop_folder) || return 0
  if ! is_orchestrators_session "$loop" "$session_id"; then
    return 0
  fi
  size=$(context_size "$transcript")
  if [[ ! $size =~ ^[0-9]+$ ]]; then
    return 0
  fi
  told=$loop/told-to-compact
  request=$loop/compact-request.txt
  if ((size <= compact_tokens)); then
    if [[ -e $told ]] && ! rm -f "$told" 2>/dev/null; then
      message="scripts/hooks/hand-off couldn't delete $told, so it won't tell you again when your context passes $((compact_tokens / 1000))k tokens. Delete the file."
    fi
    if [[ -e $request ]]; then
      message+="${message:+ }$(refuse_request "$request" "$size")"
    fi
    if [[ -n $message ]]; then
      tell "$message"
    fi
    return 0
  fi
  if ! claim_note "$told"; then
    message=$(tell_late_request "$request" "$loop")
    if [[ -n $message ]]; then
      tell "$message"
    fi
    return 0
  fi
  message="Your context has passed $((compact_tokens / 1000))k tokens. If the maintainer installed a compaction sender, ask for a compaction, as \"Compact your context\" in docs/loop.md describes: finish the step you're on, and bring your state file up to date. Then write $request with $session_id on its first line and \"Resume from .loop/state.md.\" on its second, and end your turn. Without a sender, ask the maintainer to type /compact, and go on with the loop."
  if [[ -n $unwritten ]]; then
    message+=" scripts/hooks/hand-off couldn't write${unwritten}, so it may give this note again."
  fi
  tell "$message"
}

# A subagent's input has an agent_id, and a session that scripts/loop/run-builder started has LOOP_HAND_OFF.
if [[ -z $agent_id && -z ${LOOP_HAND_OFF:-} ]]; then
  tell_orchestrator
  exit 0
fi
# A subagent of an agent that scripts/loop/run-builder started has LOOP_HAND_OFF too.
if [[ -n $agent_id && -n ${LOOP_HAND_OFF:-} ]]; then
  exit 0
fi
# The input of a session that scripts/loop/run-builder started has no type, so the session has it in LOOP_HAND_OFF.
if [[ -z $agent_id ]]; then
  agent_type=${LOOP_HAND_OFF:-}
fi
# The types in .claude/agents that hand off are auditor, builder, builder-<kind of issue>, reviewer and researcher.
case $agent_type in
  auditor | builder | builder-*)
    how="To hand off, push your branch. Then write a comment on your issue or pull request with what's done, what's left, the commands you ran and where their outputs are, and the open questions. End with a report that says that you handed off, with the comment's link."
    ;;
  reviewer)
    how="To hand off, end with a report that says that you handed off, with the errors that you have found so far, and the parts of the diff that you haven't read yet."
    ;;
  researcher)
    how="To hand off, write a comment on your issue with what you have found so far, what's left to find out, and the open questions. End with a report that says that you handed off, with the comment's link."
    ;;
  *) exit 0 ;;
esac
# A subagent's hook gets the transcript of its session, and the subagent's own is in a folder next to it.
agent=${agent_id:-$session_id}
if [[ -n $agent_id ]]; then
  transcript=${transcript%.jsonl}/subagents/agent-$agent_id.jsonl
fi
# The agent's id names a file below.
if [[ ! $agent =~ ^[A-Za-z0-9_-]+$ ]]; then
  exit 0
fi
size=$(context_size "$transcript")
if [[ ! $size =~ ^[0-9]+$ ]] || ((size <= soon_tokens)); then
  exit 0
fi

loop=$(find_loop_folder) || exit 0
if [[ -n $agent_id ]]; then
  if ! is_orchestrators_session "$loop" "$session_id"; then
    exit 0
  fi
  # Claude Code writes the depth at which the agent started next to its transcript: 1 for an agent that the session
  # started itself, and 2 for one that its agent started.
  depth=$(jq -r '.spawnDepth // empty' "${transcript%.jsonl}.meta.json" 2>/dev/null)
  if [[ $depth != 1 ]]; then
    exit 0
  fi
fi
notes=$loop/hand-offs
mkdir -p "$notes" 2>/dev/null

note=""
if ((size > now_tokens)); then
  # The note to hand off at the next stopping point would come too late after this one.
  claim_note "$notes/$agent.$soon_tokens" || true
  if claim_note "$notes/$agent.$now_tokens"; then
    note="Your context has passed $((now_tokens / 1000))k tokens. Hand off your work as soon as the step you're on ends, so that a fresh agent continues it. $how"
  fi
elif claim_note "$notes/$agent.$soon_tokens"; then
  note="Your context has passed $((soon_tokens / 1000))k tokens. Hand off your work at your next stopping point, so that a fresh agent continues it. $how"
fi
if [[ -n $note && -n $unwritten ]]; then
  note+=" scripts/hooks/hand-off couldn't write${unwritten}, so it may give this note again, and scripts/loop/meter doesn't show it. List this in your report for the orchestrator."
fi
if [[ -n $note ]]; then
  tell "$note"
fi
exit 0
