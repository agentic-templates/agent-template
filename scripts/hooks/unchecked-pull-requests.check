#!/usr/bin/env bash
# Blocks opening a pull request with gh pr create, or its alias gh pr new, until scripts/check has passed on the
# pull request's files, because a pull request that fails in CI costs a round trip.
# scripts/check records the tree of the files it passed on, as check-passed.bash describes. This check compares that
# record with the tree of the pull request's latest commit, as find_head_commit in helpers.bash finds it, in the folder
# that gh runs in: the folder the agent works in, or the one that a cd before gh changes to, as follow_cd in
# helpers.bash finds it. While that commit is HEAD, as is_pull_request_at_head in helpers.bash finds it, the check also
# blocks the command when tracked files have changes that aren't committed, because a commit before gh in the same
# command would add them to the pull request.
# It allows the command when it has nothing to compare: outside a git repository, before the first commit, when this
# repository has no branch that --head names, and after a cd to a folder that it can't tell.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"
# shellcheck source=scripts/hooks/check-passed.bash
source "${BASH_SOURCE[0]%/*}/check-passed.bash"

not_checked="Blocked: scripts/check hasn't passed on these files. Run it, fix what it reports, and open the pull request again."
not_committed="Blocked: tracked files have changes that aren't committed, so this hook can't tell which files the pull request holds. Commit them first, and then run gh pr create in a command of its own."

check_gh_pr_create() {
  local head_tree disk_tree record
  if ! opens_pull_request; then
    return 0
  fi
  if [[ -z $command_folder ]] || ! cd -- "$command_folder" 2>/dev/null; then
    return 0
  fi
  head_tree=$(git rev-parse --verify --quiet 'HEAD^{tree}') || return 0
  find_head_commit || return 0

  # git's warnings, such as about line endings, would end up in the message, so they're left out.
  if is_pull_request_at_head && disk_tree=$(tree_on_disk 2>/dev/null) && [[ $disk_tree != "$head_tree" ]]; then
    block "$not_committed"
  fi
  record=$(pass_record_path)
  if [[ ! -f $record || $(< "$record") != "$(git rev-parse "$head_commit^{tree}")" ]]; then
    block "$not_checked"
  fi
}

check_simple_command() {
  drop_command_prefixes "$@"
  move_gh_repository_flags
  if ((${#command_words[@]} == 0)); then
    return 0
  fi
  check_gh_pr_create
  follow_cd
}

read_input
if [[ $tool_name == Bash ]]; then
  # The folder that gh runs in, as follow_cd in helpers.bash describes.
  command_folder=${cwd:-$PWD}
  for_each_simple_command check_simple_command "$shell_command"
fi
