#!/usr/bin/env bash
# Blocks opening a pull request with gh pr create, or its alias gh pr new, when it adds or rewrites text in README.md or
# in a Markdown page anywhere in docs/, and no fresh reader has read that page as the pull request has it, because
# "Review a changed page with a fresh reader" in docs/pages.md asks for one. A pull request that only deletes a page's
# lines or renames the page needs no reader.
# scripts/fresh-reader records git's hash of each page that it gives a reader, as pages-read.bash describes, and this
# check looks up the hash that each such page has in the pull request's latest commit. The pull request's commits are
# those that find_commits in helpers.bash finds, in the folder that gh runs in, as follow_cd in helpers.bash finds it.
# The check allows the command when it can't find them, and when claude isn't installed, because scripts/fresh-reader
# runs claude, and docs/pages.md has the agent give the page to another reader then.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"
# shellcheck source=scripts/hooks/pages-read.bash
source "${BASH_SOURCE[0]%/*}/pages-read.bash"

# Prints each page that the pull request adds or rewrites lines in, and that no reader has read as the pull request has
# it, one to a line. Run find_commits first.
unread_pages() {
  local record entry added path hash
  record=$(pages_read_path)
  # With -z, git prints a renamed page's counts with an empty path, and then its old path and its new path. A binary
  # file's counts are -.
  git diff --numstat -z --find-renames --no-relative "$base_commit...$head_commit" -- \
    ':(top)README.md' ':(top)docs/*.md' | while IFS= read -r -d '' entry; do
    IFS=$'\t' read -r added _ path <<<"$entry"
    if [[ -z $path ]]; then
      IFS= read -r -d '' _
      IFS= read -r -d '' path
    fi
    if [[ $added == 0 || $added == - ]]; then
      continue
    fi
    hash=$(git rev-parse "$head_commit:$path")
    if [[ ! -f $record ]] || ! grep -qxF -- "$hash" "$record"; then
      printf '%s\n' "$path"
    fi
  done
}

check_gh_pr_create() {
  local pages page commands=""
  if ! opens_pull_request || ! command -v claude >/dev/null; then
    return 0
  fi
  if [[ -z $command_folder ]] || ! cd -- "$command_folder" 2>/dev/null; then
    return 0
  fi
  if ! find_commits; then
    return 0
  fi
  pages=$(unread_pages)
  if [[ -z $pages ]]; then
    return 0
  fi
  while IFS= read -r page; do
    commands+="scripts/fresh-reader \"<reader>\" $page"$'\n'
  done <<<"$pages"
  block "Blocked: this pull request adds or rewrites text in pages that no fresh reader has read as the pull request has them. Give each page to a reader, as \"Review a changed page with a fresh reader\" in docs/pages.md describes:"$'\n'"${commands}If you change a page after the reader read it, run its command again. Then open the pull request again."
}

check_simple_command() {
  drop_command_prefixes "$@"
  move_gh_repository_flags
  if ((${#command_words[@]} == 0)); then
    return 0
  fi
  check_gh_pr_create
  follow_cd
}

read_input
if [[ $tool_name == Bash ]]; then
  # The folder that gh runs in, as follow_cd in helpers.bash describes.
  command_folder=${cwd:-$PWD}
  for_each_simple_command check_simple_command "$shell_command"
fi
