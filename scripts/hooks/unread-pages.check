#!/usr/bin/env bash
# Blocks opening a pull request with gh pr create, or its alias gh pr new, when it adds or rewrites text in README.md or
# in a Markdown page anywhere in docs/, and no fresh reader has read that page as it is now, because "Review a changed
# page with a fresh reader" in docs/pages.md asks for one. A pull request that only deletes a page's lines or renames
# the page needs no reader. Once the pull request is open, the check blocks a git push to its branch in the same way,
# for each page that the push adds a line to that the page lacks where the branch starts from the pull request's base
# branch. So a page needs no reader when a merge of the base branch, or a rebase onto it, only brings in the base
# branch's lines.
# scripts/fresh-reader records git's hash of each page that it gives a reader, as pages-read.bash describes, and this
# check looks up the hash of each such page. The pull request's commits are those that find_commits in helpers.bash
# finds, in the folder that gh runs in, as follow_cd in helpers.bash finds it. A push's commits are those after the
# commit of the branch on origin, as the repository last fetched or pushed it. When the pull request's latest commit is
# HEAD, the pages on disk count, because the check runs before the whole command, and a command such as
# git commit -am ... && gh pr create commits them first. The check also blocks while a page has changes that aren't
# committed, because it can't tell then which text the pull request holds.
# The check allows the command when it can't find the pull request's commits, and when claude isn't installed, because
# scripts/fresh-reader runs claude, and docs/pages.md has the agent give the page to another reader then. It allows a
# push that sends no pages to the branches on origin: one to another remote, with --delete or --dry-run, alone or in a
# group of short options such as -nu, or with --tags and no refspec, which sends only the tags. It also
# allows a push whose branches or repository the command doesn't name: one with --all, --branches or --mirror, or with
# --git-dir or --work-tree before push.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"
# shellcheck source=scripts/hooks/pages-read.bash
source "${BASH_SOURCE[0]%/*}/pages-read.bash"

# The pages that need a reader when a pull request adds or rewrites text in them
page_paths=(':(top)README.md' ':(top)docs/*.md')

# Sets pages_commit to head_commit, the pull request's latest commit, or to empty when that commit is HEAD and the
# pages on disk count. Changes to the repository's top folder, from which git hash-object reads the pages.
find_pages_commit() {
  local top
  pages_commit=$head_commit
  if is_pull_request_at_head; then
    pages_commit=""
  fi
  top=$(git rev-parse --show-toplevel) || return 1
  cd -- "$top"
}

# Prints each page that has lines that a commit doesn't have, one to a line: pages_with_new_text <commit>
pages_with_new_text() {
  local entry added path
  # With -z, git prints a renamed page's counts with an empty path, and then its old path and its new path. A binary
  # file's counts are -. Without a second commit, git compares the first one with the files on disk.
  git diff --numstat -z --find-renames --no-relative "$1" ${pages_commit:+"$pages_commit"} -- \
    "${page_paths[@]}" | while IFS= read -r -d '' entry; do
    IFS=$'\t' read -r added _ path <<<"$entry"
    if [[ -z $path ]]; then
      IFS= read -r -d '' _
      IFS= read -r -d '' path
    fi
    if [[ $added != 0 && $added != - ]]; then
      printf '%s\n' "$path"
    fi
  done
}

# Prints the lines that a page has and a commit doesn't, one to a line: added_lines <commit> <path>
added_lines() {
  # With -U0, each hunk holds only the lines that it removes and adds, after the header that starts with @@.
  git diff --no-ext-diff --no-textconv --no-color --no-relative -U0 "$1" ${pages_commit:+"$pages_commit"} -- "$2" |
    awk '/^@@/ { in_hunk = 1; next } /^diff --git / { in_hunk = 0 } in_hunk && /^\+/ { print substr($0, 2) }'
}

# Prints each page on the input that has a line that a commit doesn't have and that the page lacks at the commit where
# the branch starts from the base branch, one to a line:
# pages_with_lines_not_at_branch_start <the commit where the branch starts> <commit>
# Such a line is one that the branch wrote, rather than one that a merge of the base branch, or a rebase onto it,
# brought in. The page counts as it is where the branch starts, not at the base branch's latest commit, because the base
# branch can rewrite a line after a merge brought it in.
pages_with_lines_not_at_branch_start() {
  local path lines
  while IFS= read -r path; do
    lines=$(added_lines "$2" "$path")
    # A page that the branch's start doesn't have lacks every line, and grep -v with no patterns prints every line.
    if [[ -n $lines ]] && grep -qvxF -f <(git cat-file blob "$1:$path" 2>/dev/null || true) <<<"$lines"; then
      printf '%s\n' "$path"
    fi
  done
}

# Prints git's hash of a page as the pull request has it: page_hash <path>
page_hash() {
  if [[ -z $pages_commit ]]; then
    git hash-object -- "$1"
  else
    git rev-parse "$pages_commit:$1"
  fi
}

# Prints each page on the input that no reader has read as it is now, one to a line.
unread_pages() {
  local record path
  record=$(pages_read_path)
  while IFS= read -r path; do
    if [[ ! -f $record ]] || ! grep -qxF -- "$(page_hash "$path")" "$record"; then
      printf '%s\n' "$path"
    fi
  done
}

# Prints each page that has changes that aren't committed, one to a line, when the pages on disk count.
uncommitted_pages() {
  if [[ -z $pages_commit ]]; then
    git -c core.quotePath=false diff --name-only --no-relative HEAD -- "${page_paths[@]}"
  fi
}

# Prints the message that blocks a command that gives a pull request pages that no reader has read:
# unread_message <what adds the text, such as: this pull request> <command> <pages, one to a line>
unread_message() {
  local page
  echo "Blocked: $1 adds or rewrites text in pages that no fresh reader has read as they are now. Give each page to a reader, as \"Review a changed page with a fresh reader\" in docs/pages.md describes:"
  while IFS= read -r page; do
    echo "scripts/fresh-reader \"<reader>\" $page"
  done <<<"$3"
  echo "If you change a page after the reader read it, run its command again. Then commit the pages, and run $2 in a command of its own."
}

# Prints the message that blocks a command while pages have changes that aren't committed:
# uncommitted_message <command> <pages, one to a line>
uncommitted_message() {
  echo "Blocked: these pages have changes that aren't committed, so this hook can't tell which text the pull request holds: ${2//$'\n'/, }. Commit them first, and then run $1 in a command of its own."
}

# Changes to command_folder, the folder that the command runs in, or fails when the hook can't tell it.
change_to_command_folder() {
  [[ -n $command_folder ]] && cd -- "$command_folder" 2>/dev/null
}

check_gh_pr_create() {
  local branch_start unread uncommitted
  if ! opens_pull_request || ! command -v claude >/dev/null || ! change_to_command_folder; then
    return 0
  fi
  if ! find_commits || ! branch_start=$(git merge-base "$base_commit" "$head_commit") || ! find_pages_commit; then
    return 0
  fi
  unread=$(pages_with_new_text "$branch_start" | unread_pages)
  if [[ -n $unread ]]; then
    block "$(unread_message "this pull request" "gh pr create" "$unread")"
  fi
  uncommitted=$(uncommitted_pages)
  if [[ -n $uncommitted ]]; then
    block "$(uncommitted_message "gh pr create" "$uncommitted")"
  fi
}

# Prints the number and the base branch of each open pull request on GitHub whose branch is the one given, one to a
# line, as in "12 main". A pull request from a fork whose branch has the same name doesn't count:
# open_pull_requests <branch>
open_pull_requests() {
  gh pr list --head "$1" --state open --json number,baseRefName,isCrossRepository \
    --jq '.[] | select(.isCrossRepository | not) | "\(.number) \(.baseRefName)"' 2>/dev/null
}

# Blocks a push that gives a branch on origin pages that no reader has read as the push leaves them, when the branch has
# an open pull request, and the push adds lines to those pages that they lack where the branch starts from the pull
# request's base branch: check_pushed_branch <the commit or branch that the push sends> <the branch on origin>
check_pushed_branch() {
  local origin_commit unread uncommitted pull_requests number base_branch branch_start written
  # The repository has a copy of the branch on origin once it has fetched or pushed the branch. Without one, the hook
  # can't tell which text the push adds.
  if ! head_commit=$(git rev-parse --verify --quiet "$1^{commit}") ||
    ! origin_commit=$(git rev-parse --verify --quiet "refs/remotes/origin/$2^{commit}") || ! find_pages_commit; then
    return 0
  fi
  unread=$(pages_with_new_text "$origin_commit" | unread_pages)
  uncommitted=$(uncommitted_pages)
  # Most pushes add no text to pages, or only text that a reader has read, so they need no question to GitHub.
  if [[ -z $unread && -z $uncommitted ]] || ! pull_requests=$(open_pull_requests "$2") || [[ -z $pull_requests ]]; then
    return 0
  fi
  while read -r number base_branch; do
    if ! find_base_commit "$base_branch" || ! branch_start=$(git merge-base "$base_commit" "$head_commit"); then
      continue
    fi
    written=""
    if [[ -n $unread ]]; then
      written=$(pages_with_lines_not_at_branch_start "$branch_start" "$origin_commit" <<<"$unread")
    fi
    if [[ -n $written ]]; then
      block "$(unread_message "this push to pull request #$number" "git push" "$written")"
    fi
    if [[ -n $uncommitted ]]; then
      block "$(uncommitted_message "git push" "$uncommitted")"
    fi
  done <<<"$pull_requests"
}

# Changes to the folder that the git command in command_words works in: command_folder, as each -C before the
# subcommand changes it. Fails when the hook can't tell the folder, as with --git-dir or --work-tree, which can give the
# command a repository other than the folder's. Run read_git_options first.
change_to_git_folder() {
  local i
  change_to_command_folder || return 1
  for ((i = 2; i < ${#git_folder[@]}; i += 2)); do
    if [[ ${git_folder[i]} != -C ]] || ! expand_home "${git_folder[i + 1]}" ||
      ! CDPATH='' cd -- "$expanded_path" 2>/dev/null; then
      return 1
    fi
  done
}

# Succeeds if git push gets one of these short options, alone or in a group such as -nu, as read_push_arguments found
# the flags: has_short_push_flag <letters>
has_short_push_flag() {
  local flag letters
  for flag in ${flags[@]+"${flags[@]}"}; do
    if [[ $flag == --* || $flag != -?* ]]; then
      continue
    fi
    # -o takes the rest of its word as its value, as in -oci.skip.
    letters=${flag#-}
    letters=${letters%%o*}
    if [[ $letters == *["$1"]* ]]; then
      return 0
    fi
  done
  return 1
}

# Succeeds if the check lets a git push through, as read_push_arguments read it, because the push sends no pages to the
# branches on origin, or the command doesn't name its branches, as the comment at the top of this file lists.
is_push_let_through() {
  if [[ -n $push_remote && $push_remote != origin ]] || has_short_push_flag dn ||
    has_git_flag --delete --dry-run --all --branches --mirror; then
    return 0
  fi
  # With --tags and no refspec, git pushes only the tags.
  if ((${#push_refspecs[@]} == 0)) && has_git_flag --tags; then
    return 0
  fi
  return 1
}

# Checks each branch that a git push updates, as read_push_branches in helpers.bash finds them, and as
# check_pushed_branch describes. A refspec that deletes its branch sends no pages.
check_git_push() {
  local i
  if [[ ${command_words[0]##*/} != git ]]; then
    return 0
  fi
  read_git_options
  if [[ ${command_words[git_subcommand]:-} != push ]] || ! command -v claude >/dev/null || ! change_to_git_folder; then
    return 0
  fi
  read_push_arguments
  if is_push_let_through; then
    return 0
  fi
  read_push_branches -C "$PWD"
  for ((i = 0; i < ${#push_branches[@]}; i++)); do
    if [[ -n ${push_sources[i]} ]]; then
      check_pushed_branch "${push_sources[i]}" "${push_branches[i]}"
    fi
  done
}

check_simple_command() {
  drop_command_prefixes "$@"
  move_gh_repository_flags
  if ((${#command_words[@]} == 0)); then
    return 0
  fi
  check_gh_pr_create
  check_git_push
  follow_cd
}

read_input
if [[ $tool_name == Bash ]]; then
  # The folder that gh and git run in, as follow_cd in helpers.bash describes.
  command_folder=${cwd:-$PWD}
  for_each_simple_command check_simple_command "$shell_command"
fi
