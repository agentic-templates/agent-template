#!/usr/bin/env bash
# Tests scripts/hooks/unchecked-pull-requests.check through scripts/hooks/before-tool.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"
# shellcheck source=scripts/hooks/check-passed.bash
source "$hooks_folder/check-passed.bash"

# The cases run in repositories in a temporary folder, and git looks for no repository above it.
# The repositories have no remote, so scripts/hooks/pull-request-rules.check allows each command that opens a pull
# request with a title and body that it can read.
base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT
export GIT_CEILING_DIRECTORIES=$base
# git reads none of the person's settings, such as one that signs each commit, and commits as a stand-in person.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=Tester GIT_AUTHOR_EMAIL=tester@example.com GIT_COMMITTER_NAME=Tester GIT_COMMITTER_EMAIL=tester@example.com
# A stand-in for gh that fails, first on the PATH, so that the cases don't depend on the gh on this machine.
# forbidden-commands.check asks gh for its version before each gh command, and allows the command when gh fails.
mkdir "$base/bin"
printf '#!/usr/bin/env bash\nexit 1\n' >"$base/bin/gh"
chmod +x "$base/bin/gh"
PATH=$base/bin:$PATH

not_checked="Blocked: scripts/check hasn't passed on these files. Run it, fix what it reports, and open the pull request again."
not_committed="Blocked: scripts/check passed on the files on disk, but some of their changes aren't committed. Commit them first, and then run gh pr create in a command of its own."

# Makes a folder the one that the agent works in. Cursor doesn't send that folder, so the hook uses its own,
# which is this script's: work_in <folder>
work_in() {
  test_cwd=$1
  cd "$1"
}

# Records a pass of scripts/check on the files as they are on disk now, as scripts/check does,
# for the repository or worktree in the current folder.
record_pass() {
  tree_on_disk >"$(pass_record_path)"
}

forget_pass() {
  rm -f "$(pass_record_path)"
}

# The cases for the repository or worktree in the current folder, which starts with notes.txt committed.
check_pull_requests() {
  forget_pass
  expect_block Bash 'gh pr create --title "Add notes" --body "Closes #1"' "$not_checked"
  expect_block Bash 'gh pr new --title "Add notes" --body "Closes #1"' "$not_checked"

  for subcommand in create new; do
    expect_repository_flags 2 "$not_checked" pr "$subcommand" '--title "Add notes" --body "Closes #1"'
  done

  # A pass on the files of HEAD. A file that git doesn't track doesn't count.
  echo "Scratch" >scratch.txt
  record_pass
  expect_allow Bash 'gh pr create --title "Add notes" --body "Closes #1"'
  expect_allow Bash 'gh pr new --title "Add notes" --body "Closes #1"'

  for subcommand in create new; do
    expect_repository_flags 0 "" pr "$subcommand" '--title "Add notes" --body "Closes #1"'
  done

  # A pass on changes that aren't committed: a change that isn't staged, and a new file that is
  echo "More notes" >>notes.txt
  echo "Plans" >plans.txt
  git add plans.txt
  record_pass
  expect_block Bash 'gh pr create --title "Add notes" --body "Closes #1"' "$not_committed"
  expect_block Bash 'git commit -am "Add plans" && gh pr create --title "Add notes" --body "Closes #1"' "$not_committed"

  # The same pass, once the changes are committed
  git commit --quiet -am "Add plans"
  expect_allow Bash 'gh pr create --title "Add notes" --body "Closes #1"'

  # A change committed after the pass
  echo "Even more notes" >>notes.txt
  git commit --quiet -am "Add more notes"
  expect_block Bash 'gh pr create --title "Add notes" --body "Closes #1"' "$not_checked"
}

# A repository with notes.txt committed on main and on the branch first, and a worktree on the branch work
repository=$base/repository
worktree=$base/worktree
git init --quiet --initial-branch=main "$repository"
work_in "$repository"
echo "Notes" >notes.txt
git add notes.txt
git commit --quiet -m "Add notes"
git branch first
git worktree add --quiet -b work "$worktree"

# In the worktree, which has a record of its own. A pass in the repository's folder doesn't count there,
# though the files are the same.
record_pass
work_in "$worktree"
check_pull_requests

work_in "$repository"
check_pull_requests

# In a folder inside the repository
mkdir "$repository/docs"
work_in "$repository/docs"
forget_pass
expect_block Bash 'gh pr create --title "Add notes" --body "Closes #1"' "$not_checked"
record_pass
expect_allow Bash 'gh pr create --title "Add notes" --body "Closes #1"'

# The branch that --head names, alone or after a person's name and a colon. The branch first has only the first commit.
work_in "$repository"
record_pass
expect_allow Bash 'gh pr create --head main --title "Add notes" --body "Closes #1"'
expect_allow Bash 'gh pr create --head=main --title "Add notes" --body "Closes #1"'
expect_allow Bash 'gh pr create -H jtmpl:main --title "Add notes" --body "Closes #1"'
expect_block Bash 'gh pr create --head first --title "Add notes" --body "Closes #1"' "$not_checked"
expect_block Bash 'gh pr create -H jtmpl:first --title "Add notes" --body "Closes #1"' "$not_checked"
# With no branch of that name here, the hook has nothing to compare.
expect_allow Bash 'gh pr create --head missing --title "Add notes" --body "Closes #1"'

# Commands that don't open a pull request, and flags whose values look like flags
forget_pass
expect_allow Bash 'gh pr create --help'
expect_allow Bash 'gh pr create -h'
expect_allow Bash 'gh pr create --fill --dry-run'
expect_allow Bash 'gh pr view 7'
expect_allow Bash 'echo gh pr create'
expect_block Bash 'gh pr create --title "--dry-run" --body "Notes"' "$not_checked"
expect_block Bash 'GH_DEBUG=1 gh pr create --title "Add notes" --body "Closes #1"' "$not_checked"

# Outside a git repository, and before a repository's first commit, the hook has nothing to compare.
mkdir "$base/outside"
work_in "$base/outside"
expect_allow Bash 'gh pr create --title "Add notes" --body "Closes #1"'
git init --quiet --initial-branch=main "$base/empty"
work_in "$base/empty"
expect_allow Bash 'gh pr create --title "Add notes" --body "Closes #1"'

finish_tests
