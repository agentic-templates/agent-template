#!/usr/bin/env bash
# Tests scripts/hooks/unpublished-advisories.check through scripts/hooks/before-tool.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"

# The agent works in a project in a temporary home folder.
folders=$(CDPATH='' cd -- "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$folders"' EXIT
test_home=$folders/home
test_cwd=$test_home/project
mkdir -p "$test_cwd" "$folders/bin" "$folders/advisories"

# A stand-in for gh, first on the PATH. It answers a request for a security advisory of this repository with the file
# in TEST_ADVISORIES named for the advisory's GHSA ID, as GitHub would send it, through the request's --jq filter. For
# an advisory without a file, it answers as GitHub does for an advisory that the repository doesn't have. It fails with
# the error in TEST_GH_ERROR, when the case sets it, and on every other command, as gh does without a network, so the
# other checks ask nothing of GitHub.
cat >"$folders/bin/gh" <<'STAND_IN'
#!/usr/bin/env bash
if [[ -n ${TEST_GH_ERROR:-} ]]; then
  echo "$TEST_GH_ERROR" >&2
  exit 1
fi
if (($# != 4)) || [[ $1 != api || $2 != "repos/{owner}/{repo}/security-advisories/"* || $3 != --jq ]]; then
  exit 1
fi
advisory=$TEST_ADVISORIES/${2##*/}.json
if [[ ! -f $advisory ]]; then
  printf '%s' '{"message":"Not Found","documentation_url":"https://docs.github.com/rest/security-advisories/repository-advisories#get-a-repository-security-advisory","status":"404"}'
  echo "gh: Not Found (HTTP 404)" >&2
  exit 1
fi
jq -r "$4" "$advisory"
STAND_IN
chmod +x "$folders/bin/gh"
PATH=$folders/bin:$PATH
export TEST_ADVISORIES=$folders/advisories

# Writes an advisory of the repository jtmpl/expenses, as GitHub sends it, with the fields that a check could read:
# add_advisory <GHSA ID> <state> [<full name of its private fork>]
add_advisory() {
  local fork=null
  if [[ -n ${3:-} ]]; then
    fork="{\"id\": 1, \"name\": \"${3#*/}\", \"full_name\": \"$3\", \"private\": true}"
  fi
  cat >"$TEST_ADVISORIES/$1.json" <<EOF
{
  "ghsa_id": "$1",
  "cve_id": null,
  "url": "https://api.github.com/repos/jtmpl/expenses/security-advisories/$1",
  "html_url": "https://github.com/jtmpl/expenses/security/advisories/$1",
  "summary": "The import reads files outside the project.",
  "state": "$2",
  "private_fork": $fork
}
EOF
}

draft=GHSA-2c5x-3m4v-7q8r
fork=jtmpl/expenses-ghsa-2c5x-3m4v-7q8r
triage=GHSA-6666-6666-6666
published=GHSA-3333-3333-3333
closed=GHSA-4444-4444-4444
withdrawn=GHSA-5555-5555-5555
# GitHub has no advisory of this ID in the repository, as for one of another repository.
unknown=GHSA-9999-9999-9999
add_advisory "$draft" draft "$fork"
add_advisory "$triage" triage
add_advisory "$published" published jtmpl/expenses-ghsa-3333-3333-3333
add_advisory "$closed" closed
add_advisory "$withdrawn" withdrawn

# Prints the message that blocks a command that would post an ID as the text writes it: blocked <ID>
blocked() {
  echo "Blocked: this command would post $1, the ID of a security advisory of this repository that isn't published yet. Write the text without the ID, and run the command again."
}

# Each body starts with this text, because scripts/hooks/issues-and-labels.check blocks a new issue whose body lacks
# its headings.
change_body=$'## What should change\nThe app skips the expenses it already has.\n\n## Why\nPeople import the same file twice.\n\n## Done when\n- Importing a file twice adds each expense once.'

# Prints a body that names an ID: body_with <ID>
body_with() {
  printf '%s\n%s' "$change_body" "The import checks the paths, as the advisory $1 asks."
}

# Prints a command with a text in single quotes in place of TEXT: with_text <command> <text>
with_text() {
  local quoted="'$2'"
  printf '%s' "${1/TEXT/$quoted}"
}

# The commands that the issue names, with TEXT in place of their text
templates=(
  "gh issue create --title 'Skip imported expenses' --label feature --body TEXT"
  "gh pr create --title 'feat: skip imported expenses' --body TEXT"
  "gh issue comment 7 --body TEXT"
  "git commit -m TEXT"
)
for template in "${templates[@]}"; do
  expect_block Bash "$(with_text "$template" "$(body_with "$draft")")" "$(blocked "$draft")"
  expect_block Bash "$(with_text "$template" "$(body_with "$triage")")" "$(blocked "$triage")"
  for id in "$published" "$closed" "$withdrawn" "$unknown"; do
    expect_allow Bash "$(with_text "$template" "$(body_with "$id")")"
  done
  expect_allow Bash "$(with_text "$template" "$change_body")"
done

# The other commands that post text, with TEXT in place of it. The text starts with a type, because
# scripts/hooks/pull-request-rules.check blocks a pull request's title without one.
other_templates=(
  "gh issue create --title TEXT --label feature --body '$change_body'"
  "gh issue new -t TEXT --label feature -b '$change_body'"
  "gh issue edit 7 --title TEXT"
  "gh issue edit 7 -b TEXT"
  "gh pr comment 5 -b TEXT"
  "gh pr review 5 --request-changes --body TEXT"
  "gh issue close 7 --reason 'not planned' -c TEXT"
  "gh issue reopen 7 --comment TEXT"
  "gh pr close 5 -c TEXT"
  "gh pr reopen 5 --comment TEXT"
  "gh pr create --title TEXT --body '$change_body'"
  "gh pr new -t 'feat: skip imported expenses' -b TEXT"
  "gh pr edit 5 --title TEXT"
  "gh pr edit 5 --body TEXT"
  "gh pr merge 5 --squash --subject TEXT"
  "gh pr merge 5 --squash -b TEXT"
  "git commit --message TEXT"
  "git commit --message=TEXT"
  "git commit -am TEXT"
  "git commit -m 'feat: skip imported expenses' -m TEXT"
  "git commit -m 'feat: skip imported expenses' --trailer TEXT"
  "git -C . commit --amend -m TEXT"
  "git merge --no-ff -m TEXT topic"
  "git merge -s ort --message TEXT topic"
  # git reads a prefix of a long flag that starts no other long flag of the subcommand as that flag, and the value of
  # -S only from the same word.
  "git commit --m TEXT"
  "git commit --mess=TEXT"
  "git commit -m 'feat: skip imported expenses' --tr TEXT"
  "git commit -m 'feat: skip imported expenses' --trail=TEXT"
  "git commit -Spat -m TEXT"
  "git merge --no-ff --m TEXT topic"
  "git merge --no-ff --mess=TEXT topic"
  "git merge -Sjules -m TEXT topic"
)
for template in "${other_templates[@]}"; do
  expect_block Bash "$(with_text "$template" "fix: check the paths that $draft names")" "$(blocked "$draft")"
  expect_allow Bash "$(with_text "$template" "fix: check the paths that $published names")"
done

# Releases, which scripts/hooks/forbidden-commands.check lets only the orchestrator publish, so this check runs by
# itself for them.
release_templates=(
  "gh release create v1.2.0 --title TEXT --generate-notes"
  "gh release new v1.2.0 -n TEXT"
  "gh release edit v1.2.0 --notes TEXT"
)
for template in "${release_templates[@]}"; do
  for id in "$draft" "$published"; do
    command=$(with_text "$template" "Fixes $id")
    hook_status=0
    hook_message=$(run_check unpublished-advisories "$(sample_input claude-code Bash "$command")" 2>&1) || hook_status=$?
    if [[ $id == "$draft" ]]; then
      expect_result "scripts/hooks/unpublished-advisories.check for \"$command\"" 2 "$(blocked "$draft")"
    else
      expect_result "scripts/hooks/unpublished-advisories.check for \"$command\"" 0 ""
    fi
  done
done
body_with "$draft" >"$test_cwd/notes.md"
command="gh release edit v1.2.0 --notes-file notes.md"
hook_status=0
hook_message=$(run_check unpublished-advisories "$(sample_input claude-code Bash "$command")" 2>&1) || hook_status=$?
expect_result "scripts/hooks/unpublished-advisories.check for \"$command\"" 2 "$(blocked "$draft")"

# Text from a file, from a here-document on standard input or inside $( ), and after a repository flag
body_with "$draft" >"$test_cwd/body.md"
expect_block Bash "gh issue comment 7 --body-file body.md" "$(blocked "$draft")"
expect_block Bash "gh pr create --title 'feat: skip imported expenses' -F body.md" "$(blocked "$draft")"
expect_block Bash "git commit -F body.md" "$(blocked "$draft")"
expect_block Bash "git commit --file=body.md" "$(blocked "$draft")"
expect_block Bash "git merge --no-ff -F body.md topic" "$(blocked "$draft")"
expect_block Bash "git commit --fil body.md" "$(blocked "$draft")"
expect_block Bash "git merge --no-ff --fi=body.md topic" "$(blocked "$draft")"
expect_block Bash "git commit -F - <<'EOF'
$(body_with "$draft")
EOF" "$(blocked "$draft")"
expect_block Bash "git commit -m \"\$(cat <<'EOF'
$(body_with "$draft")
EOF
)\"" "$(blocked "$draft")"
expect_block Bash "gh issue comment 7 --body-file - <<'EOF'
$(body_with "$draft")
EOF" "$(blocked "$draft")"
expect_block Bash "gh issue comment -R jtmpl/other 7 --body 'Fix $draft'" "$(blocked "$draft")"

# A relative path to a file starts from the folder that a cd before the command changes to.
mkdir "$test_cwd/notes"
body_with "$draft" >"$test_cwd/notes/message.md"
expect_block Bash "cd notes && git commit -F message.md" "$(blocked "$draft")"

# git opens a relative path to the file of -F from the folder that its -C options lead to, but the shell opens the file
# of a < redirection from the folder that the command runs in.
mkdir "$test_cwd/notes/drafts"
body_with "$draft" >"$test_cwd/notes/drafts/clean.md"
printf '%s\n' "$change_body" >"$test_cwd/clean.md"
expect_block Bash "git -C notes commit -F message.md" "$(blocked "$draft")"
expect_block Bash "git -C notes -C drafts commit -F clean.md" "$(blocked "$draft")"
expect_block Bash "git -C notes/drafts merge --no-ff --file=clean.md topic" "$(blocked "$draft")"
expect_allow Bash "git -C notes/drafts commit -F - <clean.md"
# git merge reads - as the name of a file, not as standard input.
cp "$test_cwd/notes/drafts/clean.md" "$test_cwd/notes/drafts/-"
expect_block Bash "git -C notes/drafts merge --no-ff -F - topic <clean.md" "$(blocked "$draft")"
body_with "$published" >"$test_cwd/notes/published.md"
expect_allow Bash "git -C notes commit -F published.md"

# git writes the names of the commits that it merges, and the value of --into-name, into the message of a merge commit
# when the command gives no message. With --log, or the setting merge.log, it writes the names after a message that the
# command gives, too. The merge commit of git pull names the repository and the branches that it pulls.
blocked_merge() {
  echo "Blocked: this command gives git a name or URL that holds $1, the ID of a security advisory of this repository that isn't published yet, and git can write it into the merge commit's message. Merge the commit by its SHA, as in git merge <SHA>, and run the command again."
}
merge_templates=(
  "git merge --no-edit refs/private-fork/ID/fix"
  "git merge refs/private-fork/ID/fix"
  "git merge --no-ff topic refs/private-fork/ID/fix"
  "git merge --no-edit -- refs/private-fork/ID/fix"
  "git -C notes merge -s ort refs/private-fork/ID/fix"
  "git merge -m 'Merge the fix' refs/private-fork/ID/fix"
  "git merge -F clean.md --log refs/private-fork/ID/fix"
  "git pull --no-rebase origin fix-ID"
  "git pull --no-rebase origin main fix-ID:fix"
  "git pull --no-rebase -s ort -- origin fix-ID"
  "git -C notes pull --no-rebase --depth 10 origin fix-ID"
)
for template in "${merge_templates[@]}"; do
  expect_block Bash "${template/ID/$draft}" "$(blocked_merge "$draft")"
  expect_allow Bash "${template/ID/$published}"
done
expect_block Bash "git merge --no-edit expenses-ghsa-2c5x-3m4v-7q8r/main" "$(blocked_merge ghsa-2c5x-3m4v-7q8r)"
expect_block Bash "git pull --no-rebase https://github.com/$fork main" "$(blocked_merge ghsa-2c5x-3m4v-7q8r)"
expect_block Bash "git pull --no-rebase -Sjules https://github.com/$fork" "$(blocked_merge ghsa-2c5x-3m4v-7q8r)"
expect_allow Bash "git pull --no-rebase https://github.com/jtmpl/expenses-ghsa-3333-3333-3333 main"
expect_block Bash "git merge --no-edit --into-name $draft topic" "$(blocked "$draft")"
expect_block Bash "git merge --no-edit --into-name=fix-$draft topic" "$(blocked "$draft")"
expect_block Bash "git merge --no-edit --into=fix-$draft topic" "$(blocked "$draft")"
expect_block Bash "git merge --no-edit --i fix-$draft topic" "$(blocked "$draft")"
expect_allow Bash "git merge --no-edit --into-name $published topic"
# git commit reads the words after -- as paths, which its message doesn't hold.
expect_allow Bash "git commit -m 'feat: skip imported expenses' -- notes/$draft.md"

# After a cd or a git -C that the hook can't follow, it still reads the text that the command writes, and a body file by
# its absolute path, but it can't tell which file a relative path names.
unknown_folder_block="Blocked: this hook checks the body file before the command runs, but it can't tell which folder the path body.md starts from, such as after a cd to a folder that a variable names. Give the file's absolute path."
for cd_command in "cd \"\$WORKTREE\"" "cd /no/such/folder" "cd -"; do
  expect_block Bash "$cd_command && git commit -m 'fix: check the paths that $draft names'" "$(blocked "$draft")"
  expect_block Bash "$cd_command && gh issue comment 7 --body 'Fix $draft'" "$(blocked "$draft")"
  expect_block Bash "$cd_command && gh issue comment 7 --body-file '$test_cwd/body.md'" "$(blocked "$draft")"
  expect_block Bash "$cd_command && gh issue comment 7 --body-file body.md" "$unknown_folder_block"
  expect_block Bash "$cd_command && git commit -F - <body.md" "$unknown_folder_block"
  expect_allow Bash "$cd_command && git commit -m 'fix: check the paths that $published names'"
done
expect_block Bash "git -C \"\$WORKTREE\" commit -m 'fix: check the paths that $draft names'" "$(blocked "$draft")"
expect_block Bash "git -C \"\$WORKTREE\" commit -F body.md" "$unknown_folder_block"
expect_block Bash "git -C /no/such/folder commit -F body.md" "$unknown_folder_block"
expect_block Bash "git -C \"\$WORKTREE\" commit -F - <body.md" "$(blocked "$draft")"

# An absolute -C names the folder that git opens the file of -F from, also after a cd that the hook can't follow.
expect_block Bash "cd \"\$WORKTREE\" && git -C '$test_cwd/notes' commit -F message.md" "$(blocked "$draft")"
expect_block Bash "cd \"\$WORKTREE\" && git -C ~/project -C notes commit -F message.md" "$(blocked "$draft")"
expect_allow Bash "cd \"\$WORKTREE\" && git -C '$test_cwd/notes' commit -F published.md"
expect_block Bash "git -C '$test_cwd' -C \"\$WORKTREE\" commit -F body.md" "$unknown_folder_block"

# The ID in capitals, in a link, and in lower case in the name of the advisory's private fork, as the text writes it
expect_block Bash "gh issue comment 7 --body 'Fix GHSA-2C5X-3M4V-7Q8R'" "$(blocked GHSA-2C5X-3M4V-7Q8R)"
expect_block Bash "gh issue comment 7 --body 'See https://github.com/jtmpl/expenses/security/advisories/$draft.'" \
  "$(blocked "$draft")"
expect_block Bash "git commit -m 'fix: check the paths of imports' -m 'Built in $fork.'" \
  "$(blocked ghsa-2c5x-3m4v-7q8r)"

# Every ID counts, not only the first. The block names the first ID of an advisory that isn't published, in the title
# before the body.
expect_block Bash "gh issue comment 7 --body 'Like $published and $draft.'" "$(blocked "$draft")"
expect_block Bash "gh issue create --title 'Fix $draft' --label feature --body '$(body_with "$triage")'" \
  "$(blocked "$draft")"

# A post to the advisory's private fork, which is private too, goes ahead. One to any other repository doesn't.
# scripts/hooks/maintainer-only.check blocks posts to other repositories, so this check runs by itself for them.
for repository in "$fork" "https://github.com/$fork" JTMPL/EXPENSES-GHSA-2C5X-3M4V-7Q8R jtmpl/other; do
  command="gh pr comment -R $repository 5 --body 'Fix $draft'"
  hook_status=0
  hook_message=$(run_check unpublished-advisories "$(sample_input claude-code Bash "$command")" 2>&1) || hook_status=$?
  if [[ $repository == jtmpl/other ]]; then
    expect_result "scripts/hooks/unpublished-advisories.check for \"$command\"" 2 "$(blocked "$draft")"
  else
    expect_result "scripts/hooks/unpublished-advisories.check for \"$command\"" 0 ""
  fi
done

# Posts to the advisory itself, and the scripts that take its ID
printf '%s\n' "The import reads files outside the project." "Fix merged in 1a2b3c4." >"$test_cwd/description.md"
expect_allow Bash "gh api --method PATCH \"repos/{owner}/{repo}/security-advisories/$draft\" -F \"description=@description.md\""
expect_allow Bash "gh api \"repos/{owner}/{repo}/security-advisories/$draft\" --jq .description"
expect_allow Bash "scripts/create-private-fork $draft"

# Commands that post nothing
expect_allow Bash "gh issue comment 7 --body 'Fix $draft' --help"
expect_allow Bash "echo 'Fix $draft'"
expect_allow Bash "git log --grep $draft"
expect_allow Bash "git commit --amend --no-edit"

# When gh fails, the hook can't tell whether an ID is that of an advisory that isn't published. It asks GitHub nothing
# for a text without an ID.
export TEST_GH_ERROR="error connecting to api.github.com"
expect_block Bash "gh issue comment 7 --body 'Fix $published'" \
  "Blocked: this hook can't tell whether $published is the ID of a security advisory of this repository that isn't published yet. Write the text without the ID, or run the command again once gh works. gh failed: $TEST_GH_ERROR"
expect_allow Bash "gh issue comment 7 --body '$change_body'"
expect_allow Bash "git commit -m 'feat: skip imported expenses'"
unset TEST_GH_ERROR

# A commit message that the hook can't read before the command runs
expect_block Bash "git commit -m \"\$(git log -1 --format=%B)\"" \
  "Blocked: this hook can't run the command in \$( ) or backticks that prints the body, so it can't check the text for the IDs of security advisories that aren't published. Write the body to a file in a command of its own first, and give the file with -F."
expect_block Bash "git log -1 --format=%B | git commit -F -" \
  "Blocked: this hook can't read a body from standard input, other than from a here-document, so it can't check the text for the IDs of security advisories that aren't published. Give the body with -m, or write it to a file and give the file with -F."

finish_tests
