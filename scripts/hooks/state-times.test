#!/usr/bin/env bash
# Tests that scripts/hooks/state-times writes the clock's time into the orchestrator's state file. The hook finds the
# state file from the repository that it's in, so the cases run copies of the scripts in a git repository and in a
# worktree of it.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"
# The cases check the state file that the hook finds on its own.
unset LOOP_DIR

base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT
# git looks for no repository above the temporary folder, and reads none of the person's settings.
export GIT_CEILING_DIRECTORIES=$base GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=Tester GIT_AUTHOR_EMAIL=tester@example.com GIT_COMMITTER_NAME=Tester GIT_COMMITTER_EMAIL=tester@example.com
main_checkout=$base/main
worktree=$base/worktree
git init --quiet "$main_checkout"
git -C "$main_checkout" commit --quiet --allow-empty -m Start
git -C "$main_checkout" worktree add --quiet --detach "$worktree"
for checkout in "$main_checkout" "$worktree"; do
  mkdir -p "$checkout/scripts/hooks"
  cp -p "$hooks_folder/state-times" "$checkout/scripts/hooks/"
  cp -p "${hooks_folder%/*}/loop-folder" "$checkout/scripts/"
done
mkdir "$main_checkout/.loop" "$main_checkout/docs"
state_file=$main_checkout/.loop/state.md

# The orchestrator schedules the heartbeat with the prompt that docs/loop.md gives.
heartbeat=$(sed -n 's/^ *\(Loop heartbeat: .*\)$/\1/p' "$hooks_folder/../../docs/loop.md")
if [[ -z $heartbeat ]]; then
  echo "error: docs/loop.md gives no heartbeat prompt that starts with \"Loop heartbeat:\", and the hook writes the heartbeat's time only after CronCreate of such a prompt. Start the prompt with those words, or change the hook and this test to look for its new start." >&2
  exit 1
fi

# Prints Claude Code's input after an Edit or a Write: file_input <tool name> <path> [<folder the agent works in>]
file_input() {
  jq -n --arg tool "$1" --arg path "$2" --arg cwd "${3:-$main_checkout}" \
    '{session_id: "abc123", cwd: $cwd, hook_event_name: "PostToolUse", tool_name: $tool,
      tool_input: {file_path: $path, content: "session: abc123"}, tool_response: {}}'
}

# Prints Claude Code's input after CronCreate: cron_input <prompt>
cron_input() {
  jq -n --arg cwd "$main_checkout" --arg prompt "$1" \
    '{session_id: "abc123", cwd: $cwd, hook_event_name: "PostToolUse", tool_name: "CronCreate",
      tool_input: {cron: "7 * * * *", prompt: $prompt, recurring: true}, tool_response: {id: "a1b2c3d4"}}'
}

# Runs a checkout's copy of the hook on an input, and sets hook_status and hook_output, and before and after to the
# clock's time in seconds before and after the hook ran: run_hook <checkout> <input>
run_hook() {
  hook_status=0
  before=$(date -u +%s)
  hook_output=$("$1/scripts/hooks/state-times" <<<"$2" 2>&1) || hook_status=$?
  after=$(date -u +%s)
}

# Prints the state file with each time on an updated, heartbeat or taken in line that falls between before and after
# replaced by "now", or prints "no file" if it doesn't exist.
state_with_now() {
  if [[ ! -f $state_file ]]; then
    echo "no file"
    return 0
  fi
  jq -R -r --argjson before "$before" --argjson after "$after" '
    (capture("^(?<name>updated|heartbeat|taken in): (?<time>.*)$") // null) as $line
    | ($line.time // "" | try fromdateiso8601 catch null) as $seconds
    | if $seconds != null and $seconds >= $before and $seconds <= $after then "\($line.name): now" else . end' \
    "$state_file"
}

# Checks that the hook exited with code 0, printed nothing, and left the state file as expected:
# expect_state <description> <state file, with now for the clock's time, or "no file">
expect_state() {
  local description=$1 expected=$2 state
  case_count=$((case_count + 1))
  state=$(state_with_now)
  if [[ $hook_status != 0 || -n $hook_output || $state != "$expected" ]]; then
    echo "error: $description, the hook must exit with code 0, print nothing and leave the state file as \"$expected\", where now is the clock's time, but it exited with code $hook_status, printed \"$hook_output\" and left \"$state\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

printf '%s\n' 'session: owner-1' 'pid: 42' >"$state_file"
run_hook "$main_checkout" "$(file_input Edit "$state_file")"
expect_state "After an Edit of the state file" $'session: owner-1\npid: 42\nupdated: now'

# The orchestrator's own guess at the time gives way to the clock's.
printf '%s\n' 'session: owner-1' 'updated: 2020-01-01T00:00:00Z' 'goal: ship' >"$state_file"
run_hook "$main_checkout" "$(file_input Write "$state_file")"
expect_state "After a Write of the state file with an updated line" $'session: owner-1\nupdated: now\ngoal: ship'

# The orchestrator writes "taken in: now" before it reads the maintainer's comments on GitHub.
printf '%s\n' 'session: owner-1' 'taken in: now' 'updated: 2020-01-01T00:00:00Z' >"$state_file"
run_hook "$main_checkout" "$(file_input Edit "$state_file")"
expect_state "After an Edit that writes \"taken in: now\"" $'session: owner-1\ntaken in: now\nupdated: now'

printf '%s\n' 'taken in: 2020-01-01T00:00:00Z' 'note: taken in: now' >"$state_file"
run_hook "$main_checkout" "$(file_input Edit "$state_file")"
expect_state "After an Edit of a state file with a time on its taken in line" \
  $'taken in: 2020-01-01T00:00:00Z\nnote: taken in: now\nupdated: now'

printf '%s\n' 'session: owner-1' 'pid: 42' >"$state_file"
run_hook "$main_checkout" "$(file_input Edit .loop/state.md)"
expect_state "After an Edit of the state file by a path relative to the main checkout" \
  $'session: owner-1\npid: 42\nupdated: now'

printf '%s\n' 'session: owner-1' 'pid: 42' >"$state_file"
run_hook "$worktree" "$(file_input Edit "$state_file" "$worktree")"
expect_state "After an Edit of the main checkout's state file from a worktree" $'session: owner-1\npid: 42\nupdated: now'

printf '%s\n' 'session: owner-1' 'heartbeat: 2020-01-01T00:00:00Z' 'updated: 2020-01-02T00:00:00Z' >"$state_file"
run_hook "$main_checkout" "$(cron_input "$heartbeat")"
expect_state "After CronCreate of the heartbeat" \
  $'session: owner-1\nheartbeat: now\nupdated: 2020-01-02T00:00:00Z'

printf '%s\n' 'session: owner-1' >"$state_file"
run_hook "$main_checkout" "$(cron_input "$heartbeat")"
expect_state "After CronCreate of the heartbeat, with no heartbeat line" $'session: owner-1\nheartbeat: now'

# Other actions leave the state file as it is.
unchanged=$'session: owner-1\nupdated: 2020-01-01T00:00:00Z'
printf '%s\n' "$unchanged" >"$state_file"
run_hook "$main_checkout" "$(cron_input "Check whether the deploy finished.")"
expect_state "After CronCreate of another prompt" "$unchanged"

printf '%s\n' 'Notes' >"$main_checkout/docs/state.md"
run_hook "$main_checkout" "$(file_input Edit "$main_checkout/docs/state.md")"
expect_state "After an Edit of another file named state.md" "$unchanged"
case_count=$((case_count + 1))
if [[ $(<"$main_checkout/docs/state.md") != Notes ]]; then
  echo "error: After an Edit of another file named state.md, the hook must leave that file as it is, but it holds \"$(<"$main_checkout/docs/state.md")\"." >&2
  failed_cases=$((failed_cases + 1))
fi

run_hook "$main_checkout" "$(file_input Edit "$main_checkout/README.md")"
expect_state "After an Edit of another file" "$unchanged"

run_hook "$main_checkout" "$(file_input Read "$state_file")"
expect_state "After a Read of the state file" "$unchanged"

run_hook "$main_checkout" "not JSON"
expect_state "For input that isn't JSON" "$unchanged"

rm "$state_file"
run_hook "$main_checkout" "$(cron_input "$heartbeat")"
expect_state "After CronCreate of the heartbeat, without a state file" "no file"

finish_tests
