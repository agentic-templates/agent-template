#!/usr/bin/env bash
# Tests scripts/hooks/hand-off in a small repository, with transcripts in a folder of Claude Code's form.
set -euo pipefail
cd "$(dirname "$0")/../.."

case_count=0
failed_cases=0

base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT
export GIT_CEILING_DIRECTORIES=$base GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
repository=$base/repository
mkdir -p "$repository/scripts/hooks" "$repository/.loop"
cp -p scripts/hooks/hand-off "$repository/scripts/hooks/"
cp -p scripts/loop-folder "$repository/scripts/"
git -C "$repository" init --quiet
orchestrator=11111111-aaaa-4bbb-8ccc-000000000001
echo "session: $orchestrator" >"$repository/.loop/state.md"
projects=$base/projects/-repository
notes=$repository/.loop/hand-offs

soon="Your context has passed 400k tokens. Hand off your work at your next stopping point, so that a fresh agent continues it."
now="Your context has passed 500k tokens. Hand off your work as soon as the step you're on ends, so that a fresh agent continues it."
how="To hand off, push your branch. Then write a comment on your issue or pull request with what's done, what's left, the commands you ran and where their outputs are, and the open questions. End with a report that says that you handed off, with the comment's link and the GHSA ID of each vulnerability that you recorded privately."
reviewer_how="To hand off, end with a report that says that you handed off, with the errors that you have found so far, and the parts of the diff that you haven't read yet."
researcher_how="To hand off, write a comment on your issue with what you have found so far, what's left to find out, and the open questions. End with a report that says that you handed off, with the comment's link."
compact="Your context has passed 300k tokens. If the maintainer installed a compaction sender, ask for a compaction, as \"Compact your context\" in docs/loop.md describes: finish the step you're on, and bring your state file up to date. Then write $repository/.loop/compact-request.txt with $orchestrator on its first line and \"Resume from .loop/state.md.\" on its second, and end your turn. Without a sender, ask the maintainer to type /compact, and go on with the loop."

# Prints a reply of a transcript, whose call read the given number of tokens: reply <tokens>
# The call's input splits into its three parts, so that a hook that leaves one out reads a smaller size.
reply() {
  jq -c -n --argjson tokens "$1" '{type: "assistant", message: {role: "assistant",
    usage: {input_tokens: 3, cache_read_input_tokens: ($tokens - 1003), cache_creation_input_tokens: 1000,
      output_tokens: 900000}}}'
}

# Adds lines to the transcript of a session, or of a subagent of it: add_lines <session> <agent id or ""> <line>...
# A subagent's transcript gets the file that Claude Code writes next to it, for an agent that the session started.
add_lines() {
  local transcript=$projects/$1.jsonl
  if [[ -n $2 ]]; then
    transcript=$projects/$1/subagents/agent-$2.jsonl
  fi
  shift 2
  mkdir -p "${transcript%/*}"
  printf '%s\n' "$@" >>"$transcript"
  if [[ $transcript == */subagents/* && ! -f ${transcript%.jsonl}.meta.json ]]; then
    echo '{"agentType": "builder", "toolUseId": "toolu_01", "spawnDepth": 1}' >"${transcript%.jsonl}.meta.json"
  fi
}

# Adds a reply to a transcript, with a tool result after it: add_reply <session> <agent id or ""> <tokens>
add_reply() {
  add_lines "$1" "$2" "$(reply "$3")" \
    '{"type": "user", "message": {"role": "user", "content": [{"type": "tool_result", "content": "a \"usage\" line"}]}}'
}

# Runs the hook after a tool call of a session or of a subagent, whose type is in agent_type, and sets output:
# run_hook <session> <agent id or ""> [<NAME=value>...]
agent_type=builder
run_hook() {
  local input
  input=$(jq -n --arg session "$1" --arg agent "$2" --arg type "$agent_type" --arg transcript "$projects/$1.jsonl" \
    --arg cwd "$repository" \
    '{session_id: $session, transcript_path: $transcript, cwd: $cwd, hook_event_name: "PostToolUse", tool_name: "Read",
      tool_input: {file_path: "README.md"}} + (if $agent == "" then {} else {agent_id: $agent, agent_type: $type} end)')
  shift 2
  output=$(env -u LOOP_HAND_OFF -u LOOP_RUN -u LOOP_DIR "$@" "$repository/scripts/hooks/hand-off" <<<"$input" 2>&1) || true
}

# Checks what the hook told the agent: expect_note <description> <message, or nothing>
expect_note() {
  local description=$1 message=$2 actual_message=""
  case_count=$((case_count + 1))
  if [[ -n $output ]]; then
    actual_message=$(jq -r .hookSpecificOutput.additionalContext <<<"$output" 2>/dev/null) || actual_message=$output
  fi
  if [[ $actual_message != "$message" ]]; then
    echo "error: $description, the hook must tell \"$message\", but it told \"$actual_message\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks the files of the notes that the hook gave: expect_note_files <description> <file names, or nothing>
expect_note_files() {
  local description=$1 expected=$2 file files=""
  case_count=$((case_count + 1))
  for file in "$notes"/*; do
    if [[ -e $file ]]; then
      files+=" ${file##*/}"
    fi
  done
  if [[ ${files# } != "$expected" ]]; then
    echo "error: $description, the hook must leave the files \"$expected\" in .loop/hand-offs, but it left \"${files# }\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Checks whether the orchestrator's request for a compaction is in place: expect_request <description> <kept or deleted>
request=$repository/.loop/compact-request.txt
expect_request() {
  local actual=deleted
  case_count=$((case_count + 1))
  if [[ -e $request ]]; then
    actual=kept
  fi
  if [[ $actual != "$2" ]]; then
    echo "error: $1, the hook must leave the request for a compaction $2, but it left it $actual." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Writes the orchestrator's request for a compaction, as "Compact your context" in docs/loop.md describes.
write_request() {
  printf '%s\nResume from .loop/state.md.\n' "$orchestrator" >"$request"
}

# Checks that the hook didn't create the file of the orchestrator's note: expect_no_compact_file <description>
expect_no_compact_file() {
  case_count=$((case_count + 1))
  if [[ -e $repository/.loop/told-to-compact ]]; then
    echo "error: $1, the hook must not create .loop/told-to-compact, but it did." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# A subagent of the orchestrator's session, as its context grows
add_reply "$orchestrator" a1 120000
run_hook "$orchestrator" a1
expect_note "Under 400k tokens" ""
add_reply "$orchestrator" a1 400000
run_hook "$orchestrator" a1
expect_note "At 400k tokens" ""
add_reply "$orchestrator" a1 400001
run_hook "$orchestrator" a1
expect_note "Just past 400k tokens" "$soon $how"
expect_note_files "Just past 400k tokens" "a1.400000"
add_reply "$orchestrator" a1 430000
run_hook "$orchestrator" a1
expect_note "After the note for 400k tokens" ""
add_reply "$orchestrator" a1 500000
run_hook "$orchestrator" a1
expect_note "At 500k tokens" ""
add_reply "$orchestrator" a1 500001
run_hook "$orchestrator" a1
expect_note "Just past 500k tokens" "$now $how"
add_reply "$orchestrator" a1 520000
run_hook "$orchestrator" a1
expect_note "After the note for 500k tokens" ""
expect_note_files "After both notes" "a1.400000 a1.500000"

# A subagent whose context is far past each threshold at its first tool call
add_reply "$orchestrator" a2 480000
run_hook "$orchestrator" a2
expect_note "Far past 400k tokens" "$soon $how"
add_reply "$orchestrator" a3 900000
run_hook "$orchestrator" a3
expect_note "Far past 500k tokens" "$now $how"
add_reply "$orchestrator" a3 450000
run_hook "$orchestrator" a3
expect_note "After a compaction to past 400k tokens, once the note for 500k tokens came" ""

# The hook reads the latest reply, as after a compaction, and a transcript whose start the hook's read cuts.
add_lines "$orchestrator" a4 "$(reply 700000)" "$(reply 200000)"
run_hook "$orchestrator" a4
expect_note "When an earlier reply is past both thresholds" ""
add_lines "$orchestrator" a5 "{\"type\": \"user\", \"message\": {\"content\": \"$(head -c 400000 /dev/zero | tr '\0' x)\", \"usage\": 1}}" \
  "$(reply 410000)"
run_hook "$orchestrator" a5
expect_note "After a line longer than the part of the transcript that the hook reads" "$soon $how"

# The orchestrator itself, as its context grows, and after a compaction
add_reply "$orchestrator" "" 300000
run_hook "$orchestrator" ""
expect_note "For the orchestrator at 300k tokens" ""
add_reply "$orchestrator" "" 300001
# Before the orchestrator's note, so that the hook hasn't created the note's file yet
add_reply "$orchestrator" a10 350000
run_hook "$orchestrator" a10
expect_note "For a builder in the orchestrator's session, past 300k tokens" ""
run_hook "$orchestrator" ""
expect_note "For the orchestrator just past 300k tokens" "$compact"
add_reply "$orchestrator" "" 600000
run_hook "$orchestrator" ""
expect_note "For the orchestrator after its note" ""
add_reply "$orchestrator" "" 40000
run_hook "$orchestrator" ""
expect_note "For the orchestrator after a compaction" ""
add_reply "$orchestrator" "" 300001
run_hook "$orchestrator" ""
expect_note "For the orchestrator just past 300k tokens after a compaction" "$compact"
run_hook "$orchestrator" ""
expect_note "For the orchestrator after its note after a compaction" ""

# A file of the orchestrator's note that the hook can't write or delete. A symbolic link to a missing folder, or a
# folder, stands in its place, because a read-only folder wouldn't stop root.
told=$repository/.loop/told-to-compact
add_reply "$orchestrator" "" 40000
run_hook "$orchestrator" ""
ln -s "$base/missing/told-to-compact" "$told"
add_reply "$orchestrator" "" 300001
run_hook "$orchestrator" ""
expect_note "When the hook can't write the file of the orchestrator's note" \
  "$compact scripts/hooks/hand-off couldn't write $told, so it may give this note again."
rm "$told"
mkdir "$told"
add_reply "$orchestrator" "" 40000
run_hook "$orchestrator" ""
expect_note "When the hook can't delete the file of the orchestrator's note" \
  "scripts/hooks/hand-off couldn't delete $told, so it won't tell you again when your context passes 300k tokens. Delete the file."
rmdir "$told"

# The orchestrator after a compaction that Claude Code marks in the transcript, before and after its first reply
compact_boundary='{"type": "system", "subtype": "compact_boundary", "content": "Conversation compacted", "compactMetadata": {"trigger": "manual", "preTokens": 301000}}'
add_reply "$orchestrator" "" 301000
add_lines "$orchestrator" "" "$compact_boundary"
run_hook "$orchestrator" ""
expect_note "For the orchestrator after a compaction from past 300k tokens, before its first reply" ""
expect_no_compact_file "For the orchestrator after a compaction from past 300k tokens, before its first reply"
add_reply "$orchestrator" "" 57000
run_hook "$orchestrator" ""
expect_note "For the orchestrator at 57k tokens after a compaction from past 300k tokens" ""
expect_no_compact_file "For the orchestrator at 57k tokens after a compaction from past 300k tokens"
add_reply "$orchestrator" "" 310000
run_hook "$orchestrator" ""
expect_note "For the orchestrator past 300k tokens after a compaction that the transcript marks" "$compact"

# The orchestrator's request for a compaction, before and after the hook tells it to ask for one
refused="because your context is"
go_on="Go on with the loop, and ask for a compaction only after the hook tells you that your context has passed 300k tokens."
add_reply "$orchestrator" "" 40000
run_hook "$orchestrator" ""
write_request
add_reply "$orchestrator" "" 261000
run_hook "$orchestrator" ""
expect_note "For a request at 261k tokens" \
  "scripts/hooks/hand-off deleted your request for a compaction, $request, $refused 261k tokens. $go_on"
expect_request "For a request at 261k tokens" deleted
write_request
add_reply "$orchestrator" "" 300000
run_hook "$orchestrator" ""
expect_note "For a request at 300k tokens" \
  "scripts/hooks/hand-off deleted your request for a compaction, $request, $refused 300k tokens. $go_on"
expect_request "For a request at 300k tokens" deleted
add_reply "$orchestrator" "" 300001
run_hook "$orchestrator" ""
expect_note "For the orchestrator just past 300k tokens, before its request" "$compact"
write_request
run_hook "$orchestrator" ""
expect_note "For a request after the note" ""
expect_request "For a request after the note" kept
add_reply "$orchestrator" "" 241000
run_hook "$orchestrator" ""
expect_note "For a request after the note, once the context is below 300k tokens again" \
  "scripts/hooks/hand-off deleted your request for a compaction, $request, $refused 241k tokens. $go_on"
expect_request "For a request after the note, once the context is below 300k tokens again" deleted
write_request
add_reply "$orchestrator" "" 320000
run_hook "$orchestrator" ""
expect_note "For a request that comes with the first tool call past 300k tokens" "$compact"
expect_request "For a request that comes with the first tool call past 300k tokens" kept
add_reply "$orchestrator" a11 100000
run_hook "$orchestrator" a11
expect_request "For a builder in the orchestrator's session, under 300k tokens" kept
rm "$request"
mkdir "$request"
add_reply "$orchestrator" "" 250000
run_hook "$orchestrator" ""
expect_note "For a request that the hook can't delete" \
  "scripts/hooks/hand-off refuses your request for a compaction, $request, $refused 250k tokens. $go_on It couldn't delete the file, so delete it."
rmdir "$request"

# Agents that get no note
rm -rf "$notes"
run_hook "$orchestrator" a9
expect_note "For a subagent whose transcript can't be found" ""
add_reply 22222222-aaaa-4bbb-8ccc-000000000002 b1 600000
run_hook 22222222-aaaa-4bbb-8ccc-000000000002 b1
expect_note "For a subagent of a session other than the orchestrator's" ""
add_reply "$orchestrator" ../a6 600000
run_hook "$orchestrator" ../a6
expect_note "For an agent id that isn't a file name" ""
add_reply "$orchestrator" d1 600000
echo '{"agentType": "builder", "toolUseId": "toolu_02", "spawnDepth": 2}' >"$projects/$orchestrator/subagents/agent-d1.meta.json"
run_hook "$orchestrator" d1
expect_note "For a subagent of a builder in the orchestrator's session" ""
add_reply "$orchestrator" d2 600000
rm "$projects/$orchestrator/subagents/agent-d2.meta.json"
run_hook "$orchestrator" d2
expect_note "For a subagent without the file that says who started it" ""
for agent_type in Explore general-purpose; do
  add_reply "$orchestrator" "t-$agent_type" 600000
  run_hook "$orchestrator" "t-$agent_type"
  expect_note "For a subagent of the type $agent_type" ""
done
expect_note_files "For the agents that get no note" ""

# Subagents of the other types that hand off their work
agent_type="builder-small"
add_reply "$orchestrator" t-small 410000
run_hook "$orchestrator" t-small
expect_note "For a subagent of the type builder-small" "$soon $how"
agent_type=auditor
add_reply "$orchestrator" t-auditor 400001
run_hook "$orchestrator" t-auditor
expect_note "For an auditor just past 400k tokens" "$soon $how"
add_reply "$orchestrator" t-auditor 500001
run_hook "$orchestrator" t-auditor
expect_note "For an auditor just past 500k tokens" "$now $how"
agent_type=reviewer
add_reply "$orchestrator" t-reviewer 400001
run_hook "$orchestrator" t-reviewer
expect_note "For a reviewer just past 400k tokens" "$soon $reviewer_how"
add_reply "$orchestrator" t-reviewer 500001
run_hook "$orchestrator" t-reviewer
expect_note "For a reviewer just past 500k tokens" "$now $reviewer_how"
agent_type=researcher
add_reply "$orchestrator" t-researcher 400001
run_hook "$orchestrator" t-researcher
expect_note "For a researcher just past 400k tokens" "$soon $researcher_how"
add_reply "$orchestrator" t-researcher 500001
run_hook "$orchestrator" t-researcher
expect_note "For a researcher just past 500k tokens" "$now $researcher_how"
agent_type=builder
expect_note_files "For the subagents of the other types that hand off" \
  "t-auditor.400000 t-auditor.500000 t-researcher.400000 t-researcher.500000 t-reviewer.400000 t-reviewer.500000 t-small.400000"
rm -rf "$notes"

# The sessions that scripts/loop/run-builder started, and a subagent of one
builder=33333333-aaaa-4bbb-8ccc-000000000003
add_reply "$builder" "" 410000
run_hook "$builder" "" LOOP_HAND_OFF=builder
expect_note "For a builder that scripts/loop/run-builder started" "$soon $how"
reviewer=55555555-aaaa-4bbb-8ccc-000000000005
add_reply "$reviewer" "" 410000
run_hook "$reviewer" "" LOOP_HAND_OFF=reviewer
expect_note "For a reviewer that scripts/loop/run-builder started" "$soon $reviewer_how"
researcher=66666666-aaaa-4bbb-8ccc-000000000006
add_reply "$researcher" "" 410000
run_hook "$researcher" "" LOOP_HAND_OFF=researcher
expect_note "For a researcher that scripts/loop/run-builder started" "$soon $researcher_how"
other=77777777-aaaa-4bbb-8ccc-000000000007
add_reply "$other" "" 410000
run_hook "$other" "" LOOP_HAND_OFF=Explore
expect_note "For a session whose type in LOOP_HAND_OFF doesn't hand off" ""
run_hook "$builder" ""
expect_note "For a session that scripts/loop/run-builder didn't start, and that isn't the orchestrator" ""
add_reply "$builder" c1 410000
run_hook "$builder" c1 LOOP_HAND_OFF=builder
expect_note "For a subagent of a builder that scripts/loop/run-builder started" ""
run_hook 44444444-aaaa-4bbb-8ccc-000000000004 "" LOOP_HAND_OFF=builder
expect_note "For a builder whose transcript can't be found" ""
expect_note_files "For the sessions that scripts/loop/run-builder started" \
  "$builder.400000 $reviewer.400000 $researcher.400000"

# A note whose file the hook can't write, because a file stands where its folder should be. A read-only folder
# wouldn't stop root.
add_reply "$orchestrator" a8 410000
rm -rf "$notes"
touch "$notes"
run_hook "$orchestrator" a8
rm "$notes"
expect_note "When the hook can't write the note's file" "$soon $how scripts/hooks/hand-off couldn't write $notes/a8.400000, so it may give this note again, and scripts/loop/meter doesn't show it. List this in your report for the orchestrator."

# Calls that end at the same time
add_reply "$orchestrator" a7 410000
mkdir "$base/calls"
for call in 1 2 3 4 5 6 7 8; do
  (
    run_hook "$orchestrator" a7
    printf '%s' "$output" >"$base/calls/$call"
  ) &
done
wait
notes_given=0
for call in "$base"/calls/*; do
  if [[ -s $call ]]; then
    notes_given=$((notes_given + 1))
  fi
done
case_count=$((case_count + 1))
if ((notes_given != 1)); then
  echo "error: Of 8 calls that end at the same time, one must give the note, but $notes_given gave it." >&2
  failed_cases=$((failed_cases + 1))
fi

# Checks the text in the file of a note: expect_note_text <description> <file name> <text>
expect_note_text() {
  local actual=""
  case_count=$((case_count + 1))
  if [[ -f $notes/$2 ]]; then
    actual=$(<"$notes/$2")
  fi
  if [[ $actual != "$3" ]]; then
    echo "error: $1, the file $2 in .loop/hand-offs must hold \"$3\", but it holds \"$actual\"." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# The notes about the account's room, which scripts/loop/meter --hand-off gives from the account's latest reading. The
# meter needs uv, and the bash-3-2 and macos jobs of CI don't install it, so these cases run only where uv is installed.
if command -v uv >/dev/null; then
  mkdir -p "$repository/scripts/loop"
  cp -p scripts/loop/meter scripts/loop/*.py "$repository/scripts/loop/"
  cp -p .python-version "$repository/"
  rm -rf "$notes"
  base_time=$(jq -n 'now | floor')
  # Prints the time this many minutes after the base time, as the logs give times: at <minutes>
  at() {
    jq -n -r --argjson base "$base_time" --argjson minutes "$1" '$base + $minutes * 60 | todate'
  }
  # Adds a reading of the account claude, a minute before the base time, with the 5-hour meter at the percentage, at
  # 0.25 points an agent-minute: add_reading <percentage>
  add_reading() {
    jq -c -n --argjson used "$1" --arg at "$(at -1)" --arg session_reset "$(at 120)" --arg week_reset "$(at 4320)" \
      '{at: $at, account: "claude", meters: {session: {used: $used, resets: $session_reset},
        week: {used: 30, resets: $week_reset}}, per_agent_minute: {session: 0.25, week: 0.01}, orchestrator_share: 0}' \
      >>"$repository/.loop/meter.jsonl"
  }
  # An earlier builder ran 30 minutes, so a builder's long run takes 30 minutes. At the reading, the subagent r1 had run
  # 1 minute, so it still needs 29, or 7.25 points, and the builder r2 of scripts/loop/run-builder had run 20, so it
  # still needs 2.5 points. Until an agent with a note ends, a hand-off takes 10 minutes, or 2.5 points.
  run_builder=88888888-aaaa-4bbb-8ccc-000000000008
  {
    jq -c -n --arg at "$(at -180)" '{at: $at, event: "start", id: "toolu_09", type: "builder", account: "claude"}'
    jq -c -n --arg at "$(at -150)" '{at: $at, event: "end", id: "toolu_09", minutes: 30}'
    jq -c -n --arg at "$(at -2)" '{at: $at, event: "start", id: "toolu_r1", type: "builder", account: "claude"}'
    jq -c -n --arg at "$(at -21)" '{at: $at, event: "start", id: "r2-20261020", type: "builder", account: "claude"}'
  } >"$repository/.loop/agents.jsonl"
  mkdir -p "$projects/$orchestrator/subagents"
  echo '{"agentType": "builder", "toolUseId": "toolu_r1", "spawnDepth": 1}' \
    >"$projects/$orchestrator/subagents/agent-r1.meta.json"
  add_reply "$orchestrator" r1 100000
  add_reply "$run_builder" "" 100000
  room_soon="Your account's usage limit leaves too little room for all its agents to finish, and you're among those with the most work left. Hand off your work at your next stopping point, so that a fresh agent continues it."
  room_now="Your account's usage limit leaves its agents only the room to hand off. Hand off your work as soon as the step you're on ends, so that a fresh agent continues it."

  add_reading 90.25
  run_hook "$orchestrator" r1
  expect_note "While the room covers what every agent still needs" ""
  run_hook "$run_builder" "" LOOP_HAND_OFF=builder LOOP_RUN=r2-20261020
  expect_note "For a builder of scripts/loop/run-builder, while the room covers what every agent still needs" ""
  add_reading 90.5
  run_hook "$run_builder" "" LOOP_HAND_OFF=builder LOOP_RUN=r2-20261020
  expect_note "For the agent that needs less, once the room doesn't cover what every agent still needs" ""
  run_hook "$orchestrator" r1
  expect_note "For the agent that needs the most, once the room doesn't cover what every agent still needs" \
    "$room_soon $how"
  expect_note_text "For the agent that needs the most" r1.room-soon toolu_r1
  run_hook "$orchestrator" r1
  expect_note "After the note to hand off at the next stopping point" ""
  add_reply "$orchestrator" r1 410000
  run_hook "$orchestrator" r1
  expect_note "Past 400k tokens, after the note about the room" ""
  add_reading 94.75
  run_hook "$run_builder" "" LOOP_HAND_OFF=builder LOOP_RUN=r2-20261020
  expect_note "For the agent that needs less, while the room covers its need and the other's hand-off" ""
  add_reading 95
  run_hook "$run_builder" "" LOOP_HAND_OFF=builder LOOP_RUN=r2-20261020
  expect_note "For a builder of scripts/loop/run-builder, once the room is down to the hand-offs" "$room_now $how"
  expect_note_text "For a builder of scripts/loop/run-builder" "$run_builder.room-now" r2-20261020
  run_hook "$orchestrator" r1
  expect_note "For a subagent, once the room is down to the hand-offs" "$room_now $how"
  add_reply "$orchestrator" r1 510000
  run_hook "$orchestrator" r1
  expect_note "Past 500k tokens, after the note about the room" ""
  expect_note_files "After the notes about the room" \
    "$run_builder.room-now r1.room-now r1.room-soon"

  # An agent that got the note about its context before the hook wrote ids in the notes' files, which the meter doesn't
  # count as told
  rm -rf "$notes"
  mkdir "$notes"
  touch "$notes/r1.400000"
  add_reply "$orchestrator" r1 100000
  add_reading 90.5
  run_hook "$orchestrator" r1
  expect_note "After the note to hand off at the next stopping point about the context" ""
  add_reply "$orchestrator" r1 410000
  rm "$notes/r1.400000"
  add_reading 90.25
  run_hook "$orchestrator" r1
  expect_note "Past 400k tokens, while the room covers what every agent needs" "$soon $how"
  expect_note_text "For a note about the context" r1.400000 toolu_r1

  rm -rf "$notes"
  mkdir "$notes"
  printf toolu_r1 >"$notes/r1.room-soon"
  add_reply "$orchestrator" r1 510000
  run_hook "$orchestrator" r1
  expect_note "Past 500k tokens, after the note about the room to hand off at the next stopping point" "$now $how"
fi

if ((failed_cases > 0)); then
  echo "error: $failed_cases of the $case_count cases in scripts/hooks/hand-off.test failed. The errors above say which." >&2
  exit 1
fi
echo "scripts/hooks/hand-off.test passed. Cases: $case_count."
