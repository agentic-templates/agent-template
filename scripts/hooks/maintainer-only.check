#!/usr/bin/env bash
# Blocks the actions that only the maintainer may take, with a message that says what to do instead:
# - sudo, doas and su, and the commands that change the machine's disks, settings or security, such as defaults write
# - writing a settings file in the home folder, such as ~/.zshrc, a file in ~/.config/ or ~/.claude/settings.json, with
#   a redirection, tee, cp and the like, sed -i, perl -i or the agent's file-writing tool, and git config --global or
#   --system
# - writing .loop/reviewed-fixes in the main checkout in the same ways, unless the orchestrator's session writes it,
#   because a release includes each fix in a private fork that the file marks as reviewed without asking the maintainer
# - deleting with rm, find and the like outside the repository's worktrees and the temporary folders
# - making a gist public, and making a repository public or posting with gh to a repository other than this one, unless
#   the list of allowed repositories names it. The list is .loop/allowed-repositories in the main checkout, with one
#   owner/name to a line.
# - pushing to a URL instead of a remote, and a git push that can skip the leak scan: with --no-verify or a start of it,
#   such as --no-veri, or with git hooks other than the ones in scripts/git-hooks of a worktree of its repository
# - gh pr merge --admin, and changing the repository's rulesets or security settings with gh api, gh repo edit or
#   gh repo deploy-key
# - printing the whole environment with env or printenv, because it holds tokens
# A path or a repository that a variable other than HOME decides goes ahead, because the hook can't tell it before the
# command runs. A push is blocked, though, when the hook can't tell the folder that it runs in, or when git fails on the
# push's own words, because the hook can't ask git then which hooks the push would run. It's blocked too when its remote
# or a refspec has a variable, a $( ) or backticks, as read_push_arguments in helpers.bash describes.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"

# The flags that take a value, as gh repo create --help, gh repo edit --help and gh gist create --help list them.
repo_create_flags_with_value=" -d --description -g --gitignore -h --homepage -l --license -r --remote -s --source -t --team -p --template "
repo_edit_flags_with_value=" --add-topic --default-branch -d --description -h --homepage --remove-topic --squash-merge-commit-message --visibility "
gist_create_flags_with_value=" -d --desc -f --filename "

# The endpoints of gh api that hold the repository's rules and security settings, such as its rulesets, its deploy
# keys and the settings that scripts/configure-github turns on.
security_endpoint='rulesets|/protection|/collaborators|/keys|/hooks|actions/permissions|/environments|vulnerability-alerts|automated-security-fixes|private-vulnerability-reporting|code-scanning/default-setup'

# The words before git that set a variable which says where git's repository and its settings are, as git help git and
# git help config list them, and GIT_CONFIG_PARAMETERS, which holds the -c options that git passes on to the git
# commands it runs. The hook passes on only these variables to its own git, because others, such as PATH or
# LD_PRELOAD, could make the hook run a program that the command chooses.
git_location_variable='^(GIT_DIR|GIT_WORK_TREE|GIT_COMMON_DIR|GIT_CEILING_DIRECTORIES|GIT_DISCOVERY_ACROSS_FILESYSTEM|GIT_CONFIG_PARAMETERS|GIT_CONFIG_COUNT|GIT_CONFIG_KEY_[0-9]+|GIT_CONFIG_VALUE_[0-9]+|GIT_CONFIG_GLOBAL|GIT_CONFIG_SYSTEM|GIT_CONFIG_NOSYSTEM|HOME|XDG_CONFIG_HOME)='

ask="Ask the maintainer, and go on with the other work."
# AGENTS.md lets agents make public the repositories that they create from this template to test it.
test_repositories="If it's a repository that agents created from this template to test it, add its owner/name to .loop/allowed-repositories in the main checkout first. Otherwise, ask the maintainer, and go on with the other work."
security_change="Blocked: this changes the repository's rules or security settings, and only the maintainer may do that. $ask"

# The physical paths of the home folder and of the file of reviewed fixes, and the folders inside which an agent may
# delete, which is_settings_file, is_reviewed_fixes_file and may_delete find when they first need them.
physical_home=""
reviewed_fixes_file=""
deletable_folders=()

# Succeeds if a word is one of the others: is_one_of <word> <other>...
is_one_of() {
  local word=$1 other
  shift
  for other in "$@"; do
    if [[ $word == "$other" ]]; then
      return 0
    fi
  done
  return 1
}

# Prints the physical path that a word names, or fails when the hook can't tell it: when a variable other than HOME
# decides it, or when it's relative and the folder is unknown:
# resolved_path <word> <folder that a relative path starts from, or empty when the hook can't tell it>
resolved_path() {
  if ! expand_home "$1" || [[ $expanded_path != /* && -z $2 ]]; then
    return 1
  fi
  physical_path "$expanded_path" "$2"
}

# Blocks sudo, doas and su, also after env or NAME=value words: check_sudo <the words before the command's name>...
check_sudo() {
  local word name=${command_words[0]:-}
  name=${name##*/}
  # drop_command_prefixes drops each sudo before the command's name.
  for word in "$@"; do
    if [[ $word == sudo ]]; then
      name=sudo
    fi
  done
  if is_one_of "$name" sudo doas su; then
    block "Blocked: $name runs a command as another user, such as the machine's administrator, and only the maintainer may change the machine's settings or security. Do the work without $name, such as in the repository or a temporary folder, or ask the maintainer."
  fi
}

# Succeeds if command_words changes the machine's disks, settings or security. For a command that can also only read
# them, its first argument usually tells which, as in defaults read and defaults write.
changes_machine() {
  local name=${command_words[0]##*/} first=${command_words[1]:-} i word operand=""
  case $name in
    mkfs* | newfs* | fdisk | gpt | csrutil | spctl | systemsetup | nvram | kextload | kextunload | fdesetup | profiles | \
      chsh | dscl | passwd | shutdown | reboot | halt | ufw | iptables | pfctl | bless)
      return 0
      ;;
    diskutil) ! is_one_of "$first" list info activity ;;
    defaults) ! is_one_of "$first" read read-type domains find help ;;
    launchctl) ! is_one_of "$first" list print print-disabled getenv help version blame ;;
    crontab) [[ $first != -l ]] ;;
    pmset) [[ $first != -g ]] ;;
    scutil) ! is_one_of "$first" --get --dns --proxy --nwi -r ;;
    networksetup) [[ ! $first =~ ^-(list|get|print) ]] ;;
    softwareupdate) ! is_one_of "$first" -l --list --history ;;
    tmutil) ! is_one_of "$first" status listbackups latestbackup destinationinfo machinedirectory version ;;
    systemctl)
      # The first word that isn't an option, as in systemctl --user restart app
      for ((i = 1; i < ${#command_words[@]}; i++)); do
        if [[ ${command_words[i]} != -* ]]; then
          operand=${command_words[i]}
          break
        fi
      done
      ! is_one_of "$operand" "" status show cat list-units list-unit-files list-timers is-active is-enabled is-failed help
      ;;
    sysctl | dd)
      for ((i = 1; i < ${#command_words[@]}; i++)); do
        word=${command_words[i]}
        if [[ ($name == sysctl && ($word == -w || $word == *=*)) || ($name == dd && $word == of=/dev/*) ]]; then
          return 0
        fi
      done
      return 1
      ;;
    *) return 1 ;;
  esac
}

# Succeeds if the simple command prints the whole environment: env without a command, or printenv without a name.
# Run drop_command_prefixes first.
prints_environment() {
  local word
  if ((${#command_words[@]} == 0)); then
    [[ $runs_through_env == true ]]
    return
  fi
  if [[ ${command_words[0]##*/} != printenv ]]; then
    return 1
  fi
  # Any other word is a variable that printenv prints.
  for word in "${command_words[@]:1}"; do
    if [[ $word != -* ]]; then
      return 1
    fi
  done
}

# Succeeds if a physical path is a settings file of the machine or of a tool in the home folder: a file right in the
# home folder whose name starts with a dot, such as .zshrc, a file in .config/, .ssh/ or Library/LaunchAgents/, or the
# settings of Claude Code or Codex: is_settings_file <physical path>
is_settings_file() {
  local relative
  if [[ -z $physical_home ]]; then
    physical_home=$(physical_path "$HOME" /)
  fi
  if [[ $1 != "$physical_home"/* ]]; then
    return 1
  fi
  relative=${1#"$physical_home"/}
  [[ $relative =~ ^(\.[^/]+|\.config/.+|\.ssh/.+|\.claude/settings[^/]*\.json|\.codex/config\.toml|Library/LaunchAgents/.+)$ ]]
}

# Succeeds if a physical path is the file of reviewed fixes in the loop's folder, which step 1 of "Publish a release" in
# docs/releasing.md reads. A name in another case counts too, because macOS finds a file by its name in any case:
# is_reviewed_fixes_file <physical path>
is_reviewed_fixes_file() {
  local loop is_match=""
  shopt -s nocasematch
  # Only a path with the file's name makes the hook ask git for the loop's folder, which takes about 5 milliseconds.
  if [[ ${1##*/} == reviewed-fixes ]]; then
    if [[ -z $reviewed_fixes_file ]] && loop=$(hook_loop_folder); then
      reviewed_fixes_file=$(physical_path "$loop/reviewed-fixes" /)
    fi
    if [[ -n $reviewed_fixes_file && $1 == "$reviewed_fixes_file" ]]; then
      is_match=yes
    fi
  fi
  shopt -u nocasematch
  [[ -n $is_match ]]
}

# Blocks a write to a settings file in the home folder, and a write to the file of reviewed fixes unless the
# orchestrator's session writes it:
# block_if_protected_file <path as the command or the tool names it> <folder that a relative path starts from, or empty>
# [<the part of the action to log, if not the simple command>]
block_if_protected_file() {
  local path
  path=$(resolved_path "$1" "$2") || return 0
  if is_settings_file "$path"; then
    block "Blocked: $1 holds settings of the machine or of a tool, and only the maintainer may change them. $ask" ${3+"$3"}
  fi
  if is_reviewed_fixes_file "$path" && ! is_orchestrator; then
    block "Blocked: only the orchestrator writes $1, because a release includes each fix that it marks as reviewed without asking the maintainer. Go on with the other work, and list the change in your report." ${3+"$3"}
  fi
}

# Blocks cp, mv, install or ln when it writes a file that block_if_protected_file protects: the file that its last
# word names, or a file in the folder that its last word or -t names.
check_copy() {
  local name=${command_words[0]##*/} with_value=" -S --suffix " i word folder="" destination path source
  local -a operands=()
  if [[ $name == install ]]; then
    with_value+="-m --mode -o --owner -g --group "
  fi
  for ((i = 1; i < ${#command_words[@]}; i++)); do
    word=${command_words[i]}
    case $word in
      -t | --target-directory)
        folder=${command_words[i + 1]:-}
        i=$((i + 1))
        ;;
      --target-directory=*) folder=${word#*=} ;;
      -*)
        if [[ $with_value == *" $word "* ]]; then
          i=$((i + 1))
        fi
        ;;
      *) operands+=("$word") ;;
    esac
  done
  if [[ -z $folder ]]; then
    # With one word, ln makes the link in the folder that it runs in, and the other commands fail.
    if ((${#operands[@]} < 2)); then
      return 0
    fi
    destination=${operands[${#operands[@]} - 1]}
    unset 'operands[${#operands[@]} - 1]'
    path=$(resolved_path "$destination" "$command_folder") || return 0
    if [[ ! -d $path && $destination != */ ]]; then
      block_if_protected_file "$destination" "$command_folder"
      return 0
    fi
    folder=$destination
  fi
  for source in ${operands[@]+"${operands[@]}"}; do
    source=${source%/}
    block_if_protected_file "${folder%/}/${source##*/}" "$command_folder"
  done
}

# Blocks sed -i or perl -i when it changes a file that block_if_protected_file protects.
check_in_place_edit() {
  local name=${command_words[0]##*/} with_value in_place_option i word in_place=""
  local -a operands=()
  # -i, or a group of the options that take no value, such as sed -ni or perl -pi, also with a suffix, as in -i.bak
  case $name in
    sed)
      with_value=" -e --expression -f --file "
      in_place_option='^-[nrEsuz]*i'
      ;;
    perl)
      with_value=" -e -E "
      in_place_option='^-[pnaslwtTWX]*i'
      ;;
  esac
  for ((i = 1; i < ${#command_words[@]}; i++)); do
    word=${command_words[i]}
    if [[ $word != -* ]]; then
      operands+=("$word")
    elif [[ $with_value == *" $word "* ]]; then
      i=$((i + 1))
    elif [[ $word == --in-place || $word == --in-place=* || $word =~ $in_place_option ]]; then
      in_place=yes
      # The sed of macOS takes the word after -i as the suffix of a backup, such as '' or .bak.
      if [[ $name == sed && $word == -i ]] && [[ -z ${command_words[i + 1]:-} || ${command_words[i + 1]:-} == .* ]]; then
        i=$((i + 1))
      fi
    fi
  done
  if [[ -z $in_place ]]; then
    return 0
  fi
  # The first word can be the script rather than a file, but a script doesn't name a protected file.
  for word in ${operands[@]+"${operands[@]}"}; do
    block_if_protected_file "$word" "$command_folder"
  done
}

# Blocks git config when it changes the settings of git for the person, with --global, or for the machine, with
# --system. It allows reading them, as with --get or --list, or with a name and no value.
check_git_config() {
  local i word scope="" writes="" count=0 first=""
  for ((i = git_subcommand + 1; i < ${#command_words[@]}; i++)); do
    word=${command_words[i]}
    case $word in
      --global | --system) scope=$word ;;
      --get | --get-all | --get-regexp | --get-urlmatch | --get-color | --get-colorbool | -l | --list) return 0 ;;
      --add | --append | --replace-all | --unset | --unset-all | --rename-section | --remove-section | -e | --edit)
        writes=yes
        ;;
      # The options that take the next word as their value, as git config -h lists them
      -f | --file | --blob | --type | --default | --comment) i=$((i + 1)) ;;
      -*) ;;
      *)
        count=$((count + 1))
        if ((count == 1)); then
          first=$word
        fi
        ;;
    esac
  done
  if [[ -z $scope ]]; then
    return 0
  fi
  case $first in
    get | list) return 0 ;;
    set | unset | rename-section | remove-section | edit) writes=yes ;;
  esac
  if [[ -n $writes ]] || ((count > 1)); then
    block "Blocked: git config $scope changes the settings of git outside this repository, and only the maintainer may change them. $ask"
  fi
}

# Sets deletable_folders to the folders inside which an agent may delete: the repository's worktrees, the main checkout
# among them, and the temporary folders.
find_deletable_folders() {
  local line folder
  # The hook's own checkout counts too, in case git can't list the worktrees.
  deletable_folders=("$(physical_path "$hooks_folder/../.." /)")
  # git lists each worktree's physical path.
  while IFS= read -r line; do
    if [[ $line == "worktree "* ]]; then
      deletable_folders+=("${line#worktree }")
    fi
  done < <(git -C "$hooks_folder" worktree list --porcelain 2>/dev/null)
  for folder in "${TMPDIR:-/tmp}" /tmp /var/folders; do
    deletable_folders+=("$(physical_path "$folder" /)")
  done
}

# Succeeds if a command may delete a physical path: one inside the repository's worktrees or the temporary folders,
# or for find, which deletes only inside the folders that it starts from, one of those folders too:
# may_delete <physical path> <the command's name>
may_delete() {
  local folder
  if ((${#deletable_folders[@]} == 0)); then
    find_deletable_folders
  fi
  for folder in "${deletable_folders[@]}"; do
    if [[ $1 == "$folder"/* || ($2 == find && $1 == "$folder") ]]; then
      return 0
    fi
  done
  return 1
}

is_deleting_command() {
  is_one_of "$1" rm rmdir unlink shred srm trash
}

# Succeeds if the find command in command_words deletes what it finds, with -delete, or with -exec and the like
# followed by a command that deletes, as in -exec rm {} +.
find_deletes() {
  local i next
  for ((i = 1; i < ${#command_words[@]}; i++)); do
    case ${command_words[i]} in
      -delete) return 0 ;;
      -exec | -execdir | -ok | -okdir)
        next=${command_words[i + 1]:-}
        if is_deleting_command "${next##*/}"; then
          return 0
        fi
        ;;
    esac
  done
  return 1
}

# Sets delete_targets to the words of the command in command_words that name what it deletes: the words other than
# flags after rm and the like, and the folders that find starts from when it deletes what it finds:
# read_delete_targets <the command's name>
read_delete_targets() {
  local i
  delete_targets=()
  if is_deleting_command "$1"; then
    for ((i = 1; i < ${#command_words[@]}; i++)); do
      if [[ ${command_words[i]} != -* ]]; then
        delete_targets+=("${command_words[i]}")
      fi
    done
  elif [[ $1 == find ]] && find_deletes; then
    # The folders that find starts from come before its first expression, which starts with -, ( or !.
    for ((i = 1; i < ${#command_words[@]}; i++)); do
      if [[ ${command_words[i]} == [-\(\!]* ]]; then
        break
      fi
      delete_targets+=("${command_words[i]}")
    done
  fi
}

# Blocks a command that deletes outside the repository's worktrees and the temporary folders.
check_delete() {
  local name=${command_words[0]##*/} word path what
  read_delete_targets "$name"
  for word in ${delete_targets[@]+"${delete_targets[@]}"}; do
    path=$(resolved_path "$word" "$command_folder") || continue
    if may_delete "$path" "$name"; then
      continue
    fi
    what=$word
    if [[ $name == find ]]; then
      what="files in $word"
    fi
    block "Blocked: $name would delete $what, and only the maintainer may delete outside the repository, its worktrees and the temporary folders. Delete only inside them, or ask the maintainer."
  done
}

# Sets filled_in to a word with HOME filled in, as expand_home reads it, or to the word as the command writes it when
# expand_home can't read it: fill_in_home <word>
fill_in_home() {
  filled_in=$1
  if expand_home "$1"; then
    filled_in=$expanded_path
  fi
}

# Adds one of git's options before the subcommand to the array git_options, with its value when that's the next word,
# and sets option_words to the number of words that it took: add_git_option <option> <next word, or empty>
# It fills in HOME in the folder of -C, --git-dir and --work-tree, where the shell would: ~ at the start of a word, and
# $HOME and ${HOME}.
add_git_option() {
  local option=$1
  option_words=1
  case $option in
    -C | --git-dir | --work-tree)
      fill_in_home "$2"
      git_options+=("$option" "$filled_in")
      option_words=2
      return 0
      ;;
    --git-dir=* | --work-tree=*)
      # The shell fills in ~ only at the start of a word, so it leaves --git-dir=~/x as it is.
      if [[ ${option#*=} != "~"* ]]; then
        fill_in_home "${option#*=}"
        option=${option%%=*}=$filled_in
      fi
      ;;
  esac
  git_options+=("$option")
  if [[ $git_options_with_value == *" $option "* ]]; then
    git_options+=("$2")
    option_words=2
  fi
}

# Runs git as the git command in command_words runs, in command_folder, with its options before the subcommand and the
# variables in git_variables, but with other arguments. It fills in HOME where the shell would, in the folders, as
# add_git_option does, and in the variables' values, where ~ after NAME= counts too. Run it in a subshell, because it
# exports the variables: run_git_as_command <argument>...
run_git_as_command() {
  local assignment i=1
  for assignment in ${git_variables[@]+"${git_variables[@]}"}; do
    fill_in_home "${assignment#*=}"
    export "${assignment%%=*}=$filled_in"
  done
  git_options=()
  while ((i < git_subcommand)); do
    add_git_option "${command_words[i]}" "${command_words[i + 1]:-}"
    i=$((i + option_words))
  done
  # A config file that the command names, such as one in GIT_CONFIG_GLOBAL, could otherwise turn on git's trace2 output,
  # which git would write to a file that the config file chooses, even when the hook blocks the push.
  export GIT_TRACE2=0 GIT_TRACE2_EVENT=0 GIT_TRACE2_PERF=0
  git -C "$command_folder" ${git_options[@]+"${git_options[@]}"} "$@"
}

# Prints what run_git_as_command prints with the arguments, or fails and prints git's error on one line:
# ask_git_as_command <argument>...
ask_git_as_command() {
  local output
  if output=$(run_git_as_command "$@" 2>/dev/null); then
    printf '%s\n' "$output"
    return 0
  fi
  output=$(run_git_as_command "$@" 2>&1 >/dev/null) || true
  printf '%s\n' "${output//$'\n'/ }"
  return 1
}

# Blocks a push when git fails with its options and variables: block_unknown_hooks <git's error>
block_unknown_hooks() {
  local advice="Fix what git says."
  if [[ $1 == "fatal: cannot change to "* ]]; then
    advice="The hook asks git before any part of the command runs, so if the command creates that folder, push in a command of its own after it."
  fi
  block "Blocked: the hook can't tell which git hooks this push would run, so it can't check that the pre-push hook scans the push for leaks. git fails with the push's options and the variables before git, as the command writes them: $1. $advice The hook fills in only HOME, in folders and in the variables before git, and runs no \$( ), so write any other variable or \$( ) in those words out in full."
}

# Blocks a push that would run git hooks other than the ones in scripts/git-hooks of the main checkout or another
# worktree of its repository, because only those scan the push for leaks. git takes the folder from core.hooksPath,
# which the repository's config, an included file, -c, --config-env and the variables before git can set, or else uses
# .git/hooks. A relative core.hooksPath starts from the folder that the push runs in, which -C, --git-dir and
# --work-tree can move. So the hook asks git, with the push's options and variables as the command writes them, but
# with HOME filled in, as run_git_as_command describes. It doesn't see the variables that an earlier part of the command
# exports. env's -i and -u don't count either, because they only take variables away, and of these variables the
# agent's environment usually holds only HOME: check_push_hooks <word that sets a variable for git>...
check_push_hooks() {
  local word hooks worktrees physical_hooks line
  git_variables=()
  for word in "$@"; do
    if [[ $word =~ $git_location_variable ]]; then
      git_variables+=("$word")
    fi
  done
  if [[ -z $command_folder ]]; then
    block "Blocked: the hook can't tell which folder this push runs in, so it can't check that the pre-push hook scans the push for leaks. Push in a folder that exists, and name it without variables or \$( ), as in git -C <folder> push."
  fi
  if ! hooks=$(ask_git_as_command rev-parse --path-format=absolute --git-path hooks); then
    block_unknown_hooks "$hooks"
  fi
  if ! worktrees=$(ask_git_as_command worktree list --porcelain); then
    block_unknown_hooks "$worktrees"
  fi
  physical_hooks=$(physical_path "$hooks" /)
  while IFS= read -r line; do
    if [[ $line == "worktree "* && $(physical_path "${line#worktree }/scripts/git-hooks" /) == "$physical_hooks" ]]; then
      return 0
    fi
  done <<<"$worktrees"
  block "Blocked: this push would run the git hooks in $hooks, not the ones in scripts/git-hooks of the repository's main checkout or of one of its worktrees, so the pre-push hook wouldn't scan the push for leaks. If the repository's core.hooksPath names another folder, or none, run scripts/install-git-hooks. Push from the main checkout or a worktree, without setting core.hooksPath for the push."
}

# check_git_push <word that sets a variable for git>...
check_git_push() {
  read_push_arguments
  if has_git_flag --no-verify; then
    block "Blocked: --no-verify skips the pre-push hook, which scans the push for leaks. Push without it. If the scan finds a leak, take it out of the commits."
  fi
  check_push_hooks "$@"
  # A URL, or an address such as git@github.com:owner/name.git
  if [[ $push_remote == *://* || $push_remote =~ ^[^/]+@[^/]+: ]]; then
    block "Blocked: this pushes to a URL instead of a remote, and only the maintainer may do that. Push to a remote that git remote -v lists, such as origin, or ask the maintainer."
  fi
}

# Sets name_with_owner to owner/name of a repository as gh or git names it: owner/name, host/owner/name, a URL such as
# https://github.com/owner/name/issues/5, or an address such as git@github.com:owner/name.git:
# read_name_with_owner <repository>
read_name_with_owner() {
  local name=$1 owner
  if [[ $name =~ ^[A-Za-z][A-Za-z0-9+.-]*://[^/]+/([^/]+/[^/]+) ]]; then
    name=${BASH_REMATCH[1]}
  elif [[ $name =~ ^[^/]+:(.+)$ ]]; then
    name=${BASH_REMATCH[1]}
  fi
  name=${name%/}
  name=${name%.git}
  if [[ $name == */*/* ]]; then
    owner=${name%/*}
    name=${owner##*/}/${name##*/}
  fi
  name_with_owner=$name
}

# Succeeds if the list of allowed repositories names a repository, in any case. HOOK_ALLOWED_REPOSITORIES names another
# list, as in the hooks' tests: is_allowed <repository>
is_allowed() {
  local wanted list=${HOOK_ALLOWED_REPOSITORIES:-} line
  if [[ -z $1 ]]; then
    return 1
  fi
  read_name_with_owner "$1"
  wanted=$name_with_owner
  if [[ -z $list ]]; then
    list=$(hook_loop_folder)/allowed-repositories || return 1
  fi
  if [[ ! -f $list ]]; then
    return 1
  fi
  shopt -s nocasematch
  while read -r line || [[ -n $line ]]; do
    read_name_with_owner "$line"
    if [[ -n $line && $name_with_owner == "$wanted" ]]; then
      shopt -u nocasematch
      return 0
    fi
  done <"$list"
  shopt -u nocasematch
  return 1
}

# Succeeds if an agent may post to a repository, as gh or git names it: this hook's repository, which its origin names,
# or one that the list of allowed repositories names. Without an origin, the hook can't tell which repository is this
# one, so it allows them all: may_post_to <repository>
may_post_to() {
  local origin
  origin=$(git -C "$hooks_folder" remote get-url origin 2>/dev/null) || return 0
  read_name_with_owner "$origin"
  origin=$name_with_owner
  read_name_with_owner "$1"
  shopt -s nocasematch
  if [[ $name_with_owner == "$origin" ]]; then
    shopt -u nocasematch
    return 0
  fi
  shopt -u nocasematch
  is_allowed "$1"
}

# Blocks making a repository public, unless the list of allowed repositories names it:
# block_if_public_unless_allowed <repository, or empty when the command names none> <what the message calls it then>
block_if_public_unless_allowed() {
  local name=$2
  if is_allowed "$1"; then
    return 0
  fi
  if [[ -n $1 ]]; then
    read_name_with_owner "$1"
    name=$name_with_owner
  fi
  block "Blocked: this makes $name public, and only the maintainer may make a repository public. $test_repositories"
}

check_repo_create() {
  read_arguments 3 "$repo_create_flags_with_value"
  if has_true_flag "$repo_create_flags_with_value" --public; then
    block_if_public_unless_allowed "$argument" "a new repository"
  fi
}

check_repo_edit() {
  local i visibility=""
  read_arguments 3 "$repo_edit_flags_with_value"
  for ((i = 0; i < ${#flags[@]}; i++)); do
    case ${flags[i]} in
      --visibility) visibility=${flag_values[i]} ;;
      --visibility=*) visibility=${flags[i]#--visibility=} ;;
      --enable-secret-scanning=false | --enable-secret-scanning-push-protection=false | --enable-advanced-security=false)
        block "$security_change"
        ;;
    esac
  done
  if [[ $visibility == public ]]; then
    block_if_public_unless_allowed "$argument" "this repository"
  fi
}

check_gh_api() {
  local i field="" makes_public=""
  read_arguments 2 "$api_flags_with_value"
  read_api_method
  if [[ $api_method == GET ]]; then
    return 0
  fi
  if [[ $argument =~ $security_endpoint ]]; then
    block "$security_change"
  fi
  for ((i = 0; i < ${#last_flags[@]}; i++)); do
    case ${last_flags[i]} in
      -f | -F | --field | --raw-field) field=${flag_values[i]} ;;
      *) continue ;;
    esac
    case $field in
      security_and_analysis*) block "$security_change" ;;
      private=false | visibility=public) makes_public=yes ;;
    esac
  done
  if [[ -n $makes_public ]]; then
    find_destination
    block_if_public_unless_allowed "$destination" "a repository"
  fi
}

# Succeeds if the gh command in command_words can post or change something on GitHub, rather than only read it or
# print its help.
# For gh api, run read_arguments and read_api_method first.
gh_posts() {
  if prints_help; then
    return 1
  fi
  case ${command_words[1]:-} in
    api) [[ $api_method != GET ]] ;;
    "" | -* | search | status | browse | auth | config | alias | extension | completion | help | version) return 1 ;;
    *)
      case ${command_words[2]:-} in
        "" | -* | list | view | status | diff | checks | check | download | watch | clone | checkout) return 1 ;;
      esac
      ;;
  esac
}

# The flags that take text, which can hold the URL of an issue of another repository, of the gh commands whose flags the
# hooks don't list
text_flags=" -b --body -t --title -c -F --body-file --description -n --notes --notes-file --template "

# Sets destination to the repository that a gh command posts to, as the command or git names it, or to empty when the
# hook can't tell. gh takes the repository from the first of these that it finds:
# - the endpoint of gh api, such as repos/owner/name/issues, unless it's repos/{owner}/{repo}
# - for any other command, the repository that gh repo edit and the like take, -R or --repo, or the URL of an issue or
#   a pull request
# - GH_REPO, whose value check_gh puts in gh_repo
# - the remote named origin of the folder that the command runs in
# It also sets guessed_repositories, as find_named_repository describes.
# For gh api, run read_arguments first.
find_destination() {
  local origin
  destination="" guessed_repositories=()
  if [[ ${command_words[1]:-} == api ]]; then
    if [[ ! $argument =~ ^/?repos/([^/]+/[^/?#]+) ]]; then
      return 0
    fi
    if [[ ${BASH_REMATCH[1]} != "{owner}/{repo}" ]]; then
      destination=${BASH_REMATCH[1]}
      return 0
    fi
  else
    find_named_repository
  fi
  if [[ -n $destination ]]; then
    return 0
  fi
  if [[ -n $gh_repo ]]; then
    destination=$gh_repo
    return 0
  fi
  if [[ -z $command_folder ]]; then
    return 0
  fi
  origin=$(git -C "$command_folder" remote get-url origin 2>/dev/null) || return 0
  # gh posts to a repository on a host, such as https://github.com/owner/name or git@github.com:owner/name, and fails
  # for a repository in a local folder.
  if [[ $origin =~ ^(https?|ssh|git):// || ($origin != *://* && $origin =~ ^[^/]+:) ]]; then
    destination=$origin
  fi
}

# Sets command_flags_with_value to the flags that take a value of the gh command in command_words, from the lists in
# helpers.bash, or to empty when the hooks list no flags of the command.
read_command_flags_with_value() {
  case "${command_words[1]:-} ${command_words[2]:-}" in
    "issue create" | "issue new") command_flags_with_value=$issue_create_flags_with_value ;;
    "issue edit") command_flags_with_value=$issue_edit_flags_with_value ;;
    "issue close") command_flags_with_value=$issue_close_flags_with_value ;;
    "issue develop") command_flags_with_value=$develop_flags_with_value ;;
    "issue comment" | "pr comment") command_flags_with_value=$comment_flags_with_value ;;
    "issue reopen" | "pr reopen") command_flags_with_value=$reopen_flags_with_value ;;
    "pr create" | "pr new") command_flags_with_value=$pr_create_flags_with_value ;;
    "pr edit") command_flags_with_value=$pr_edit_flags_with_value ;;
    "pr review") command_flags_with_value=$review_flags_with_value ;;
    "pr close") command_flags_with_value=$pr_close_flags_with_value ;;
    "pr merge") command_flags_with_value=$merge_flags_with_value ;;
    *) command_flags_with_value="" ;;
  esac
}

# Sets destination to the repository that gh repo edit, delete, archive or unarchive in command_words takes as its
# argument, or to empty for another command or when the command names none. These commands take no -R.
read_repository_argument() {
  destination=""
  case "${command_words[1]:-} ${command_words[2]:-}" in
    "repo edit")
      read_arguments 3 "$repo_edit_flags_with_value"
      destination=$argument
      ;;
    "repo delete" | "repo archive" | "repo unarchive")
      read_arguments 3 " "
      destination=$argument
      ;;
  esac
}

# Adds the repository of each -R and --repo that read_arguments found to guessed_repositories.
add_guessed_repositories() {
  local i
  for ((i = 0; i < ${#last_flags[@]}; i++)); do
    if [[ ${last_flags[i]} == -R || ${last_flags[i]} == --repo ]]; then
      guessed_repositories+=("${flag_values[i]}")
    fi
  done
}

# Adds to guessed_repositories the repository of each -R and --repo after the first word with an expansion, which it
# reads as read_arguments reads a command whose flags the hooks don't list. Once the shell expands that word, it can
# become nothing, become a flag that takes a value, or end in a flag that takes no value or one whose value is the next
# word, as -${letters}b and -b$text can. Then gh can read a word as a flag that the hook reads as a flag's value, as in
# -b $text -b -Rowner/name. It sets the variables of read_arguments anew.
# A word with an expansion is one that the splitter marks, or one that holds $, {, *, ? or [, because the splitter
# doesn't mark ANSI-C quoting, locale quoting, brace expansion or a pattern, as in $'-b', $"-b", {-b,} and -[b].
add_repositories_after_expansions() {
  local i
  for ((i = 2; i < ${#command_words[@]}; i++)); do
    if [[ -n ${command_word_may_expand[i]:-} || ${command_words[i]} == *[\$\{\*\?\[]* ]]; then
      read_arguments $((i + 1)) " -R --repo "
      add_guessed_repositories
      return 0
    fi
  done
}

# Sets destination to the repository that the words of a gh command other than gh api name, or to empty. It reads -R
# and --repo as read_arguments in helpers.bash reads them, with the command's flags that take a value, and takes the
# last of them, as gh does.
# A later -R can be part of the value of a flag before it, and gh then takes an earlier -R. The hook can't tell this
# when a word with an expansion becomes nothing, so that the -R after it becomes the value of the flag before it. So the
# function adds the repository of each -R and --repo to guessed_repositories, which must all be allowed. It also adds
# that of each -R that gh can read as a flag after a word with an expansion, as add_repositories_after_expansions
# describes.
# For a command whose flags the hooks don't list, it reads each flag other than -R and --repo as one that takes no
# value, as in -dRowner/name, which it reads as -d -R owner/name. Then any -R can be part of the value of a flag before
# it, in the same word or the word before, and without another -R, gh posts to the repository that the command names
# without -R. So for such a command, the function goes on as if the command gave no -R.
find_named_repository() {
  local i word command_flags_with_value
  guessed_repositories=()
  read_repository_argument
  if [[ -n $destination ]]; then
    return 0
  fi
  read_command_flags_with_value
  add_repositories_after_expansions
  read_arguments 2 "${command_flags_with_value:-" -R --repo "}"
  add_guessed_repositories
  if [[ -n $command_flags_with_value ]] && ((${#repository[@]} > 0)); then
    destination=${repository[1]}
    return 0
  fi
  if [[ ${command_words[1]:-} == repo ]]; then
    return 0
  fi
  # The URL can stand anywhere among the words after the subcommand.
  for ((i = 3; i < ${#command_words[@]}; i++)); do
    word=${command_words[i]}
    if is_flag_before_value "$word" "$command_flags_with_value"; then
      i=$((i + 1))
    elif [[ $word =~ ^https?://[^/]+/[^/]+/[^/]+ ]]; then
      destination=$word
      return 0
    fi
  done
}

# Succeeds if gh reads the word after a word of a gh command as the value of a flag that the word ends in. It reads the
# word as split_flag_word does, with the command's flags that take a value. For a command whose flags the hooks don't
# list, it reads only a word in text_flags as such a flag:
# is_flag_before_value <word> <the command's flags that take a value, or empty>
is_flag_before_value() {
  local flag value value_is_next_word flags_before
  if [[ -z $2 ]]; then
    [[ $text_flags == *" $1 "* ]]
    return
  fi
  if [[ $1 != -* ]]; then
    return 1
  fi
  split_flag_word "$1" "$2"
  [[ -n $value_is_next_word ]]
}

# Blocks a post to a repository other than this one, unless the list of allowed repositories names it. It allows the
# post when the hook can't tell the repository: block_if_other_repository <repository, or empty>
block_if_other_repository() {
  if [[ -z $1 || $1 == *[\$\`]* ]] || may_post_to "$1"; then
    return 0
  fi
  read_name_with_owner "$1"
  block "Blocked: this posts to $name_with_owner, which isn't this repository, and only the maintainer may post to another repository. $test_repositories"
}

# Blocks a gh command that posts to a repository other than this one, unless the list of allowed repositories names
# it. When a -R of the command can be part of the value of a flag before it, the command can post to the repository of
# any -R, or to the one it names without -R, so all of them must be allowed.
check_destination() {
  local guessed
  if ! gh_posts; then
    return 0
  fi
  find_destination
  for guessed in ${guessed_repositories[@]+"${guessed_repositories[@]}"}; do
    block_if_other_repository "$guessed"
  done
  block_if_other_repository "$destination"
}

# check_gh <word that sets a variable for gh, such as GH_REPO=owner/name>...
check_gh() {
  local word
  gh_repo=""
  for word in "$@"; do
    if [[ $word == GH_REPO=* ]]; then
      gh_repo=${word#GH_REPO=}
    fi
  done
  move_flags_after_gh_subcommand
  case "${command_words[1]:-} ${command_words[2]:-}" in
    "pr merge")
      read_arguments 3 "$merge_flags_with_value"
      if has_true_flag "$merge_flags_with_value" --admin; then
        block "Blocked: --admin merges the pull request without the checks that main requires, and only the maintainer may skip them. Merge without --admin, so that the merge waits for the checks."
      fi
      ;;
    "repo create" | "repo new") check_repo_create ;;
    "repo edit") check_repo_edit ;;
    "repo deploy-key")
      if [[ ${command_words[3]:-} == add || ${command_words[3]:-} == delete ]]; then
        block "$security_change"
      fi
      ;;
    "gist create" | "gist new")
      read_arguments 3 "$gist_create_flags_with_value"
      if has_true_flag "$gist_create_flags_with_value" -p --public; then
        block "Blocked: this makes a gist public, and only the maintainer may make something public outside this repository. $ask"
      fi
      ;;
    "api "*) check_gh_api ;;
  esac
  check_destination
}

check_simple_command() {
  local prefix_count file i
  drop_command_prefixes "$@"
  # The words that drop_command_prefixes dropped, such as sudo or env
  prefix_count=$(($# - ${#command_words[@]}))
  check_sudo "${@:1:prefix_count}"
  written_files=()
  record_written_files
  for file in ${written_files[@]+"${written_files[@]}"}; do
    block_if_protected_file "$file" "$command_folder"
  done
  if prints_environment; then
    # bash -c, because zsh has no compgen.
    block "Blocked: this command prints the whole environment, which holds tokens. Print only the variables you need, by name, as in printenv PATH. To list the variables' names without their values, run bash -c 'compgen -e'."
  fi
  if ((${#command_words[@]} == 0)); then
    return 0
  fi
  if changes_machine; then
    block "Blocked: this ${command_words[0]##*/} command changes the machine's disks, settings or security, and only the maintainer may do that. $ask"
  fi
  case ${command_words[0]##*/} in
    tee)
      for ((i = 1; i < ${#command_words[@]}; i++)); do
        if [[ ${command_words[i]} != -* ]]; then
          block_if_protected_file "${command_words[i]}" "$command_folder"
        fi
      done
      ;;
    cp | mv | install | ln) check_copy ;;
    sed | perl) check_in_place_edit ;;
    git)
      read_git_options
      case ${command_words[git_subcommand]:-} in
        push) check_git_push ${assignment_words[@]+"${assignment_words[@]}"} ;;
        config) check_git_config ;;
      esac
      ;;
    gh) check_gh ${assignment_words[@]+"${assignment_words[@]}"} ;;
  esac
  check_delete
  follow_cd
}

read_input
case $tool_name in
  Bash)
    command_folder=${cwd:-$PWD}
    for_each_simple_command check_simple_command "$shell_command"
    ;;
  Write | Edit | apply_patch)
    read_tool_paths
    for path in ${tool_paths[@]+"${tool_paths[@]}"}; do
      block_if_protected_file "$path" "${cwd:-$PWD}" "$path"
    done
    ;;
esac
