#!/usr/bin/env bash
# Tests scripts/hooks/forbidden-commands.check through scripts/hooks/before-tool.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"

# The agent works in the repository project, next to the repository other, in a temporary folder.
# git looks for no repository above that folder, and reads none of the person's settings.
base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT
export GIT_CEILING_DIRECTORIES=$base GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
test_cwd=$base/project
other=$base/other
git init --quiet "$test_cwd"
git init --quiet "$other"
# git runs each repository's hooks in its scripts/git-hooks, so that scripts/hooks/maintainer-only.check lets the pushes
# go ahead. The paths are absolute, because a push from project with --git-dir=../other/.git would run project's hooks
# from a relative one.
git -C "$test_cwd" config core.hooksPath "$test_cwd/scripts/git-hooks"
git -C "$other" config core.hooksPath "$other/scripts/git-hooks"

# A stand-in for gh, first on the PATH, so that the cases ask nothing of GitHub. It records each call in TEST_GH_CALLS.
# It has no #! line, so that the check takes it for the gh program rather than for a script that runs another gh. bash
# runs a file without one as a bash script.
# - gh --version reports the version in TEST_GH_VERSION, or fails if that says fail. If TEST_GH_UPDATE_TO names a
#   file, it first points the link that it ran from at that file, as an update that ends while gh --version runs.
# - gh pr view about pull request 7, or the current branch's, reports the author in TEST_AUTHOR: dependabot, person
#   or fail.
# - gh issue view about issue 12 reports the labels in TEST_LABELS, separated by spaces, or fails if that says fail.
# It fails for anything else, as gh does for a pull request or an issue that doesn't exist.
stand_in=$base/bin
mkdir -p "$stand_in"
cat >"$stand_in/gh" <<'STAND_IN'
printf '%s\n' "$*" >>"$TEST_GH_CALLS"
if [[ $1 == --version && -n ${TEST_GH_UPDATE_TO:-} ]]; then
  ln -sf "$TEST_GH_UPDATE_TO" "$0"
fi
if [[ $1 == --version && $TEST_GH_VERSION != fail ]]; then
  echo "gh version $TEST_GH_VERSION (2026-08-20)"
  echo "https://github.com/cli/cli/releases/tag/v$TEST_GH_VERSION"
elif [[ $1 == pr && $2 == view && ($3 == -* || $3 == 7) ]]; then
  case $TEST_AUTHOR in
    dependabot) echo '{"author": {"is_bot": true, "login": "app/dependabot"}}' ;;
    person) echo '{"author": {"is_bot": false, "login": "jtmpl", "name": "Jacob Templeton"}}' ;;
    *) exit 1 ;;
  esac
elif [[ $1 == issue && $2 == view && $3 == 12 && $TEST_LABELS != fail ]]; then
  jq -n --arg names "$TEST_LABELS" '{labels: [$names | splits(" ") | select(. != "") | {name: .}]}'
else
  exit 1
fi
STAND_IN
chmod +x "$stand_in/gh"
PATH=$stand_in:$PATH
export TEST_GH_CALLS=$base/gh-calls TEST_GH_VERSION TEST_AUTHOR TEST_LABELS

# Checks that the hook asks gh about the pull request or the issue of a command: expect_gh_call <command> <arguments of the call>
expect_gh_call() {
  : >"$TEST_GH_CALLS"
  run_hook "$(sample_input claude-code Bash "$1")"
  case_count=$((case_count + 1))
  if ! grep -qxF -e "$2" "$TEST_GH_CALLS"; then
    echo "error: for $1, the hook must call gh $2, but it called: $(tr '\n' ';' <"$TEST_GH_CALLS")" >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# Every gh command while gh is older than the rules need
TEST_GH_VERSION=2.97.0 TEST_AUTHOR=person TEST_LABELS=feature
old_gh="Blocked: the rules in AGENTS.md need gh 2.98 or later, and this machine has gh 2.97.0. Tell the maintainer, and that https://github.com/cli/cli#installation says how to update it."
expect_block Bash 'gh pr list' "$old_gh"
expect_block Bash 'gh --version' "$old_gh"
expect_block Bash 'git status && /usr/local/bin/gh issue view 12' "$old_gh"
expect_allow Bash 'git status'
TEST_GH_VERSION=1.99.0
expect_block Bash 'gh pr list' "${old_gh/2.97.0/1.99.0}"
for TEST_GH_VERSION in 2.98.0 2.102.0 3.0.0 "that can't be read" fail; do
  expect_allow Bash 'gh pr list'
done

# Runs the hook on gh pr list, and checks its result and whether it ran gh --version:
# expect_version_run <description> <exit code> <message> <yes or no>
expect_version_run() {
  local description=$1 status=$2 message=$3 must_run=$4 ran=no
  : >"$TEST_GH_CALLS"
  run_hook "$(sample_input claude-code Bash 'gh pr list')"
  expect_result "$description, the hook for gh pr list" "$status" "$message"
  if grep -qxF -e --version "$TEST_GH_CALLS"; then
    ran=yes
  fi
  case_count=$((case_count + 1))
  if [[ $ran != "$must_run" ]]; then
    echo "error: $description, whether the hook for gh pr list runs gh --version must be $must_run, but it was $ran." >&2
    failed_cases=$((failed_cases + 1))
  fi
}

# gh --version runs again only when the hook finds another gh. The hook records the gh in the loop's folder.
unset HOOK_GH_VERSION_FILE
export LOOP_DIR=$base/loop
TEST_GH_VERSION=2.98.0
expect_version_run "With no gh recorded" 0 "" yes
expect_version_run "With the same gh" 0 "" no
# A package manager can give the new file the package's time, which is older than the file before.
TEST_GH_VERSION=2.97.0
touch -t 200001010000 "$stand_in/gh"
expect_version_run "After an update to an older gh" 2 "$old_gh" yes
expect_version_run "With the same old gh" 2 "$old_gh" no
TEST_GH_VERSION=2.98.0
cp -p "$stand_in/gh" "$base/gh-update"
mv "$base/gh-update" "$stand_in/gh"
expect_version_run "After an update to a new file with the old file's time" 0 "" yes
expect_version_run "With the same updated gh" 0 "" no
mkdir "$base/other-bin"
ln -s "$stand_in/gh" "$base/other-bin/gh"
PATH=$base/other-bin:$PATH
expect_version_run "With the same file at another path" 0 "" yes
PATH=${PATH#"$base/other-bin:"}
expect_version_run "With the file at its first path again" 0 "" yes
# A record that another hook is still writing lacks the end of its version.
record=$(<"$LOOP_DIR/gh-version")
printf '%s' "${record%8.0 *}" >"$LOOP_DIR/gh-version"
expect_version_run "With an incomplete record" 0 "" yes
expect_version_run "With the record complete again" 0 "" no
# A version manager's shim runs the gh that the project's settings pick, so the version changes while the shim stays
# the same. Such a shim is a link to the version manager, as mise's are, a script, as asdf's are, or a program in a
# folder named shims.
mkdir -p "$base/mise/bin" "$base/linked-shim" "$base/script-shim" "$base/manager/shims"
cp "$stand_in/gh" "$base/mise/bin/mise"
ln -s "$base/mise/bin/mise" "$base/linked-shim/gh"
{
  echo '#!/usr/bin/env bash'
  cat "$stand_in/gh"
} >"$base/script-shim/gh"
chmod +x "$base/script-shim/gh"
cp "$stand_in/gh" "$base/manager/shims/gh"
for shim in linked-shim script-shim manager/shims; do
  PATH=$base/$shim:$PATH
  TEST_GH_VERSION=2.98.0
  expect_version_run "With the gh in $shim" 0 "" yes
  TEST_GH_VERSION=2.90.0
  expect_version_run "After the gh in $shim picks an older gh" 2 "${old_gh/2.97.0/2.90.0}" yes
  PATH=${PATH#"$base/$shim:"}
done
# After an update that ends while gh --version runs, the version can be either gh's.
mkdir -p "$base/cellar/2.97.0" "$base/cellar/2.98.0" "$base/linked-bin"
cp "$stand_in/gh" "$base/cellar/2.97.0/gh"
cp "$stand_in/gh" "$base/cellar/2.98.0/gh"
ln -s "$base/cellar/2.97.0/gh" "$base/linked-bin/gh"
PATH=$base/linked-bin:$PATH
export TEST_GH_UPDATE_TO=$base/cellar/2.98.0/gh
TEST_GH_VERSION=2.98.0
expect_version_run "With an update that ends while gh --version runs" 0 "" yes
unset TEST_GH_UPDATE_TO
ln -sf "$base/cellar/2.97.0/gh" "$base/linked-bin/gh"
TEST_GH_VERSION=2.97.0
expect_version_run "With the gh from before that update again" 2 "$old_gh" yes
PATH=${PATH#"$base/linked-bin:"}
export HOOK_GH_VERSION_FILE=/dev/null
TEST_GH_VERSION=2.98.0

# Approving a workflow run
approval="Blocked: a maintainer decides whether to approve a workflow run, because the run executes the code of a pull request from outside the project. Go on with the other work, and list the run in your report for the maintainer."
expect_block Bash 'gh api -X POST repos/{owner}/{repo}/actions/runs/123/approve' "$approval"
expect_block Bash 'gh api --method=POST /repos/jtmpl/project/actions/runs/123/approve' "$approval"
expect_block Bash 'gh api repos/jtmpl/project/actions/runs/123/approve --method POST --silent' "$approval"
expect_block Bash 'gh api -H "Accept: application/vnd.github+json" -X POST repos/jtmpl/project/actions/runs/123/approve' "$approval"
expect_allow Bash 'gh api repos/{owner}/{repo}/actions/runs/123'
expect_allow Bash 'gh api -X POST repos/{owner}/{repo}/actions/runs/123/rerun'

# Closing one of Dependabot's pull requests
TEST_AUTHOR=dependabot
from_dependabot="is one of Dependabot's, and closing it makes Dependabot stop offering that version. Leave it open, because Dependabot closes it once main has the update."
expect_block Bash 'gh pr close 7' "Blocked: pull request 7 $from_dependabot"
expect_block Bash 'gh pr close --comment "Superseded by #8" 7' "Blocked: pull request 7 $from_dependabot"
expect_block Bash 'gh pr close 7 --delete-branch' "Blocked: pull request 7 $from_dependabot"
expect_block Bash 'gh pr close' "Blocked: this branch's pull request $from_dependabot"
expect_block Bash 'gh pr close -R jtmpl/other 7' "Blocked: pull request 7 $from_dependabot"
expect_gh_call 'gh pr close -R jtmpl/other 7' "pr view 7 --repo jtmpl/other --json author"
expect_repository_flags 2 "Blocked: pull request 7 $from_dependabot" pr close '7'
for repository in '-R jtmpl/other' '--repo jtmpl/other' '--repo=jtmpl/other'; do
  expect_gh_call "gh pr $repository close 7" "pr view 7 --repo jtmpl/other --json author"
done
# A word can hold several short flags, and a value for the last of them, as split_flag_word in helpers.bash reads it.
# The -c of gh pr close takes a comment, and its -d takes no value.
for repository in -Rjtmpl/other -R=jtmpl/other -dRjtmpl/other '-dR jtmpl/other'; do
  expect_gh_call "gh pr close 7 $repository" "pr view 7 --repo jtmpl/other --json author"
done
expect_gh_call 'gh pr close 7 -cRjtmpl/other' "pr view 7 --json author"
expect_block Bash 'gh pr close -dc "Superseded by #8" 7' "Blocked: pull request 7 $from_dependabot"
expect_allow Bash 'gh pr view 7'
expect_allow Bash 'gh pr comment 7 --body "@dependabot rebase"'
# The orchestrator merges Dependabot's pull requests, as "Stuck pull requests" in docs/loop.md describes.
expect_allow Bash 'gh pr merge 7'
expect_allow Bash 'gh pr merge 7 --disable-auto'
expect_allow Bash 'scripts/merge-dependabot-pull-requests'
for TEST_AUTHOR in person fail; do
  expect_allow Bash 'gh pr close 7'
  expect_allow Bash 'gh pr close'
done

# Pushing to a dependabot/ branch
dependabot_branch=dependabot/npm_and_yarn/lodash-4.17.21
to_dependabot="Blocked: $dependabot_branch is the branch of one of Dependabot's pull requests, and Dependabot stops rebasing a pull request once someone else pushes to it. Make the update in a pull request of your own instead, as \"Stuck pull requests\" in docs/loop.md describes."
git -C "$test_cwd" symbolic-ref HEAD refs/heads/383-block-commands
git -C "$other" symbolic-ref HEAD refs/heads/main
pushes_to_dependabot=(
  "git push origin $dependabot_branch"
  "git push origin HEAD:$dependabot_branch"
  "git push --force origin +HEAD:refs/heads/$dependabot_branch"
  "git push origin --delete $dependabot_branch"
  "git push origin :$dependabot_branch"
  "git push origin main $dependabot_branch"
  "git -C ../other push origin $dependabot_branch"
  "git -c color.ui=never push origin $dependabot_branch"
)
for command in "${pushes_to_dependabot[@]}"; do
  expect_block Bash "$command" "$to_dependabot"
done
for command in 'git push' 'git push origin' 'git push -u origin HEAD' 'git push origin 383-block-commands' \
  'git push origin dependabot-notes' 'git -C ../other push'; do
  expect_allow Bash "$command"
done
# Without a refspec, or with HEAD, git pushes the current branch.
git -C "$test_cwd" symbolic-ref HEAD "refs/heads/$dependabot_branch"
for command in 'git push' 'git push origin' 'git push -u origin HEAD' 'git push -o ci.skip origin' 'git push --force-with-lease origin'; do
  expect_block Bash "$command" "$to_dependabot"
done
expect_allow Bash 'git push origin main'
expect_allow Bash 'git -C ../other push'
expect_allow Bash 'git --git-dir=../other/.git push'
expect_allow Bash 'git status'
git -C "$test_cwd" symbolic-ref HEAD refs/heads/383-block-commands
git -C "$other" symbolic-ref HEAD "refs/heads/$dependabot_branch"
expect_block Bash 'git -C ../other push' "$to_dependabot"
# git takes a relative --git-dir from the folder after every -C, wherever the -C stands.
expect_block Bash 'git --git-dir ../other/.git push' "$to_dependabot"
expect_block Bash 'git --git-dir=other/.git -C .. push' "$to_dependabot"
expect_allow Bash 'git push'

# Publishing a release or putting a version tag on GitHub. The orchestrator's session is the one that the state file
# names. A builder runs as a subagent of that session, with an agent id of its own, or in a session of its own. The
# project has the version tag v1.0.0, another tag, and a branch whose name starts with v.
orchestrator=11111111-aaaa-4bbb-8ccc-000000000001
mkdir -p "$LOOP_DIR"
printf '%s\n' "session: $orchestrator" "goal: the release" >"$LOOP_DIR/state.md"
git -C "$test_cwd" -c user.name=Tester -c user.email=tester@example.com commit --quiet --allow-empty -m "chore: start"
git -C "$test_cwd" tag v1.0.0
git -C "$test_cwd" tag notes-draft
git -C "$test_cwd" branch validate-input
publishes_release="Blocked: only the orchestrator publishes a release or a version tag, because it releases a commit that it checked on main, as \"Publish a release\" in docs/releasing.md describes. Go on with the other work, and list the command in your report."
releases=(
  'gh release create v1.0.0'
  'gh release create v1.0.0 --target 0123abc --generate-notes'
  'gh release new v1.0.0'
  'gh release create v1.0.0 --draft'
  'gh release edit v1.0.0 --draft=false'
  'gh release edit --draft=0 v1.0.0'
  'gh release edit v1.0.0 --notes Fixed --draft=False'
  'git push origin v1.0.0'
  'git push origin tag v1.0.0'
  'git push origin refs/tags/v1.0.0'
  'git push --force origin +v1.0.0'
  'git push origin v1.0.0:v1.0.0'
  'git push origin HEAD:refs/tags/v1.0.0'
  'git push --force origin HEAD:v1.0.0'
  'git push origin +validate-input:v1.0.0'
  'git push origin --delete v1.0.0'
  'git push origin :refs/tags/v1.0.0'
  'git tag v2.0.0 && git push origin v2.0.0'
  'git -C ../other push origin v1.0.0'
  "git push origin 'refs/tags/*'"
  "git push origin 'refs/*:refs/*'"
  'git push --tags'
  'git push origin --tag'
  'git push --follow-tags origin HEAD'
  'git push --mirror origin'
  'gh api -X POST repos/{owner}/{repo}/releases -f tag_name=v1.0.0'
  'gh api repos/{owner}/{repo}/releases --input release.json'
  'gh api --method PATCH repos/{owner}/{repo}/releases/123 -F draft=false'
  'gh api repos/{owner}/{repo}/git/refs -f ref=refs/tags/v1.0.0 -f sha=0123abc'
  'gh api -X PATCH repos/{owner}/{repo}/git/refs/tags/v1.0.0 -f sha=0123abc -F force=true'
  'gh api graphql -f query="mutation { createRef(input: {repositoryId: \"R_1\", name: \"refs/tags/v1.0.0\", oid: \"0123abc\"}) { clientMutationId } }"'
  # gh reads -X and -f after other short flags in one word, as split_flag_word in helpers.bash does. Its -i takes no
  # value.
  'gh api -i -X DELETE repos/{owner}/{repo}/releases/123'
  'gh api -iX DELETE repos/{owner}/{repo}/releases/123'
  'gh api -iXDELETE repos/{owner}/{repo}/releases/123'
  'gh api -i -f tag_name=v1.0.0 repos/{owner}/{repo}/releases'
  'gh api -if tag_name=v1.0.0 repos/{owner}/{repo}/releases'
  'gh api -iftag_name=v1.0.0 repos/{owner}/{repo}/releases'
)
for command in "${releases[@]}"; do
  expect_from abc123 "" "$command" 2 "$publishes_release"
  expect_from "$orchestrator" agent-7 "$command" 2 "$publishes_release"
  expect_from "$orchestrator" "" "$command" 0 ""
done
expect_repository_flags 2 "$publishes_release" release create 'v1.0.0'
expect_repository_flags 2 "$publishes_release" release edit 'v1.0.0 --draft=false'
not_releases=(
  'git push'
  'git push -u origin HEAD'
  'git push origin 383-block-commands'
  'git push origin validate-input'
  'git push origin HEAD:v2-notes'
  'git push origin notes-draft'
  'git push origin refs/tags/notes-draft'
  "git push origin 'refs/heads/*'"
  'git push --no-tags --all origin'
  'git tag v2.0.0'
  'gh release list'
  'gh release view v1.0.0'
  'gh release create --help'
  'gh release edit v1.0.0 --notes "Fixed the date"'
  'gh release edit v1.0.0 --draft'
  'gh release edit v1.0.0 --draft=true'
  'gh release upload v1.0.0 app.tar'
  'gh api repos/{owner}/{repo}/releases'
  'gh api -iX GET repos/{owner}/{repo}/releases/123'
  'gh api -iq .tag_name repos/{owner}/{repo}/releases/123'
  'gh api -X POST repos/{owner}/{repo}/releases/generate-notes -f tag_name=v1.0.0'
  'gh api repos/{owner}/{repo}/git/refs/tags/v1.0.0'
  'gh api repos/{owner}/{repo}/git/refs -f ref=refs/heads/fix-12 -f sha=0123abc'
  'gh api graphql -f query="{ repository(owner: \"jtmpl\", name: \"project\") { ref(qualifiedName: \"refs/tags/v1.0.0\") { name } } }"'
)
for command in "${not_releases[@]}"; do
  expect_from abc123 "" "$command" 0 ""
done

# Deleting a pull request's branch with gh pr close
TEST_AUTHOR=person
delete_branch="Blocked: gh pr close with --delete-branch or -d deletes the pull request's branch, and the next agent that works on its issue starts from that branch. Close the pull request without that flag."
for command in 'gh pr close 7 --delete-branch' 'gh pr close -d 7' 'gh pr close 7 --delete-branch=true' 'gh pr close --comment "Giving it back" -d'; do
  expect_block Bash "$command" "$delete_branch"
done
for command in 'gh pr close 7' 'gh pr close 7 --comment "Giving it back"' 'gh pr close 7 --delete-branch=false'; do
  expect_allow Bash "$command"
done
# gh reads -d in a word of several short flags, before the first flag that takes a value, which the rest of the word
# or the next word gives.
for command in "gh pr close 7 -dc'Giving it back'" "gh pr close 7 -dc 'Giving it back'" 'gh pr close 7 -dRjtmpl/other'; do
  expect_block Bash "$command" "$delete_branch"
done
for command in 'gh pr close 7 -cd' 'gh pr close 7 -c-d' 'gh pr close 7 --comment=-d'; do
  expect_allow Bash "$command"
done
# gh reads a value after = as Go's strconv.ParseBool does.
for value in 1 t T true TRUE True; do
  expect_block Bash "gh pr close 7 --delete-branch=$value" "$delete_branch"
  expect_block Bash "gh pr close 7 -d=$value" "$delete_branch"
done
for value in 0 f F false FALSE False; do
  expect_allow Bash "gh pr close 7 --delete-branch=$value"
  expect_allow Bash "gh pr close 7 -d=$value"
done

expect_repository_flags 2 "$delete_branch" pr close '7 --delete-branch'
expect_repository_flags 0 "" pr close '7 --delete-branch=false'
# gh finds the subcommand after the subcommand's own flags. While it looks for the subcommand, it reads the word after
# a single short flag, or a long flag without =, as that flag's value, so a flag that takes no value comes before
# another flag here.
expect_before_and_after_subcommand 2 "$delete_branch" pr '--delete-branch --comment=Done' close '7'
expect_before_and_after_subcommand 2 "$delete_branch" pr "--comment 'Giving it back' --delete-branch=true" close '7'
expect_before_and_after_subcommand 2 "$delete_branch" pr "-dc'Giving it back'" close '7'
expect_before_and_after_subcommand 0 "" pr '--delete-branch=false --comment=Done' close '7'
# gh reads close as the value of -d, finds no subcommand, and closes nothing.
expect_allow Bash 'gh pr -d close 7'
# gh skips an empty word while it looks for the subcommand, and finds none after --.
expect_before_and_after_subcommand 2 "$delete_branch" pr "'' --delete-branch=true" close '7'
expect_allow Bash 'gh pr -- close 7 --delete-branch'

# gh issue develop on an issue with needs-triage
TEST_LABELS="feature needs-triage"
needs_triage="Blocked: issue 12 has needs-triage, so no maintainer has accepted it yet. If a maintainer asked you to work on it, remove the label with gh issue edit 12 --remove-label needs-triage, and run the command again. Otherwise, leave the issue for the maintainer to triage."
expect_block Bash 'gh issue develop 12 --checkout' "$needs_triage"
expect_block Bash 'gh issue develop --list 12' "$needs_triage"
expect_block Bash 'gh issue develop --name fix-12 --base main 12' "$needs_triage"
expect_block Bash 'gh issue develop 12 -R jtmpl/other' "${needs_triage/edit 12/edit 12 --repo jtmpl/other}"
expect_gh_call 'gh issue develop 12 -R jtmpl/other' "issue view 12 --repo jtmpl/other --json labels"
expect_repository_flags 2 "${needs_triage/edit 12/edit 12 --repo jtmpl/other}" issue develop '12 --checkout'
for repository in '-R jtmpl/other' '--repo jtmpl/other' '--repo=jtmpl/other'; do
  expect_gh_call "gh issue $repository develop 12" "issue view 12 --repo jtmpl/other --json labels"
done
# The -c of gh issue develop is --checkout, which takes no value, so -cn fix-12 is -c -n fix-12.
for command in 'gh issue develop -c -n fix-12 12' 'gh issue develop -cn fix-12 12' 'gh issue develop -cnfix-12 12'; do
  expect_block Bash "$command" "$needs_triage"
done
expect_gh_call 'gh issue develop 12 -cRjtmpl/other' "issue view 12 --repo jtmpl/other --json labels"
expect_allow Bash 'gh issue view 12'
expect_allow Bash 'gh issue edit 12 --remove-label needs-triage'
expect_allow Bash 'gh issue develop'
for TEST_LABELS in "feature ready" "" fail; do
  expect_allow Bash 'gh issue develop 12 --checkout'
  expect_allow Bash 'gh issue develop --list 12'
done

# The commands that print the token that gh uses
prints_token="Blocked: this command prints the token that gh uses, and AGENTS.md says never to read or print secrets. gh commands use the token without it."
# shellcheck disable=SC2016 # The commands are the text that the agent sends, so $( ) stays as written.
prints_token_commands=(
  'gh auth token'
  'gh auth token -h github.com'
  'gh auth token --user other'
  'gh auth status -t'
  'gh auth status --show-token'
  'gh auth status --show-token=true'
  'gh auth status -at'
  'gh auth git-credential get'
  'git credential fill'
  'git -C ../other credential fill'
  'export GH_TOKEN=$(gh auth token)'
)
for command in "${prints_token_commands[@]}"; do
  expect_block Bash "$command" "$prints_token"
done
for command in 'gh auth token --help' 'gh auth status' 'gh auth status --active' 'gh auth status --show-token=false' \
  'git credential approve' 'git commit -m "Block gh auth token"'; do
  expect_allow Bash "$command"
done
expect_allow Bash "git commit --file - <<'EOF'
feat: block the commands that print the token

gh auth token
EOF"

# Substitutions run inside quoted words and expandable here-documents, but quoted delimiters keep them literal.
# shellcheck disable=SC2016 # Inspect shell text without expanding it in the test.
substitution_commands=(
  'export GH_TOKEN="$(gh auth token)"'
  'echo `gh auth token`'
  'echo "`gh auth token`"'
  'echo "$(printf ok)$(gh auth token)"'
  'echo "$(printf "%s" ")"; gh auth token)"'
  'echo "$(printf "%s" "$(gh auth token)")"'
  'echo "`printf "%s" \`gh auth token\``"'
  $'cat <<EOF\n$(gh auth token)\nEOF'
  $'cat <<EOF\n`gh auth token`\nEOF'
  $'cat <<EOF\n\'$(gh auth token)\'\nEOF'
  $'cat <<-EOF\n\t$(gh auth token)\n\tEOF'
  $'cat <<\'FIRST\' <<SECOND\n$(printf ok)\nFIRST\n$(gh auth token)\nSECOND'
  $'cat <<E"OF"\n$(printf ok)\nEOF\ngh auth token'
)
for command in "${substitution_commands[@]}"; do
  expect_block Bash "$command" "$prints_token"
done
# shellcheck disable=SC2016
literal_commands=(
  "echo '\$(gh auth token)'"
  'echo "\$(gh auth token)"'
  'echo "\`gh auth token\`"'
  'echo "$(printf ok)"'
  'git commit -m "Stop running gh auth token"'
  $'cat <<EOF\ngh auth token\nEOF'
  $'cat <<\'EOF\'\n$(gh auth token)\nEOF'
  $'cat <<"EOF"\n`gh auth token`\nEOF'
  $'cat <<E"OF"\n$(gh auth token)\nEOF'
  $'cat <<\\EOF\n$(gh auth token)\nEOF'
  $'cat <<FIRST <<\'SECOND\'\n$(printf ok)\nFIRST\n$(gh auth token)\nSECOND'
  '' 'echo ""' 'echo "$()"' $'cat <<EOF\nEOF'
)
for command in "${literal_commands[@]}"; do
  expect_allow Bash "$command"
done

# Inspecting a substitution must not run it.
expect_allow Bash "echo \"\$(touch '$base/substitution-ran')\""
case_count=$((case_count + 1))
if [[ -e $base/substitution-ran ]]; then
  echo "error: inspecting a substitution ran the command inside it." >&2
  failed_cases=$((failed_cases + 1))
fi

# A broken hook would be allowed by before-tool, so check incomplete input directly as well.
# shellcheck disable=SC2016
for command in 'echo "$(' 'echo "$(printf ok' 'echo "`printf ok' $'cat <<EOF\n$(printf ok'; do
  input=$(sample_input claude-code Bash "$command")
  for check in forbidden-commands secret-files; do
    status=0
    message=$(run_check "$check" "$input" 2>&1) || status=$?
    case_count=$((case_count + 1))
    if [[ $status != 0 && $status != 2 ]] || [[ $status == 0 && -n $message ]]; then
      echo "error: $check crashed while inspecting an incomplete substitution or here-document: $message" >&2
      failed_cases=$((failed_cases + 1))
    fi
  done
done

# Incomplete commands start no subcommand check, and each check itself exits cleanly.
for command in '' 'gh' 'gh pr' 'gh pr --repo' 'gh pr --repo create' 'gh pr -R create' 'gh pr --repo=jtmpl/other' \
  'gh release' 'gh release edit' 'gh release -R edit' 'git push origin tag'; do
  expect_allow Bash "$command"
  for check in forbidden-commands maintainer-commands maintainer-only issues-and-labels posted-text pull-request-rules \
    unchecked-pull-requests unread-pages; do
    hook_status=0
    hook_message=$(run_check "$check" "$(sample_input claude-code Bash "$command")" 2>&1 >/dev/null) || hook_status=$?
    expect_result "$check for incomplete command $command" 0 ""
  done
done

finish_tests
