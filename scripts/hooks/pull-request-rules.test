#!/usr/bin/env bash
# Tests scripts/hooks/pull-request-rules.check through scripts/hooks/before-tool.
set -euo pipefail
# shellcheck source=scripts/hooks/testing.bash
source "${BASH_SOURCE[0]%/*}/testing.bash"
# shellcheck source=scripts/hooks/check-passed.bash
source "$hooks_folder/check-passed.bash"
# shellcheck source=scripts/hooks/pages-read.bash
source "$hooks_folder/pages-read.bash"

# The cases run in repositories in a temporary folder, and git looks for no repository above it.
base=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$base"' EXIT
export GIT_CEILING_DIRECTORIES=$base
# git reads none of the person's settings, such as one that signs each commit, and commits as a stand-in person.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=Tester GIT_AUTHOR_EMAIL=tester@example.com GIT_COMMITTER_NAME=Tester GIT_COMMITTER_EMAIL=tester@example.com

# A stand-in for gh, first on the PATH, that answers the commands that look up an issue and list the branches that
# link to it: #12 and #20 are open issues, the branch 20-show-the-totals links to #20, and no other number exists.
# scripts/check-pull-request.test checks the commands that the script runs. The stand-in also answers gh pr view, with
# the file in the folder pull-requests named for the word after view, such as 5.json, or for the current branch when
# that word is a flag. For gh pr view <name> --repo <repository>, the file is in the folder of that name in
# pull-requests, such as jtmpl/other/7.json. The cases write those files with pull_request.
mkdir "$base/bin" "$base/pull-requests"
cat >"$base/bin/gh" <<'STAND_IN'
#!/usr/bin/env bash
if [[ ${1:-} == pr && ${2:-} == view ]]; then
  name=${3:-}
  if [[ $name == -* ]]; then
    name=$(git symbolic-ref --quiet --short HEAD) || name=""
  fi
  folder=${0%/*}/../pull-requests
  if [[ ${4:-} == --repo ]]; then
    folder=$folder/${5:-}
  fi
  file=$folder/$name.json
  if [[ -z $name || ! -f $file ]]; then
    echo "no pull requests found for \"$name\"" >&2
    exit 1
  fi
  cat "$file"
  exit 0
fi
# The query for the branches of an issue gives the issue's number in its eighth argument, as number=<number>.
if [[ ${1:-} == api && ${2:-} == graphql ]]; then
  case ${8:-} in
    number=12) ;;
    number=20) echo 20-show-the-totals ;;
    *)
      echo "gh: Could not resolve to an issue or pull request with the number of ${8#number=}." >&2
      exit 1
      ;;
  esac
  exit 0
fi
if [[ ${1:-} != api || ${2:-} != "repos/{owner}/{repo}/issues/"* ]]; then
  echo "The stand-in for gh doesn't answer: gh $*" >&2
  exit 1
fi
case ${2##*/} in
  12 | 20) printf 'open\tfalse\tfalse\t0\n' ;;
  *)
    echo "gh: Not Found (HTTP 404)" >&2
    exit 1
    ;;
esac
STAND_IN
chmod +x "$base/bin/gh"
export PATH=$base/bin:$PATH

# Prints the message that blocks a pull request with these errors: blocked <error>...
blocked() {
  printf '%s\n' "Blocked: the checks on pull requests in CI would fail on this one:" "$@" "Fix each problem, and run gh pr create again."
}

# Prints the message that blocks gh pr edit when the pull request would have these errors: edit_blocked <error>...
edit_blocked() {
  printf '%s\n' "Blocked: the checks on pull requests in CI would fail on this one:" "$@" "Fix each problem, and run gh pr edit again."
}

# Prints the message that blocks gh pr edit when the hook checks only the text that it gives, and the text has these
# problems: text_blocked <problem>...
text_blocked() {
  printf '%s\n' "Blocked: the text that this command would post has these problems:" "$@" "Fix each problem, and run gh pr edit again."
}

# The name of a person's home folder. scripts/check doesn't take $person for a name, so this file holds no path into
# a home folder.
person=ana
home_path_line="The app reads /Users/$person/bank.csv."
home_path_problem="The line \"$home_path_line\" holds a path into a home folder, /Users/$person/. Use a path relative to the repository, or ~ or \$HOME."
semicolon_line="The app skips the expenses; it keeps the total."
semicolon_problem="The line \"$semicolon_line\" has a semicolon in prose. Replace it with a period or a word such as \"and\", as \"Write clear sentences\" in docs/writing.md says."

# Writes what the stand-in for gh prints for gh pr view <name>: an open pull request from the branch work into main,
# with the title and body that the scripts pass, and with the changes that a jq program makes to it:
# pull_request <name> [<jq program>]
pull_request() {
  # shellcheck disable=SC2016 # The $ words are jq's variables.
  jq -n --arg title "$title" --arg body "$body" --arg commit "$(git -C "$clone" rev-parse work)" \
    '{title: $title, body: $body, state: "OPEN", baseRefName: "main", headRefName: "work", headRefOid: $commit,
      isCrossRepository: false, author: {login: "ana"}} | '"${2:-.}" >"$base/pull-requests/$1.json"
}

# Prints the message that blocks a pull request that changes files that scripts/consequential-paths lists, and isn't a
# draft: draft_needed <the files, separated by commas>
draft_needed() {
  printf '%s\n' "Blocked: this pull request changes files that a reviewer reads before the change merges: $1. Run gh pr create again with --draft, so that it waits for the review, and say in your report that it's a draft."
}

# Makes a folder the one that the agent works in, and the one that the cases' own commands, such as git add, run in,
# so that they act on its files: work_in <folder>
work_in() {
  test_cwd=$1
  cd "$1"
}

# Records a pass of scripts/check on the files of the current folder's repository, as scripts/check does, because
# scripts/hooks/unchecked-pull-requests.check blocks gh pr create without it.
record_pass() {
  tree_on_disk >"$(pass_record_path)"
}

# Records that a fresh reader read README.md and docs/code.md as they are on disk, as scripts/fresh-reader does, because
# scripts/hooks/unread-pages.check blocks gh pr create on the branch rules without it when claude is installed.
record_reading() {
  git hash-object README.md docs/code.md >>"$(pages_read_path)"
}

# A repository on GitHub, as a bare repository, whose main has notes.txt and scripts/configure-github,
# and a clone of it with two branches:
# - work adds a file in one commit.
# - co-authored has a commit with a Co-authored-by trailer.
origin=$base/origin.git
clone=$base/clone
git init --quiet --bare --initial-branch=main "$origin"
git init --quiet --initial-branch=main "$base/seed"
mkdir "$base/seed/scripts"
echo "Notes" >"$base/seed/notes.txt"
echo "echo Settings" >"$base/seed/scripts/configure-github"
git -C "$base/seed" add --all
git -C "$base/seed" commit --quiet -m "chore: start the project"
git -C "$base/seed" push --quiet "$origin" main
git clone --quiet "$origin" "$clone"
git -C "$clone" switch --quiet -c co-authored
git -C "$clone" commit --quiet --allow-empty -m "feat: export the totals" -m "Co-authored-by: Claude <noreply@anthropic.com>"
git -C "$clone" switch --quiet -c work main
echo "Imports" >"$clone/imports.txt"
git -C "$clone" add imports.txt
git -C "$clone" commit --quiet -m "feat: skip the expenses that were already imported"

title="feat: skip the expenses that were already imported"
body=$'Closes #12\n\n## What changed and why\n\nThe app skips the expenses that it has already imported.\n\n## How it was checked\n\nscripts/check passes.'
printf '%s\n' "$body" >"$base/body.md"
printf '%s\n' "${body/Closes #12/See #12}" >"$base/no-closing-line.md"
no_closing_line="The body has no line that says which issue the pull request closes. Edit the body and add a line such as \"Closes #12\", with the number of the issue."
not_a_type="The title \"skip the expenses that were already imported\" doesn't follow the format \"<type>: <what changed>\". Edit the title to match. The types are feat, fix, docs, test, refactor, perf, build, ci, revert, chore."

work_in "$clone"
record_pass

# A title and body that the scripts pass, from --body, from --body-file, and from a path relative to the folder
expect_allow Bash "gh pr create --title '$title' --body '$body'"
expect_allow Bash "gh pr create --title '$title' --body-file $base/body.md"
expect_allow Bash "gh pr create -t '$title' -F ../body.md --label feature"
expect_allow Bash "gh pr new --title='$title' --body-file=../body.md"
expect_allow Bash "gh pr create --base main --title '$title' --body-file ../body.md"

# A title or body that a script fails, in commands that open a pull request in other ways
expect_block Bash "gh pr create --title 'skip the expenses that were already imported' --body-file ../body.md" \
  "$(blocked "$not_a_type")"
expect_block Bash "gh pr create --title '$title' --body-file ../no-closing-line.md" "$(blocked "$no_closing_line")"
expect_block Bash "git push && GH_DEBUG=1 gh pr new --body-file ../no-closing-line.md --title 'skip the expenses that were already imported'" \
  "$(blocked "$not_a_type" "$no_closing_line")"

# Each repository flag form preserves the title and body checks, including the new alias.
for subcommand in create new; do
  expect_repository_flags 0 "" pr "$subcommand" "--title '$title' --body '$body'"
  expect_repository_flags 2 "Blocked: the command gives no title, so this hook can't check it. Give the title with --title." pr "$subcommand" '--fill'
  expect_repository_flags 2 "$(blocked "$no_closing_line")" pr "$subcommand" "--title '$title' --body-file ../no-closing-line.md"
  expect_repository_flags 2 "$(blocked "$not_a_type")" pr "$subcommand" "--title 'skip the expenses that were already imported' --body-file ../body.md"
  expect_repository_flags 0 "" pr "$subcommand" '--help'
  expect_repository_flags 0 "" pr "$subcommand" '--fill --dry-run'
done
expect_repository_flags 0 "" pr view '7'
for repository in '-R jtmpl/other' '--repo jtmpl/other' '--repo=jtmpl/other'; do
  expect_allow Bash "echo gh pr $repository create"
  expect_block Bash "echo \"\$(gh pr $repository create --fill)\"" \
    "Blocked: the command gives no title, so this hook can't check it. Give the title with --title."
  expect_allow Bash "echo '\$(gh pr $repository create --fill)'"
done

# The commits of the branch that --head names, alone or after a person's name and a colon
co_authored_commit=$(git rev-parse --short co-authored)
co_authored="Commit $co_authored_commit \"feat: export the totals\" has a Co-authored-by trailer, for Claude <noreply@anthropic.com>. Rewrite the commit without the trailer, such as with git commit --amend when it's the latest commit, and push the branch again with --force-with-lease."
expect_block Bash "gh pr create --head co-authored --title '$title' --body-file ../body.md" "$(blocked "$co_authored")"
expect_block Bash "gh pr create -H jtmpl:co-authored --title '$title' --body-file ../body.md" "$(blocked "$co_authored")"
# With no branch after the colon, the commits are those of HEAD.
expect_block Bash "gh pr create --head jtmpl: --title 'skip the expenses that were already imported' --body-file ../body.md" \
  "$(blocked "$not_a_type")"

# The branch that --head names, or the one that HEAD points to, was created for #20, though the body closes #12. The
# branch holds the commit of work.
git branch 20-show-the-totals work
not_the_branch_issue="The body closes #12, but the branch 20-show-the-totals was created for #20. Edit the body to close #20 instead."
expect_block Bash "gh pr create --head 20-show-the-totals --title '$title' --body-file ../body.md" \
  "$(blocked "$not_the_branch_issue")"
git switch --quiet 20-show-the-totals
expect_block Bash "gh pr create --title '$title' --body-file ../body.md" "$(blocked "$not_the_branch_issue")"
git switch --quiet work
# After a person's name and a colon, the branch can be in a fork, which no issue here links to.
expect_allow Bash "gh pr create --head ana:20-show-the-totals --title '$title' --body-file ../body.md"

# Bodies from here-documents and standard input, with quotes in the text, which would end a quoted word
quoted_body=${body/"skips the expenses"/skips the \"imported\" expenses}
expect_allow Bash "gh pr create --title '$title' --body \"\$(cat <<'EOF'
$quoted_body
EOF
)\""
expect_allow Bash "gh pr create --title '$title' --body-file - <<'EOF'
$quoted_body
EOF"
expect_allow Bash "gh pr create --title '$title' --body-file - < ../body.md"

# A title that the hook reads as the command writes it, without filling in variables
may_expand="This hook reads the title and body as the command writes them, without running \$( ) or filling in variables."
expect_block Bash "gh pr create --title \"\$type: skip the expenses\" --body-file ../body.md" \
  "$(blocked "The title \"\$type: skip the expenses\" doesn't follow the format \"<type>: <what changed>\". Edit the title to match. The types are feat, fix, docs, test, refactor, perf, build, ci, revert, chore.") $may_expand"

# Bodies that a command in $( ) or backticks prints. The hook asks for the body in a file, and checks neither the
# command's text nor the title. The text of this printf would fail the checks, though the body it prints passes them.
from_command="Blocked: this hook can't run the command in \$( ) or backticks that prints the body, so it can't check the pull request's body. Write the body to a file in a command of its own first, and give the file with --body-file."
printf_body="\"\$(printf '%s\n' 'Closes #12.' '' '## What changed and why' '' 'The app skips the expenses.')\""
expect_block Bash "gh pr create --title '$title' --body $printf_body" "$from_command"
expect_block Bash "gh pr create --title 'skip the expenses that were already imported' --body=$printf_body" "$from_command"
expect_block Bash "gh pr create --title '$title' --body \"\$(cat ../body.md)\"" "$from_command"
expect_block Bash "gh pr create --title '$title' -b \"\`cat ../body.md\`\"" "$from_command"

# Commands that give no title or no body, or a body file that the hook can't read before the command runs
expect_block Bash "gh pr create --fill" "Blocked: the command gives no title, so this hook can't check it. Give the title with --title."
expect_block Bash "gh pr create --body-file ../body.md" "Blocked: the command gives no title, so this hook can't check it. Give the title with --title."
expect_block Bash "gh pr create --title '$title' --fill" \
  "Blocked: the command gives no body, so this hook can't check the pull request's body. Give the body with --body, or write it to a file and give the file with --body-file."
expect_block Bash "gh pr create --title '$title' --body-file ../missing.md" \
  "Blocked: this hook checks the body file before the command runs, and ../missing.md doesn't exist yet or the command writes it. Write the file in a command of its own first, and give its path without variables."
# copy.md exists, and the command writes it before gh reads it.
cp "$base/body.md" "$base/copy.md"
expect_block Bash "cat ../body.md > ../copy.md && gh pr create --title '$title' --body-file ../copy.md" \
  "Blocked: this hook checks the body file before the command runs, and ../copy.md doesn't exist yet or the command writes it. Write the file in a command of its own first, and give its path without variables."

# Commands that don't open a pull request
expect_allow Bash "gh pr create --fill --dry-run"
expect_allow Bash "gh pr create --help"
# gh reads -dh as -d -h, so it shows its help for both.
expect_allow Bash "gh pr create -d -h"
expect_allow Bash "gh pr create -dh"
# gh keeps the last value that the command gives --help, but it reads no flag after -h.
expect_block Bash "gh pr create --help --help=false" \
  "Blocked: the command gives no title, so this hook can't check it. Give the title with --title."
expect_allow Bash "gh pr create -h --help=false"
# The shell can turn the letters or the word before the h into a flag that takes the h as its value, so the hook checks
# a command with a word that may expand.
for help in "-d\${x}h" "\$x -h" "--help \$x"; do
  expect_block Bash "gh pr create $help" \
    "Blocked: the command gives no title, so this hook can't check it. Give the title with --title."
done
expect_allow Bash "gh pr view 7 --json title"
expect_allow Bash "echo gh pr create --fill"

# gh pr edit on pull requests from the branch work: #5 has a title and body that the scripts pass, as has the branch's
# own pull request, and #7 has a title and body that they fail. The hook checks the title and body that the command
# gives, with the one that it keeps as GitHub has it.
pull_request 5
pull_request work
pull_request 7 '.title = "skip the expenses that were already imported" | .body |= sub("Closes #12"; "See #12")'
expect_allow Bash "gh pr edit 5 --body-file ../body.md"
expect_allow Bash "gh pr edit 5 -t '$title' --body '$body'"
expect_allow Bash "gh pr edit --title='$title' --add-label feature"
expect_allow Bash "gh pr edit 7 --title '$title' -F ../body.md"
expect_block Bash "gh pr edit 5 --body-file ../no-closing-line.md" "$(edit_blocked "$no_closing_line")"
expect_block Bash "gh pr edit 5 --title 'skip the expenses that were already imported'" "$(edit_blocked "$not_a_type")"
expect_block Bash "git push && gh pr edit -F ../no-closing-line.md" "$(edit_blocked "$no_closing_line")"
expect_block Bash "gh pr edit 7 --title '$title'" "$(edit_blocked "$no_closing_line")"
expect_block Bash "gh pr edit 7 --body-file ../body.md" "$(edit_blocked "$not_a_type")"
expect_block Bash "gh pr edit 5 --title \"\$type: skip the expenses\"" \
  "$(edit_blocked "The title \"\$type: skip the expenses\" doesn't follow the format \"<type>: <what changed>\". Edit the title to match. The types are feat, fix, docs, test, refactor, perf, build, ci, revert, chore.") $may_expand"
expect_block Bash "gh pr edit 5 --body-file ../missing.md" \
  "Blocked: this hook checks the body file before the command runs, and ../missing.md doesn't exist yet or the command writes it. Write the file in a command of its own first, and give its path without variables."
expect_block Bash "gh pr edit 5 --body \"\$(cat ../body.md)\"" "$from_command"
# gh pr edit with -R edits the pull request of that repository, also when the repository follows -R in the same word.
# Pull requests 5 and 7 of jtmpl/other have a title and body that the scripts pass.
mkdir -p "$base/pull-requests/jtmpl/other"
pull_request jtmpl/other/5
pull_request jtmpl/other/7
expect_repository_flags 2 "$(edit_blocked "$no_closing_line")" pr edit "5 --body-file ../no-closing-line.md"
for repository in '-R jtmpl/other' -Rjtmpl/other; do
  expect_allow Bash "gh pr edit 7 $repository --title '$title'"
done

# A short flag's value right after the flag, with or without =
expect_block Bash "gh pr edit 5 -t'skip the expenses that were already imported'" "$(edit_blocked "$not_a_type")"
expect_block Bash "gh pr edit 5 -b'${body/Closes #12/See #12}'" "$(edit_blocked "$no_closing_line")"
expect_block Bash "gh pr edit 5 -F../no-closing-line.md" "$(edit_blocked "$no_closing_line")"
expect_block Bash "gh pr edit 5 -F=../no-closing-line.md" "$(edit_blocked "$no_closing_line")"
expect_block Bash "gh pr create -t'skip the expenses that were already imported' --body-file ../body.md" \
  "$(blocked "$not_a_type")"
# The -d of gh pr create takes no value, so the title follows it in the same word.
expect_block Bash "gh pr create -dt'skip the expenses that were already imported' --body-file ../body.md" \
  "$(blocked "$not_a_type")"

# gh pr edit commands that change no title and no body, or that change nothing
expect_allow Bash "gh pr edit 7 --add-label feature"
expect_allow Bash "gh pr edit 7 --base main --remove-label bug"
expect_allow Bash "gh pr edit 7 --title '$title' --help"
expect_allow Bash "echo gh pr edit 7 --title '$title'"

# gh pr edit on a pull request that gh can't find, or on a merged one, whose checks no longer decide anything. The hook
# checks only the format of the title that the command gives, and the prose of the title and body, as
# scripts/hooks/posted-text.check checks the text of other commands.
pull_request 9 '.state = "MERGED"'
expect_allow Bash "gh pr edit 404 --body-file ../no-closing-line.md"
expect_allow Bash "gh pr edit 9 --body-file ../no-closing-line.md"
expect_block Bash "gh pr edit 404 --body '$semicolon_line'" "$(text_blocked "$semicolon_problem")"
expect_block Bash "gh pr edit 9 --body '$body
$home_path_line'" "$(text_blocked "$home_path_problem")"
expect_block Bash "gh pr edit 9 --title 'skip the expenses; keep the total'" "$(text_blocked \
  "The title \"skip the expenses; keep the total\" doesn't follow the format \"<type>: <what changed>\". Edit the title to match. The types are feat, fix, docs, test, refactor, perf, build, ci, revert, chore." \
  "The title \"skip the expenses; keep the total\" has a semicolon in prose. Replace it with a period or a word such as \"and\", as \"Write clear sentences\" in docs/writing.md says.")"
# gh reads -t= as the title =, because it drops the = after a short flag only when more follows it.
expect_block Bash "gh pr edit 9 -t=" "$(text_blocked \
  "The title \"=\" doesn't follow the format \"<type>: <what changed>\". Edit the title to match. The types are feat, fix, docs, test, refactor, perf, build, ci, revert, chore.")"

# A body that closes #12 for a pull request from the branch 20-show-the-totals, which was created for #20. From a
# fork, the branch can have that name though no issue here links to it.
pull_request 20 '.headRefName = "20-show-the-totals" | .body |= sub("#12"; "#20")'
pull_request 21 '.headRefName = "20-show-the-totals" | .body |= sub("#12"; "#20") | .isCrossRepository = true'
expect_block Bash "gh pr edit 20 --body-file ../body.md" "$(edit_blocked "$not_the_branch_issue")"
expect_allow Bash "gh pr edit 21 --body-file ../body.md"

# A pull request whose latest commit on GitHub, which the clone hasn't fetched, has a Co-authored-by trailer. With
# --base, the pull request would merge into a branch that has that commit.
git -C "$base/seed" switch --quiet -c shared
git -C "$base/seed" commit --quiet --allow-empty -m "feat: share the totals" -m "Co-authored-by: Ana <ana@example.com>"
git -C "$base/seed" push --quiet "$origin" shared
git -C "$base/seed" switch --quiet main
pull_request 8 ".headRefName = \"shared\" | .headRefOid = \"$(git -C "$base/seed" rev-parse shared)\""
shared_commit=$(git -C "$base/seed" rev-parse --short shared)
expect_block Bash "gh pr edit 8 --body-file ../body.md" \
  "$(edit_blocked "Commit $shared_commit \"feat: share the totals\" has a Co-authored-by trailer, for Ana <ana@example.com>. Rewrite the commit without the trailer, such as with git commit --amend when it's the latest commit, and push the branch again with --force-with-lease.")"
expect_allow Bash "gh pr edit 8 --base shared --body-file ../body.md"
expect_allow Bash "gh pr edit 8 -Bshared --body-file ../body.md"

# A pull request whose latest commit origin doesn't have either. The hook checks only the text that the command gives.
pull_request 10 '.headRefOid = "0123456789abcdef0123456789abcdef01234567"'
expect_allow Bash "gh pr edit 10 --body-file ../no-closing-line.md"
expect_block Bash "gh pr edit 10 --body '$semicolon_line'" "$(text_blocked "$semicolon_problem")"

# git reads a --base that starts with a dash as a branch, and not as its option --upload-pack, which would run the
# command in it, because origin is a folder on this machine.
ran_marker=$base/upload-pack-ran
expect_allow Bash "gh pr create --base '--upload-pack=touch $ran_marker' --title '$title' --body-file ../body.md"
expect_allow Bash "gh pr edit 5 --base '--upload-pack=touch $ran_marker' --body-file ../body.md"
case_count=$((case_count + 1))
if [[ -e $ran_marker ]]; then
  echo "error: the hook let git fetch read a --base that starts with a dash as the option --upload-pack, and run its command." >&2
  failed_cases=$((failed_cases + 1))
fi

# As in the title job, the hook checks only the title of a pull request from Dependabot, and the prose of the text that
# the command gives.
pull_request 30 '.title = "build: bump jq" | .body = "Bumps jq." | .author.login = "app/dependabot"'
expect_allow Bash "gh pr edit 30 --title 'build: bump jq from 1.7 to 1.8'"
expect_allow Bash "gh pr edit 30 --body 'Bumps jq from 1.7 to 1.8.'"
expect_block Bash "gh pr edit 30 --title 'bump jq'" \
  "$(text_blocked "The title \"bump jq\" doesn't follow the format \"<type>: <what changed>\". Edit the title to match. The types are feat, fix, docs, test, refactor, perf, build, ci, revert, chore.")"
expect_block Bash "gh pr edit 30 --body '$semicolon_line'" "$(text_blocked "$semicolon_problem")"

# Branches that change files that scripts/consequential-paths lists, which open only as drafts: rules changes some
# of the rules and README.md, and moved moves scripts/configure-github away. A renamed file counts by its old path.
git switch --quiet -c rules main
mkdir -p docs src/app
for file in AGENTS.md README.md docs/code.md src/app/AGENTS.md; do
  echo "Rules" >"$file"
done
git add --all
git commit --quiet -m "docs: write the rules"
record_pass
record_reading
rules_need_draft=$(draft_needed "AGENTS.md, docs/code.md, src/app/AGENTS.md")
expect_block Bash "gh pr create --title '$title' --body-file ../body.md" "$rules_need_draft"
expect_block Bash "gh pr new --title '$title' --body-file ../body.md" "$rules_need_draft"
expect_block Bash "gh pr create --draft=false --title '$title' --body-file ../body.md" "$rules_need_draft"
expect_block Bash "gh pr create --draft --title '$title' --body-file ../body.md --draft=false" "$rules_need_draft"
expect_allow Bash "gh pr create --draft --title '$title' --body-file ../body.md"
expect_allow Bash "gh pr create -d --title '$title' --body-file ../body.md"
expect_allow Bash "gh pr new --title '$title' --body-file ../body.md --draft=true"
# gh reads -dt'<title>' as -d -t '<title>', and the value after the = in -dd=false as the value of the last -d.
expect_allow Bash "gh pr create -d -t '$title' --body-file ../body.md"
expect_allow Bash "gh pr create -dt'$title' --body-file ../body.md"
expect_allow Bash "gh pr create -d=true --title '$title' --body-file ../body.md"
expect_block Bash "gh pr create -d=false --title '$title' --body-file ../body.md" "$rules_need_draft"
expect_block Bash "gh pr create -dd=false --title '$title' --body-file ../body.md" "$rules_need_draft"
# A body that the title job fails, without --draft and with it. Without it, one block names both problems.
expect_block Bash "gh pr create --title '$title' --body-file ../no-closing-line.md" \
  "$rules_need_draft"$'\n'"$(blocked "$no_closing_line")"
expect_block Bash "gh pr create --draft --title '$title' --body-file ../no-closing-line.md" "$(blocked "$no_closing_line")"
git switch --quiet -c moved main
mkdir tools
git mv scripts/configure-github tools/configure-github
git commit --quiet -m "refactor: move the settings script"
record_pass
# The title job also asks the body of such a pull request to say that the orchestrator runs the script after the merge.
expect_block Bash "gh pr create --title '$title' --body-file ../body.md" "$(draft_needed scripts/configure-github)"$'\n'"$(
  blocked "The pull request changes scripts/configure-github, and the body doesn't say that the orchestrator runs it after the merge. Add this sentence under \"What changed and why\": The orchestrator runs scripts/configure-github after the merge.")"

# A branch whose paths look like listed ones but aren't, which opens without --draft
git switch --quiet -c look-alikes main
mkdir -p src/scripts
for file in src/scripts/check src/xAGENTS.md AGENTS.md.old; do
  echo "Notes" >"$file"
done
git add --all
git commit --quiet -m "feat: add the notes"
record_pass
expect_allow Bash "gh pr create --title '$title' --body-file ../body.md"

# A copy of the scripts whose list of paths has no line break after its last pattern, imports.txt, which the branch
# work adds
cp -R "${hooks_folder%/*}" "$base/copy"
printf 'AGENTS.md\nimports.txt' >"$base/copy/consequential-paths"
git switch --quiet work
record_pass
hook_status=0
hook_message=$(HOME=$test_home "$base/copy/hooks/before-tool" 2>&1 >/dev/null \
  <<<"$(sample_input claude-code Bash "gh pr create --title '$title' --body-file ../body.md")") || hook_status=$?
expect_result "With no line break after the last pattern, the hook" 2 "$(draft_needed imports.txt)"

# A cd before gh pr create changes the folder that the hook reads the body file and the commits from, unless the cd
# runs in a subshell. The worktree holds the commit of the branch rules, a body file of its own, and a pass and a
# record of the pages read of its own, while the folder that the agent works in is on the branch work.
worktree=$base/rules-worktree
git worktree add --quiet --detach "$worktree" rules
cp "$base/body.md" "$worktree/pr-body.md"
(cd "$worktree" && record_pass && record_reading)
expect_block Bash "cd $worktree && gh pr create --title '$title' --body-file ../body.md" "$rules_need_draft"
expect_allow Bash "cd $worktree && gh pr create --draft --title '$title' --body-file pr-body.md"
expect_allow Bash "(cd $worktree) && gh pr create --title '$title' --body-file ../body.md"
expect_allow Bash "echo \"\$(cd $worktree)\" && gh pr create --title '$title' --body-file ../body.md"
# After a cd to a folder that a variable names, the hook can't tell the branch, even when the folder that the agent
# works in is on rules.
git switch --quiet rules
record_pass
expect_allow Bash "cd \"\$folder\" && gh pr create --title '$title' --body-file ../body.md"

# A branch from a main that has moved on since the clone last fetched it. The commit on main that the clone hasn't
# fetched changes scripts/configure-github and has a Co-authored-by trailer, and it's no part of the pull request.
git -C "$base/seed" switch --quiet -c fresh
echo "echo More settings" >>"$base/seed/scripts/configure-github"
git -C "$base/seed" commit --quiet -am "feat: turn on code scanning" -m "Co-authored-by: Ana <ana@example.com>"
git -C "$base/seed" push --quiet "$origin" fresh:main
echo "Totals" >"$base/seed/totals.txt"
git -C "$base/seed" add totals.txt
git -C "$base/seed" commit --quiet -m "feat: show the monthly totals"
git -C "$base/seed" push --quiet "$origin" fresh
git fetch --quiet origin fresh
git switch --quiet fresh
record_pass
expect_allow Bash "gh pr create --title 'feat: show the monthly totals' --body-file ../body.md"

# When the hook can't find the pull request's commits, it has nothing to check them with.
expect_allow Bash "gh pr create --head missing --title 'skip the expenses that were already imported' --body-file ../body.md"
expect_allow Bash "gh pr create --base missing --title 'skip the expenses that were already imported' --body-file ../body.md"
git init --quiet --initial-branch=main "$base/no-remote"
work_in "$base/no-remote"
git commit --quiet --allow-empty -m "chore: start the project"
record_pass
expect_allow Bash "gh pr create --title 'skip the expenses that were already imported' --body-file ../body.md"
mkdir "$base/outside"
work_in "$base/outside"
expect_allow Bash "gh pr create --title 'skip the expenses that were already imported' --body-file ../body.md"

finish_tests
