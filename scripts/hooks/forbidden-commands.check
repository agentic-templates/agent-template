#!/usr/bin/env bash
# Blocks the commands that the rules forbid, with a message that says what to do instead:
# - every gh command while gh is older than scripts/minimum-gh-version says, because the rules' commands need it
# - approving a workflow run with gh api, because the run executes the code of a pull request from outside the project
# - closing one of Dependabot's pull requests, because Dependabot then stops offering that version, and pushing to a
#   dependabot/ branch, because Dependabot then stops rebasing the pull request
# - deleting a pull request's branch with gh pr close, because the next agent that works on its issue starts from it
# - gh issue develop on an issue with needs-triage, because no maintainer has accepted the issue yet
# - gh auth token, gh auth status with --show-token, gh auth git-credential and git credential fill, because they print
#   the token that gh uses, and AGENTS.md says never to read or print secrets
# - publishing a release or putting a version tag on GitHub, unless the orchestrator's session runs it, because the
#   orchestrator releases a commit that it checked on main, as "Publish a release" in docs/releasing.md describes. A
#   version tag matches v*, because only such tags can use the release environment, whose jobs start without approval.
#   The check reads only the command, so it misses a push that git's settings make push tags, such as push.followTags.
#   A refspec that a variable gives, as in git push origin $tag, goes ahead, because the hook can't tell it before the
#   command runs.
# It asks gh and git about the pull request, the issue or the branch, and allows the command when they fail, such as
# without a network.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"
# shellcheck source=scripts/minimum-gh-version
source "${BASH_SOURCE[0]%/*}/../minimum-gh-version"
# shellcheck source=scripts/needs-triage
source "${BASH_SOURCE[0]%/*}/../needs-triage"

# The flags that take a value, as gh auth token --help and gh auth status --help list them.
token_flags_with_value=" -h --hostname -u --user "
status_flags_with_value=" -h --hostname --jq --json --template "

prints_token="Blocked: this command prints the token that gh uses, and AGENTS.md says never to read or print secrets. gh commands use the token without it."
publishes_release="Blocked: only the orchestrator publishes a release or a version tag, because it releases a commit that it checked on main, as \"Publish a release\" in docs/releasing.md describes. Go on with the other work, and list the command in your report."

# The endpoints of gh api that create, change or delete a release: a repository's releases, or one release by its id.
release_endpoint='(^|/)repos/[^/]+/[^/]+/releases(/[0-9]+)?/?(\?|$)'
# The endpoints of gh api that create, change or delete a ref, such as a tag.
ref_endpoint='(^|/)repos/[^/]+/[^/]+/git/refs(/|\?|$)'

# gh --version takes about 54 ms of CPU, the largest part of the hook's call for a gh command, as issue #116 measured.
# So the check records the gh that it found and the first line of what its gh --version printed, and runs
# gh --version again only when it finds another gh, such as after an update.

# Prints the record's path, or fails when the check can't find the loop's folder. HOOK_GH_VERSION_FILE names another
# file, as in the hooks' tests.
gh_version_record() {
  local loop
  if [[ -n ${HOOK_GH_VERSION_FILE:-} ]]; then
    printf '%s\n' "$HOOK_GH_VERSION_FILE"
    return 0
  fi
  loop=$(hook_loop_folder) || return 1
  printf '%s\n' "$loop/gh-version"
}

# Succeeds if the file that the shell finds for gh is the gh program, and not a version manager's shim. A shim runs
# the gh that the project's settings pick, so its version can change while the shim stays the same. A shim is a link
# to the version manager, as mise's are, a script, as asdf's are, or a program in a folder named shims:
# is_gh_program <path where the shell finds gh> <the file that the path resolves to>
is_gh_program() {
  local start
  if [[ ${1%/*} == */shims || ${2##*/} != gh ]]; then
    return 1
  fi
  { IFS= read -r -n 2 start; } 2>/dev/null <"$2" || return 1
  [[ $start != "#!" ]]
}

# Prints what tells one gh program apart from another: the inode and the modification time of its file, and the path
# where the shell finds it. An update either writes a new file, which has another inode, or rewrites the old one, which
# changes its time. Fails for a version manager's shim.
gh_identity() {
  local path program file
  path=$(command -v gh) || return 1
  program=$path
  if [[ -L $path ]]; then
    # On macOS before 12.3, readlink has no -f, and the check runs gh --version for each gh command.
    program=$(readlink -f "$path") || return 1
  fi
  is_gh_program "$path" "$program" || return 1
  # GNU stat takes -c, and the stat of macOS and BSD takes -f.
  file=$(stat -c '%i %Y' "$program" 2>/dev/null || stat -f '%i %m' "$program" 2>/dev/null) || return 1
  printf '%s %s\n' "$file" "$path"
}

# Prints the version that the record holds for a gh, or fails when the record names another gh or can't be read:
# recorded_gh_version <record> <identity>
recorded_gh_version() {
  local recorded_identity version
  # A record that another hook is still writing lacks the newline at the end of its version, so read fails on it.
  { IFS= read -r recorded_identity && IFS= read -r version; } 2>/dev/null <"$1" || return 1
  if [[ $recorded_identity != "$2" ]]; then
    return 1
  fi
  printf '%s\n' "$version"
}

# Prints the first line of what gh --version prints, such as "gh version 2.98.0 (2026-08-20)", or fails when
# gh --version fails.
gh_version() {
  local record identity identity_after output version
  record=$(gh_version_record) || record=""
  identity=$(gh_identity) || identity=""
  if [[ -n $record && -n $identity ]] && recorded_gh_version "$record" "$identity"; then
    return 0
  fi
  output=$(gh --version 2>/dev/null) || return 1
  version=${output%%$'\n'*}
  # When gh changes while gh --version runs, as when an update ends, the version can be either gh's, so the check
  # records it only when gh stayed the same. A record that can't be written only makes the next gh command run
  # gh --version again.
  identity_after=$(gh_identity) || identity_after=""
  if [[ -n $record && -n $identity && $identity_after == "$identity" ]]; then
    { mkdir -p "${record%/*}" && printf '%s\n%s\n' "$identity" "$version" >"$record"; } 2>/dev/null || true
  fi
  printf '%s\n' "$version"
}

check_gh_version() {
  local version found
  version=$(gh_version) || return 0
  found=$(older_gh_version "$version")
  if [[ -n $found ]]; then
    block "Blocked: the rules in AGENTS.md need gh $minimum_gh_version or later, and this machine has gh $found. Tell the maintainer, and that https://github.com/cli/cli#installation says how to update it."
  fi
}

check_gh_api() {
  local approval='(^|/)actions/runs/[^/]+/approve/?(\?.*)?$'
  read_arguments 2 "$api_flags_with_value"
  if [[ $argument =~ $approval ]]; then
    block "Blocked: a maintainer decides whether to approve a workflow run, because the run executes the code of a pull request from outside the project. Go on with the other work, and list the run in your report for the maintainer."
  fi
  read_api_method
  if [[ $api_method == GET ]]; then
    return 0
  fi
  if [[ $argument =~ $release_endpoint ]]; then
    block_release
  fi
  # A request that creates or moves a tag names it in a field or in the query of a mutation, which can be in any word
  # of the command or in a here-document, so the whole command is searched. The hook can't read a file that gives them.
  if [[ $shell_command == *refs/tags/v* ]] &&
    [[ $argument =~ $ref_endpoint || ($argument == graphql && $shell_command == *mutation*) ]]; then
    block_release
  fi
}

# Blocks a command that publishes a release or a version tag, unless the orchestrator's session runs it.
block_release() {
  if ! is_orchestrator; then
    block "$publishes_release"
  fi
}

check_gh_release() {
  if prints_help; then
    return 0
  fi
  case ${command_words[2]:-} in
    create | new) block_release ;;
    edit)
      if publishes_draft; then
        block_release
      fi
      ;;
  esac
}

# Succeeds if gh release edit in command_words sets --draft to false, which publishes the draft. gh reads the value as
# Go's strconv.ParseBool does.
publishes_draft() {
  local word
  for word in "${command_words[@]:3}"; do
    case $word in
      --draft=0 | --draft=f | --draft=F | --draft=false | --draft=FALSE | --draft=False) return 0 ;;
    esac
  done
  return 1
}

# Succeeds if a pull request is one of Dependabot's: is_from_dependabot [<pull request>] [--repo <repository>]
# Without a pull request, gh asks about the current branch's.
is_from_dependabot() {
  local answer
  answer=$(gh pr view "$@" --json author 2>/dev/null) || return 1
  [[ $(jq -r .author.login <<<"$answer") == app/dependabot ]]
}

check_gh_pr_close() {
  local pull_request="this branch's pull request"
  read_arguments 3 "$pr_close_flags_with_value"
  if [[ -n $argument ]]; then
    pull_request="pull request $argument"
  fi
  if is_from_dependabot ${target[@]+"${target[@]}"}; then
    block "Blocked: $pull_request is one of Dependabot's, and closing it makes Dependabot stop offering that version. Leave it open, because Dependabot closes it once main has the update."
  fi
  if deletes_branch; then
    block "Blocked: gh pr close with --delete-branch or -d deletes the pull request's branch, and the next agent that works on its issue starts from that branch. Close the pull request without that flag."
  fi
}

# Succeeds if gh pr close, whose flags read_arguments read, deletes the pull request's branch. gh reads -d among several
# short flags in one word, as split_flag_word does, so -dc'Giving it back' deletes the branch and -cd is the comment d.
# It reads the value of --delete-branch=<value> or -d=<value> as is_true_flag_value does.
deletes_branch() {
  local word flag value value_is_next_word flags_before
  for word in ${flags[@]+"${flags[@]}"}; do
    split_flag_word "$word" "$pr_close_flags_with_value"
    # A flag before the last in a word takes no value, so a -d there deletes the branch.
    if [[ $flags_before == *d* ]]; then
      return 0
    fi
    if [[ $flag == -d || $flag == --delete-branch ]] && is_true_flag_value "$value"; then
      return 0
    fi
  done
  return 1
}

check_gh_issue_develop() {
  local answer
  read_arguments 3 "$develop_flags_with_value"
  if [[ -z $argument ]]; then
    return 0
  fi
  answer=$(gh issue view "${target[@]}" --json labels 2>/dev/null) || return 0
  if jq -e 'any(.labels[]; .name == "needs-triage")' >/dev/null <<<"$answer"; then
    block "Blocked: $(needs_triage_message "$argument" "${target[*]}")"
  fi
}

check_git_push() {
  read_push_arguments
  check_push_to_dependabot
  check_push_of_version_tag
}

# Run read_push_arguments first.
check_push_to_dependabot() {
  local refspec branch
  local -a refspecs=(HEAD)
  # Without a refspec, git pushes the current branch.
  if ((${#push_refspecs[@]} > 0)); then
    refspecs=("${push_refspecs[@]}")
  fi
  for refspec in "${refspecs[@]}"; do
    # A refspec is [+]<source>[:<branch>]. Without a colon, it pushes to the branch with the source's name.
    branch=${refspec#+}
    branch=${branch#*:}
    if [[ $branch == HEAD ]]; then
      branch=$(git "${git_folder[@]}" symbolic-ref --quiet --short HEAD 2>/dev/null) || continue
    fi
    branch=${branch#refs/heads/}
    if [[ $branch == dependabot/* ]]; then
      block "Blocked: $branch is the branch of one of Dependabot's pull requests, and Dependabot stops rebasing a pull request once someone else pushes to it. Make the update in a pull request of your own instead, as \"Stuck pull requests\" in docs/loop.md describes."
    fi
  done
}

# Blocks a push of a version tag to any remote, unless the orchestrator's session runs it: one with a flag that pushes
# tags, or with a refspec that can push to a version tag. git push <remote> tag <name> pushes refs/tags/<name>.
# Run read_push_arguments first.
check_push_of_version_tag() {
  local i refspec
  if has_git_flag --tags --follow-tags --mirror; then
    block_release
  fi
  for ((i = 0; i < ${#push_refspecs[@]}; i++)); do
    refspec=${push_refspecs[i]}
    if [[ $refspec == tag ]] && ((i + 1 < ${#push_refspecs[@]})); then
      i=$((i + 1))
      refspec=refs/tags/${push_refspecs[i]}
    fi
    if pushes_to_version_tag "$refspec"; then
      block_release
    fi
  done
}

# Succeeds if a refspec of git push, [+]<source>[:<destination>], can push to a version tag. Without a colon, the
# destination is the source. For a destination that doesn't start with refs/, git first looks for a ref of that name on
# the remote, and pushes to it, even a tag from a branch. The hook can't ask the remote, so a local tag of that name
# counts for the remote's. Otherwise git pushes to a branch when the source is a branch, and to a tag when the source is
# a tag, so the destination counts as a tag unless git names the source as a branch. A tag that an earlier part of the
# command creates counts too, because git doesn't have it yet when the hook runs: pushes_to_version_tag <refspec>
pushes_to_version_tag() {
  local refspec=${1#+} source destination full_source
  source=${refspec%%:*}
  destination=${refspec#*:}
  if [[ $destination == refs/* ]]; then
    names_version_tag "$destination"
    return
  fi
  if ! names_version_tag "refs/tags/$destination"; then
    return 1
  fi
  if git "${git_folder[@]}" rev-parse --verify --quiet "refs/tags/$destination" >/dev/null 2>&1; then
    return 0
  fi
  # git rev-parse would read a source that starts with - as an option, and git push can't push it as a branch either.
  if [[ $source == -* ]] ||
    ! full_source=$(git "${git_folder[@]}" rev-parse --symbolic-full-name "$source" 2>/dev/null); then
    return 0
  fi
  [[ $full_source != refs/heads/* ]]
}

# Succeeds if a full ref can name a version tag, as refs/tags/v1.0.0 does. A refspec's pattern, which holds a *, counts
# when the refs that it matches can include a version tag, as with refs/tags/* and refs/*: names_version_tag <ref>
names_version_tag() {
  local before_star=${1%%\**}
  if [[ $before_star == "$1" ]]; then
    [[ $1 == refs/tags/v* ]]
    return
  fi
  [[ refs/tags/v == "$before_star"* || $before_star == refs/tags/v* ]]
}

check_gh_auth_token() {
  read_arguments 3 "$token_flags_with_value"
  # Only --help shows the help instead of the token, because -h means --hostname here.
  if ! has_flag --help; then
    block "$prints_token"
  fi
}

check_gh_auth_status() {
  local flag
  read_arguments 3 "$status_flags_with_value"
  for flag in ${flags[@]+"${flags[@]}"}; do
    case $flag in
      --show-token=false) ;;
      --show-token | --show-token=*) block "$prints_token" ;;
      --*) ;;
      # -t, or a group of short flags that holds it, such as -at
      -*t*) block "$prints_token" ;;
    esac
  done
}

check_simple_command() {
  drop_command_prefixes "$@"
  move_gh_repository_flags
  if ((${#command_words[@]} == 0)); then
    return 0
  fi
  if [[ ${command_words[0]##*/} == git ]]; then
    read_git_options
    case "${command_words[git_subcommand]:-} ${command_words[git_subcommand + 1]:-}" in
      "push "*) check_git_push ;;
      "credential fill") block "$prints_token" ;;
    esac
    return 0
  fi
  if [[ ${command_words[0]##*/} != gh ]]; then
    return 0
  fi
  check_gh_version
  case "${command_words[1]:-} ${command_words[2]:-}" in
    "api "*) check_gh_api ;;
    "release "*) check_gh_release ;;
    "pr close") check_gh_pr_close ;;
    "issue develop") check_gh_issue_develop ;;
    "auth token") check_gh_auth_token ;;
    "auth status") check_gh_auth_status ;;
    "auth git-credential") block "$prints_token" ;;
  esac
}

read_input
if [[ $tool_name == Bash ]]; then
  # A here-document holds text, such as a commit message that names a command, and not commands.
  for_each_simple_command check_simple_command "$shell_command"
fi
