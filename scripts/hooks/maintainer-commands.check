#!/usr/bin/env bash
# Blocks the commands that wait for a maintainer:
# - running scripts/configure-github again on a repository whose settings were applied, unless the orchestrator's
#   session runs it in the main checkout, as a command of its own, while the checkout's scripts folder and .gitignore
#   are the same as on the repository's main on GitHub, because a reviewer read each change to them before it merged.
#   The repository is the one that the script would change. No hook protects the state file, which names the orchestrator's session, so a
#   builder that scripts/loop/run-builder started, which has a session id of its own, could write its id there and
#   count as the orchestrator.
# - checking out, fetching or merging a pull request from a fork, because a checkout brings in the pull
#   request's hook scripts and AGENTS.md, and only a maintainer decides to put a fork's code on main
# - merging a pull request while the rules for main no longer require a check that scripts/configure-github
#   requires there, because the merge could skip that check
# - changing a code scanning or Dependabot alert, such as dismissing it, because only a maintainer decides
#   that an alert is wrong
# For the first three, it asks gh about the repository, and allows the command when gh fails, such as without a network.
# The exception is the orchestrator's run of scripts/configure-github, which gh's answer about main allows, so a
# failure blocks it.
# shellcheck source=scripts/hooks/helpers.bash
source "${BASH_SOURCE[0]%/*}/helpers.bash"

# The flags of gh pr checkout that take a value, as gh pr checkout --help lists them.
checkout_flags_with_value=" -b --branch --worktree -R --repo "

report="Go on with the other work, and list the command in your report for the maintainer, who runs it."
alert_change="Blocked: only a maintainer dismisses or changes a code scanning or Dependabot alert. Fix the code that the alert points to. If you think the alert is wrong, tell the maintainer which alert and why."
# The endpoint of a single alert, with or without a leading slash, a host or a query string.
# The owner and the repository can be one word, such as $repo.
single_alert='(^|/)repos/.+/(code-scanning|dependabot)/alerts/[^/?]+(\?|$)'

# Blocks a checkout or fetch of a fork's pull request: block_checkout <pull request> [--repo <repository>]
block_checkout() {
  block "Blocked: pull request $1 comes from a fork. Read it with gh pr diff $* instead, because a checkout brings in its hook scripts and its AGENTS.md."
}

# Succeeds if a repository's settings were applied before, because scripts/configure-github creates a ruleset
# named main: settings_applied_before <owner/repository>
settings_applied_before() {
  local rulesets
  rulesets=$(gh api "repos/$1/rulesets?includes_parents=false" 2>/dev/null) || return 1
  jq -e 'any(.[]; .name == "main")' >/dev/null <<<"$rulesets"
}

# Prints the repository that scripts/configure-github would change, which the script gets from gh repo view.
# The hook asks gh the same way: in the folder that the script runs in, and with GH_REPO if the command sets it
# for the script: script_repository <folder> [<value of GH_REPO>]
script_repository() {
  local answer
  if (($# == 2)); then
    answer=$(cd -- "$1" 2>/dev/null && GH_REPO=$2 gh repo view --json nameWithOwner 2>/dev/null) || return 1
  else
    answer=$(cd -- "$1" 2>/dev/null && gh repo view --json nameWithOwner 2>/dev/null) || return 1
  fi
  jq -r .nameWithOwner <<<"$answer"
}

# Succeeds if a pull request comes from a fork: is_from_fork [<pull request>] [--repo <repository>]
# Without a pull request, gh asks about the current branch's.
is_from_fork() {
  local answer
  answer=$(gh pr view "$@" --json isCrossRepository 2>/dev/null) || return 1
  [[ $(jq -r .isCrossRepository <<<"$answer") == true ]]
}

# Blocks a merge while the rules for main no longer require a check that scripts/configure-github requires there,
# which scripts/check-main-rules finds: block_if_main_lacks_checks [--repo <repository>]
# Without a repository, the script asks about this checkout's.
block_if_main_lacks_checks() {
  local problem status=0
  # The subshells drop the trap, which would otherwise turn every exit code of the script into 1.
  if (($# == 2)); then
    problem=$(trap - ERR && GH_REPO=$2 "${BASH_SOURCE[0]%/*}/../check-main-rules" 2>&1 >/dev/null) || status=$?
  else
    problem=$(trap - ERR && "${BASH_SOURCE[0]%/*}/../check-main-rules" 2>&1 >/dev/null) || status=$?
  fi
  # Any other code means that the script can't tell, such as when gh fails.
  if ((status == 1)); then
    block "Blocked: ${problem#error: } Go on with the other work, and list this in your report for the maintainer."
  fi
}

# Reads the words of a bash or sh command after the shell's name, and sets these variables:
# - shell_operand: the first word after the flags, which names the script, or with -c holds the command
# - shell_rcfile: the file that --rcfile or --init-file names, or empty
# - shell_only_reads: true if -n or -o noexec is on after the flags, so that the shell checks the script's syntax
#   and doesn't run it. -i doesn't turn it off for a script, although the manual of bash says that interactive shells
#   ignore -n.
read_shell_arguments() {
  local i word noexec_sign=""
  shell_operand="" shell_rcfile=""
  for ((i = 1; i < ${#command_words[@]}; i++)); do
    word=${command_words[i]}
    case $word in
      --rcfile | --init-file)
        i=$((i + 1))
        shell_rcfile=${command_words[i]:-}
        ;;
      --*) ;;
      [-+]*) read_shell_flag_letters "$word" ;;
      *)
        shell_operand=$word
        break
        ;;
    esac
  done
  shell_only_reads=false
  if [[ $noexec_sign == - ]]; then
    shell_only_reads=true
  fi
}

# Reads the word at index i of command_words for read_shell_arguments, when the word holds one-letter flags, such as
# -xo or +n. It sets noexec_sign to the word's sign if the word turns -n or -o noexec on or off, and moves i past the
# values of the flags: read_shell_flag_letters <word>
read_shell_flag_letters() {
  local sign=${1:0:1} position
  # In a word such as -xo, each o and O takes the next word as its value.
  for ((position = 1; position < ${#1}; position++)); do
    case ${1:position:1} in
      n) noexec_sign=$sign ;;
      o)
        i=$((i + 1))
        if [[ ${command_words[i]:-} == noexec ]]; then
          noexec_sign=$sign
        fi
        ;;
      O) i=$((i + 1)) ;;
    esac
  done
}

# Succeeds if a word names scripts/configure-github: is_configure_github <word>
is_configure_github() {
  [[ $1 == scripts/configure-github || $1 == */scripts/configure-github ]]
}

# Succeeds if the command in command_words runs scripts/configure-github, and sets script_word to the word that names
# the script.
runs_configure_github() {
  script_word=${command_words[0]}
  # bash or sh can run the script too.
  if [[ ${script_word##*/} == bash || ${script_word##*/} == sh ]]; then
    read_shell_arguments
    # An interactive shell runs the file that --rcfile or --init-file names, and the hook can't tell whether the
    # shell is interactive, such as when it reads a terminal. So that file counts as a run, whatever the other flags are.
    if is_configure_github "$shell_rcfile"; then
      script_word=$shell_rcfile
      return 0
    elif $shell_only_reads; then
      return 1
    fi
    script_word=$shell_operand
  fi
  is_configure_github "$script_word"
}

# Adds 1 to other_commands for a simple command other than a cd without redirections, because a redirection can write
# a file, also on a cd: count_other_command <word>...
count_other_command() {
  if [[ $1 != cd || ${#redirections[@]} != 0 ]]; then
    other_commands=$((other_commands + 1))
  fi
}

# Prints the number of simple commands in the shell command other than a cd without redirections.
other_command_count() {
  other_commands=0
  for_each_simple_command count_other_command "$shell_command"
  echo "$other_commands"
}

# Succeeds if the command in command_words runs the main checkout's scripts/configure-github in the main checkout, and
# nothing else in the shell command can change what the run reads after this hook compares the scripts folder with
# GitHub's: no word before the script, such as a variable, env or bash, no redirection, and no simple command other than
# a cd without redirections. A variable such as BASH_ENV or PATH can run other code, and a redirection can write a file:
# runs_alone_in_main_checkout <main checkout> <number of the words before the command's name>
# other_command_count runs in a subshell, because its for_each_simple_command changes command_folder after a command
# that runs through env -C.
runs_alone_in_main_checkout() {
  [[ $2 == 0 && ${#redirections[@]} == 0 && $script_word == "${command_words[0]}" &&
    $(physical_path "$command_folder" /) == "$1" &&
    $(physical_path "$script_word" "$command_folder") == "$1/scripts/configure-github" &&
    $(other_command_count) == 1 ]]
}

# Prints the tree of the scripts folder on the main branch of a repository on GitHub, and on the next line the mode and
# blob of its .gitignore, or an empty line when main has none: scripts_and_gitignore_on_github <owner/name>
scripts_and_gitignore_on_github() {
  local answer
  answer=$(gh api "repos/$1/git/trees/main" 2>/dev/null) || return 1
  jq -r '(first(.tree[] | select(.path == "scripts" and .type == "tree") | .sha) // error("main has no scripts folder")),
    (first(.tree[] | select(.path == ".gitignore") | "\(.mode) \(.sha)") // "")' <<<"$answer" 2>/dev/null
}

# Runs git on the files of a checkout, with paths relative to it: git_in_checkout <checkout> <argument>...
# GIT_DIR and GIT_WORK_TREE name the checkout, because they override core.worktree, which the shared git folder's
# config, or the checkout's config.worktree, can set to another folder, whose untracked files git would list instead.
# GIT_DIR can name a .git file, as in the checkout of a submodule.
git_in_checkout() {
  GIT_DIR=$1/.git GIT_WORK_TREE=$1 git -C "$1" "${@:2}"
}

# Prints an entry for git update-index -z --index-info for each path that standard input lists, separated by NUL
# characters, as the path is on disk in a checkout: disk_entries <checkout>
# It hashes the bytes on disk and takes the mode from the disk, because git add would follow settings in the shared git
# folder that can make it store a file as main has it while the file on disk differs, such as a clean filter, a
# conversion of line endings or core.fileMode=false. A symbolic link is a blob of its target, as git stores it. A path
# that is neither a file nor a symbolic link gets no entry, such as a file that's gone or a folder in its place, whose
# files are listed too. It fails for a folder that holds a repository of its own, which git lists with a / at the end
# rather than its files.
disk_entries() {
  local path target blob blobs files=() modes=() i=0
  while IFS= read -r -d '' path; do
    if [[ -L $1/$path ]]; then
      target=$(readlink "$1/$path") || return 1
      blob=$(printf '%s' "$target" | git_in_checkout "$1" hash-object -w --stdin 2>/dev/null) || return 1
      printf '120000 %s\t%s\0' "$blob" "$path"
    elif [[ -f $1/$path ]]; then
      files+=("$path")
      if [[ -x $1/$path ]]; then
        modes+=(100755)
      else
        modes+=(100644)
      fi
    elif [[ $path == */ ]]; then
      return 1
    fi
  done
  if ((${#files[@]} == 0)); then
    return 0
  fi
  # One git hash-object for all the files takes 0.01 seconds for the 165 files in scripts, and one for each file 0.8.
  blobs=$(git_in_checkout "$1" hash-object -w --no-filters -- "${files[@]}" 2>/dev/null) || return 1
  while IFS= read -r blob; do
    printf '%s %s\t%s\0' "${modes[i]}" "$blob" "${files[i]}"
    i=$((i + 1))
  done <<<"$blobs"
}

# Prints the tree of a checkout's scripts folder as it is on disk, as disk_entries finds the files: the files of HEAD,
# the ones that git doesn't track, other than the ones that a .gitignore ignores, and each .gitignore, also one that
# ignores itself. It lists them with an index that it reads from HEAD, rather than with a copy of the checkout's index,
# which can hold flags, such as assume-unchanged and skip-worktree, that make git skip a file that differs. It reads
# only the rules of .gitignore files, which scripts_and_gitignore_on_disk compares with main's, and not the ones of the
# shared git folder: scripts_tree_on_disk <checkout>
scripts_tree_on_disk() {
  local folder status=0
  folder=$(mktemp -d) || return 1
  if ! GIT_INDEX_FILE=$folder/head-index git_in_checkout "$1" read-tree HEAD 2>/dev/null ||
    ! GIT_INDEX_FILE=$folder/head-index git_in_checkout "$1" ls-files -z --cached --others \
      --exclude-per-directory=.gitignore -- scripts >"$folder/paths" 2>/dev/null ||
    ! GIT_INDEX_FILE=$folder/head-index git_in_checkout "$1" ls-files -z --others -- ':(glob)scripts/**/.gitignore' \
      >>"$folder/paths" 2>/dev/null ||
    ! disk_entries "$1" <"$folder/paths" >"$folder/entries" ||
    ! GIT_INDEX_FILE=$folder/disk-index git_in_checkout "$1" update-index -z --index-info \
      <"$folder/entries" 2>/dev/null ||
    ! GIT_INDEX_FILE=$folder/disk-index git_in_checkout "$1" write-tree --prefix=scripts/ 2>/dev/null; then
    status=1
  fi
  rm -rf "$folder"
  return "$status"
}

# Prints the tree of a checkout's scripts folder and the mode and blob of its .gitignore, as they are on disk, in the
# form of scripts_and_gitignore_on_github. The .gitignore counts, because its rules decide which new files in the
# scripts folder scripts_tree_on_disk leaves out: scripts_and_gitignore_on_disk <checkout>
scripts_and_gitignore_on_disk() {
  local tree entry
  tree=$(scripts_tree_on_disk "$1") || return 1
  entry=$(printf '.gitignore\0' | disk_entries "$1" | tr '\0' '\n') || return 1
  printf '%s\n%s\n' "$tree" "${entry%%$'\t'*}"
}

# Blocks the orchestrator's run of scripts/configure-github, unless it runs alone in the main checkout while the
# checkout's scripts folder and .gitignore are the same as on the repository's main on GitHub. Each worktree can move
# origin/main, because they share the git folder, so the hook asks GitHub:
# check_orchestrators_run <owner/name> <number of the words before the command's name>
check_orchestrators_run() {
  local main on_github on_disk
  main=$(hook_main_checkout 2>/dev/null) || main=""
  if [[ -z $main ]] || ! runs_alone_in_main_checkout "$main" "$2"; then
    block "Blocked: the orchestrator runs scripts/configure-github again only in the main checkout, as a command of its own, without a variable, env, bash, sh or a redirection: cd ${main:-<main checkout>} && scripts/configure-github."
  fi
  if ! on_github=$(scripts_and_gitignore_on_github "$1") || ! on_disk=$(scripts_and_gitignore_on_disk "$main"); then
    block "Blocked: this hook can't compare the main checkout's scripts folder and .gitignore with the ones on main on GitHub, because gh or git failed, or the folder holds a repository of its own. Check that gh can reach GitHub, remove any repository inside the folder, and try again."
  fi
  if [[ $on_github != "$on_disk" ]]; then
    block "Blocked: the orchestrator runs scripts/configure-github again only while the main checkout's scripts folder, with its untracked files, and its .gitignore are the same as on main on GitHub, because a reviewer read each change to them before it merged. Bring the main checkout up to date with git fetch origin && git merge --ff-only origin/main, undo any other change to its .gitignore and its scripts folder, remove any new file in the folder, also a .gitignore that ignores itself, and run the script again."
  fi
}

# Blocks a run of scripts/configure-github on a repository whose settings were applied before, unless the orchestrator
# runs it as check_orchestrators_run allows:
# check_configure_github [<word that drop_command_prefixes dropped, such as GH_REPO=owner/name>]...
check_configure_github() {
  local word repository sets_gh_repo=false gh_repo=""
  if ! runs_configure_github; then
    return 0
  fi
  for word in "$@"; do
    if [[ $word == GH_REPO=* ]]; then
      sets_gh_repo=true
      gh_repo=${word#GH_REPO=}
    fi
  done
  if [[ -z $command_folder || $gh_repo == *[\$\`]* ]]; then
    block "Blocked: can't tell which repository scripts/configure-github would change. Clone the repository first. Then run cd <folder> && scripts/configure-github as a command of its own, with the folder written out."
  fi
  if $sets_gh_repo; then
    repository=$(script_repository "$command_folder" "$gh_repo") || return 0
  else
    repository=$(script_repository "$command_folder") || return 0
  fi
  if ! settings_applied_before "$repository"; then
    return 0
  fi
  if ! is_orchestrator; then
    block "Blocked: this repository's settings were applied before, so only the orchestrator or a maintainer with admin access runs scripts/configure-github again. Go on with the other work, and list the command in your report."
  fi
  check_orchestrators_run "$repository" "$#"
}

check_gh_pr() {
  local subcommand
  if [[ ${command_words[0]##*/} != gh || ${command_words[1]:-} != pr ]]; then
    return 0
  fi
  subcommand=${command_words[2]:-}
  case $subcommand in
    checkout | co) read_arguments 3 "$checkout_flags_with_value" ;;
    merge) read_arguments 3 "$merge_flags_with_value" ;;
    *) return 0 ;;
  esac
  # Without a pull request, gh pr checkout asks the person to pick one.
  if [[ -z $argument && $subcommand != merge ]]; then
    return 0
  fi
  if is_from_fork ${target[@]+"${target[@]}"}; then
    if [[ $subcommand != merge ]]; then
      block_checkout "${target[@]}"
    elif [[ -n $argument ]]; then
      block "Blocked: pull request $argument comes from a fork, so a maintainer merges it. $report"
    else
      block "Blocked: this branch's pull request comes from a fork, so a maintainer merges it. $report"
    fi
  fi
  # Turning auto-merge off merges nothing.
  if [[ $subcommand == merge ]] && ! has_flag --disable-auto; then
    block_if_main_lacks_checks ${repository[@]+"${repository[@]}"}
  fi
}

check_git_fetch() {
  local i=1 number pull_ref='^\+?(refs/)?pull/([0-9]+)/(head|merge)(:.*)?$'
  if [[ ${command_words[0]##*/} != git ]]; then
    return 0
  fi
  while [[ ${command_words[i]:-} == -C ]]; do
    i=$((i + 2))
  done
  if [[ ${command_words[i]:-} != fetch && ${command_words[i]:-} != pull ]]; then
    return 0
  fi
  for ((i = i + 1; i < ${#command_words[@]}; i++)); do
    if [[ ${command_words[i]} =~ $pull_ref ]]; then
      number=${BASH_REMATCH[2]}
      if is_from_fork "$number"; then
        block_checkout "$number"
      fi
    fi
  done
}

check_gh_api() {
  if [[ ${command_words[0]##*/} != gh || ${command_words[1]:-} != api ]]; then
    return 0
  fi

  # gh api's argument is the endpoint.
  read_arguments 2 "$api_flags_with_value"
  read_api_method
  if [[ $argument =~ $single_alert && $api_method != GET ]]; then
    block "$alert_change"
  fi
  # The query can come from a here-document or from another command through a pipe,
  # which aren't words of this command, so the whole command is searched.
  if [[ $argument == graphql && $shell_command == *dismissRepositoryVulnerabilityAlert* ]]; then
    block "$alert_change"
  fi
}

check_simple_command() {
  local prefix_count
  drop_command_prefixes "$@"
  move_flags_after_gh_subcommand
  if ((${#command_words[@]} == 0)); then
    return 0
  fi
  # The words that drop_command_prefixes dropped, such as GH_REPO=<repository>
  prefix_count=$(($# - ${#command_words[@]}))
  follow_cd
  check_configure_github "${@:1:prefix_count}"
  check_gh_pr
  check_git_fetch
  check_gh_api
}

read_input
# The folder that scripts/configure-github would run in, as follow_cd in helpers.bash describes.
command_folder=${cwd:-$PWD}
if [[ $tool_name == Bash ]]; then
  for_each_simple_command check_simple_command "$shell_command"
fi
