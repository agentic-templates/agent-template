# shellcheck shell=bash
# Prints the types that the title check in scripts/check-title allows, one to a line.
# scripts/next-version reads the titles of commits with them.
# Run it from the repository's root.
allowed_title_types() {
  sed -n 's/^[[:space:]]*types="\([^"]*\)".*/\1/p' scripts/check-title | tr '|' '\n'
}
